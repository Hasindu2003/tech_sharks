@page
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Branch Manager")]
@model HRMS.UI.Pages.BranchManager.ReviewTransfersModel
@{
    ViewData["Title"] = "Review Transfers";
}

<style>
    .back-link { color: #7a8863; font-size: 13px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; margin-bottom: 8px; }
    .back-link:hover { color: #10823c; }
    .page-h { font-size: 19px; font-weight: 800; color: #151811; margin: 0 0 3px 0; }
    .page-s { font-size: 12px; color: #7a8863; margin: 0 0 22px 0; }
    .sec-title { font-size: 14px; font-weight: 700; color: #151811; margin: 0 0 10px 0; }
    .table-card { background: white; border: 1px solid #e2e5dc; border-radius: 10px; overflow: hidden; margin-bottom: 28px; box-shadow: 0 1px 2px rgba(0,0,0,.05); }
    .emp-table { width: 100%; border-collapse: collapse; }
    .emp-table th { background: #f9fafb; padding: 13px 19px; text-align: left; font-size: 13px; font-weight: 700; color: #7a8863; border-bottom: 1px solid #e2e5dc; }
    .emp-table td { padding: 13px 19px; border-bottom: 1px solid #e2e5dc; font-size: 14px; color: #151811; }
    .emp-table tr:last-child td { border-bottom: none; }
    .emp-table tbody tr:hover { background: #fafafa; }
    .employee-cell { display: flex; align-items: center; gap: 10px; }
    .avatar-circle { width: 36px; height: 36px; border-radius: 50%; background: #e8f3ec; color: #10823c; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; flex-shrink: 0; }
    .emp-info .name { font-size: 14px; font-weight: 700; color: #151811; display: block; }
    .emp-info .sub  { font-size: 12px; color: #7a8863; }
    .btn-action { color: #10823c; font-size: 13px; font-weight: 700; text-decoration: none; padding: 5px 10px; border-radius: 5px; transition: background .2s; }
    .btn-action:hover { background: #e8f3ec; }
    .empty-state { text-align: center; padding: 48px; }
    .empty-state svg { display: block; margin: 0 auto 12px; }
    .e-title { font-size: 14px; font-weight: 600; color: #151811; margin-bottom: 4px; }
    .e-sub { font-size: 12px; color: #7a8863; }
</style>

<h2 class="page-h">Review Transfers</h2>
<p class="page-s">Manage employee transfer processes in your branch</p>

<!-- Pending -->
<div style="font-size:14px;font-weight:700;color:#151811;margin:0 0 10px">
    New Requests
    @if (Model.PendingRequests.Any())
    {
        <span style="background:#ef4444;color:#fff;padding:2px 8px;border-radius:20px;font-size:11px;font-weight:800;margin-left:6px">@Model.PendingRequests.Count</span>
    }
</div>

@if (Model.PendingRequests.Any())
{
    <div class="table-card">
        <table class="emp-table">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>From Branch</th>
                    <th>To Branch</th>
                    <th>Your Role</th>
                    <th>Submitted</th>
                    <th style="text-align:right"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model.PendingRequests)
                {
                    var initials = string.Join("", request.EmployeeName.Split(' ').Take(2).Select(w => w[0])).ToUpper();
                    var role = request.CurrentBranch == Model.BranchManagerBranch ? "Current BM" : "Target BM";
                    <tr>
                        <td>
                            <div class="employee-cell">
                                <div class="avatar-circle">@initials</div>
                                <div class="emp-info">
                                    <span class="name">@request.EmployeeName</span>
                                    <span class="sub">@request.CurrentDesignation</span>
                                </div>
                            </div>
                        </td>
                        <td style="color:#7a8863">@request.CurrentBranch</td>
                        <td style="font-weight:600">@request.RequestedBranch</td>
                        <td>
                            <span class="k-badge @(role == "Current BM" ? "k-badge-info" : "k-badge-approved")" style="font-size:11px">@role</span>
                        </td>
                        <td style="color:#7a8863">@request.RequestedDate.ToString("MMM dd, yyyy")</td>
                        <td style="text-align:right">
                            <a asp-page="/BranchManager/ReviewTransfer" asp-route-id="@request.Id" class="btn-action">Review</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="table-card empty-state">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#e2e5dc" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
        <p class="e-title">No pending transfer requests</p>
        <span class="e-sub">All transfer requests in your branch have been reviewed.</span>
    </div>
}

<!-- History -->
<div style="font-size:14px;font-weight:700;color:#151811;margin:0 0 10px">
    Previously Reviewed
    <span style="background:#f3f4f6;color:#7a8863;padding:2px 8px;border-radius:20px;font-size:11px;font-weight:800;margin-left:6px">@Model.ReviewedRequests.Count</span>
</div>

@if (Model.ReviewedRequests.Any())
{
    <div class="table-card">
        <table class="emp-table">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>From → To</th>
                    <th>Your Role</th>
                    <th>Your Decision</th>
                    <th>Reviewed On</th>
                    <th style="text-align:right"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.ReviewedRequests)
                {
                    var initials = string.Join("", r.EmployeeName.Split(' ').Take(2).Select(w => w[0])).ToUpper();
                    var wasCurrent  = r.CurrentBranch == Model.BranchManagerBranch;
                    var decision    = wasCurrent ? r.CurrentBMReview    : r.TargetBMReview;
                    var reviewDate  = wasCurrent ? r.CurrentBMReviewDate : r.TargetBMReviewDate;
                    var role        = wasCurrent ? "Current BM"          : "Target BM";
                    var isApproved  = decision == "Approved";
                    <tr>
                        <td>
                            <div class="employee-cell">
                                <div class="avatar-circle">@initials</div>
                                <div class="emp-info">
                                    <span class="name">@r.EmployeeName</span>
                                    <span class="sub">@r.EpfNumber · @r.CurrentDesignation</span>
                                </div>
                            </div>
                        </td>
                        <td style="font-size:13px;color:#7a8863">@r.CurrentBranch → <strong style="color:#151811">@r.RequestedBranch</strong></td>
                        <td>
                            <span class="k-badge @(wasCurrent ? "k-badge-info" : "k-badge-approved")" style="font-size:11px">@role</span>
                        </td>
                        <td>
                            <span style="display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;
                                         background:@(isApproved ? "#e8f3ec" : "#fff0f0");color:@(isApproved ? "#10823c" : "#dc3545")">
                                <i class="bi bi-@(isApproved ? "check-circle" : "x-circle")"></i>
                                @decision
                            </span>
                        </td>
                        <td style="color:#7a8863;font-size:13px">
                            @(reviewDate.HasValue ? reviewDate.Value.ToString("MMM dd, yyyy") : "-")
                        </td>
                        <td style="text-align:right">
                            <a asp-page="/Transfer/Details" asp-route-id="@r.Id" class="btn-action">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="table-card" style="text-align:center;padding:32px 24px">
        <div style="font-size:13px;color:#7a8863">No reviewed requests yet.</div>
    </div>
}
