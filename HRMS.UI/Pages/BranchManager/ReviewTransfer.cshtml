@page "{id:int}"
@model HRMS.UI.Pages.BranchManager.ReviewTransferModel
@{
    ViewData["Title"] = "Transfer Request Review";
}

@if (Model.TransferRequest == null)
{
    <div class="k-alert k-alert-danger"><i class="bi bi-exclamation-triangle"></i> Transfer request not found.</div>
}
else
{
    var req = Model.TransferRequest;
    var nameParts = (req.EmployeeName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = nameParts.Length > 0 ? string.Join("", nameParts.Take(2).Select(w => w[0])).ToUpper() : "EM";
    var isCurrentBM = Model.ReviewerRole == "Current Branch Manager";

    <div style="margin-bottom:20px">
        <a asp-page="/Separation/Dashboard" asp-route-ActiveTab="Transfers" style="color:#6b7280;text-decoration:none;font-size:0.88rem;display:inline-flex;align-items:center;gap:6px">
            <i class="bi bi-arrow-left"></i> Back
        </a>
        <span style="color:#9ca3af;font-size:0.85rem;margin-left:8px">Request #@req.Id</span>
        <span class="k-badge @(isCurrentBM ? "k-badge-info" : "k-badge-approved")" style="margin-left:8px">
            You are: @Model.ReviewerRole
        </span>
    </div>

    <div class="profile-header">
        <div class="profile-info">
            <div class="profile-avatar">@initials</div>
            <div>
                <div class="profile-name">@req.EmployeeName</div>
                <div class="profile-meta">
                    <span><i class="bi bi-hash"></i> @req.EpfNumber</span>
                    <span><i class="bi bi-building"></i> @req.CurrentBranch</span>
                    <span><i class="bi bi-diagram-3"></i> @req.Department</span>
                </div>
            </div>
        </div>
    </div>

    <div class="transfer-detail-grid">
        <div>
            <div class="k-card" style="margin-bottom:20px">
                <div class="k-card-header">Transfer Details</div>
                <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;margin-bottom:20px">
                    <div>
                        <div class="detail-label">Current Branch</div>
                        <div class="detail-value">@req.CurrentBranch</div>
                    </div>
                    <div>
                        <div class="detail-label">Target Branch</div>
                        <div class="detail-value">@req.RequestedBranch</div>
                    </div>
                    <div>
                        <div class="detail-label">Department</div>
                        <div class="detail-value">@req.Department</div>
                    </div>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:20px;margin-bottom:20px">
                    <div>
                        <div class="detail-label">Position</div>
                        <div class="detail-value">@req.CurrentDesignation</div>
                    </div>
                    <div>
                        <div class="detail-label">Years of Service</div>
                        <div class="detail-value">@ServiceDurationHelper.Format(req.JoinDate, req.YearsOfService)</div>
                    </div>
                    <div>
                        <div class="detail-label">Preferred Date</div>
                        <div class="detail-value">@(req.PreferredDate?.ToString("MMM dd, yyyy") ?? "—")</div>
                    </div>
                    <div>
                        <div class="detail-label">Submission Date</div>
                        <div class="detail-value">@req.RequestedDate.ToString("MMM dd, yyyy")</div>
                    </div>
                </div>
                <div>
                    <div class="detail-label">Reason for Transfer</div>
                    <div style="background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:14px;margin-top:6px;font-size:0.9rem;color:#374151;line-height:1.6">
                        @req.Reason
                    </div>
                </div>
            </div>

            <!-- HR Finalization -->
            @if (!string.IsNullOrEmpty(req.HRManagerReview))
            {
                <div class="review-card approved" style="margin-bottom:20px">
                    <h6 style="font-weight:700;margin-bottom:8px"><i class="bi bi-clipboard-check"></i> HR Finalization</h6>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;font-size:0.88rem">
                        <div><strong>Decision:</strong> @req.HRManagerReview</div>
                        <div><strong>Date:</strong> @req.HRManagerReviewDate?.ToString("MMM dd, yyyy")</div>
                    </div>
                    <div style="margin-top:8px;font-size:0.88rem"><strong>Comments:</strong> @req.HRManagerComments</div>
                </div>
            }

            <!-- Area Manager Review (for HR-initiated) -->
            @if (!string.IsNullOrEmpty(req.AreaManagerReview))
            {
                <div class="review-card approved" style="margin-bottom:20px">
                    <h6 style="font-weight:700;margin-bottom:8px"><i class="bi bi-person-badge"></i> Area Manager Review</h6>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;font-size:0.88rem">
                        <div><strong>Decision:</strong> @req.AreaManagerReview</div>
                        <div><strong>Date:</strong> @req.AreaManagerReviewDate?.ToString("MMM dd, yyyy")</div>
                    </div>
                    <div style="margin-top:8px;font-size:0.88rem"><strong>Comments:</strong> @req.AreaManagerComments</div>
                </div>
            }

            <!-- Other BM Review (if available) -->
            @if (isCurrentBM && !string.IsNullOrEmpty(req.TargetBMReview))
            {
                <div class="review-card @(req.TargetBMReview == "Approved" ? "approved" : "rejected")" style="margin-bottom:20px">
                    <h6 style="font-weight:700;margin-bottom:8px"><i class="bi bi-building"></i> Target Branch Manager Review</h6>
                    <div style="font-size:0.88rem"><strong>Decision:</strong> @req.TargetBMReview — @req.TargetBMReviewDate?.ToString("MMM dd, yyyy")</div>
                    <div style="margin-top:6px;font-size:0.88rem"><strong>Comments:</strong> @req.TargetBMComments</div>
                </div>
            }
            else if (!isCurrentBM && !string.IsNullOrEmpty(req.CurrentBMReview))
            {
                <div class="review-card @(req.CurrentBMReview == "Approved" ? "approved" : "rejected")" style="margin-bottom:20px">
                    <h6 style="font-weight:700;margin-bottom:8px"><i class="bi bi-building"></i> Current Branch Manager Review</h6>
                    <div style="font-size:0.88rem"><strong>Decision:</strong> @req.CurrentBMReview — @req.CurrentBMReviewDate?.ToString("MMM dd, yyyy")</div>
                    <div style="margin-top:6px;font-size:0.88rem"><strong>Comments:</strong> @req.CurrentBMComments</div>
                </div>
            }

            @if (req.HasDocument)
            {
                <div class="k-card">
                    <div class="k-card-header">Document Attachments</div>
                    <div class="doc-item">
                        <div class="doc-info">
                            @{
                                var ext = req.DocumentFileName?.Split('.').LastOrDefault()?.ToLower();
                                var iconClass = ext switch { "pdf" => "pdf", "jpg" or "jpeg" or "png" => "img", _ => "doc" };
                                var icon = ext switch { "pdf" => "bi-file-earmark-pdf", "jpg" or "jpeg" or "png" => "bi-file-earmark-image", _ => "bi-file-earmark-word" };
                            }
                            <div class="doc-icon @iconClass"><i class="bi @icon"></i></div>
                            <div><div class="doc-name">@req.DocumentFileName</div></div>
                        </div>
                        <a asp-page="/Transfer/DownloadDocument" asp-route-id="@req.Id" style="color:#1a7a3a;font-size:1.1rem"><i class="bi bi-download"></i></a>
                    </div>
                </div>
            }
        </div>

        <div>
            @{
                bool canReview = false;
                if (isCurrentBM && req.CurrentBMReview == null &&
                    (req.Status == TransferStatus.DeptHeadApproved || req.Status == TransferStatus.TargetBMApproved))
                    canReview = true;
                if (!isCurrentBM && req.TargetBMReview == null &&
                    (req.Status == TransferStatus.DeptHeadApproved || req.Status == TransferStatus.CurrentBMApproved))
                    canReview = true;
            }

            @if (canReview)
            {
                <div class="eligibility-panel">
                    <h5><i class="bi bi-shield-check"></i> @Model.ReviewerRole Review</h5>
                    <p class="ep-subtitle">Review this transfer as the @(isCurrentBM ? "current" : "receiving") branch manager.</p>

                    <div class="ep-check-item">
                        <div class="ep-check-circle"></div>
                        <div>
                            <div class="ep-check-label">Service Period Check</div>
                            <div class="ep-check-desc">Current: @ServiceDurationHelper.Format(req.JoinDate, req.YearsOfService)</div>
                        </div>
                    </div>
                    <div class="ep-check-item">
                        <div class="ep-check-circle"></div>
                        <div>
                            <div class="ep-check-label">@(isCurrentBM ? "Handover Readiness" : "Position Availability")</div>
                            <div class="ep-check-desc">@(isCurrentBM ? "Role can be covered during transition" : "Receiving branch has capacity")</div>
                        </div>
                    </div>

                    <form method="post" class="ep-actions">
                        <input type="hidden" name="id" value="@req.Id" />
                        <div style="margin-bottom:10px">
                            <textarea name="comments" placeholder="Add your review comments..." required minlength="10"
                                      style="width:100%;padding:10px;border-radius:6px;border:1px solid rgba(255,255,255,0.3);background:rgba(255,255,255,0.1);color:#fff;font-family:inherit;resize:vertical;min-height:80px"></textarea>
                        </div>
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="All" style="color:#fecaca;font-size:0.82rem;margin-bottom:8px;font-weight:600"></div>
                        }
                        <button type="submit" name="action" value="approve" class="btn-ep-approve">
                            <i class="bi bi-check-circle"></i> Approve Transfer
                        </button>
                        <button type="submit" name="action" value="reject" class="btn-ep-reject">
                            <i class="bi bi-x-circle"></i> Reject Transfer
                        </button>
                    </form>
                </div>
            }
            else
            {
                <div class="k-card">
                    <div class="k-alert k-alert-info" style="margin-bottom:0">
                        <i class="bi bi-info-circle"></i> You have already reviewed this request or it's not at your review stage yet.
                    </div>
                </div>
            }
        </div>
    </div>
}