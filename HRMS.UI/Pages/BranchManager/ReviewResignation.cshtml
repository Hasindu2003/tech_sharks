@page "{id:int}"
@model HRMS.UI.Pages.BranchManager.ReviewResignationModel
@{
    ViewData["Title"] = "Review Resignation";
}

@if (Model.ResignationRequest == null)
{
    <div class="k-alert k-alert-danger"><i class="bi bi-exclamation-triangle"></i> Resignation request not found.</div>
}
else
{
    var req = Model.ResignationRequest;
    var initials = string.Join("", req.EmployeeName.Split(' ').Take(2).Select(w => w[0])).ToUpper();
    bool canReview = req.Status == ResignationStatusEnum.SubmittedForApproval;

    <div style="margin-bottom:20px">
        <a asp-page="/BranchManager/ReviewResignations" style="color:#6b7280;text-decoration:none;font-size:0.88rem;display:inline-flex;align-items:center;gap:6px">
            <i class="bi bi-arrow-left"></i> Back to Resignations
        </a>
        <span style="color:#9ca3af;font-size:0.85rem;margin-left:8px">Request #@req.Id</span>
        <span class="k-badge @req.StatusBadgeClass" style="margin-left:8px">@req.StatusDisplay</span>
    </div>

    <div class="profile-header">
        <div class="profile-info">
            <div class="profile-avatar">@initials</div>
            <div>
                <div class="profile-name">@req.EmployeeName</div>
                <div class="profile-meta">
                    <span><i class="bi bi-hash"></i> @req.EpfNumber</span>
                    <span><i class="bi bi-building"></i> @req.Branch</span>
                    <span><i class="bi bi-diagram-3"></i> @req.Department</span>
                    <span><i class="bi bi-person-badge"></i> @req.Designation</span>
                </div>
            </div>
        </div>
    </div>

    <div class="transfer-detail-grid">
        <div>
            <!-- Resignation Details -->
            <div class="k-card" style="margin-bottom:20px">
                <div class="k-card-header">Resignation Details</div>
                <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;margin-bottom:20px">
                    <div>
                        <div class="detail-label">Submitted On</div>
                        <div class="detail-value">@req.ResignationDate.ToString("MMM dd, yyyy")</div>
                    </div>
                    <div>
                        <div class="detail-label">Last Working Day</div>
                        <div class="detail-value" style="color:#1a7a3a;font-weight:700">@req.EffectiveDate.ToString("MMM dd, yyyy")</div>
                    </div>
                    <div>
                        <div class="detail-label">Notice Period</div>
                        <div class="detail-value">@req.NoticePeriodDays days</div>
                    </div>
                </div>
                <div>
                    <div class="detail-label">Reason for Resignation</div>
                    <div style="background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:14px;margin-top:6px;font-size:0.9rem;color:#374151;line-height:1.6">
                        @req.ReasonForResignation
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(req.AdditionalRemarks))
                {
                    <div style="margin-top:14px">
                        <div class="detail-label">Additional Remarks</div>
                        <div style="font-size:0.9rem;color:#6b7280;margin-top:4px">@req.AdditionalRemarks</div>
                    </div>
                }
            </div>

            <!-- Obligations -->
            @if (req.HasOutstandingLoans || req.IsLoanGuarantor)
            {
                <div class="k-card" style="margin-bottom:20px;border-left:4px solid #f59e0b">
                    <div class="k-card-header" style="color:#92400e"><i class="bi bi-exclamation-triangle me-2"></i>Financial Obligations Declared</div>
                    <div style="display:flex;gap:16px;flex-wrap:wrap;margin-top:8px">
                        @if (req.HasOutstandingLoans)
                        {
                            <span class="k-badge k-badge-rejected"><i class="bi bi-bank"></i> Outstanding Loan Balance</span>
                        }
                        @if (req.IsLoanGuarantor)
                        {
                            <span class="k-badge k-badge-rejected"><i class="bi bi-people"></i> Loan Guarantor</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(req.ObligationDetails))
                    {
                        <div style="margin-top:10px;font-size:0.88rem;color:#6b7280">@req.ObligationDetails</div>
                    }
                    <div style="margin-top:10px;font-size:0.85rem;color:#92400e;font-weight:500">
                        <i class="bi bi-info-circle"></i> You may reject this resignation based on these obligations.
                    </div>
                </div>
            }

            <!-- Attached Documents -->
            @if (req.Documents.Any())
            {
                <div class="k-card">
                    <div class="k-card-header">Document Attachments</div>
                    @foreach (var doc in req.Documents)
                    {
                        var ext = doc.FileName.Split('.').LastOrDefault()?.ToLower();
                        var icon = ext switch { "pdf" => "bi-file-earmark-pdf", "jpg" or "jpeg" or "png" => "bi-file-earmark-image", _ => "bi-file-earmark-word" };
                        var iconClass = ext switch { "pdf" => "pdf", "jpg" or "jpeg" or "png" => "img", _ => "doc" };
                        <div class="doc-item">
                            <div class="doc-info">
                                <div class="doc-icon @iconClass"><i class="bi @icon"></i></div>
                                <div><div class="doc-name">@doc.FileName</div><div style="font-size:0.78rem;color:#9ca3af">@doc.UploadedDate.ToString("MMM dd, yyyy")</div></div>
                            </div>
                            <a asp-page="/Resignation/DownloadDocument" asp-route-id="@doc.Id" style="color:#1a7a3a;font-size:1.1rem"><i class="bi bi-download"></i></a>
                        </div>
                    }
                </div>
            }
        </div>

        <div>
            @if (canReview)
            {
                <div class="eligibility-panel">
                    <h5><i class="bi bi-shield-check"></i> Branch Manager Review</h5>
                    <p class="ep-subtitle">Acknowledge this resignation and ensure operational continuity planning.</p>

                    <div class="ep-check-item">
                        <div class="ep-check-circle"></div>
                        <div>
                            <div class="ep-check-label">Verify Notice Period</div>
                            <div class="ep-check-desc">@req.NoticePeriodDays days — Last day: @req.EffectiveDate.ToString("MMM dd, yyyy")</div>
                        </div>
                    </div>
                    <div class="ep-check-item">
                        <div class="ep-check-circle"></div>
                        <div>
                            <div class="ep-check-label">Financial Obligations</div>
                            <div class="ep-check-desc">@(req.HasOutstandingLoans || req.IsLoanGuarantor ? "⚠ Obligations declared — review before approving" : "✓ No obligations declared")</div>
                        </div>
                    </div>

                    <form method="post" class="ep-actions">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@req.Id" />
                        <div style="margin-bottom:10px">
                            <textarea name="comments" placeholder="Add acknowledgement notes or rejection reason (required, min 5 chars)..." required minlength="5"
                                      style="width:100%;padding:10px;border-radius:6px;border:1px solid rgba(255,255,255,0.3);background:rgba(255,255,255,0.1);color:#fff;font-family:inherit;resize:vertical;min-height:80px"></textarea>
                        </div>
                        <button type="submit" name="action" value="approve" class="btn-ep-approve">
                            <i class="bi bi-check-circle"></i> Acknowledge & Forward
                        </button>
                        <button type="submit" name="action" value="reject" class="btn-ep-reject"
                                onclick="return confirm('Reject this resignation request?')">
                            <i class="bi bi-x-circle"></i> Reject
                        </button>
                    </form>
                </div>
            }
            else
            {
                <div class="k-card">
                    <div class="k-alert k-alert-info" style="margin-bottom:0">
                        <i class="bi bi-info-circle"></i> This request has already been reviewed or is not at your review stage.
                    </div>
                </div>
            }
        </div>
    </div>
}
