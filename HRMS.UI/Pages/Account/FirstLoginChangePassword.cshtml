@page
@model HRMS.UI.Pages.Account.FirstLoginChangePasswordModel
@{
    ViewData["Title"] = "Activate Your Account";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Set New Password - Kanrich HRMS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        html, body {
            height: 100%;
            font-family: 'Manrope', sans-serif;
            background: #f8fafc;
            color: #151811;
        }

        .auth-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .auth-card {
            background: #ffffff;
            border: 1px solid #e2e5dc;
            border-radius: 14px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.03);
            width: 100%;
            max-width: 480px;
            overflow: hidden;
        }

        .auth-header {
            background: #ffffff;
            padding: 32px 32px 16px;
            text-align: center;
            border-bottom: 1px solid #f1f5f9;
        }

        .auth-logo {
            height: 42px;
            width: auto;
            margin-bottom: 16px;
        }

        .auth-header h1 {
            font-size: 22px;
            font-weight: 800;
            letter-spacing: -0.3px;
            color: #151811;
            margin-bottom: 6px;
        }

        .auth-header p {
            font-size: 13px;
            color: #64748b;
            line-height: 1.5;
        }

        .auth-header p strong {
            color: #151811;
        }

        .auth-body {
            padding: 28px 32px 32px;
        }

        .alert-banner {
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            border-radius: 8px;
            padding: 12px 14px;
            margin-bottom: 20px;
            font-size: 12.5px;
            color: #1e40af;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            line-height: 1.45;
        }

        .alert-error {
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 8px;
            color: #dc3545;
            font-size: 12.5px;
            padding: 10px 14px;
            margin-bottom: 20px;
            line-height: 1.4;
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-label {
            display: block;
            font-size: 12.5px;
            font-weight: 700;
            color: #151811;
            margin-bottom: 6px;
        }

        .input-wrap {
            position: relative;
        }

        .form-control {
            width: 100%;
            height: 42px;
            padding: 10px 38px 10px 14px;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            font-family: 'Manrope', sans-serif;
            font-size: 13.5px;
            color: #151811;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .form-control:focus {
            border-color: #10823c;
            box-shadow: 0 0 0 3px rgba(16, 130, 60, 0.12);
        }

        .eye-toggle {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: #7a8863;
            padding: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .eye-toggle:hover { color: #151811; }

        .validation-message {
            color: #dc3545;
            font-size: 11px;
            font-weight: 600;
            margin-top: 4px;
            display: block;
        }

        /* ── Realtime Requirements Box ── */
        .rules-box {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 14px 16px;
            margin: 18px 0 24px;
        }

        .rules-title {
            font-size: 12px;
            font-weight: 700;
            color: #334155;
        }

        .req-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: #64748b;
            margin-bottom: 6px;
            transition: all 0.2s ease;
        }

        .req-item:last-child { margin-bottom: 0; }

        .req-item.valid {
            color: #10823c;
            font-weight: 600;
        }

        .req-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 16px;
            height: 16px;
            font-size: 11px;
            color: #94a3b8;
            transition: all 0.2s ease;
        }

        .req-item.valid .req-icon {
            color: #10823c;
            transform: scale(1.1);
        }

        .btn-submit {
            width: 100%;
            height: 44px;
            background: #10823c;
            color: #ffffff;
            border: none;
            border-radius: 6px;
            font-family: 'Manrope', sans-serif;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 2px 4px rgba(16, 130, 60, 0.2);
            transition: background 0.2s, box-shadow 0.2s;
        }

        .btn-submit:hover {
            background: #0d6e32;
            box-shadow: 0 4px 10px rgba(16, 130, 60, 0.3);
        }

        .logout-link {
            display: block;
            text-align: center;
            margin-top: 18px;
            font-size: 12.5px;
            font-weight: 600;
            color: #7a8863;
            text-decoration: none;
        }

        .logout-link:hover { color: #dc3545; text-decoration: underline; }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <img src="/images/logo.webp" alt="Kanrich Finance" class="auth-logo" onerror="this.style.display='none'" />
                <h1>First-Time Login Setup</h1>
                <p>Welcome, <strong>@Model.UserDisplayName</strong> (@Model.UserRoleName)! Please create a new password to activate your account.</p>
            </div>

            <div class="auth-body">
                <div class="alert-banner">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:1px;">
                        <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
                    </svg>
                    <div>For corporate security, all accounts must replace their initial system-generated password on first login.</div>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert-error">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <form method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label asp-for="Input.CurrentPassword" class="form-label">Current Temporary Password</label>
                        <div class="input-wrap">
                            <input asp-for="Input.CurrentPassword" class="form-control" id="currPass" placeholder="Enter the temporary password you signed in with" />
                            <button type="button" class="eye-toggle" onclick="toggleVisibility('currPass')">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            </button>
                        </div>
                        <span asp-validation-for="Input.CurrentPassword" class="validation-message"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.NewPassword" class="form-label">New Password</label>
                        <div class="input-wrap">
                            <input asp-for="Input.NewPassword" class="form-control" id="newPass" placeholder="Create your new password" />
                            <button type="button" class="eye-toggle" onclick="toggleVisibility('newPass')">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            </button>
                        </div>
                        <span asp-validation-for="Input.NewPassword" class="validation-message"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.ConfirmPassword" class="form-label">Confirm New Password</label>
                        <div class="input-wrap">
                            <input asp-for="Input.ConfirmPassword" class="form-control" id="confPass" placeholder="Re-type your new password" />
                            <button type="button" class="eye-toggle" onclick="toggleVisibility('confPass')">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            </button>
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="validation-message"></span>
                    </div>

                    <!-- Realtime Requirement Checklist -->
                    <div class="rules-box">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                            <div class="rules-title">Password Strength: <span id="strengthText" style="font-weight:800; color:#94a3b8;">None</span></div>
                        </div>
                        <div style="height:5px; background:#e2e8f0; border-radius:999px; overflow:hidden; margin-bottom:12px;">
                            <div id="strengthBar" style="height:100%; width:0%; background:#ef4444; transition:width 0.3s ease, background-color 0.3s ease;"></div>
                        </div>
                        <div class="req-item" id="req-len">
                            <span class="req-icon">○</span>
                            <span>At least 8 characters in length</span>
                        </div>
                        <div class="req-item" id="req-upper">
                            <span class="req-icon">○</span>
                            <span>At least one uppercase letter (A-Z)</span>
                        </div>
                        <div class="req-item" id="req-lower">
                            <span class="req-icon">○</span>
                            <span>At least one lowercase letter (a-z)</span>
                        </div>
                        <div class="req-item" id="req-num">
                            <span class="req-icon">○</span>
                            <span>At least one number (0-9)</span>
                        </div>
                        <div class="req-item" id="req-spec">
                            <span class="req-icon">○</span>
                            <span>At least one special symbol (e.g. @@, #, $, !)</span>
                        </div>
                        <div class="req-item" id="req-match" style="margin-top:6px; padding-top:6px; border-top:1px dashed #e2e8f0;">
                            <span class="req-icon">○</span>
                            <span>Passwords match</span>
                        </div>
                    </div>

                    <button type="submit" class="btn-submit" id="submitBtn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        Save Password & Continue
                    </button>
                </form>

                <form method="post" asp-page="/Account/Logout" id="logoutForm" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <a href="javascript:document.getElementById('logoutForm').submit()" class="logout-link">
                        &larr; Sign out and activate later
                    </a>
                </form>
            </div>
        </div>
    </div>

    <script>
        function toggleVisibility(id) {
            const input = document.getElementById(id);
            if (input) {
                input.type = input.type === 'password' ? 'text' : 'password';
            }
        }

        const newPassInput = document.getElementById('newPass');
        const confPassInput = document.getElementById('confPass');

        const reqLen = document.getElementById('req-len');
        const reqUpper = document.getElementById('req-upper');
        const reqLower = document.getElementById('req-lower');
        const reqNum = document.getElementById('req-num');
        const reqSpec = document.getElementById('req-spec');
        const reqMatch = document.getElementById('req-match');
        const strengthBar = document.getElementById('strengthBar');
        const strengthText = document.getElementById('strengthText');

        function setStatus(elem, isValid) {
            if (isValid) {
                elem.classList.add('valid');
                elem.querySelector('.req-icon').innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10823c" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
            } else {
                elem.classList.remove('valid');
                elem.querySelector('.req-icon').innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>';
            }
        }

        function evaluatePassword() {
            const val = newPassInput.value || '';
            const conf = confPassInput.value || '';

            const hasLen = val.length >= 8;
            const hasUpper = /[A-Z]/.test(val);
            const hasLower = /[a-z]/.test(val);
            const hasNum = /[0-9]/.test(val);
            const hasSpec = /[^A-Za-z0-9]/.test(val);
            const hasMatch = val.length > 0 && val === conf;

            setStatus(reqLen, hasLen);
            setStatus(reqUpper, hasUpper);
            setStatus(reqLower, hasLower);
            setStatus(reqNum, hasNum);
            setStatus(reqSpec, hasSpec);
            setStatus(reqMatch, hasMatch);

            let score = [hasLen, hasUpper, hasLower, hasNum, hasSpec].filter(Boolean).length;
            
            if (val.length === 0) {
                strengthBar.style.width = '0%';
                strengthText.textContent = 'None';
                strengthText.style.color = '#94a3b8';
            } else if (score <= 2) {
                strengthBar.style.width = '30%';
                strengthBar.style.backgroundColor = '#ef4444';
                strengthText.textContent = 'Weak';
                strengthText.style.color = '#ef4444';
            } else if (score <= 4) {
                strengthBar.style.width = '70%';
                strengthBar.style.backgroundColor = '#f59e0b';
                strengthText.textContent = 'Medium';
                strengthText.style.color = '#f59e0b';
            } else {
                strengthBar.style.width = '100%';
                strengthBar.style.backgroundColor = '#10823c';
                strengthText.textContent = 'Strong';
                strengthText.style.color = '#10823c';
            }
        }

        newPassInput.addEventListener('input', evaluatePassword);
        confPassInput.addEventListener('input', evaluatePassword);
        document.addEventListener('DOMContentLoaded', evaluatePassword);
    </script>
</body>
</html>
