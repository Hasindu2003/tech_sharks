@page
@model HRMS.UI.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - Kanrich HRMS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        html, body {
            height: 100%;
            font-family: 'Manrope', sans-serif;
            background: #f8fafc;
            color: #151811;
        }

        .auth-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .auth-card {
            background: #ffffff;
            border: 1px solid #e2e5dc;
            border-radius: 14px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.03);
            width: 100%;
            max-width: 440px;
            overflow: hidden;
        }

        .auth-header {
            background: #ffffff;
            padding: 32px 32px 16px;
            text-align: center;
        }

        .auth-logo {
            height: 44px;
            width: auto;
            margin-bottom: 20px;
        }

        .auth-header h1 {
            font-size: 22px;
            font-weight: 800;
            color: #151811;
            margin-bottom: 6px;
        }

        .auth-header p {
            font-size: 13px;
            color: #7a8863;
            line-height: 1.5;
        }

        .auth-body {
            padding: 20px 32px 32px;
        }

        .alert-success {
            background: #ecfdf5;
            border: 1px solid #10b981;
            border-radius: 8px;
            color: #065f46;
            padding: 16px;
            font-size: 13px;
            line-height: 1.5;
            margin-bottom: 20px;
        }

        .alert-warning {
            background: #fffbeb;
            border: 1px solid #f59e0b;
            border-radius: 8px;
            color: #92400e;
            padding: 16px;
            font-size: 13px;
            line-height: 1.5;
            margin-bottom: 20px;
        }

        .alert-error {
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 8px;
            color: #dc3545;
            font-size: 12.5px;
            padding: 10px 14px;
            margin-bottom: 18px;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-label {
            display: block;
            font-size: 12.5px;
            font-weight: 700;
            color: #151811;
            margin-bottom: 6px;
        }

        .form-control {
            width: 100%;
            height: 42px;
            padding: 10px 14px;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            font-family: 'Manrope', sans-serif;
            font-size: 13.5px;
            color: #151811;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .form-control:focus {
            border-color: #10823c;
            box-shadow: 0 0 0 3px rgba(16, 130, 60, 0.12);
        }

        .validation-message {
            color: #dc3545;
            font-size: 11px;
            font-weight: 600;
            margin-top: 4px;
            display: block;
        }

        .btn-submit {
            width: 100%;
            height: 44px;
            background: #10823c;
            color: #ffffff;
            border: none;
            border-radius: 6px;
            font-family: 'Manrope', sans-serif;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 2px 4px rgba(16, 130, 60, 0.2);
            transition: background 0.2s, box-shadow 0.2s;
            margin-top: 8px;
        }

        .btn-submit:hover {
            background: #0d6e32;
            box-shadow: 0 4px 10px rgba(16, 130, 60, 0.3);
        }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            font-size: 13px;
            font-weight: 600;
            color: #10823c;
            text-decoration: none;
        }

        .back-link:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <img src="/images/logo.webp" alt="Kanrich Finance" class="auth-logo" />
                <h1>Reset Password</h1>
                <p>Enter your employee email or username and we'll send you a link to reset your password.</p>
            </div>

            <div class="auth-body">
                @if (Model.IsSuccess)
                {
                    <div class="alert-success">
                        <strong>📩 Reset Link Sent!</strong><br />
                        If an active employee account matches the provided identifier, a password reset link has been dispatched to your email address. Please check your inbox and spam folder.
                    </div>
                    <a href="/Account/Login" class="btn-submit" style="text-decoration:none;">
                        Return to Sign In
                    </a>
                }
                else
                {
                    @if (!string.IsNullOrEmpty(Model.DutyAccountWarning))
                    {
                        <div class="alert-warning">
                            <strong>⚠️ Duty Account Notice:</strong><br />
                            @Model.DutyAccountWarning
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert-error">
                            <div asp-validation-summary="All"></div>
                        </div>
                    }

                    <form method="post">
                        @Html.AntiForgeryToken()

                        <div class="form-group">
                            <label asp-for="Input.Identifier" class="form-label">Work Email or Username</label>
                            <input asp-for="Input.Identifier" class="form-control" placeholder="Enter your work email or username" autofocus />
                            <span asp-validation-for="Input.Identifier" class="validation-message"></span>
                        </div>

                        <button type="submit" class="btn-submit">
                            Send Password Reset Link
                        </button>
                    </form>

                    <a href="/Account/Login" class="back-link">
                        &larr; Back to Sign In
                    </a>
                }
            </div>
        </div>
    </div>
</body>
</html>
