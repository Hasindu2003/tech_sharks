@page
@model HRMS.UI.Pages.Notifications.IndexModel
@{
    ViewData["Title"] = "Notification History";
}

@section Styles {
    <style>
        .page-header {
            padding: 24px 32px 0 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }

        .page-title {
            font-size: 24px;
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.5px;
        }

        .btn-mark-all {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(16,130,60,0.1);
            color: var(--primary-green);
            border: none;
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-mark-all:hover {
            background: rgba(16,130,60,0.2);
        }

        .history-container {
            padding: 0 32px 32px 32px;
            max-width: 900px;
        }

        .history-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
            overflow: hidden;
        }

        .notif-row {
            display: flex;
            align-items: flex-start;
            gap: 16px;
            padding: 20px 24px;
            border-bottom: 1px solid #f1f5f9;
            text-decoration: none;
            transition: background 0.2s;
        }

        .notif-row:last-child {
            border-bottom: none;
        }

        .notif-row:hover {
            background: #f8fafc;
        }

        .notif-row.unread {
            background: #f0fdf4;
        }
        .notif-row.unread:hover {
            background: #dcfce7;
        }

        .notif-icon {
            flex-shrink: 0;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #e8f3ec;
            color: #10823c;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .notif-icon svg {
            width: 20px;
            height: 20px;
            stroke-width: 2;
            stroke: currentColor;
            fill: none;
        }

        .notif-content {
            flex: 1;
        }

        .notif-title {
            font-size: 14px;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 4px;
        }

        .notif-msg {
            font-size: 13px;
            color: #475569;
            line-height: 1.5;
            margin-bottom: 8px;
        }

        .notif-time {
            font-size: 12px;
            font-weight: 600;
            color: #94a3b8;
        }

        .badge-new {
            display: inline-block;
            background: #ef4444;
            color: #fff;
            font-size: 10px;
            font-weight: 800;
            padding: 2px 6px;
            border-radius: 4px;
            margin-left: 8px;
            vertical-align: middle;
        }

        .empty-state {
            padding: 64px 32px;
            text-align: center;
            color: #94a3b8;
        }

        .empty-state svg {
            width: 48px;
            height: 48px;
            stroke: #cbd5e1;
            margin-bottom: 16px;
        }
    </style>
}

<div class="page-header">
    <h1 class="page-title">Notification History</h1>
    
    @if (Model.NotificationsList.Any(n => !n.IsRead))
    {
        <form method="post" asp-page-handler="MarkAllAsRead">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-mark-all">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                Mark all as read
            </button>
        </form>
    }
</div>

<div class="history-container">
    <div class="history-card">
        @if (Model.NotificationsList.Count == 0)
        {
            <div class="empty-state">
                <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                </svg>
                <div style="font-size: 16px; font-weight: 700; color: #475569; margin-bottom: 4px;">No notifications yet</div>
                <div style="font-size: 14px;">When you get alerts, they will appear here.</div>
            </div>
        }
        else
        {
            @foreach (var notif in Model.NotificationsList)
            {
                <a href="javascript:void(0)" onclick="clickHistoricalNotif(@notif.Id, '@notif.TargetUrl')" class="notif-row @(!notif.IsRead ? "unread" : "")">
                    <div class="notif-icon">
                        <svg viewBox="0 0 24 24">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                        </svg>
                    </div>
                    <div class="notif-content">
                        <div class="notif-title">
                            @notif.Title
                            @if (!notif.IsRead)
                            {
                                <span class="badge-new">NEW</span>
                            }
                        </div>
                        <div class="notif-msg">
                            @notif.Message
                        </div>
                        <div class="notif-time">
                            @notif.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                        </div>
                    </div>
                </a>
            }
        }
    </div>
</div>

@section Scripts {
<script>
    async function clickHistoricalNotif(id, targetUrl) {
        try {
            await fetch(`/Api/Notifications?handler=MarkAsRead&id=${id}`, { method: 'POST' });
        } catch (e) {}
        window.location.href = targetUrl;
    }
</script>
}
