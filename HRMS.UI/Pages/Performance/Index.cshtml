@page
@model HRMS.UI.Pages.Performance.IndexModel
@{
    ViewData["Title"] = "Employee Performance Analytics";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Employee Performance Analytics — Kanrich HRMS</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script>tailwind.config = { theme: { extend: { colors: { primary: "#10823c" }, fontFamily: { display: "Manrope" } } } };</script>
    <style>
        .material-symbols-outlined { font-variation-settings: 'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24; }
        .icon-fill { font-variation-settings: 'FILL' 1,'wght' 400,'GRAD' 0,'opsz' 24; }
        body { font-family: 'Manrope', sans-serif; }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 3px; }
        .bar-fill { animation: growUp 1s ease-out forwards; transform-origin: bottom; }
        @@keyframes growUp { from { height: 0 !important; } }
        .fade-in { opacity: 0; transform: translateY(16px); animation: fadeUp 0.5s ease forwards; }
        @@keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }
        .fade-in:nth-child(1) { animation-delay: .05s }
        .fade-in:nth-child(2) { animation-delay: .1s }
        .fade-in:nth-child(3) { animation-delay: .15s }
        .fade-in:nth-child(4) { animation-delay: .2s }
        .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.45); backdrop-filter: blur(4px); z-index: 50; align-items: center; justify-content: center; }
        .modal-overlay.open { display: flex; }
    </style>
</head>
<body class="bg-[#f6f8f7] text-[#151811] overflow-hidden">
<div class="flex h-screen w-full">

    <!-- SIDEBAR -->
    <aside class="w-[260px] bg-white border-r border-[#e2e5dc] flex flex-col justify-between shrink-0 h-full overflow-y-auto z-20">
        <div class="flex flex-col gap-5 p-5">
            <div class="flex items-center gap-3">
                <div class="bg-[#10823c] rounded-xl size-10 flex items-center justify-center text-white font-bold text-lg shadow-lg">K</div>
                <div>
                    <h1 class="text-[#151811] text-base font-bold leading-tight">Kanrich HRMS</h1>
                    <p class="text-[#7a8863] text-xs">Admin Portal</p>
                </div>
            </div>
            <nav class="flex flex-col gap-1">
                <p class="px-3 text-[10px] font-bold text-[#7a8863] uppercase tracking-widest mb-1">Main Menu</p>
                <a href="/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#f6f8f7] text-[#7a8863] transition-colors">
                    <span class="material-symbols-outlined text-[20px]">dashboard</span><span class="text-sm font-medium">Dashboard</span>
                </a>
                <a href="/Employees/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#f6f8f7] text-[#7a8863] transition-colors">
                    <span class="material-symbols-outlined text-[20px]">group</span><span class="text-sm font-medium">Employees</span>
                </a>
                <a href="/Performance/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg bg-[#10823c]/10 text-[#10823c]">
                    <span class="material-symbols-outlined icon-fill text-[20px]">bar_chart</span><span class="text-sm font-bold">Performance</span>
                </a>
                <a href="/Welfare/RequestList" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#f6f8f7] text-[#7a8863] transition-colors">
                    <span class="material-symbols-outlined text-[20px]">volunteer_activism</span><span class="text-sm font-medium">Welfare</span>
                </a>
                <a href="/Payroll/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#f6f8f7] text-[#7a8863] transition-colors">
                    <span class="material-symbols-outlined text-[20px]">payments</span><span class="text-sm font-medium">Payroll</span>
                </a>
                @if (User.IsInRole("SeniorManagement"))
                {
                    <a href="/Welfare/Approvals/SeniorManagementApproval" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#f6f8f7] text-[#7a8863] transition-colors">
                        <span class="material-symbols-outlined text-[20px]">approval</span><span class="text-sm font-medium">My Approvals</span>
                    </a>
                }
                <div class="h-px bg-gray-100 my-2"></div>
                <p class="px-3 text-[10px] font-bold text-[#7a8863] uppercase tracking-widest mb-1">Analytics</p>
                <a href="#" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#f6f8f7] text-[#7a8863] transition-colors">
                    <span class="material-symbols-outlined text-[20px]">analytics</span><span class="text-sm font-medium">Reports</span>
                </a>
            </nav>
        </div>
        <div class="p-5">
            <div class="bg-[#f6f8f7] p-3 rounded-xl mb-3 flex items-center gap-3">
                <div class="bg-[#10823c]/20 rounded-full p-1.5 text-[#10823c]"><span class="material-symbols-outlined text-lg">headset_mic</span></div>
                <div><p class="text-xs font-bold text-[#151811]">Need Help?</p><p class="text-[11px] text-[#7a8863]">Contact IT Support</p></div>
            </div>
            <form method="post" asp-page="/Account/Logout">
                <button type="submit" class="w-full h-10 bg-[#10823c] text-white text-sm font-bold rounded-xl hover:bg-opacity-90 shadow-md">Log Out</button>
            </form>
        </div>
    </aside>

    <!-- MAIN -->
    <div class="flex flex-col flex-1 h-full overflow-hidden">

        <!-- HEADER -->
        <header class="flex items-center justify-between border-b border-[#e2e5dc] bg-white px-8 py-4 shrink-0">
            <div class="flex items-center gap-3">
                <h2 class="text-xl font-bold">Employee Performance Analytics</h2>
                <span class="px-2.5 py-0.5 rounded-full bg-green-100 text-green-700 text-xs font-bold border border-green-200">Multi-Factor Scoring</span>
            </div>
            <div class="flex items-center gap-3">
                <div class="flex items-center bg-[#f6f8f7] rounded-xl px-4 py-2.5 gap-2 min-w-56 border border-transparent focus-within:border-[#10823c]/40 transition-all">
                    <span class="material-symbols-outlined text-[#7a8863] text-[18px]">search</span>
                    <input id="globalSearch" oninput="filterTable()" class="bg-transparent text-sm placeholder:text-[#7a8863] focus:outline-none w-full" placeholder="Search employees..." />
                </div>
                <button onclick="openNotifications()" class="relative flex size-10 items-center justify-center rounded-xl bg-[#f6f8f7] hover:bg-gray-200 transition-colors">
                    <span class="material-symbols-outlined text-[20px]">notifications</span>
                    <span class="notif-dot absolute top-2.5 right-2.5 size-2 bg-red-500 rounded-full border border-white" style="display:none"></span>
                </button>
                @await Html.PartialAsync("_ProfilePill", Model.CurrentUser)
            </div>
        </header>

        <!-- CONTENT -->
        <main class="flex-1 overflow-y-auto bg-[#f6f8f7] p-8">
            <div class="max-w-[1400px] mx-auto flex flex-col gap-7">

                <!-- Info -->
                <div class="flex items-start gap-3 px-5 py-3.5 bg-blue-50 border border-blue-200 rounded-2xl text-sm text-blue-800">
                    <span class="material-symbols-outlined icon-fill text-blue-500 text-[20px] mt-0.5 shrink-0">info</span>
                    <div>
                        <p class="font-bold mb-0.5">How scores are calculated</p>
                        <p class="text-xs text-blue-600">Attendance 30% &nbsp;·&nbsp; Training 25% &nbsp;·&nbsp; Leave 20% &nbsp;·&nbsp; Punctuality 15% &nbsp;·&nbsp; Welfare/Discipline 10% &nbsp;·&nbsp; Attendance based on last 90 days &nbsp;·&nbsp; Punctuality: on-time before 08:00 AM</p>
                    </div>
                </div>

                <!-- Metric Cards -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
                    <div class="fade-in p-5 bg-white rounded-2xl border border-[#e2e5dc] shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between h-36 group">
                        <div class="flex justify-between items-start">
                            <div class="p-2.5 bg-blue-50 rounded-xl text-blue-600 group-hover:scale-110 transition-transform"><span class="material-symbols-outlined text-[20px]">speed</span></div>
                            <span class="text-xs font-bold text-green-600 bg-green-100 px-2 py-0.5 rounded-lg">Live Data</span>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-[#7a8863]">Company Average</p>
                            <div class="flex items-baseline gap-1 mt-0.5">
                                <span class="text-3xl font-bold">@Model.AvgPerformanceScore</span>
                                <span class="text-sm text-[#7a8863]">/ 100</span>
                            </div>
                            <p class="text-[10px] text-[#7a8863] mt-0.5">All @Model.TotalEmployees employees</p>
                        </div>
                    </div>
                    <div class="fade-in p-5 bg-white rounded-2xl border border-[#e2e5dc] shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between h-36 group">
                        <div class="flex justify-between items-start">
                            <div class="p-2.5 bg-purple-50 rounded-xl text-purple-600 group-hover:scale-110 transition-transform"><span class="material-symbols-outlined text-[20px]">workspace_premium</span></div>
                            <span class="text-xs font-bold text-green-600 bg-green-100 px-2 py-0.5 rounded-lg">Score ≥ 80</span>
                        </div>
                        <div class="flex items-end justify-between">
                            <div><p class="text-xs font-medium text-[#7a8863]">Top Performers</p><span class="text-3xl font-bold">@Model.TopPerformerCount</span></div>
                            <span class="text-xs text-[#7a8863]">of @Model.TotalEmployees</span>
                        </div>
                    </div>
                    <div class="fade-in p-5 bg-white rounded-2xl border border-[#e2e5dc] shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between h-36 group">
                        <div class="flex justify-between items-start">
                            <div class="p-2.5 bg-orange-50 rounded-xl text-orange-500 group-hover:scale-110 transition-transform"><span class="material-symbols-outlined text-[20px]">track_changes</span></div>
                            <span class="text-xs font-bold text-orange-600 bg-orange-100 px-2 py-0.5 rounded-lg">Payment Done</span>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-[#7a8863]">Welfare Completed</p>
                            <span class="text-3xl font-bold">@Model.GoalsAchievedPercent%</span>
                            <div class="w-full bg-gray-100 rounded-full h-1.5 mt-2 overflow-hidden">
                                <div class="bg-[#10823c] h-1.5 rounded-full" style="width:@Model.GoalsAchievedPercent%"></div>
                            </div>
                        </div>
                    </div>
                    <div class="fade-in p-5 bg-white rounded-2xl border border-[#e2e5dc] shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between h-36 group">
                        <div class="flex justify-between items-start">
                            <div class="p-2.5 bg-red-50 rounded-xl text-red-500 group-hover:scale-110 transition-transform"><span class="material-symbols-outlined text-[20px]">pending_actions</span></div>
                            @if (Model.PendingReviews > 0) {
                                <span class="text-xs font-bold text-red-600 bg-red-100 px-2 py-0.5 rounded-lg">Action Needed</span>
                            } else {
                                <span class="text-xs font-bold text-green-600 bg-green-100 px-2 py-0.5 rounded-lg">All Clear</span>
                            }
                        </div>
                        <div class="flex items-end justify-between">
                            <div><p class="text-xs font-medium text-[#7a8863]">Pending Approvals</p><span class="text-3xl font-bold">@Model.PendingReviews</span></div>
                            @if (Model.PendingReviews > 0) { <a href="/Welfare/Approvals/BranchDGMApproval" class="text-xs font-bold text-[#10823c] hover:underline">View</a> }
                        </div>
                    </div>
                </div>

                <!-- Charts -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <div class="bg-white p-6 rounded-2xl border border-[#e2e5dc] shadow-sm flex flex-col h-80">
                        <div class="flex justify-between items-center mb-5">
                            <h3 class="text-base font-bold">Departmental Performance</h3>
                            <span class="inline-flex items-center gap-1.5 text-xs text-[#7a8863]">
                                <span class="inline-block w-6 border-t-2 border-dashed border-blue-400"></span>
                                Company avg (@Model.AvgPerformanceScore)
                            </span>
                        </div>
                        @if (!Model.DepartmentStats.Any()) {
                            <div class="flex-1 flex items-center justify-center text-[#7a8863] text-sm">No department data available</div>
                        } else {
                            var maxDept = Model.DepartmentStats.Max(d => d.AvgScore);
                            var avgLine = maxDept > 0 ? (int)Math.Round(Model.AvgPerformanceScore / maxDept * 100) : 50;
                            int bd = 0;
                            <div class="flex-1 flex items-end justify-between gap-3 pb-1 relative">
                                @foreach (var dept in Model.DepartmentStats) {
                                    var above = dept.AvgScore >= Model.AvgPerformanceScore;
                                    var bc    = above ? "bg-[#10823c]" : "bg-[#7a8863]";
                                    <div class="flex flex-col items-center gap-2 flex-1 group cursor-pointer">
                                        <div class="w-full bg-[#10823c]/5 rounded-xl relative h-52 flex flex-col justify-end overflow-hidden group-hover:bg-[#10823c]/10 transition-colors">
                                            <div class="@bc w-full absolute bottom-0 rounded-t-sm bar-fill" style="height:@(dept.BarHeightPercent)%; animation-delay:@(bd * 100)ms"></div>
                                            <div class="absolute w-full text-center text-[10px] font-bold z-10" style="bottom:calc(@(dept.BarHeightPercent)% + 4px); color:@(above ? "#10823c" : "#7a8863")">@dept.AvgScore</div>
                                            <div class="absolute w-full border-t-2 border-dashed border-blue-400 z-20 pointer-events-none" style="bottom:@avgLine%"></div>
                                        </div>
                                        <span class="text-[10px] font-medium text-center leading-tight @(above ? "text-[#10823c] font-bold" : "text-[#7a8863]")">@dept.DepartmentName.Split(' ')[0]</span>
                                    </div>
                                    bd++;
                                }
                            </div>
                        }
                    </div>
                    <div class="bg-white p-6 rounded-2xl border border-[#e2e5dc] shadow-sm flex flex-col h-80">
                        <div class="flex justify-between items-center mb-5">
                            <h3 class="text-base font-bold">Grade Distribution</h3>
                            <span class="text-xs text-[#7a8863]">@Model.TotalEmployees employees</span>
                        </div>
                        <div class="flex-1 flex flex-col justify-center gap-3">
                            @{
                                var grades = new[] { ("A+","≥90","bg-emerald-500"), ("A","80-89","bg-green-500"), ("B","70-79","bg-blue-500"), ("C","60-69","bg-yellow-500"), ("D","<60","bg-red-400") };
                                foreach (var (g, range, color) in grades) {
                                    int cnt = Model.AllEmployees.Count(e => e.Grade == g);
                                    int pct = Model.TotalEmployees > 0 ? (int)Math.Round((double)cnt / Model.TotalEmployees * 100) : 0;
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 text-xs font-bold text-[#151811] text-center">@g</div>
                                        <div class="text-[10px] text-[#7a8863] w-12">@range</div>
                                        <div class="flex-1 bg-gray-100 rounded-full h-3 overflow-hidden"><div class="@color h-3 rounded-full transition-all duration-700" style="width:@pct%"></div></div>
                                        <div class="text-xs font-bold text-[#151811] w-8 text-right">@cnt</div>
                                        <div class="text-[10px] text-[#7a8863] w-8">@pct%</div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <!-- Leaderboard -->
                <div class="flex flex-col gap-4">
                    <div class="flex justify-between items-center">
                        <h3 class="text-base font-bold">Employee Performance Leaderboard</h3>
                        <div class="flex items-center gap-3">
                            <select id="gradeFilter" onchange="filterTable()" class="bg-[#f6f8f7] border-none rounded-xl text-xs font-medium px-3 py-2 text-[#7a8863] focus:ring-0 cursor-pointer">
                                <option value="">All Grades</option>
                                <option value="A+">A+</option><option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="D">D</option>
                            </select>
                            <select id="deptFilter" onchange="filterTable()" class="bg-[#f6f8f7] border-none rounded-xl text-xs font-medium px-3 py-2 text-[#7a8863] focus:ring-0 cursor-pointer">
                                <option value="">All Departments</option>
                                @foreach (var dept in Model.DepartmentStats) { <option value="@dept.DepartmentName">@dept.DepartmentName</option> }
                            </select>
                        </div>
                    </div>
                    <div class="bg-white border border-[#e2e5dc] rounded-2xl overflow-hidden shadow-sm">
                        @if (!Model.AllEmployees.Any()) {
                            <div class="flex flex-col items-center justify-center py-16 text-[#7a8863]">
                                <span class="material-symbols-outlined text-5xl mb-3">people</span>
                                <p class="text-sm font-semibold">No employee data found</p>
                            </div>
                        } else {
                            <div class="overflow-x-auto">
                                <table class="w-full text-left text-sm" id="perfTable">
                                    <thead class="bg-[#f8f9fa] text-[#7a8863] border-b border-[#e2e5dc]">
                                        <tr>
                                            <th class="px-4 py-4 text-xs font-semibold uppercase tracking-wider">Rank</th>
                                            <th class="px-4 py-4 text-xs font-semibold uppercase tracking-wider">Employee</th>
                                            <th class="px-4 py-4 text-xs font-semibold uppercase tracking-wider">Dept</th>
                                            <th class="px-4 py-4 text-xs font-semibold uppercase tracking-wider text-blue-600">Attend.</th>
                                            <th class="px-4 py-4 text-xs font-semibold uppercase tracking-wider text-purple-600">Punct.</th>
                                            <th class="px-4 py-4 text-xs font-semibold uppercase tracking-wider text-orange-600">Leave</th>
                                            <th class="px-4 py-4 text-xs font-semibold uppercase tracking-wider text-green-600">Training</th>
                                            <th class="px-4 py-4 text-xs font-semibold uppercase tracking-wider text-[#10823c]">Welfare</th>
                                            <th class="px-4 py-4 text-xs font-semibold uppercase tracking-wider">Score</th>
                                            <th class="px-4 py-4 text-xs font-semibold uppercase tracking-wider">Grade</th>
                                            <th class="px-4 py-4 text-xs font-semibold uppercase tracking-wider text-right">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-[#e2e5dc]" id="perfTableBody">
                                        @foreach (var emp in Model.AllEmployees) {
                                            <tr class="hover:bg-gray-50 transition-colors perf-row"
                                                data-name="@((emp.Employee.FirstName + " " + emp.Employee.LastName).ToLower())"
                                                data-dept="@(emp.Employee.Department?.Name ?? "")"
                                                data-grade="@emp.Grade">
                                                <td class="px-4 py-4"><span class="inline-flex items-center justify-center w-7 h-7 rounded-full text-xs font-black @emp.RankBadgeColor">@emp.Rank</span></td>
                                                <td class="px-4 py-4">
                                                    <div class="flex items-center gap-2">
                                                        <div class="size-8 rounded-full bg-[#10823c]/10 flex items-center justify-center text-[#10823c] font-bold text-sm shrink-0">@emp.Employee.FirstName[0]</div>
                                                        <div>
                                                            <p class="font-bold text-[#151811] text-xs">@emp.Employee.FirstName @emp.Employee.LastName</p>
                                                            <p class="text-[10px] text-[#7a8863]">@(emp.Employee.Designation?.Title ?? "—")</p>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="px-4 py-4 text-xs text-[#151811]">@(emp.Employee.Department?.Name ?? "—")</td>
                                                <td class="px-4 py-4 text-center text-xs font-semibold text-blue-600">@emp.AttendanceScore%</td>
                                                <td class="px-4 py-4 text-center text-xs font-semibold text-purple-600">@emp.PunctualityScore%</td>
                                                <td class="px-4 py-4 text-center text-xs font-semibold text-orange-600">@emp.LeaveScore%</td>
                                                <td class="px-4 py-4 text-center text-xs font-semibold text-green-600">@emp.TrainingScore%</td>
                                                <td class="px-4 py-4 text-center text-xs font-semibold text-[#10823c]">@emp.WelfareScore%</td>
                                                <td class="px-4 py-4">
                                                    <div class="flex items-center gap-2">
                                                        <div class="w-12 bg-gray-100 rounded-full h-2 overflow-hidden"><div class="bg-[#10823c] h-2 rounded-full" style="width:@emp.PerformanceScore%"></div></div>
                                                        <span class="font-bold text-[#151811] text-xs">@emp.PerformanceScore</span>
                                                    </div>
                                                </td>
                                                <td class="px-4 py-4"><span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold @emp.GradeBadgeColor">@emp.Grade</span></td>
                                                <td class="px-4 py-4 text-right">
                                                    <button onclick="openModal('@emp.Employee.FirstName @emp.Employee.LastName','@(emp.Employee.Designation?.Title ?? "—")','@(emp.Employee.Department?.Name ?? "—")',@emp.PerformanceScore,'@emp.Grade',@emp.AttendanceScore,@emp.PunctualityScore,@emp.LeaveScore,@emp.TrainingScore,@emp.WelfareScore,@emp.PresentDays,@emp.TotalDays,@emp.LateDays,@emp.LeaveDaysUsed,@emp.LeaveDaysTotal,@emp.TrainingsAttended,@emp.TrainingsTotal,@emp.FeedbackCount,@emp.AvgFeedbackRating,@emp.WelfareTotal,@emp.WelfareApproved,@emp.WelfareRejected)"
                                                            class="px-3 py-1.5 bg-[#10823c] text-white text-xs font-bold rounded-lg hover:bg-opacity-90 transition-colors">Details</button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

            </div>
        </main>
    </div>
</div>

<!-- Modal -->
<div class="modal-overlay" id="detailModal" onclick="closeModal(event)">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg mx-4 p-6 max-h-[90vh] overflow-y-auto" onclick="event.stopPropagation()">
        <div class="flex justify-between items-center mb-5">
            <h3 class="text-lg font-bold">Employee Performance Detail</h3>
            <button onclick="closeModal()" class="size-8 flex items-center justify-center rounded-lg hover:bg-gray-100"><span class="material-symbols-outlined text-[18px]">close</span></button>
        </div>
        <div class="flex items-center gap-4 p-4 bg-[#f6f8f7] rounded-xl mb-5">
            <div class="size-14 rounded-full bg-[#10823c]/10 flex items-center justify-center text-[#10823c] font-bold text-2xl" id="mAvatar">A</div>
            <div class="flex-1">
                <p class="font-bold text-[#151811] text-base" id="mName">—</p>
                <p class="text-xs text-[#7a8863]" id="mRole">—</p>
                <p class="text-xs text-[#7a8863]" id="mDept">—</p>
            </div>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-black" id="mGrade">—</span>
        </div>
        <div class="mb-5">
            <div class="flex justify-between items-center mb-2">
                <span class="text-xs font-bold text-[#7a8863] uppercase tracking-wider">Overall Score</span>
                <span class="text-2xl font-black text-[#10823c]" id="mScore">—</span>
            </div>
            <div class="w-full bg-gray-100 rounded-full h-3 overflow-hidden"><div class="bg-[#10823c] h-3 rounded-full transition-all duration-700" id="mScoreBar" style="width:0%"></div></div>
        </div>
        <div class="bg-[#f6f8f7] rounded-xl p-4 mb-5">
            <p class="text-xs font-bold text-[#7a8863] uppercase tracking-wider mb-3">Score Breakdown</p>
            <div class="flex flex-col gap-2.5">
                <div class="flex items-center gap-3"><span class="text-[11px] text-[#7a8863] w-32">Attendance (30%)</span><div class="flex-1 bg-gray-200 rounded-full h-2 overflow-hidden"><div class="bg-blue-500 h-2 rounded-full transition-all duration-700" id="barAtt" style="width:0%"></div></div><span class="text-xs font-bold text-blue-600 w-10 text-right" id="mAtt">—</span></div>
                <div class="flex items-center gap-3"><span class="text-[11px] text-[#7a8863] w-32">Training (25%)</span><div class="flex-1 bg-gray-200 rounded-full h-2 overflow-hidden"><div class="bg-green-500 h-2 rounded-full transition-all duration-700" id="barTrain" style="width:0%"></div></div><span class="text-xs font-bold text-green-600 w-10 text-right" id="mTrain">—</span></div>
                <div class="flex items-center gap-3"><span class="text-[11px] text-[#7a8863] w-32">Leave (20%)</span><div class="flex-1 bg-gray-200 rounded-full h-2 overflow-hidden"><div class="bg-orange-400 h-2 rounded-full transition-all duration-700" id="barLeave" style="width:0%"></div></div><span class="text-xs font-bold text-orange-600 w-10 text-right" id="mLeave">—</span></div>
                <div class="flex items-center gap-3"><span class="text-[11px] text-[#7a8863] w-32">Punctuality (15%)</span><div class="flex-1 bg-gray-200 rounded-full h-2 overflow-hidden"><div class="bg-purple-500 h-2 rounded-full transition-all duration-700" id="barPunct" style="width:0%"></div></div><span class="text-xs font-bold text-purple-600 w-10 text-right" id="mPunct">—</span></div>
                <div class="flex items-center gap-3"><span class="text-[11px] text-[#7a8863] w-32">Welfare (10%)</span><div class="flex-1 bg-gray-200 rounded-full h-2 overflow-hidden"><div class="bg-[#10823c] h-2 rounded-full transition-all duration-700" id="barWelfare" style="width:0%"></div></div><span class="text-xs font-bold text-[#10823c] w-10 text-right" id="mWelfare">—</span></div>
            </div>
        </div>
        <div class="grid grid-cols-3 gap-3 mb-5">
            <div class="bg-[#f6f8f7] rounded-xl p-3 text-center"><p class="text-[10px] font-bold text-[#7a8863] uppercase mb-1">Leave Days Used</p><p class="text-xl font-bold text-[#151811]" id="mLeaveDays">—</p></div>
            <div class="bg-green-50 rounded-xl p-3 text-center"><p class="text-[10px] font-bold text-green-600 uppercase mb-1">Trainings Done</p><p class="text-xl font-bold text-green-600" id="mTrainingsDone">—</p></div>
            <div class="bg-blue-50 rounded-xl p-3 text-center"><p class="text-[10px] font-bold text-blue-600 uppercase mb-1">Welfare Requests</p><p class="text-xl font-bold text-blue-600" id="mWelfareTotal">—</p></div>
        </div>
        <div class="flex gap-3">
            <button onclick="closeModal()" class="flex-1 py-2.5 border border-gray-200 text-sm font-bold rounded-xl hover:bg-gray-50 transition-colors">Close</button>
            <a href="/Welfare/RequestList" class="flex-1 py-2.5 bg-[#10823c] text-white text-sm font-bold rounded-xl hover:bg-opacity-90 transition-all shadow-md text-center">View Welfare Requests</a>
        </div>
    </div>
</div>

<script>
    function filterTable() {
        const search = (document.getElementById('globalSearch').value || '').toLowerCase();
        const grade  = document.getElementById('gradeFilter').value;
        const dept   = document.getElementById('deptFilter').value;
        document.querySelectorAll('.perf-row').forEach(row => {
            const ok = (!search || row.dataset.name.includes(search))
                    && (!grade  || row.dataset.grade === grade)
                    && (!dept   || row.dataset.dept  === dept);
            row.style.display = ok ? '' : 'none';
        });
    }

    function openModal(name, role, dept, score, grade,
                       att, punct, leave, training, welfare,
                       presentDays, totalDays, lateDays,
                       leaveDaysUsed, leaveDaysTotal,
                       trainAttended, trainTotal, feedbackCount, avgRating,
                       welTotal, welApproved, welRejected) {

        document.getElementById('mName').textContent   = name;
        document.getElementById('mRole').textContent   = role;
        document.getElementById('mDept').textContent   = dept;
        document.getElementById('mAvatar').textContent = name[0];
        document.getElementById('mScore').textContent  = score + ' / 100';

        const gradeColors = { 'A+':'bg-emerald-100 text-emerald-700','A':'bg-green-100 text-green-700','B':'bg-blue-100 text-blue-700','C':'bg-yellow-100 text-yellow-700','D':'bg-red-100 text-red-700' };
        const gradeEl = document.getElementById('mGrade');
        gradeEl.textContent = 'Grade ' + grade;
        gradeEl.className   = 'inline-flex items-center px-3 py-1 rounded-full text-sm font-black ' + (gradeColors[grade] || 'bg-gray-100 text-gray-600');

        setTimeout(() => {
            document.getElementById('mScoreBar').style.width  = score    + '%';
            document.getElementById('barAtt').style.width     = att      + '%';
            document.getElementById('barPunct').style.width   = punct    + '%';
            document.getElementById('barLeave').style.width   = leave    + '%';
            document.getElementById('barTrain').style.width   = training + '%';
            document.getElementById('barWelfare').style.width = welfare  + '%';
        }, 50);

        document.getElementById('mAtt').textContent     = att      + '%';
        document.getElementById('mPunct').textContent   = punct    + '%';
        document.getElementById('mLeave').textContent   = leave    + '%';
        document.getElementById('mTrain').textContent   = training + '%';
        document.getElementById('mWelfare').textContent = welfare  + '%';

        // Detail stat cards
        document.getElementById('mLeaveDays').textContent =
            leaveDaysTotal > 0 ? `${leaveDaysUsed} / ${leaveDaysTotal}` : '—';

        document.getElementById('mTrainingsDone').textContent =
            trainTotal > 0
                ? (feedbackCount > 0 ? `${trainAttended}/${trainTotal} + ${feedbackCount} review${feedbackCount!==1?'s':''}` : `${trainAttended} / ${trainTotal}`)
                : feedbackCount > 0 ? `${feedbackCount} review${feedbackCount!==1?'s':''}` : '—';

        document.getElementById('mWelfareTotal').textContent =
            welTotal > 0 ? `${welApproved} ✓ / ${welRejected} ✗` : '—';

        document.getElementById('detailModal').classList.add('open');
    }

    function closeModal(e) {
        if (!e || e.target === document.getElementById('detailModal')) {
            document.getElementById('detailModal').classList.remove('open');
            ['mScoreBar','barAtt','barPunct','barLeave','barTrain','barWelfare'].forEach(id => document.getElementById(id).style.width = '0%');
        }
    }
</script>
<script src="/js/notifications.js"></script>
</body>
</html>
