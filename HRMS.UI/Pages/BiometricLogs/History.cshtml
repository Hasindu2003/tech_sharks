@page
@model HRMS.UI.Pages.BiometricLogs.HistoryModel
@{
    ViewData["Title"] = "Biometric Logs History";
    ViewData["ActiveNav"] = "BiometricLogs";
}

<style>
    .page-h { font-size: 19px; font-weight: 800; color: #151811; margin: 0 0 3px 0; }
    .page-s { font-size: 12px; color: #7a8863; margin: 0; }
    
    /* Filter Bar */
    .filter-card {
        background: #fff;
        border: 1px solid #e2e5dc;
        border-radius: 10px;
        padding: 16px 20px;
        margin-bottom: 20px;
        box-shadow: 0 1px 2px rgba(0,0,0,.05);
    }
    .fg { margin-bottom: 0; }
    .fl { font-size: 12px; font-weight: 700; color: #7a8863; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px; display: block; }
    .fi {
        width: 100%; padding: 8px 12px;
        border: 1px solid #d1d5db; border-radius: 6px;
        font-size: 13.5px; color: #151811;
        font-family: 'Manrope', sans-serif;
        background: #fff; box-sizing: border-box;
    }
    .fi:focus { outline: none; border-color: #10823c; box-shadow: 0 0 0 2px rgba(16,130,60,.1); }

    /* Inline table styles */
    .tbl-card { background: white; border: 1px solid #e2e5dc; border-radius: 10px; overflow: hidden; margin-bottom: 8px; box-shadow: 0 1px 2px rgba(0,0,0,.05); }
    .sep-table { width: 100%; border-collapse: collapse; }
    .sep-table th { background: #f9fafb; padding: 12px 18px; text-align: left; font-size: 12px; font-weight: 700; color: #7a8863; text-transform: uppercase; letter-spacing: 0.04em; border-bottom: 1px solid #e2e5dc; }
    .sep-table td { padding: 13px 18px; border-bottom: 1px solid #e2e5dc; font-size: 13.5px; color: #151811; vertical-align: middle; }
    .sep-table tbody tr:last-child td { border-bottom: none; }
    .sep-table tbody tr:hover { background: #fafafa; }
    
    /* Log type badges */
    .log-badge {
        padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; display: inline-flex; align-items: center; gap: 4px;
    }
    .log-badge.checkIn { background: #dcfce7; color: #166534; }
    .log-badge.checkOut { background: #fee2e2; color: #991b1b; }
</style>

<div class="page-header" style="margin-bottom: 24px;">
    <a asp-page="./Index" class="btn-kanrich btn-kanrich-outline btn-kanrich-sm" style="border: none; padding-left: 0; color: var(--text-secondary); margin-bottom: 12px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
        <i class="bi bi-arrow-left"></i> Back to Recent Logs
    </a>
    <h1 class="page-h">Biometric Logs History</h1>
    <p class="page-s">View all historical raw scan data collected from physical scanners</p>
</div>

<!-- Filter Bar -->
<div class="filter-card">
    <form method="get" style="display:grid; grid-template-columns:1.5fr 1.5fr auto; gap:16px; align-items:end;">
        <div class="fg">
            <label class="fl">Filter by Employee</label>
            <select asp-for="EmployeeId" class="fi">
                <option value="">-- All Employees --</option>
                @foreach (var emp in Model.Employees)
                {
                    <option value="@emp.Id">@emp.FullName (@emp.EPFNumber)</option>
                }
            </select>
        </div>

        <div class="fg">
            <label class="fl">Filter by Period</label>
            <select asp-for="DateFilter" class="fi">
                <option value="All">All Time</option>
                <option value="Last7Days">Last 7 Days</option>
                <option value="LastMonth">Last Month</option>
                <option value="Last3Months">Last 3 Months</option>
            </select>
        </div>
        
        <div style="display:flex; gap:10px;">
            <button type="submit" class="btn-kanrich btn-kanrich-primary" style="padding:9px 20px; height: 38px;">
                <i class="bi bi-funnel"></i> Filter
            </button>
            @if (Model.EmployeeId.HasValue || Model.DateFilter != "All")
            {
                <a asp-page="./History" class="btn-kanrich btn-kanrich-outline" style="padding:9px 20px; height: 38px; display:inline-flex; align-items:center; text-decoration:none;">Clear</a>
            }
        </div>
    </form>
</div>

<!-- Table -->
<div class="tbl-card">
    <table class="sep-table" id="biometricHistoryTable">
        <thead>
            <tr>
                <th>ID</th>
                <th>Employee</th>
                <th>Scan Timestamp</th>
                <th>Device ID</th>
                <th>Direction</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.BiometricLogs.Any())
            {
                @foreach (var log in Model.BiometricLogs)
                {
                    <tr>
                        <td><span style="font-weight: 700; color: #7a8863;">#@log.Id</span></td>
                        <td>
                            <div style="font-weight: 600; color: #151811;">@log.Employee?.FullName</div>
                            <div style="font-size: 11px; color: #7a8863;">@log.Employee?.EPFNumber</div>
                        </td>
                        <td>@log.LogDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td><span style="font-family: monospace; font-weight: 600; color: #4b5563;">@log.DeviceId</span></td>
                        <td>
                            <span class="log-badge @log.LogType">
                                @if (log.LogType == "checkIn")
                                {
                                    <i class="bi bi-box-arrow-in-right"></i> @("IN")
                                }
                                else
                                {
                                    <i class="bi bi-box-arrow-left"></i> @("OUT")
                                }
                            </span>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" style="text-align: center; color: #9ca3af; padding: 48px 24px;">
                        <i class="bi bi-inbox" style="font-size: 2.2rem; display: block; margin-bottom: 10px;"></i>
                        No biometric logs found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        initTablePagination("biometricHistoryTable", 10);
    </script>
}
