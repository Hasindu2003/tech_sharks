@page
@model HRMS.UI.Pages.BiometricLogs.IndexModel
@{
    ViewData["Title"] = "Biometric Logs";
    ViewData["ActiveNav"] = "BiometricLogs";
}

<style>
    .page-h { font-size: 19px; font-weight: 800; color: #151811; margin: 0 0 3px 0; }
    .page-s { font-size: 12px; color: #7a8863; margin: 0; }
    
    /* Filter Bar */
    .filter-card {
        background: #fff;
        border: 1px solid #e2e5dc;
        border-radius: 10px;
        padding: 16px 20px;
        margin-bottom: 20px;
        box-shadow: 0 1px 2px rgba(0,0,0,.05);
    }
    .fg { margin-bottom: 0; }
    .fl { font-size: 12px; font-weight: 700; color: #7a8863; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px; display: block; }
    .fi {
        width: 100%; padding: 8px 12px;
        border: 1px solid #d1d5db; border-radius: 6px;
        font-size: 13.5px; color: #151811;
        font-family: 'Manrope', sans-serif;
        background: #fff; box-sizing: border-box;
    }
    .fi:focus { outline: none; border-color: #10823c; box-shadow: 0 0 0 2px rgba(16,130,60,.1); }

    /* Inline table styles */
    .tbl-card { background: white; border: 1px solid #e2e5dc; border-radius: 10px; overflow: hidden; margin-bottom: 8px; box-shadow: 0 1px 2px rgba(0,0,0,.05); }
    .sep-table { width: 100%; border-collapse: collapse; }
    .sep-table th { background: #f9fafb; padding: 12px 18px; text-align: left; font-size: 12px; font-weight: 700; color: #7a8863; text-transform: uppercase; letter-spacing: 0.04em; border-bottom: 1px solid #e2e5dc; }
    .sep-table td { padding: 13px 18px; border-bottom: 1px solid #e2e5dc; font-size: 13.5px; color: #151811; vertical-align: middle; }
    .sep-table tbody tr:last-child td { border-bottom: none; }
    .sep-table tbody tr:hover { background: #fafafa; }
    
    /* Log type badges */
    .log-badge {
        padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; display: inline-flex; align-items: center; gap: 4px;
    }
    .log-badge.checkIn { background: #dcfce7; color: #166534; }
    .log-badge.checkOut { background: #fee2e2; color: #991b1b; }
</style>

<div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:22px;">
    <div>
        <h1 class="page-h">Biometric Raw Logs</h1>
        <p class="page-s">View raw scan data collected from physical scanners (ordered by latest activity)</p>
    </div>
    <div style="display:flex; gap:10px;">
        <a asp-page="./History" class="btn-kanrich btn-kanrich-outline" style="padding:9px 18px">
            <i class="bi bi-clock-history"></i> View Historical Logs
        </a>
        @if (User.IsInRole("Branch Manager") || User.IsInRole("HR Manager") || User.IsInRole("HR Officer") || User.IsInRole("Area Manager"))
        {
            <a asp-page="./Create" class="btn-kanrich btn-kanrich-primary" style="padding:9px 18px">
                <i class="bi bi-plus-circle"></i> Add New Log
            </a>
        }
    </div>
</div>

<!-- Filter Bar -->
<div class="filter-card">
    <form method="get" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap:16px; align-items:end;">
        @if (Model.ShowBranchFilter)
        {
            <div class="fg">
                <label class="fl">Branch</label>
                <select asp-for="FilterBranchId" class="fi" onchange="this.form.submit()">
                    <option value="">@Model.BranchFilterPlaceholder</option>
                    @foreach (var br in Model.ManagedBranchesList)
                    {
                        <option value="@br.Id">@br.Name</option>
                    }
                </select>
            </div>
        }

        @if (Model.ShowDepartmentFilter)
        {
            <div class="fg">
                <label class="fl">Department</label>
                <select asp-for="FilterDepartmentId" class="fi" onchange="this.form.submit()">
                    <option value="">-- All Departments --</option>
                    @foreach (var dept in Model.DepartmentsList)
                    {
                        <option value="@dept.Id">@dept.Name</option>
                    }
                </select>
            </div>
        }

        <div class="fg">
            <label class="fl">Employee</label>
            <select asp-for="EmployeeId" class="fi">
                <option value="">-- All Employees --</option>
                @foreach (var emp in Model.Employees)
                {
                    var empDisplayName = !string.IsNullOrWhiteSpace(emp.NameWithInitials) ? emp.NameWithInitials : emp.FullName;
                    <option value="@emp.Id">@empDisplayName (@emp.EPFNumber)</option>
                }
            </select>
        </div>
        
        <div class="fg">
            <label class="fl">From Date</label>
            <input type="date" asp-for="FromDate" class="fi" />
        </div>
        
        <div class="fg">
            <label class="fl">To Date</label>
            <input type="date" asp-for="ToDate" class="fi" />
        </div>
        
        <div style="grid-column: 1 / -1; display:flex; justify-content:flex-end; gap:10px; margin-top:8px;">
            <a asp-page="./Index" class="btn-kanrich btn-kanrich-outline" style="padding:9px 24px; height: 38px; display:inline-flex; align-items:center; justify-content:center; text-decoration:none;">Reset</a>
            <button type="submit" class="btn-kanrich btn-kanrich-primary" style="padding:9px 36px; height: 38px;">
                <i class="bi bi-funnel"></i> Filter
            </button>
        </div>
    </form>
</div>

<!-- Table -->
<div class="tbl-card">
    <table class="sep-table" id="biometricLogsTable">
        <thead>
            <tr>
                <th>ID</th>
                <th>Employee</th>
                <th>Branch & Department</th>
                <th>Scan Timestamp</th>
                <th>Device ID</th>
                <th>Direction</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.BiometricLogs.Any())
            {
                @foreach (var log in Model.BiometricLogs)
                {
                    <tr>
                        <td><span style="font-weight: 700; color: #7a8863;">#@log.Id</span></td>
                        <td>
                            <div style="font-weight: 600; color: #151811;">@(!string.IsNullOrWhiteSpace(log.Employee?.NameWithInitials) ? log.Employee.NameWithInitials : log.Employee?.FullName)</div>
                            <div style="font-size: 11px; color: #7a8863;">ID: @log.EmployeeId | EPF: @log.Employee?.EPFNumber</div>
                        </td>
                        <td>
                            <div style="font-weight: 500; color: #151811;">@(log.Employee?.Branch?.Name ?? "—")</div>
                            <div style="font-size: 11px; color: #7a8863;">@(log.Employee?.Department?.Name ?? "—")</div>
                        </td>
                        <td>
                            <span style="font-weight: 600; color: #151811;">@log.LogDateTime.ToString("yyyy-MM-dd")</span>
                            <span style="font-size: 12px; color: #7a8863; margin-left: 4px;">@log.LogDateTime.ToString("HH:mm:ss")</span>
                        </td>
                        <td><span style="font-family: monospace; font-weight: 600; color: #4b5563; background: #f3f4f6; padding: 2px 6px; border-radius: 4px;">@log.DeviceId</span></td>
                        <td>
                            <span class="log-badge @log.LogType">
                                @if (log.LogType == "checkIn")
                                {
                                    <i class="bi bi-box-arrow-in-right"></i> @("IN")
                                }
                                else
                                {
                                    <i class="bi bi-box-arrow-left"></i> @("OUT")
                                }
                            </span>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" style="text-align: center; color: #9ca3af; padding: 48px 24px;">
                        <i class="bi bi-inbox" style="font-size: 2.2rem; display: block; margin-bottom: 10px;"></i>
                        No biometric logs found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        initTablePagination("biometricLogsTable", 10);
    </script>
}
