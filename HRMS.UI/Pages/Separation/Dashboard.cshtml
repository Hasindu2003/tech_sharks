@page
@model HRMS.UI.Pages.Separation.DashboardModel
@{
    ViewData["Title"] = "Separation Management Hub";
    ViewData["PageTitle"] = "Separation Management Hub";
    ViewData["ActiveNav"] = "Separation";
}

<style>
    .sep-wrap { background: #ffffff; min-height: calc(100vh - 62px); }

    .sep-page-title  { font-size: 19px; font-weight: 800; color: #151811; margin: 0 0 3px 0; }
    .sep-page-sub    { font-size: 12px; font-weight: 400; color: #7a8863; margin: 0 0 22px 0; }
    .sep-section-title { font-size: 14px; font-weight: 700; color: #151811; margin: 0 0 12px 0; }

    .sep-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 14px;
    }

    .sep-card {
        background: #ffffff;
        border: 1px solid #e2e5dc;
        border-radius: 10px;
        padding: 16px;
        display: flex;
        align-items: flex-start;
        gap: 14px;
        text-decoration: none;
        color: inherit;
        box-shadow: 0 1px 2px rgba(0,0,0,.05);
        transition: box-shadow 0.2s;
    }
    .sep-card:hover { box-shadow: 0 2px 8px rgba(0,0,0,.08); color: inherit; text-decoration: none; }

    .sep-icon {
        width: 40px; height: 40px; border-radius: 10px; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
    }
    .sep-icon svg { width: 20px; height: 20px; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

    .sep-icon.green  { background: rgba(16,130,60,0.1); }
    .sep-icon.green svg  { stroke: #10823c; }
    .sep-icon.orange { background: rgba(249,115,22,0.1); }
    .sep-icon.orange svg { stroke: #f97316; }
    .sep-icon.blue   { background: rgba(59,130,246,0.1); }
    .sep-icon.blue svg   { stroke: #3b82f6; }
    .sep-icon.purple { background: rgba(168,85,247,0.1); }
    .sep-icon.purple svg { stroke: #a855f7; }
    .sep-icon.red    { background: rgba(239,68,68,0.1); }
    .sep-icon.red svg    { stroke: #ef4444; }

    .sep-card-title { font-size: 13px; font-weight: 700; color: #151811; margin: 0 0 3px 0; }
    .sep-card-desc  { font-size: 12px; font-weight: 400; color: #7a8863; margin: 0; line-height: 1.5; }

    .sep-card.danger { background: #fff5f5; border-color: #fecaca; }
    .sep-card.danger .sep-card-title { color: #b91c1c; }
    .sep-card.danger .sep-card-desc  { color: #ef4444; }
</style>

<div class="sep-wrap">
    <h2 class="sep-page-title">Separation Management</h2>
    <p class="sep-page-sub">Central hub for reviewing transfers, resignations, terminations, and death processes.</p>

    <h3 class="sep-section-title">Process Queues</h3>
    <div class="sep-grid">

        @if (User.IsInRole("Branch Manager"))
        {
            <a asp-page="/BranchManager/ReviewTransfers" class="sep-card">
                <div class="sep-icon blue">
                    <svg viewBox="0 0 24 24"><path d="M8 3L4 7l4 4"/><path d="M4 7h16"/><path d="M16 21l4-4-4-4"/><path d="M20 17H4"/></svg>
                </div>
                <div>
                    <p class="sep-card-title">Transfers</p>
                    <p class="sep-card-desc">Review employee transfer requests in your branch.</p>
                </div>
            </a>
            <a asp-page="/BranchManager/ReviewResignations" class="sep-card">
                <div class="sep-icon orange">
                    <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                </div>
                <div>
                    <p class="sep-card-title">Resignations</p>
                    <p class="sep-card-desc">Acknowledge submitted resignations from your branch.</p>
                </div>
            </a>
            <a asp-page="/BranchManager/ReviewDeathRequests" class="sep-card">
                <div class="sep-icon purple">
                    <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.84-8.84 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                </div>
                <div>
                    <p class="sep-card-title">Death Process</p>
                    <p class="sep-card-desc">Review pending employee death applications.</p>
                </div>
            </a>
            <a asp-page="/DeathProcess/Apply" class="sep-card danger">
                <div class="sep-icon red">
                    <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </div>
                <div>
                    <p class="sep-card-title">Initiate Death Request</p>
                    <p class="sep-card-desc">Start a death separation process for an employee.</p>
                </div>
            </a>
        }

        @if (User.IsInRole("Area Manager"))
        {
            <a asp-page="/AreaManager/ReviewTransfers" class="sep-card">
                <div class="sep-icon blue">
                    <svg viewBox="0 0 24 24"><path d="M8 3L4 7l4 4"/><path d="M4 7h16"/><path d="M16 21l4-4-4-4"/><path d="M20 17H4"/></svg>
                </div>
                <div>
                    <p class="sep-card-title">Transfers</p>
                    <p class="sep-card-desc">Approve branch-cleared transfer requests.</p>
                </div>
            </a>
            <a asp-page="/Termination/ApprovalQueue" class="sep-card">
                <div class="sep-icon red">
                    <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="18" y1="8" x2="23" y2="13"/><line x1="23" y1="8" x2="18" y2="13"/></svg>
                </div>
                <div>
                    <p class="sep-card-title">Terminations</p>
                    <p class="sep-card-desc">Review HR-initiated terminations.</p>
                </div>
            </a>
            <a asp-page="/AreaManager/ReviewResignations" class="sep-card">
                <div class="sep-icon orange">
                    <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                </div>
                <div>
                    <p class="sep-card-title">Resignations</p>
                    <p class="sep-card-desc">Provide operations approval for resignations.</p>
                </div>
            </a>
            <a asp-page="/AreaManager/ReviewDeathRequests" class="sep-card">
                <div class="sep-icon purple">
                    <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.84-8.84 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                </div>
                <div>
                    <p class="sep-card-title">Death Process</p>
                    <p class="sep-card-desc">Review branch-approved death applications.</p>
                </div>
            </a>
        }

        @if (User.IsInRole("HR Manager"))
        {
            <a asp-page="/HRManager/ReviewTransfers" class="sep-card">
                <div class="sep-icon blue">
                    <svg viewBox="0 0 24 24"><path d="M8 3L4 7l4 4"/><path d="M4 7h16"/><path d="M16 21l4-4-4-4"/><path d="M20 17H4"/></svg>
                </div>
                <div>
                    <p class="sep-card-title">Transfers</p>
                    <p class="sep-card-desc">Manage transfer eligibility and allocations.</p>
                </div>
            </a>
            <a asp-page="/Termination/Requests" class="sep-card">
                <div class="sep-icon red">
                    <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="18" y1="8" x2="23" y2="13"/><line x1="23" y1="8" x2="18" y2="13"/></svg>
                </div>
                <div>
                    <p class="sep-card-title">Terminations</p>
                    <p class="sep-card-desc">Initiate or finalize employee terminations.</p>
                </div>
            </a>
            <a asp-page="/HRManager/ReviewResignations" class="sep-card">
                <div class="sep-icon orange">
                    <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                </div>
                <div>
                    <p class="sep-card-title">Resignations</p>
                    <p class="sep-card-desc">Final HR approval and offboarding.</p>
                </div>
            </a>
            <a asp-page="/HRManager/ReviewDeathRequests" class="sep-card">
                <div class="sep-icon purple">
                    <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.84-8.84 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                </div>
                <div>
                    <p class="sep-card-title">Death Process</p>
                    <p class="sep-card-desc">Perform system closure and finalize payouts.</p>
                </div>
            </a>
            <a asp-page="/DeathProcess/Apply" class="sep-card danger">
                <div class="sep-icon red">
                    <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </div>
                <div>
                    <p class="sep-card-title">Initiate Death Request</p>
                    <p class="sep-card-desc">Start a death separation process for an employee.</p>
                </div>
            </a>
        }

    </div>
</div>
