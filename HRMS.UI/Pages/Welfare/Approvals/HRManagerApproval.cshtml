@page
@model HRMS.UI.Pages.Welfare.Approvals.HRManagerApprovalModel
@{
    ViewData["Title"] = "HR Manager Disbursements";
    ViewData["PageTitle"] = "Welfare / HR Disbursements";
    ViewData["ActiveNav"] = "Welfare";
}

@section Styles {
    <style>
        .approval-shell {
            padding: 26px;
            background: #ffffff;
            min-height: calc(100vh - 62px);
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }
        .stat-item {
            background: white;
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius);
            padding: 20px;
            box-shadow: var(--shadow-sm);
        }
        .stat-label {
            font-size: 0.8rem;
            color: var(--text-secondary);
            margin-bottom: 4px;
            font-weight: 600;
        }
        .stat-val {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--text-primary);
            margin: 0;
            line-height: 1;
        }
        .stat-val.pending { color: var(--accent-orange); }
        .stat-val.approved { color: var(--primary); }
        .stat-val.rejected { color: var(--accent-red); }
        .req-card {
            margin-bottom: 20px;
        }
        .req-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 20px;
            background: var(--bg-body);
            border-bottom: 1px solid var(--border-color);
        }
        .req-body {
            padding: 20px;
        }
        .req-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 16px;
        }
        .req-grid-item label {
            display: block;
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 2px;
        }
        .req-grid-item span {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-primary);
        }
        .reason-box {
            padding: 12px 16px;
            background: var(--bg-body);
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-sm);
            margin-bottom: 16px;
        }
        .reason-box label {
            display: block;
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            margin-bottom: 4px;
        }
        .reason-box p {
            margin: 0;
            font-size: 0.88rem;
            color: var(--text-primary);
        }
        .doc-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            background: white;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            font-size: 0.8rem;
        }
        .doc-btn {
            font-size: 0.75rem;
            padding: 2px 6px;
            border-radius: 4px;
            text-decoration: none;
            font-weight: 700;
        }
        .input-group-prefix {
            display: flex;
        }
        .input-prefix {
            background: var(--bg-body);
            border: 1px solid var(--border-color);
            border-right: none;
            border-top-left-radius: var(--border-radius-sm);
            border-bottom-left-radius: var(--border-radius-sm);
            padding: 10px 14px;
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-secondary);
            user-select: none;
        }
        .input-with-prefix {
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
        }
    </style>
}

<div class="approval-shell">

    <!-- Header -->
    <div class="page-header">
        <h2>HR Manager Disbursements</h2>
        <p class="page-subtitle">Verify approved requests, record payment confirmations, and finalize disbursements</p>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">✓ @TempData["Message"]</div>
    }

    <!-- Stats Grid -->
    <div class="stats-grid">
        <div class="stat-item">
            <div class="stat-label">Pending Review</div>
            <div class="stat-val pending">@Model.PendingRequests.Count</div>
        </div>
        <div class="stat-item">
            <div class="stat-label">Approved by Me</div>
            <div class="stat-val approved">@Model.MyApprovedCount</div>
        </div>
        <div class="stat-item">
            <div class="stat-label">Rejected by Me</div>
            <div class="stat-val rejected">@Model.MyRejectedCount</div>
        </div>
    </div>

    <!-- Requests Listing -->
    @if (!Model.PendingRequests.Any())
    {
        <div class="k-card" style="text-align: center; padding: 48px; color: var(--text-secondary);">
            <i class="bi bi-inbox" style="font-size: 3rem; color: var(--border-color); display: block; margin-bottom: 12px;"></i>
            <p style="font-weight: 600; margin: 0 0 4px 0;">No Pending Disbursements</p>
            <p style="font-size: 0.8rem; margin: 0;">All approved welfare requests have been disbursed.</p>
        </div>
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 20px;">
            @foreach (var req in Model.PendingRequests)
            {
                <div class="k-card req-card" style="padding: 0; overflow: hidden;">
                    <div class="req-header">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span style="font-weight: 800; font-size: 0.95rem;">WF-@req.RequestId.ToString("D4")</span>
                            <span class="k-badge k-badge-approved">Approved</span>
                        </div>
                        <span style="font-size: 0.75rem; color: var(--text-secondary);">Submitted: @req.CreatedAt.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="req-body">
                        
                        <div class="req-grid">
                            <div class="req-grid-item">
                                <label>Employee</label>
                                <span>@req.Employee?.FullName</span>
                            </div>
                            <div class="req-grid-item">
                                <label>Welfare Type</label>
                                <span>@req.WelfareType?.TypeName</span>
                            </div>
                            <div class="req-grid-item">
                                <label>Requested Amount</label>
                                <span style="color: var(--primary); font-weight: 700;">LKR @req.RequestedAmount.ToString("N2")</span>
                            </div>
                            <div class="req-grid-item">
                                <label>Request Date</label>
                                <span>@req.RequestDate.ToString("MMM dd, yyyy")</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(req.Remark))
                        {
                            <div class="reason-box">
                                <label>Reason</label>
                                <p>@req.Remark</p>
                            </div>
                        }

                        <!-- Supporting Documents -->
                        @if (req.Documents != null && req.Documents.Any())
                        {
                            <div class="reason-box" style="background: white;">
                                <label style="display: flex; align-items: center; gap: 6px; margin-bottom: 8px;">
                                    <i class="bi bi-paperclip" style="color: var(--primary); font-size: 0.9rem;"></i>
                                    Supporting Documents (@req.Documents.Count)
                                </label>
                                <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                                    @foreach (var doc in req.Documents)
                                    {
                                        var ext = System.IO.Path.GetExtension(doc.FileName)?.ToLowerInvariant() ?? "";
                                        var canPreview = ext == ".pdf" || ext == ".jpg" || ext == ".jpeg" || ext == ".png";
                                        var icon = ext switch
                                        {
                                            ".pdf" => "bi-file-earmark-pdf-fill",
                                            ".jpg" or ".jpeg" or ".png" => "bi-file-earmark-image-fill",
                                            ".doc" or ".docx" => "bi-file-earmark-word-fill",
                                            _ => "bi-file-earmark-fill"
                                        };
                                        <div class="doc-chip">
                                            <i class="bi @icon" style="color: var(--primary);"></i>
                                            <span style="font-weight: 600; color: var(--text-primary); max-w: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@doc.FileName</span>
                                            <div style="display: flex; gap: 4px; margin-left: 8px;">
                                                @if (canPreview)
                                                {
                                                    <a href="/Welfare/DownloadDocument?id=@doc.DocumentId&mode=view" class="doc-btn js-doc-preview" data-doc-title="@doc.FileName" data-doc-sub="Welfare Document" style="background: var(--primary-light); color: var(--primary);">
                                                        View
                                                    </a>
                                                }
                                                <a href="/Welfare/DownloadDocument?id=@doc.DocumentId" class="doc-btn" style="background: var(--bg-body); color: var(--text-secondary);">
                                                    Download
                                                </a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Disbursement Payment Details Form -->
                        <form method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="RequestId" value="@req.RequestId" />
                            
                            <div style="border: 1px solid var(--border-color); border-radius: var(--border-radius); overflow: hidden; margin-top: 16px;">
                                <div style="display: flex; align-items: center; gap: 8px; padding: 12px 20px; background: var(--bg-body); border-bottom: 1px solid var(--border-color);">
                                    <i class="bi bi-wallet2" style="color: var(--primary); font-size: 1rem;"></i>
                                    <span style="font-size: 0.88rem; font-weight: 700;">Disbursement Details</span>
                                </div>
                                <div style="padding: 20px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                                    
                                    <div class="k-form-group">
                                        <label>Approved Amount (LKR) *</label>
                                        <div class="input-group-prefix">
                                            <span class="input-prefix">LKR</span>
                                            <input type="number" name="ApprovedAmount" value="@((req.ApprovedAmount ?? req.RequestedAmount).ToString("F2"))" min="1" step="0.01" required class="k-form-control input-with-prefix" />
                                        </div>
                                    </div>

                                    <div class="k-form-group">
                                        <label>Payment Date *</label>
                                        <input type="date" name="PaymentDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" required class="k-form-control" />
                                    </div>

                                    <div class="k-form-group">
                                        <label>Payment Reference (Optional)</label>
                                        <input type="text" name="PaymentReference" placeholder="e.g. TXN-20240101-001" class="k-form-control" />
                                    </div>

                                    <div class="k-form-group">
                                        <label>Comments / Remarks</label>
                                        <input type="text" name="Comments" placeholder="Add disbursement note…" class="k-form-control" />
                                    </div>

                                </div>
                                <div style="display: flex; justify-content: flex-end; gap: 8px; padding: 14px 20px; background: var(--bg-body); border-top: 1px solid var(--border-color);">
                                    <button type="submit" name="Action" value="Rejected" onclick="return confirm('Are you sure you want to reject this request?')" class="btn-kanrich btn-kanrich-danger">
                                        <i class="bi bi-x-circle"></i> Reject
                                    </button>
                                    <button type="submit" name="Action" value="ConfirmPayment" onclick="return confirm('Confirm payment details and mark as completed?')" class="btn-kanrich btn-kanrich-primary">
                                        <i class="bi bi-wallet2"></i> Confirm Payment
                                    </button>
                                </div>
                            </div>
                        </form>

                    </div>
                </div>
            }
        </div>
    }

</div>
