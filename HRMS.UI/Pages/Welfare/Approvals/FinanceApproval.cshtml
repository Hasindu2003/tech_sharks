@page
@model HRMS.UI.Pages.Welfare.Approvals.FinanceApprovalModel
@{
    ViewData["Title"] = "Finance Approval";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Finance Approval — Kanrich HRMS</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script>tailwind.config = { theme: { extend: { colors: { primary:"#10823c" }, fontFamily:{ display:"Manrope" } } } };</script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24;
        }

        .icon-fill {
            font-variation-settings: 'FILL' 1,'wght' 400,'GRAD' 0,'opsz' 24;
        }

        body {
            font-family: 'Manrope',sans-serif;
        }

        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-thumb {
            background: #d1d5db;
            border-radius: 3px;
        }
    </style>
</head>
<body class="bg-[#f6f8f7] text-[#151811] overflow-hidden">
    <div class="flex h-screen w-full">

        <!-- Sidebar -->
        <aside class="w-[260px] bg-white border-r border-[#e2e5dc] flex flex-col justify-between shrink-0 h-full overflow-y-auto">
            <div class="flex flex-col gap-5 p-5">
                <div class="flex items-center gap-3">
                    <div class="bg-[#10823c] rounded-xl size-10 flex items-center justify-center text-white font-bold text-lg shadow-lg">K</div>
                    <div>
                        <h1 class="text-[#151811] text-base font-bold leading-tight">Kanrich HRMS</h1>
                        <p class="text-[#7a8863] text-xs">Finance Portal</p>
                    </div>
                </div>
                <nav class="flex flex-col gap-1">
                    <p class="px-3 text-[10px] font-bold text-[#7a8863] uppercase tracking-widest mb-1">Approvals</p>
                    <a href="/Welfare/Approvals/FinanceApproval" class="flex items-center gap-3 px-3 py-2.5 rounded-lg bg-[#10823c]/10 text-[#10823c]">
                        <span class="material-symbols-outlined icon-fill text-[20px]">approval</span>
                        <span class="text-sm font-bold">Pending Payments</span>
                        @if (Model.PendingRequests.Any())
                        {
                            <span class="ml-auto bg-[#10823c] text-white text-[10px] font-bold px-2 py-0.5 rounded-full">@Model.PendingRequests.Count</span>
                        }
                    </a>
                    <div class="h-px bg-gray-100 my-2"></div>
                    <p class="px-3 text-[10px] font-bold text-[#7a8863] uppercase tracking-widest mb-1">Summary</p>
                    <div class="px-3 py-2.5 rounded-lg bg-[#f6f8f7]">
                        <div class="flex justify-between items-center mb-1.5">
                            <span class="text-xs text-[#7a8863]">Payments Confirmed</span>
                            <span class="text-xs font-bold text-[#10823c]">@Model.MyApprovedCount</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-xs text-[#7a8863]">Rejected</span>
                            <span class="text-xs font-bold text-red-500">@Model.MyRejectedCount</span>
                        </div>
                    </div>
                </nav>
            </div>
            <div class="p-5">
                <a href="/Account/Logout" class="flex w-full items-center justify-center h-10 bg-[#10823c] text-white text-sm font-bold rounded-xl hover:bg-opacity-90 transition-all shadow-md">Log Out</a>
            </div>
        </aside>

        <!-- Main -->
        <div class="flex flex-col flex-1 h-full overflow-hidden">
            <!-- Header -->
            <header class="flex items-center justify-between border-b border-[#e2e5dc] bg-white px-8 py-4 shrink-0">
                <div class="flex items-center gap-3">
                    <h2 class="text-xl font-bold">Finance Approval Panel</h2>
                    @if (Model.PendingRequests.Any())
                    {
                        <span class="px-2.5 py-0.5 rounded-full bg-yellow-100 text-yellow-700 text-xs font-bold border border-yellow-200">@Model.PendingRequests.Count Pending</span>
                    }
                </div>
                <div class="flex items-center gap-3">
                    <button onclick="openNotifications()" class="relative flex size-10 items-center justify-center rounded-xl bg-[#f6f8f7] hover:bg-gray-200 transition-colors">
                        <span class="material-symbols-outlined text-[20px]">notifications</span>
                        <span class="notif-dot absolute top-2.5 right-2.5 size-2 bg-red-500 rounded-full border border-white" style="display:none"></span>
                    </button>
                </div>
            </header>

            <!-- Content -->
            <main class="flex-1 overflow-y-auto bg-[#f6f8f7] p-8">
                <div class="max-w-[900px] mx-auto flex flex-col gap-6">

                    <!-- Breadcrumb -->
                    <div class="flex items-center gap-2 text-xs text-[#7a8863]">
                        <a href="/" class="hover:text-[#10823c]">Home</a>
                        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                        <span class="text-[#151811] font-semibold">Finance Approvals</span>
                    </div>

                    <!-- Success Message -->
                    @if (TempData["Message"] != null)
                    {
                        <div class="flex items-center gap-3 px-5 py-3.5 bg-green-50 border border-green-200 rounded-2xl text-sm font-medium text-green-800">
                            <span class="material-symbols-outlined icon-fill text-green-600 text-[20px]">check_circle</span>
                            @TempData["Message"]
                        </div>
                    }

                    <!-- Stats Cards -->
                    <div class="grid grid-cols-3 gap-4">
                        <div class="bg-white rounded-2xl border border-[#e2e5dc] p-5 shadow-sm">
                            <p class="text-xs font-semibold text-[#7a8863] mb-1">Pending Review</p>
                            <p class="text-3xl font-bold text-yellow-600">@Model.PendingRequests.Count</p>
                        </div>
                        <div class="bg-white rounded-2xl border border-[#e2e5dc] p-5 shadow-sm">
                            <p class="text-xs font-semibold text-[#7a8863] mb-1">Payments Confirmed</p>
                            <p class="text-3xl font-bold text-[#10823c]">@Model.MyApprovedCount</p>
                        </div>
                        <div class="bg-white rounded-2xl border border-[#e2e5dc] p-5 shadow-sm">
                            <p class="text-xs font-semibold text-[#7a8863] mb-1">Rejected by Me</p>
                            <p class="text-3xl font-bold text-red-500">@Model.MyRejectedCount</p>
                        </div>
                    </div>

                    <!-- Requests -->
                    @if (!Model.PendingRequests.Any())
                    {
                        <div class="bg-white rounded-2xl border border-[#e2e5dc] shadow-sm flex flex-col items-center justify-center py-16 text-[#7a8863]">
                            <span class="material-symbols-outlined text-5xl mb-3">inbox</span>
                            <p class="text-sm font-semibold">No pending requests</p>
                            <p class="text-xs mt-1">All welfare requests have been processed.</p>
                        </div>
                    }
                    else
                    {
                        <div class="flex flex-col gap-4">
                            @foreach (var req in Model.PendingRequests)
                            {
                                <div class="bg-white rounded-2xl border border-[#e2e5dc] shadow-sm overflow-hidden">

                                    <!-- Request Header -->
                                    <div class="flex items-center justify-between px-6 py-4 border-b border-[#e2e5dc] bg-[#f8f9fa]">
                                        <div class="flex items-center gap-3">
                                            <span class="text-sm font-bold text-[#151811]">WF-@req.RequestId.ToString("D4")</span>
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-green-100 text-green-700">Approved — Awaiting Payment</span>
                                        </div>
                                        <span class="text-xs text-[#7a8863]">Submitted @req.CreatedAt.ToString("MMM dd, yyyy")</span>
                                    </div>

                                    <!-- Request Details -->
                                    <div class="p-6 flex flex-col gap-5">

                                        <!-- Employee & Request Info -->
                                        <div class="grid grid-cols-4 gap-4">
                                            <div>
                                                <p class="text-[10px] font-bold text-[#7a8863] uppercase tracking-wider mb-1">Employee</p>
                                                <p class="text-sm font-semibold">@(req.Employee?.FirstName + " " + req.Employee?.LastName)</p>
                                            </div>
                                            <div>
                                                <p class="text-[10px] font-bold text-[#7a8863] uppercase tracking-wider mb-1">Welfare Type</p>
                                                <p class="text-sm">@req.WelfareType?.TypeName</p>
                                            </div>
                                            <div>
                                                <p class="text-[10px] font-bold text-[#7a8863] uppercase tracking-wider mb-1">Requested Amount</p>
                                                <p class="text-sm font-bold text-[#7a8863] line-through">LKR @req.RequestedAmount.ToString("N2")</p>
                                            </div>
                                            <div>
                                                <p class="text-[10px] font-bold text-[#7a8863] uppercase tracking-wider mb-1">Pre-Approved Amount</p>
                                                <p class="text-sm font-bold text-[#10823c]">LKR @((req.ApprovedAmount ?? req.RequestedAmount).ToString("N2"))</p>
                                            </div>
                                        </div>

                                        <!-- Bank Details -->
                                        <div class="grid grid-cols-2 gap-4 p-4 bg-blue-50 border border-blue-200 rounded-xl">
                                            <div>
                                                <p class="text-[10px] font-bold text-blue-700 uppercase tracking-wider mb-1">Bank Account Name</p>
                                                <p class="text-sm font-semibold text-[#151811]">@(req.Employee?.BankAccountName ?? "—")</p>
                                            </div>
                                            <div>
                                                <p class="text-[10px] font-bold text-blue-700 uppercase tracking-wider mb-1">Bank Account Number</p>
                                                <p class="text-sm font-semibold text-[#151811]">@(req.Employee?.BankAccountNumber ?? "—")</p>
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrEmpty(req.Remark))
                                        {
                                            <div class="px-4 py-3 bg-[#f6f8f7] rounded-xl border border-[#e2e5dc]">
                                                <p class="text-[10px] font-bold text-[#7a8863] uppercase tracking-wider mb-1">Reason</p>
                                                <p class="text-sm text-[#151811]">@req.Remark</p>
                                            </div>
                                        }

                                        <!-- Supporting Documents -->
                                        @if (req.Documents != null && req.Documents.Any())
                                        {
                                            <div class="px-4 py-3 bg-[#f6f8f7] rounded-xl border border-[#e2e5dc]">
                                                <div class="flex items-center gap-2 mb-2">
                                                    <span class="material-symbols-outlined text-[#10823c] text-[18px]">attach_file</span>
                                                    <p class="text-[10px] font-bold text-[#7a8863] uppercase tracking-wider">Supporting Documents (@req.Documents.Count)</p>
                                                </div>
                                                <div class="flex flex-wrap gap-2">
                                                    @foreach (var doc in req.Documents)
                                                    {
                                                        var ext = System.IO.Path.GetExtension(doc.FileName)?.ToLowerInvariant() ?? "";
                                                        var canPreview = ext == ".pdf" || ext == ".jpg" || ext == ".jpeg" || ext == ".png";
                                                        var icon = ext switch
                                                        {
                                                                                ".pdf" => "picture_as_pdf",
                                                                                ".jpg" or ".jpeg" or ".png" => "image",
                                                                                ".doc" or ".docx" => "description",
                                                            _ => "insert_drive_file"
                                                        };
                                                        <div class="flex items-center gap-2 px-3 py-2 bg-white border border-[#e2e5dc] rounded-lg">
                                                            <span class="material-symbols-outlined text-[#10823c] text-[18px]">@icon</span>
                                                            <span class="text-xs font-medium text-[#151811] max-w-[200px] truncate" title="@doc.FileName">@doc.FileName</span>
                                                            @if (canPreview)
                                                            {
                                                                <a href="/Welfare/DownloadDocument?id=@doc.DocumentId&mode=view" target="_blank"
                                                                   class="flex items-center gap-1 px-2 py-1 bg-[#10823c]/10 text-[#10823c] text-[11px] font-bold rounded-md hover:bg-[#10823c]/20 transition-colors"
                                                                   title="View in browser">
                                                                    <span class="material-symbols-outlined text-[14px]">visibility</span> View
                                                                </a>
                                                            }
                                                            <a href="/Welfare/DownloadDocument?id=@doc.DocumentId"
                                                               class="flex items-center gap-1 px-2 py-1 bg-[#f6f8f7] text-[#7a8863] text-[11px] font-bold rounded-md hover:bg-gray-200 transition-colors"
                                                               title="Download">
                                                                <span class="material-symbols-outlined text-[14px]">download</span>
                                                            </a>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        <!-- ✅ Payment Form — Option 2 -->
                                        <form method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="RequestId" value="@req.RequestId" />

                                            <div class="border border-[#e2e5dc] rounded-2xl overflow-hidden">
                                                <div class="flex items-center gap-2 px-5 py-3 bg-[#f8f9fa] border-b border-[#e2e5dc]">
                                                    <span class="material-symbols-outlined text-[#10823c] text-[18px]">payments</span>
                                                    <p class="text-sm font-bold">Payment Details</p>
                                                </div>
                                                <div class="p-5 grid grid-cols-2 gap-4">

                                                    <!-- ✅ Approved Amount -->
                                                    <div>
                                                        <label class="text-[10px] font-bold text-[#7a8863] uppercase tracking-wider block mb-1.5">Approved Amount (LKR) *</label>
                                                        <div class="flex">
                                                            <span class="bg-[#f6f8f7] border border-r-0 border-[#e2e5dc] rounded-l-xl px-3 py-2.5 text-sm text-[#7a8863] font-semibold">LKR</span>
                                                            <input type="number" name="ApprovedAmount"
                                                                   value="@((req.ApprovedAmount ?? req.RequestedAmount).ToString("F2"))"
                                                                   min="1" step="0.01" required
                                                                   class="flex-1 bg-[#f6f8f7] border border-[#e2e5dc] rounded-r-xl text-sm px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-[#10823c]/20 focus:border-[#10823c]" />
                                                        </div>
                                                    </div>

                                                    <!-- ✅ Payment Date -->
                                                    <div>
                                                        <label class="text-[10px] font-bold text-[#7a8863] uppercase tracking-wider block mb-1.5">Payment Date *</label>
                                                        <input type="date" name="PaymentDate"
                                                               value="@DateTime.Now.ToString("yyyy-MM-dd")" required
                                                               class="w-full bg-[#f6f8f7] border border-[#e2e5dc] rounded-xl text-sm px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-[#10823c]/20 focus:border-[#10823c]" />
                                                    </div>

                                                    <!-- Payment Reference -->
                                                    <div>
                                                        <label class="text-[10px] font-bold text-[#7a8863] uppercase tracking-wider block mb-1.5">Payment Reference</label>
                                                        <input type="text" name="PaymentReference" placeholder="e.g. TXN-20240101-001"
                                                               class="w-full bg-[#f6f8f7] border border-[#e2e5dc] rounded-xl text-sm px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-[#10823c]/20 focus:border-[#10823c]" />
                                                    </div>

                                                    <!-- Comments -->
                                                    <div>
                                                        <label class="text-[10px] font-bold text-[#7a8863] uppercase tracking-wider block mb-1.5">Comments</label>
                                                        <input type="text" name="Comments" placeholder="Add your comments…"
                                                               class="w-full bg-[#f6f8f7] border border-[#e2e5dc] rounded-xl text-sm px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-[#10823c]/20 focus:border-[#10823c]" />
                                                    </div>
                                                </div>

                                                <!-- Action Buttons -->
                                                <div class="flex justify-end gap-3 px-5 py-4 border-t border-[#e2e5dc] bg-[#f8f9fa]">
                                                    <button type="submit" name="Action" value="Rejected"
                                                            onclick="return confirm('Are you sure you want to reject this request?')"
                                                            class="flex items-center gap-2 px-5 py-2.5 bg-white border border-red-200 text-red-600 text-sm font-bold rounded-xl hover:bg-red-50 transition-colors">
                                                        <span class="material-symbols-outlined text-[16px]">cancel</span> Reject
                                                    </button>
                                                    <button type="submit" name="Action" value="ConfirmPayment"
                                                            onclick="return confirm('Confirm payment for this request?')"
                                                            class="flex items-center gap-2 px-5 py-2.5 bg-[#10823c] text-white text-sm font-bold rounded-xl hover:bg-opacity-90 transition-all shadow-md shadow-[#10823c]/20">
                                                        <span class="material-symbols-outlined text-[16px]">payments</span> Confirm Payment
                                                    </button>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </main>
        </div>
    </div>
    <script src="/js/notifications.js"></script>
</body>
</html>
