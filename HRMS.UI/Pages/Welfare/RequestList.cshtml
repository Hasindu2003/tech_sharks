@page
@model HRMS.UI.Pages.Welfare.RequestListModel
@{
    ViewData["Title"] = "My Welfare Requests";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Welfare Requests — Kanrich HRMS</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: { primary: "#10823c" },
                    fontFamily: { display: "Manrope" }
                }
            }
        };
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24;
        }

        .icon-fill {
            font-variation-settings: 'FILL' 1,'wght' 400,'GRAD' 0,'opsz' 24;
        }

        body {
            font-family: 'Manrope', sans-serif;
        }

        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-thumb {
            background: #d1d5db;
            border-radius: 3px;
        }
    </style>
</head>
<body class="bg-[#f6f8f7] text-[#151811] overflow-hidden">
    <div class="flex h-screen w-full">

        <!-- Sidebar -->
        <aside class="w-[260px] bg-white border-r border-[#e2e5dc] flex flex-col justify-between shrink-0 h-full overflow-y-auto">
            <div class="flex flex-col gap-5 p-5">
                <div class="flex items-center gap-3">
                    <div class="bg-[#10823c] rounded-xl size-10 flex items-center justify-center text-white font-bold text-lg shadow-lg">K</div>
                    <div>
                        <h1 class="text-[#151811] text-base font-bold leading-tight">Kanrich HRMS</h1>
                        <p class="text-[#7a8863] text-xs">Employee Portal</p>
                    </div>
                </div>
                <nav class="flex flex-col gap-1">
                    <p class="px-3 text-[10px] font-bold text-[#7a8863] uppercase tracking-widest mb-1">Main Menu</p>
                    <a href="/" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#f6f8f7] text-[#7a8863] transition-colors">
                        <span class="material-symbols-outlined text-[20px]">dashboard</span>
                        <span class="text-sm font-medium">Dashboard</span>
                    </a>
                    <a href="/Welfare/RequestForm" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#f6f8f7] text-[#7a8863] transition-colors">
                        <span class="material-symbols-outlined text-[20px]">add_circle</span>
                        <span class="text-sm font-medium">New Request</span>
                    </a>
                    <a href="/Welfare/RequestList" class="flex items-center gap-3 px-3 py-2.5 rounded-lg bg-[#10823c]/10 text-[#10823c]">
                        <span class="material-symbols-outlined icon-fill text-[20px]">list_alt</span>
                        <span class="text-sm font-bold">My Requests</span>
                    </a>
                    <div class="h-px bg-gray-100 my-2"></div>
                    <p class="px-3 text-[10px] font-bold text-[#7a8863] uppercase tracking-widest mb-1">Payroll</p>
                    <a href="/Payroll/Payslips" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#f6f8f7] text-[#7a8863] transition-colors">
                        <span class="material-symbols-outlined text-[20px]">receipt_long</span>
                        <span class="text-sm font-medium">My Payslips</span>
                    </a>
                </nav>
            </div>
            <div class="p-5">
                <a href="/Account/Logout" class="flex w-full items-center justify-center h-10 bg-[#10823c] text-white text-sm font-bold rounded-xl hover:bg-opacity-90 transition-all shadow-md">Log Out</a>
            </div>
        </aside>

        <!-- Main -->
        <div class="flex flex-col flex-1 h-full overflow-hidden">

            <!-- Header -->
            <header class="flex items-center justify-between border-b border-[#e2e5dc] bg-white px-8 py-4 shrink-0">
                <h2 class="text-xl font-bold">My Welfare Requests</h2>
                <div class="flex items-center gap-3">
                    <a href="/Welfare/RequestForm"
                       class="flex items-center gap-2 px-5 py-2.5 bg-[#10823c] text-white text-sm font-bold rounded-xl hover:bg-opacity-90 transition-all shadow-md shadow-[#10823c]/20">
                        <span class="material-symbols-outlined text-[16px]">add</span> New Request
                    </a>
                    <button onclick="openNotifications()"
                            class="relative flex size-10 items-center justify-center rounded-xl bg-[#f6f8f7] hover:bg-gray-200 transition-colors">
                        <span class="material-symbols-outlined text-[20px]">notifications</span>
                        <span class="notif-dot absolute top-2.5 right-2.5 size-2 bg-red-500 rounded-full border border-white" style="display:none"></span>
                    </button>
                </div>
            </header>

            <!-- Content -->
            <main class="flex-1 overflow-y-auto bg-[#f6f8f7] p-8">
                <div class="max-w-[1200px] mx-auto flex flex-col gap-6">

                    <!-- Breadcrumb -->
                    <div class="flex items-center gap-2 text-xs text-[#7a8863]">
                        <a href="/" class="hover:text-[#10823c] transition-colors">Home</a>
                        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                        <span class="text-[#151811] font-semibold">My Welfare Requests</span>
                    </div>

                    <!-- Stats Row -->
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        @{
                            var total = Model.Requests.Count();
                            var pending = Model.Requests.Count(r => r.CurrentStatus == "Pending");
                            var approved = Model.Requests.Count(r => r.CurrentStatus == "Approved" || r.Status == "PaymentCompleted");
                            var rejected = Model.Requests.Count(r => r.CurrentStatus == "Rejected");
                        }
                        <div class="bg-white rounded-2xl border border-[#e2e5dc] p-5 shadow-sm">
                            <p class="text-xs font-semibold text-[#7a8863] mb-1">Total Requests</p>
                            <p class="text-3xl font-bold text-[#151811]">@total</p>
                        </div>
                        <div class="bg-white rounded-2xl border border-[#e2e5dc] p-5 shadow-sm">
                            <p class="text-xs font-semibold text-[#7a8863] mb-1">Pending</p>
                            <p class="text-3xl font-bold text-yellow-600">@pending</p>
                        </div>
                        <div class="bg-white rounded-2xl border border-[#e2e5dc] p-5 shadow-sm">
                            <p class="text-xs font-semibold text-[#7a8863] mb-1">Approved</p>
                            <p class="text-3xl font-bold text-[#10823c]">@approved</p>
                        </div>
                        <div class="bg-white rounded-2xl border border-[#e2e5dc] p-5 shadow-sm">
                            <p class="text-xs font-semibold text-[#7a8863] mb-1">Rejected</p>
                            <p class="text-3xl font-bold text-red-500">@rejected</p>
                        </div>
                    </div>

                    <!-- Table Card -->
                    <div class="bg-white rounded-2xl border border-[#e2e5dc] shadow-sm overflow-hidden">
                        <div class="flex items-center justify-between px-6 py-4 border-b border-[#e2e5dc]">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-[#10823c] text-[20px]">list_alt</span>
                                <h3 class="text-sm font-bold text-[#151811]">Request List</h3>
                            </div>
                            <div class="flex items-center gap-3">
                                <select id="statusFilter" onchange="filterTable()"
                                        class="bg-[#f6f8f7] border-none rounded-xl text-xs font-medium px-3 py-2 text-[#7a8863] focus:ring-0 cursor-pointer">
                                    <option value="">All Status</option>
                                    <option value="Pending">Pending</option>
                                    <option value="Draft">Draft</option>
                                    <option value="Approved">Approved</option>
                                    <option value="Rejected">Rejected</option>
                                    <option value="PaymentCompleted">Completed</option>
                                </select>
                                <div class="flex items-center bg-[#f6f8f7] rounded-xl px-3 py-2 gap-2 border border-transparent focus-within:border-[#10823c]/40 transition-all">
                                    <span class="material-symbols-outlined text-[#7a8863] text-[16px]">search</span>
                                    <input id="searchBox" oninput="filterTable()"
                                           class="bg-transparent text-xs text-[#151811] placeholder:text-[#7a8863] focus:outline-none w-40"
                                           placeholder="Search requests..." />
                                </div>
                            </div>
                        </div>

                        @if (!Model.Requests.Any())
                        {
                            <div class="flex flex-col items-center justify-center py-16 text-[#7a8863]">
                                <span class="material-symbols-outlined text-5xl mb-3">inbox</span>
                                <p class="text-sm font-semibold">No requests found</p>
                                <p class="text-xs mt-1">Submit your first welfare request to get started.</p>
                                <a href="/Welfare/RequestForm"
                                   class="mt-4 px-5 py-2.5 bg-[#10823c] text-white text-xs font-bold rounded-xl hover:bg-opacity-90 transition-all">
                                    New Request
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="overflow-x-auto">
                                <table class="w-full text-left text-sm" id="requestTable">
                                    <thead class="bg-[#f8f9fa] text-[#7a8863] border-b border-[#e2e5dc]">
                                        <tr>
                                            <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider">#</th>
                                            <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider">Employee</th>
                                            <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider">Assistance Type</th>
                                            <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider">Request Date</th>
                                            <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider">Requested</th>
                                            <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider">Approved</th>
                                            <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider">Current Level</th>
                                            <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider">Status</th>
                                            <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-right">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-[#e2e5dc]">
                                        @foreach (var item in Model.Requests)
                                        {
                                            <tr class="hover:bg-gray-50 transition-colors">
                                                <td class="px-6 py-4 text-xs font-bold text-[#7a8863]">WF-@item.RequestId.ToString("D4")</td>
                                                <td class="px-6 py-4 font-semibold">@item.Employee?.FirstName @item.Employee?.LastName</td>
                                                <td class="px-6 py-4 text-[#151811]">@item.WelfareType?.TypeName</td>
                                                <td class="px-6 py-4 text-[#7a8863]">@item.RequestDate.ToString("MMM dd, yyyy")</td>
                                                <td class="px-6 py-4 font-bold text-[#10823c]">LKR @item.RequestedAmount.ToString("N2")</td>
                                                <td class="px-6 py-4 text-[#151811]">@(item.ApprovedAmount.HasValue ? "LKR " + item.ApprovedAmount.Value.ToString("N2") : "—")</td>
                                                <td class="px-6 py-4">
                                                    @{
                                                        var (lvlBg, lvlTxt) = item.CurrentLevel switch
                                                        {
                                                                            "BranchDGM" => ("bg-blue-100 text-blue-700", "Branch DGM"),
                                                                            "HODGM" => ("bg-sky-100 text-sky-700", "HO DGM"),
                                                                            "SeniorManagement" => ("bg-yellow-100 text-yellow-700", "Senior Mgmt"),
                                                                            "Finance" => ("bg-green-100 text-green-700", "Finance"),
                                                            _ => ("bg-gray-100 text-gray-600", item.CurrentLevel)
                                                        };
                                                    }
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold @lvlBg">@lvlTxt</span>
                                                </td>
                                                <td class="px-6 py-4">
                                                    @{
                                                        var (stBg, stTxt) = item.CurrentStatus switch
                                                        {
                                                                            "Approved" => ("bg-green-100 text-green-700", item.CurrentStatus),
                                                                            "Rejected" => ("bg-red-100 text-red-700", item.CurrentStatus),
                                                                            "Pending" => ("bg-yellow-100 text-yellow-700", item.CurrentStatus),
                                                                            "Draft" => ("bg-gray-100 text-gray-600", item.CurrentStatus),
                                                                            "PaymentCompleted" => ("bg-emerald-100 text-emerald-700", "Completed"),
                                                            _ => ("bg-gray-100 text-gray-600", item.CurrentStatus)
                                                        };
                                                    }
                                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold @stBg">
                                                        <span class="size-1.5 rounded-full bg-current"></span> @stTxt
                                                    </span>
                                                </td>

                                                <!-- ✅ Action column with Edit button -->
                                                <td class="px-6 py-4 text-right">
                                                    <div class="flex items-center justify-end gap-2">
                                                        @{
                                                            bool canEdit = item.CurrentLevel == "BranchDGM"
                                                            && item.CurrentStatus == "Pending"
                                                            && DateTime.Now <= item.CreatedAt.AddHours(24);
                                                            var timeLeft = item.CreatedAt.AddHours(24) - DateTime.Now;
                                                        }
                                                        @if (canEdit)
                                                        {
                                                            <div class="flex flex-col items-end gap-1">
                                                                <a href="/Welfare/EditRequest/@item.RequestId"
                                                                   class="px-3 py-1.5 bg-orange-50 border border-orange-200 text-orange-600 text-xs font-bold rounded-lg hover:bg-orange-100 transition-colors flex items-center gap-1">
                                                                    <span class="material-symbols-outlined text-[12px]">edit</span> Edit
                                                                </a>
                                                                <span class="text-[10px] text-orange-500 font-semibold">
                                                                    @((int)timeLeft.TotalHours)h @(timeLeft.Minutes)m left
                                                                </span>
                                                            </div>
                                                        }
                                                        else if (item.CurrentLevel == "BranchDGM"
                                                        && item.CurrentStatus == "Pending"
                                                        && DateTime.Now > item.CreatedAt.AddHours(24))
                                                        {
                                                            <span class="text-[10px] text-gray-400 font-semibold">Edit expired</span>
                                                        }
                                                        <a href="/Welfare/StatusTracking?id=@item.RequestId"
                                                           class="px-4 py-2 bg-white border border-gray-200 text-[#151811] text-xs font-bold rounded-lg hover:bg-gray-50 transition-colors shadow-sm">
                                                            View
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script>
        function filterTable() {
            const search = document.getElementById('searchBox').value.toLowerCase();
            const status = document.getElementById('statusFilter').value.toLowerCase();
            document.querySelectorAll('#requestTable tbody tr').forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(search) && (status === '' || text.includes(status)) ? '' : 'none';
            });
        }
    </script>

    <script src="/js/notifications.js"></script>
</body>
</html>
