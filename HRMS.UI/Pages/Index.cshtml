@page
@model HRMS.UI.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard Overview";
    ViewData["PageTitle"] = "Dashboard Overview";
    ViewData["ActiveNav"] = "Dashboard";
}

<style>
    .dash-wrap { padding: 26px; background: #ffffff; min-height: calc(100vh - 62px); }

    .dash-greeting { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px; }
    .dash-greeting-title { font-size: 19px; font-weight: 800; color: #151811; margin: 0 0 3px 0; }
    .dash-greeting-sub { font-size: 12px; font-weight: 400; color: #7a8863; margin: 0; }
    .dash-date {
        display: flex; align-items: center; gap: 6px;
        background: #ffffff; border: 1px solid #e2e5dc; border-radius: 6px;
        padding: 7px 12px; white-space: nowrap;
    }
    .dash-date svg { width: 14px; height: 14px; stroke: #7a8863; fill: none; flex-shrink: 0; }
    .dash-date span { font-size: 12px; font-weight: 500; color: #7a8863; }

    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 22px; }
    .stat-card {
        background: #ffffff; border: 1px solid #e2e5dc; border-radius: 10px;
        padding: 16px; height: 120px;
        display: flex; flex-direction: column; justify-content: space-between;
    }
    .stat-top { display: flex; justify-content: space-between; align-items: flex-start; }
    .s-icon {
        width: 32px; height: 32px; border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
    }
    .s-icon svg { width: 17px; height: 17px; fill: none; stroke-width: 2; }
    .s-icon.green  { background: rgba(16,130,60,0.1); }
    .s-icon.green svg  { stroke: #10823c; }
    .s-icon.orange { background: rgba(249,115,22,0.1); }
    .s-icon.orange svg { stroke: #f97316; }
    .s-icon.blue   { background: rgba(59,130,246,0.1); }
    .s-icon.blue svg   { stroke: #3b82f6; }
    .s-icon.purple { background: rgba(168,85,247,0.1); }
    .s-icon.purple svg { stroke: #a855f7; }

    .s-badge {
        font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 9999px;
        display: inline-flex; align-items: center; gap: 3px;
    }
    .s-badge.up    { background: rgba(7,136,26,0.1); color: #07881a; }
    .s-badge.alert { background: rgba(231,27,8,0.1); color: #e71b08; }
    .s-badge svg { width: 10px; height: 10px; }

    .s-label { font-size: 11px; font-weight: 500; color: #7a8863; margin: 0 0 1px 0; }
    .s-value { font-size: 24px; font-weight: 800; color: #151811; margin: 0; line-height: 1.15; }

    .dash-bottom { display: flex; gap: 22px; }
    .dash-left  { flex: 2; display: flex; flex-direction: column; gap: 20px; }
    .dash-right { flex: 1; display: flex; flex-direction: column; gap: 10px; min-width: 260px; }

    .sec-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
    .sec-title { font-size: 14px; font-weight: 700; color: #151811; margin: 0; }
    .sec-link {
        font-size: 11px; font-weight: 700; color: #10823c; text-decoration: none;
        display: flex; align-items: center; gap: 3px;
    }
    .sec-link:hover { text-decoration: underline; }
    .sec-link svg { width: 12px; height: 12px; stroke: #10823c; fill: none; }

    .qa-row { display: flex; gap: 10px; }
    .qa-card {
        flex: 1; background: #ffffff; border: 1px solid #e2e5dc; border-radius: 10px;
        height: 58px; display: flex; align-items: center; padding: 0 12px; gap: 10px;
        text-decoration: none; color: inherit; transition: box-shadow 0.2s;
    }
    .qa-card:hover { box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
    .qa-ic {
        width: 34px; height: 34px; border-radius: 8px;
        background: rgba(16,130,60,0.1);
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .qa-ic svg { width: 17px; height: 17px; stroke: #10823c; fill: none; }
    .qa-t { font-size: 12px; font-weight: 700; color: #151811; margin: 0; }
    .qa-s { font-size: 10px; font-weight: 400; color: #7a8863; margin: 1px 0 0 0; }

    .appr-card { background: #ffffff; border: 1px solid #e2e5dc; border-radius: 10px; overflow: hidden; }
    .appr-tbl { width: 100%; border-collapse: collapse; }
    .appr-tbl thead tr { background: #f9fafb; border-bottom: 1px solid #e2e5dc; }
    .appr-tbl th { padding: 10px 16px; font-size: 11px; font-weight: 600; color: #7a8863; text-align: left; }
    .appr-tbl th:last-child { text-align: right; }
    .appr-tbl td { padding: 10px 16px; font-size: 12px; }
    .appr-tbl tbody tr { border-top: 1px solid #e2e5dc; }
    .appr-tbl tbody tr:first-child { border-top: none; }
    .appr-tbl tbody tr:hover { background: #fafafa; }

    .e-cell { display: flex; align-items: center; gap: 8px; }
    .e-av {
        width: 28px; height: 28px; border-radius: 50%;
        background: linear-gradient(135deg, #d1d5db, #9ca3af);
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-size: 11px; font-weight: 700; flex-shrink: 0;
    }
    .e-nm { font-weight: 600; color: #151811; font-size: 12px; }
    .td-m { color: #7a8863; }
    .st-badge { display: inline-block; padding: 2px 8px; border-radius: 9999px; font-size: 10px; font-weight: 600; }
    .st-badge.pending { background: #fef3c7; color: #92400e; }
    .btn-rv {
        background: rgba(16,130,60,0.05); border: 1px solid rgba(16,130,60,0.2);
        color: #10823c; font-family: 'Manrope', sans-serif; font-size: 11px; font-weight: 700;
        padding: 5px 14px; border-radius: 6px; cursor: pointer; transition: background 0.15s;
        text-decoration: none;
    }
    .btn-rv:hover { background: rgba(16,130,60,0.1); color: #10823c; }
    .td-r { text-align: right; }
    .td-e { text-align: center; padding: 24px; color: #7a8863; font-size: 12px; }

    .ev-card {
        background: #ffffff; border: 1px solid #e2e5dc; border-radius: 10px;
        padding: 14px; display: flex; flex-direction: column; gap: 10px;
    }
    .ev-item { display: flex; align-items: center; gap: 12px; padding: 10px; border-radius: 10px; }
    .ev-item.event-green  { background: #ffffff; border: 1px solid #e2e5dc; }
    .ev-item.event-orange { background: #ffffff; border: 1px solid #e2e5dc; }
    .ev-item.event-blue   { background: #ffffff; border: 1px solid #e2e5dc; }

    .ev-date {
        width: 42px; height: 42px; border-radius: 10px;
        display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .event-green .ev-date  { background: rgba(16,130,60,0.08); color: #10823c; }
    .event-orange .ev-date { background: rgba(234,88,12,0.08); color: #ea580c; }
    .event-blue .ev-date   { background: rgba(37,99,235,0.08); color: #2563eb; }

    .ev-mon { font-size: 8px; font-weight: 700; line-height: 1.4; }
    .ev-day { font-size: 15px; font-weight: 800; line-height: 1; }
    .ev-ti  { font-size: 12px; font-weight: 700; color: #151811; margin: 0; }
    .ev-tm  { font-size: 10px; font-weight: 400; color: #7a8863; margin: 2px 0 0 0; }

    .ev-footer { border-top: 1px solid #e2e5dc; padding-top: 10px; margin-top: 2px; text-align: center; }
    .btn-cal {
        display: block; width: 100%; padding: 7px; border: 1px solid rgba(16,130,60,0.2);
        border-radius: 8px; background: transparent;
        font-family: 'Manrope', sans-serif; font-size: 11px; font-weight: 700; color: #10823c;
        text-decoration: none; text-align: center; transition: background 0.15s;
    }
    .btn-cal:hover { background: rgba(16,130,60,0.05); }
</style>

<div class="dash-wrap">

    <!-- Greeting -->
    <div class="dash-greeting">
        <div>
            <h2 class="dash-greeting-title">@Model.GreetingTime, @Model.GreetingName</h2>
            <p class="dash-greeting-sub">Here's what's happening at Kanrich Limited today.</p>
        </div>
        <div class="dash-date">
            <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            <span>@DateTime.Now.ToString("MMM dd, yyyy")</span>
        </div>
    </div>

    @if (!User.IsInRole("Admin"))
    {
        <!-- Stats Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-top">
                    <div class="s-icon green">
                        <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                    </div>
                    <span class="s-badge up">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                        3%
                    </span>
                </div>
                <div><p class="s-label">Total Employees</p><p class="s-value">@Model.TotalEmployees</p></div>
            </div>
            <div class="stat-card">
                <div class="stat-top">
                    <div class="s-icon orange">
                        <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/>
                            <line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/>
                        </svg>
                    </div>
                </div>
                <div><p class="s-label">On Leave Today</p><p class="s-value">@Model.OnLeaveToday</p></div>
            </div>
            <div class="stat-card">
                <div class="stat-top">
                    <div class="s-icon blue">
                        <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                        </svg>
                    </div>
                    @if (Model.PendingRequests > 0)
                    {
                        <span class="s-badge alert">+@Model.PendingRequests new</span>
                    }
                </div>
                <div><p class="s-label">Pending Requests</p><p class="s-value">@Model.PendingRequests</p></div>
            </div>
            <div class="stat-card">
                <div class="stat-top">
                    <div class="s-icon purple">
                        <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
                            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                        </svg>
                    </div>
                    @if (Model.OpenPositions > 0)
                    {
                        <span class="s-badge up">+@Model.OpenPositions role</span>
                    }
                </div>
                <div><p class="s-label">Open Positions</p><p class="s-value">@Model.OpenPositions</p></div>
            </div>
        </div>

        <!-- Bottom -->
        <div class="dash-bottom">
            <div class="dash-left">
                <!-- Quick Actions -->
                <div>
                    <div class="sec-header"><h3 class="sec-title">Quick Actions</h3></div>
                    <div class="qa-row">
                        @if (User.IsInRole("Employee") || User.IsInRole("Branch Manager") || User.IsInRole("HR Manager"))
                        {
                            <a href="/Transfer/Apply" class="qa-card">
                                <div class="qa-ic">
                                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/>
                                        <line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/>
                                    </svg>
                                </div>
                                <div><p class="qa-t">New Transfer</p><p class="qa-s">Submit request</p></div>
                            </a>
                        }
                        <a href="/Transfer/Separation" class="qa-card">
                            <div class="qa-ic">
                                <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/>
                                    <polyline points="17 11 19 13 23 9"/>
                                </svg>
                            </div>
                            <div><p class="qa-t">Separation</p><p class="qa-s">Resignations & transfers</p></div>
                        </a>
                        <a href="/Employees/Profile" class="qa-card">
                            <div class="qa-ic">
                                <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                                </svg>
                            </div>
                            <div><p class="qa-t">My Profile</p><p class="qa-s">View your records</p></div>
                        </a>
                    </div>
                </div>

                <!-- Pending Approvals -->
                <div>
                    <div class="sec-header">
                        <h3 class="sec-title">@(User.IsInRole("Employee") ? "My Transfer Requests" : "Pending Approvals")</h3>
                        <a href="@(User.IsInRole("Employee") ? "/Transfer/MyRequests" : User.IsInRole("Branch Manager") ? "/BranchManager/ReviewTransfers" : User.IsInRole("HR Manager") ? "/HRManager/ReviewTransfers" : "/AreaManager/ReviewTransfers")" class="sec-link">
                            View All
                            <svg viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                            </svg>
                        </a>
                    </div>
                    <div class="appr-card">
                        <table class="appr-tbl" id="tbl-dashboard">
                            <thead>
                                <tr>
                                    <th style="width:28%">Employee</th>
                                    <th style="width:20%">Request Type</th>
                                    <th style="width:22%">Date</th>
                                    <th style="width:15%">Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.PendingApprovals.Any())
                                {
                                    @foreach (var a in Model.PendingApprovals)
                                    {
                                        <tr>
                                            <td><div class="e-cell"><div class="e-av">@a.EmployeeName[0]</div><span class="e-nm">@a.EmployeeName</span></div></td>
                                            <td class="td-m">@a.RequestType</td>
                                            <td class="td-m">@a.DateRange</td>
                                            <td><span class="st-badge pending">@a.Status</span></td>
                                            <td class="td-r">
                                                <a href="/Transfer/Details/@a.RequestId" class="btn-rv">Review</a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="5" class="td-e">No pending approvals.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Upcoming Events -->
            <div class="dash-right">
                <div class="sec-header"><h3 class="sec-title">Upcoming Events</h3></div>
                <div class="ev-card">
                    @foreach (var evt in Model.UpcomingEvents)
                    {
                        <div class="ev-item @evt.ThemeClass">
                            <div class="ev-date">
                                <span class="ev-mon">@evt.Month</span>
                                <span class="ev-day">@evt.Day</span>
                            </div>
                            <div>
                                <p class="ev-ti">@evt.Title</p>
                                <p class="ev-tm">@evt.Time</p>
                            </div>
                        </div>
                    }
                    <div class="ev-footer">
                        <a href="#" class="btn-cal">View Full Calendar</a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Admin view -->
        <div style="text-align:center;padding:60px;color:#7a8863;font-size:14px;">
            Admin portal. Use Settings to manage branches, departments and designations.
        </div>
    }

</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    initTablePagination('tbl-dashboard', 8);
});
</script>
}
