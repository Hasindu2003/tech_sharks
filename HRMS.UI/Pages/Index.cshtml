@page
@model IndexModel
@{
    ViewData["Title"] = "Welcome — Kanrich HRMS";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kanrich HRMS — Login</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: { primary: "#10823c" },
                    fontFamily: { display: "Manrope" }
                }
            }
        };
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24;
        }

        .icon-fill {
            font-variation-settings: 'FILL' 1,'wght' 400,'GRAD' 0,'opsz' 24;
        }

        body {
            font-family: 'Manrope', sans-serif;
        }
    </style>
</head>
<body class="bg-[#f6f8f7] min-h-screen flex items-center justify-center">

    <div class="w-full max-w-[420px] px-4">

        <!-- Logo -->
        <div class="flex flex-col items-center mb-8">
            <div class="bg-[#10823c] rounded-2xl size-16 flex items-center justify-center text-white font-bold text-3xl shadow-lg shadow-[#10823c]/30 mb-4">
                K
            </div>
            <h1 class="text-2xl font-bold text-[#151811]">Kanrich HRMS</h1>
            <p class="text-sm text-[#7a8863] mt-1">Human Resource Management System</p>
        </div>

        <!-- Login Card -->
        <div class="bg-white rounded-2xl border border-[#e2e5dc] shadow-sm overflow-hidden">

            <div class="px-8 py-6 border-b border-[#e2e5dc]">
                <h2 class="text-lg font-bold text-[#151811]">Sign in to your account</h2>
                <p class="text-xs text-[#7a8863] mt-1">Enter your credentials to continue</p>
            </div>

            <div class="px-8 py-6">
                <form method="post" action="/Account/Login" class="flex flex-col gap-4">
                    @Html.AntiForgeryToken()

                    <!-- Email -->
                    <div>
                        <label class="text-[11px] font-bold text-[#7a8863] uppercase tracking-wider block mb-1.5">
                            Email Address
                        </label>
                        <div class="flex items-center bg-[#f6f8f7] border border-[#e2e5dc] rounded-xl px-3 py-2.5 gap-2 focus-within:border-[#10823c] focus-within:ring-2 focus-within:ring-[#10823c]/20 transition-all">
                            <span class="material-symbols-outlined text-[#7a8863] text-[18px]">mail</span>
                            <input type="email" name="Email" id="Email"
                                   placeholder="you@kanrich.lk"
                                   required autocomplete="email"
                                   class="flex-1 bg-transparent text-sm text-[#151811] placeholder:text-[#b0b8a0] focus:outline-none" />
                        </div>
                    </div>

                    <!-- Password -->
                    <div>
                        <label class="text-[11px] font-bold text-[#7a8863] uppercase tracking-wider block mb-1.5">
                            Password
                        </label>
                        <div class="flex items-center bg-[#f6f8f7] border border-[#e2e5dc] rounded-xl px-3 py-2.5 gap-2 focus-within:border-[#10823c] focus-within:ring-2 focus-within:ring-[#10823c]/20 transition-all">
                            <span class="material-symbols-outlined text-[#7a8863] text-[18px]">lock</span>
                            <input type="password" name="Password" id="Password"
                                   placeholder="••••••••"
                                   required autocomplete="current-password"
                                   class="flex-1 bg-transparent text-sm text-[#151811] placeholder:text-[#b0b8a0] focus:outline-none"
                                   id="passwordInput" />
                            <button type="button" onclick="togglePassword()"
                                    class="text-[#7a8863] hover:text-[#10823c] transition-colors focus:outline-none">
                                <span class="material-symbols-outlined text-[18px]" id="eyeIcon">visibility</span>
                            </button>
                        </div>
                    </div>

                    <!-- Remember Me -->
                    <div class="flex items-center gap-2">
                        <input type="checkbox" name="RememberMe" id="RememberMe"
                               class="accent-[#10823c] size-4 rounded" />
                        <label for="RememberMe" class="text-sm text-[#7a8863] cursor-pointer">
                            Remember me
                        </label>
                    </div>

                    <!-- Error message -->
                    @if (TempData["LoginError"] != null)
                    {
                        <div class="flex items-center gap-2 px-4 py-3 bg-red-50 border border-red-200 rounded-xl text-sm text-red-700">
                            <span class="material-symbols-outlined icon-fill text-red-500 text-[18px]">error</span>
                            @TempData["LoginError"]
                        </div>
                    }

                    <!-- Submit -->
                    <button type="submit"
                            class="w-full flex items-center justify-center gap-2 h-11 bg-[#10823c] text-white text-sm font-bold rounded-xl hover:bg-opacity-90 active:scale-[0.98] transition-all shadow-md shadow-[#10823c]/20 mt-1">
                        <span class="material-symbols-outlined text-[18px]">login</span>
                        Sign In
                    </button>
                </form>
            </div>
        </div>

        <!-- Footer -->
        <p class="text-center text-xs text-[#7a8863] mt-6">
            &copy; 2026 Kanrich HRMS. All rights reserved.
        </p>

    </div>

    <script>
        function togglePassword() {
            const input = document.getElementById('passwordInput');
            const icon  = document.getElementById('eyeIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility_off';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility';
            }
        }
    </script>

</body>
</html>
