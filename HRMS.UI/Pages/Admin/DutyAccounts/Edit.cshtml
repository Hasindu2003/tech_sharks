@page
@model HRMS.UI.Pages.Admin.DutyAccounts.EditDutyAccountModel
@{
    ViewData["Title"] = "Edit Duty Account";
    ViewData["PageTitle"] = "Settings / Duty Accounts / Edit";
    ViewData["ActiveNav"] = "Settings";
}

@section Styles {
<style>
    .page-content { background: #fff !important; }
    .edit-shell { padding: 26px; }

    .page-header { margin-bottom: 28px; }
    .page-header h2 { font-size: 20px; font-weight: 800; color: #151811; margin: 0 0 4px; }
    .page-header p  { font-size: 13px; color: #7a8863; margin: 0; }

    .btn-secondary {
        display: inline-flex; align-items: center; background: white;
        border: 1px solid #e2e5dc; padding: 7px 14px; border-radius: 6px;
        color: #151811; font-size: 13px; font-weight: 600;
        text-decoration: none; transition: background 0.2s; margin-bottom: 20px;
    }
    .btn-secondary:hover { background: #f9fafb; color: #151811; }

    .form-card {
        background: white; border: 1px solid #e2e5dc;
        border-radius: 14px;
    }
    .form-card-header {
        background: linear-gradient(135deg, #10823c 0%, #0d6e32 100%);
        padding: 18px 24px; display: flex; align-items: center; gap: 12px;
        border-radius: 13px 13px 0 0;
    }
    .form-card-header svg { width: 20px; height: 20px; stroke: #fff; fill: none; }
    .form-card-header h3 { font-size: 14px; font-weight: 700; color: #fff; margin: 0 0 2px; }
    .form-card-header p  { font-size: 12px; color: rgba(255,255,255,.75); margin: 0; }

    .form-card-body { padding: 24px; }

    .info-row {
        background: #f6f8f7; border-radius: 8px; padding: 12px 16px;
        margin-bottom: 22px; display: flex; gap: 24px; flex-wrap: wrap;
    }
    .info-item label { font-size: 11px; font-weight: 700; color: #7a8863; text-transform: uppercase; letter-spacing: .5px; display: block; margin-bottom: 3px; }
    .info-item span  { font-size: 13px; font-weight: 700; color: #151811; }

    .form-group { margin-bottom: 18px; }
    .form-label { font-size: 12px; font-weight: 700; color: #151811; display: block; margin-bottom: 5px; }
    .required-mark { color: #dc3545; }
    .form-control {
        width: 100%; padding: 9px 12px; border: 1px solid #e2e5dc; border-radius: 7px;
        font-family: 'Manrope', sans-serif; font-size: 13px; color: #151811;
        background: #fff; outline: none; transition: border-color .15s, box-shadow .15s;
    }
    .form-control:focus { border-color: #10823c; box-shadow: 0 0 0 3px rgba(16,130,60,.1); }
    .custom-dropdown { position: relative; }
    .custom-dropdown-trigger {
        display: flex; align-items: center; justify-content: space-between;
        padding: 9px 12px; border: 1px solid #e2e5dc; border-radius: 7px;
        background: #fff; cursor: pointer; font-family: 'Manrope', sans-serif;
        font-size: 13px; color: #151811; user-select: none;
        transition: border-color .15s, box-shadow .15s; min-height: 38px;
    }
    .custom-dropdown-trigger:hover { border-color: #10823c; }
    .custom-dropdown-trigger.open { border-color: #10823c; box-shadow: 0 0 0 3px rgba(16,130,60,.1); }
    .custom-dropdown-chevron { transition: transform .2s; color: #7a8863; width: 14px; height: 14px; flex-shrink: 0; }
    .custom-dropdown-trigger.open .custom-dropdown-chevron { transform: rotate(180deg); }
    .custom-dropdown-list {
        display: none; position: absolute; top: calc(100% + 4px); left: 0; right: 0;
        background: #fff; border: 1px solid #e2e5dc; border-radius: 7px;
        box-shadow: 0 4px 16px rgba(0,0,0,.12); max-height: calc(6 * 2.5rem); overflow-y: auto; z-index: 999;
    }
    .custom-dropdown-list.open { display: block; }
    .custom-dropdown-option {
        padding: 9px 12px; cursor: pointer; font-family: 'Manrope', sans-serif;
        font-size: 13px; color: #151811; transition: background .1s;
    }
    .custom-dropdown-option:hover { background: #f0faf4; color: #10823c; }
    .custom-dropdown-option.selected { background: #e6f4ec; color: #10823c; font-weight: 700; }
    .custom-dropdown-option[data-value=""] { color: #7a8863; }
    .field-error { font-size: 11px; color: #dc3545; font-weight: 600; margin-top: 4px; display: block; }

    .branch-checklist {
        display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
        max-height: 180px; overflow-y: auto; padding: 10px 12px;
        border: 1px solid #e2e5dc; border-radius: 7px; background: #fafbfa;
    }
    .branch-check-item {
        display: flex; align-items: center; gap: 8px;
        font-size: 13px; color: #151811; cursor: pointer;
        padding: 4px 6px; border-radius: 5px; transition: background .12s;
    }
    .branch-check-item:hover { background: #f0faf4; }
    .branch-check-item input[type="checkbox"] { width: 14px; height: 14px; accent-color: #10823c; cursor: pointer; }

    .form-actions {
        display: flex; justify-content: flex-end; gap: 10px;
        padding: 16px 24px; border-top: 1px solid #f0f0f0; background: #fafbfa;
    }
    .btn-cancel {
        padding: 9px 20px; border: 1px solid #e2e5dc; border-radius: 7px;
        background: #fff; font-family: 'Manrope', sans-serif; font-size: 13px;
        font-weight: 700; color: #151811; text-decoration: none; cursor: pointer;
        transition: background .15s;
    }
    .btn-cancel:hover { background: #f6f8f7; }
    .btn-save {
        padding: 9px 22px; border: none; border-radius: 7px; background: #10823c;
        font-family: 'Manrope', sans-serif; font-size: 13px; font-weight: 700; color: #fff;
        cursor: pointer; transition: background .15s;
    }
    .btn-save:hover { background: #0d6e32; }

    .alert-error {
        padding: 12px 16px; border-radius: 8px; background: #fff5f5;
        border: 1px solid rgba(220,53,69,.3); color: #dc3545;
        font-size: 13px; font-weight: 600; margin-bottom: 18px;
    }
</style>
}

<div class="edit-shell">
    <a href="/Admin/DutyAccounts" class="btn-secondary">&larr; Back to Duty Accounts</a>

    <div class="page-header">
        <h2>Edit Duty Account</h2>
        <p>Update the assignment for this @Model.Role account.</p>
    </div>

    @if (!ModelState.IsValid && ModelState.ErrorCount > 0)
    {
        <div class="alert-error">
            @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
            { <div>• @err.ErrorMessage</div> }
        </div>
    }

    <form method="post">
        <input type="hidden" name="UserId" value="@Model.UserId" />

        <div class="form-card">
            <div class="form-card-header">
                <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
                <div>
                    <h3>@Model.Role</h3>
                    <p>@Model.CurrentDisplayName</p>
                </div>
            </div>

            <div class="form-card-body">
                <div class="info-row">
                    <div class="info-item">
                        <label>Login Email</label>
                        <span>@Model.CurrentEmail</span>
                    </div>
                    <div class="info-item">
                        <label>Role</label>
                        <span>@Model.Role</span>
                    </div>
                </div>

                @if (Model.Role == "HR Manager" || Model.Role == "Branch Manager")
                {
                    <div class="form-group">
                        <label class="form-label">Branch <span class="required-mark">*</span></label>
                        <select name="BranchId" id="branchSelectEdit" style="display:none">
                            <option value="">Select Branch</option>
                            @foreach (var b in Model.BranchList)
                            {
                                if (Model.BranchId.HasValue && Model.BranchId.Value.ToString() == b.Value)
                                { <option value="@b.Value" selected>@b.Text</option> }
                                else
                                { <option value="@b.Value">@b.Text</option> }
                            }
                        </select>
                        <div class="custom-dropdown" id="branchDropdownEdit">
                            <div class="custom-dropdown-trigger" id="branchTriggerEdit">
                                <span id="branchTriggerTextEdit">Select Branch</span>
                                <svg class="custom-dropdown-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                            </div>
                            <div class="custom-dropdown-list" id="branchListEdit">
                                <div class="custom-dropdown-option" data-value="">Select Branch</div>
                                @foreach (var b in Model.BranchList)
                                {
                                    <div class="custom-dropdown-option" data-value="@b.Value">@b.Text</div>
                                }
                            </div>
                        </div>
                        <span class="field-error">@Html.ValidationMessage("BranchId")</span>
                    </div>
                }

                @if (Model.Role == "Area Manager")
                {
                    <div class="form-group">
                        <label class="form-label">Area Name <span class="required-mark">*</span></label>
                        <input type="text" name="AreaName" value="@Model.AreaName"
                               class="form-control" placeholder="e.g. Central Province" />
                        <span class="field-error">@Html.ValidationMessage("AreaName")</span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Managed Branches <span class="required-mark">*</span></label>
                        <div class="branch-checklist">
                            @foreach (var b in Model.BranchList)
                            {
                                <label class="branch-check-item">
                                    <input type="checkbox" name="ManagedBranchIds" value="@b.Value"
                                           @(Model.ManagedBranchIds.Contains(int.Parse(b.Value)) ? "checked" : "") />
                                    @b.Text
                                </label>
                            }
                        </div>
                        <span class="field-error">@Html.ValidationMessage("ManagedBranchIds")</span>
                    </div>
                }
            </div>

            <div class="form-actions">
                <a href="/Admin/DutyAccounts" class="btn-cancel">Cancel</a>
                <button type="submit" class="btn-save">Save Changes</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<script>
    function initCustomDropdown({ selectId, triggerId, listId, triggerTextId, dropdownId, placeholder }) {
        const select = document.getElementById(selectId);
        const trigger = document.getElementById(triggerId);
        const list = document.getElementById(listId);
        const triggerText = document.getElementById(triggerTextId);
        const options = list.querySelectorAll('.custom-dropdown-option');
        function close() { list.classList.remove('open'); trigger.classList.remove('open'); }
        trigger.addEventListener('click', function () {
            const isOpen = list.classList.contains('open');
            list.classList.toggle('open', !isOpen);
            trigger.classList.toggle('open', !isOpen);
        });
        options.forEach(function (opt) {
            opt.addEventListener('click', function () {
                const value = this.dataset.value;
                select.value = value;
                triggerText.textContent = value ? this.textContent.trim() : placeholder;
                options.forEach(o => o.classList.remove('selected'));
                if (value) this.classList.add('selected');
                close();
            });
        });
        document.addEventListener('click', function (e) {
            if (!document.getElementById(dropdownId).contains(e.target)) close();
        });
        if (select.value) {
            const pre = list.querySelector(`.custom-dropdown-option[data-value="${CSS.escape(select.value)}"]`);
            if (pre) { triggerText.textContent = pre.textContent.trim(); pre.classList.add('selected'); }
        }
    }
    document.addEventListener('DOMContentLoaded', function () {
        if (document.getElementById('branchSelectEdit'))
            initCustomDropdown({ selectId: 'branchSelectEdit', triggerId: 'branchTriggerEdit', listId: 'branchListEdit', triggerTextId: 'branchTriggerTextEdit', dropdownId: 'branchDropdownEdit', placeholder: 'Select Branch' });
    });
</script>
}
