@page
@model HRMS.UI.Pages.Settings.Branches.IndexModel
@{
    ViewData["Title"] = "Manage Branches";
    ViewData["PageTitle"] = "Settings / Branches";
    ViewData["ActiveNav"] = "Settings";
}

@section Styles {
    <style>
        :root {
            --primary-green: #10823c;
            --bg-light: #f6f8f7;
            --border-color: #e2e5dc;
            --text-main: #151811;
            --text-muted: #7a8863;
        }

        .dashboard-container {
            position: relative;
        }

        .main-content {
            background-color: white;
            padding: 26px;
            min-height: calc(100vh - 62px);
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }

        .page-header h2 {
            font-size: 20px;
            font-weight: 800;
            color: var(--text-main);
            margin-bottom: 4px;
        }

        .btn-primary {
            background-color: var(--primary-green);
            color: white;
            padding: 9px 17px;
            border-radius: 6px;
            font-family: 'Manrope', sans-serif;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            box-shadow: 0px 1px 2px rgba(0, 0, 0, 0.05);
            transition: background 0.2s;
        }
        .btn-primary:hover { background-color: #0d6e32; color: white; }

        .btn-secondary {
            display: inline-flex;
            align-items: center;
            background: white; border: 1px solid var(--border-color);
            padding: 7px 14px; border-radius: 6px; color: var(--text-main);
            font-size: 13px; font-weight: 600; text-decoration: none; transition: background 0.2s;
            margin-bottom: 16px;
        }
        .btn-secondary:hover { background: #f9fafb; color: var(--text-main); }

        .table-card {
            background: white;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            box-shadow: 0px 1px 2px rgba(0, 0, 0, 0.05);
            overflow: hidden;
            margin-bottom: 19px;
        }

        .emp-table { width: 100%; border-collapse: collapse; }
        .emp-table th { background: #f9fafb; padding: 13px 19px; text-align: left; font-size: 13px; font-weight: 700; color: var(--text-muted); border-bottom: 1px solid var(--border-color); }
        .emp-table td { padding: 13px 19px; vertical-align: middle; border-bottom: 1px solid var(--border-color); font-size: 14px; color: var(--text-main); }
        .emp-table tr:last-child td { border-bottom: none; }
        .emp-table tbody tr:hover { background: #fafafa; }

        .btn-view { color: var(--primary-green); font-size: 13px; font-weight: 700; text-decoration: none; padding: 5px 10px; border-radius: 5px; transition: background 0.2s; }
        .btn-view:hover { background: #e8f3ec; }
    </style>
}

<div class="dashboard-container">
    <div class="main-content">
        <a href="/Settings" class="btn-secondary">&larr; Back to Settings</a>

        <div class="page-header">
            <h2>Manage Branches</h2>
            <a href="/Settings/Branches/Create" class="btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Add Branch
            </a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div id="successBanner" style="background: #ecfdf5; color: #065f46; padding: 14px 20px; border-radius: 10px; margin-bottom: 20px; font-size: 14px; font-weight: 600; border: 1px solid #10b981; box-shadow: 0 4px 6px -1px rgba(16, 185, 129, 0.1); display: flex; justify-content: space-between; align-items: center;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div style="background: #10b981; border-radius: 50%; width: 22px; height: 22px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 2px 4px rgba(16, 185, 129, 0.3);">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </div>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
                <button type="button" onclick="document.getElementById('successBanner').style.display='none'" style="background: rgba(16, 185, 129, 0.1); border: none; color: #047857; cursor: pointer; padding: 6px; border-radius: 6px; display: flex; align-items: center; justify-content: center; transition: background 0.2s;" onmouseover="this.style.background='rgba(16, 185, 129, 0.2)'" onmouseout="this.style.background='rgba(16, 185, 129, 0.1)'">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
        }

        <div class="table-card">
            <table class="emp-table" id="tbl-branches">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Location</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Branches.Count == 0)
                    {
                        <tr><td colspan="4" style="text-align:center; color:#7a8863; padding: 32px 0;">No branches found.</td></tr>
                    }
                    @foreach (var item in Model.Branches)
                    {
                        <tr>
                            <td style="font-weight: 600;">BRN-@item.Id.ToString("D4")</td>
                            <td>@item.Name</td>
                            <td>@item.Location</td>
                            <td style="text-align: right;">
                                <a href="/Settings/Branches/Edit?id=@item.Id" class="btn-view">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    initTablePagination('tbl-branches', 10);
});
</script>
}
