@page
@model HRMS.UI.Pages.Settings.LeaveAllocations.IndexModel
@{
    ViewData["Title"] = "Leave Allocation Settings";
    ViewData["PageTitle"] = "Settings / Leave Allocations";
    ViewData["ActiveNav"] = "Settings";
}

@section Styles {
    <style>
        :root {
            --primary-green: #10823c;
            --primary-green-dark: #0d6e32;
            --bg-light: #f6f8f7;
            --border-color: #e2e5dc;
            --text-main: #151811;
            --text-muted: #7a8863;
        }

        .settings-container {
            background-color: white;
            padding: 26px 32px;
            min-height: calc(100vh - 62px);
        }

        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 600;
            margin-bottom: 20px;
            transition: color 0.2s ease;
        }

        .back-btn:hover {
            color: var(--primary-green);
        }

        .page-header {
            margin-bottom: 24px;
        }

        .page-header h2 {
            font-size: 22px;
            font-weight: 800;
            color: var(--text-main);
            margin-bottom: 4px;
        }

        .page-header p {
            font-size: 13.5px;
            color: var(--text-muted);
        }

        /* ── Tabs Segmented Bar ── */
        .tab-bar {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #f1f5f3;
            padding: 5px;
            border-radius: 12px;
            max-width: 720px;
            margin-bottom: 24px;
            border: 1px solid var(--border-color);
        }

        .tab-item {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 16px;
            border-radius: 9px;
            font-size: 13.5px;
            font-weight: 700;
            color: #526047;
            cursor: pointer;
            border: none;
            background: transparent;
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
            user-select: none;
        }

        .tab-item svg {
            width: 17px;
            height: 17px;
            stroke: currentColor;
            fill: none;
        }

        .tab-item:hover {
            color: var(--primary-green);
            background: rgba(255,255,255,0.6);
        }

        .tab-item.active {
            background: white;
            color: var(--primary-green);
            box-shadow: 0 2px 6px rgba(0,0,0,0.06);
        }

        .tab-badge {
            font-size: 11px;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: 20px;
            background: #eef7f0;
            color: var(--primary-green);
        }

        .tab-item.active .tab-badge {
            background: #10823c;
            color: white;
        }

        /* ── Panel Cards ── */
        .tab-panel {
            display: none;
            max-width: 720px;
        }

        .tab-panel.active {
            display: block;
            animation: fadeIn 0.2s ease;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(3px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .policy-banner {
            background: #f8faf8;
            border: 1px solid #e1e9e3;
            border-left: 4px solid var(--primary-green);
            border-radius: 8px;
            padding: 12px 16px;
            font-size: 13px;
            color: #3b4632;
            margin-bottom: 20px;
            line-height: 1.5;
        }

        .settings-card {
            background: white;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.03);
            padding: 24px;
            margin-bottom: 24px;
        }

        .allocation-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 0;
            border-bottom: 1px solid #f1f5f9;
        }

        .allocation-row:last-child {
            border-bottom: none;
        }

        .allocation-info {
            display: flex;
            flex-direction: column;
            gap: 2px;
            max-width: 70%;
        }

        .allocation-name {
            font-size: 14.5px;
            font-weight: 700;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .allocation-desc {
            font-size: 12px;
            color: var(--text-muted);
            line-height: 1.4;
        }

        .allocation-input-group {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .days-input {
            width: 84px;
            padding: 8px 12px;
            border: 1px solid var(--border-color);
            border-radius: 7px;
            font-size: 14px;
            font-weight: 700;
            color: var(--text-main);
            text-align: center;
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .days-input:focus {
            border-color: var(--primary-green);
            box-shadow: 0 0 0 3px rgba(16,130,60,0.12);
        }

        .days-label {
            font-size: 13px;
            font-weight: 600;
            color: #64748b;
        }

        .btn-save {
            background: var(--primary-green);
            color: white;
            border: none;
            border-radius: 8px;
            padding: 11px 24px;
            font-size: 14.5px;
            font-weight: 700;
            cursor: pointer;
            transition: background-color 0.2s ease, transform 0.1s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-save:hover {
            background: var(--primary-green-dark);
        }

        .btn-save:active {
            transform: scale(0.98);
        }

        .alert {
            padding: 12px 18px;
            border-radius: 8px;
            font-size: 13.5px;
            margin-bottom: 22px;
            display: flex;
            align-items: center;
            gap: 10px;
            max-width: 720px;
        }

        .alert-success {
            background: #dcfce7;
            color: #15803d;
            border: 1px solid #bbf7d0;
        }

        .alert-danger {
            background: #fee2e2;
            color: #b91c1c;
            border: 1px solid #fca5a5;
        }
    </style>
}

<div class="settings-container">
    <a href="/Settings" class="back-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Back to Settings
    </a>

    <div class="page-header">
        <h2>Leave Allocation Settings</h2>
        <p>Configure and synchronize separate annual leave day allocations for Permanent, Probationary, and Intern employees.</p>
    </div>

    @if (Model.SuccessMessage != null)
    {
        <div class="alert alert-success">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            @Model.SuccessMessage
        </div>
    }

    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            @Model.ErrorMessage
        </div>
    }

    <!-- Tab Bar -->
    <div class="tab-bar">
        <button type="button" class="tab-item @(Model.ActiveTab == "Permanent" ? "active" : "")" onclick="selectTab('Permanent')">
            <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            </svg>
            Permanent
            <span class="tab-badge">Full</span>
        </button>
        <button type="button" class="tab-item @(Model.ActiveTab == "Probationary" ? "active" : "")" onclick="selectTab('Probationary')">
            <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            Probationary
            <span class="tab-badge">Probation</span>
        </button>
        <button type="button" class="tab-item @(Model.ActiveTab == "Intern" ? "active" : "")" onclick="selectTab('Intern')">
            <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
            Intern
            <span class="tab-badge">Internship</span>
        </button>
    </div>

    <form method="post">
        <input type="hidden" id="activeTabInput" asp-for="ActiveTab" />

        <!-- Permanent Panel -->
        <div id="panel-Permanent" class="tab-panel @(Model.ActiveTab == "Permanent" ? "active" : "")">
            <div class="policy-banner">
                <strong>Permanent Staff Policy:</strong> Confirmed employees receive standard annual leave entitlement with full access to recreation, medical, and overseas leave options.
            </div>
            <div class="settings-card">
                <div style="display: flex; flex-direction: column; gap: 4px;">
                    @for (int i = 0; i < Model.PermanentAllocations.Count; i++)
                    {
                        <div class="allocation-row">
                            <div class="allocation-info">
                                <span class="allocation-name">@Model.PermanentAllocations[i].LeaveType Leave</span>
                                <span class="allocation-desc">@GetLeaveDescription(Model.PermanentAllocations[i].LeaveType)</span>
                            </div>
                            <div class="allocation-input-group">
                                <input type="hidden" asp-for="PermanentAllocations[i].LeaveType" />
                                <input type="number" asp-for="PermanentAllocations[i].DefaultDays" class="days-input" min="0" max="365" required />
                                <span class="days-label">Days</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Probationary Panel -->
        <div id="panel-Probationary" class="tab-panel @(Model.ActiveTab == "Probationary" ? "active" : "")">
            <div class="policy-banner">
                <strong>Probationary Staff Policy:</strong> Employees under evaluation during their initial probation period. Typically allocated casual and medical leaves without annual recreation entitlement.
            </div>
            <div class="settings-card">
                <div style="display: flex; flex-direction: column; gap: 4px;">
                    @for (int i = 0; i < Model.ProbationaryAllocations.Count; i++)
                    {
                        <div class="allocation-row">
                            <div class="allocation-info">
                                <span class="allocation-name">@Model.ProbationaryAllocations[i].LeaveType Leave</span>
                                <span class="allocation-desc">@GetLeaveDescription(Model.ProbationaryAllocations[i].LeaveType)</span>
                            </div>
                            <div class="allocation-input-group">
                                <input type="hidden" asp-for="ProbationaryAllocations[i].LeaveType" />
                                <input type="number" asp-for="ProbationaryAllocations[i].DefaultDays" class="days-input" min="0" max="365" required />
                                <span class="days-label">Days</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Intern Panel -->
        <div id="panel-Intern" class="tab-panel @(Model.ActiveTab == "Intern" ? "active" : "")">
            <div class="policy-banner">
                <strong>Intern Staff Policy:</strong> Students or trainees on internship assignments. Allocated short-term casual, exam, and emergency leave allowances.
            </div>
            <div class="settings-card">
                <div style="display: flex; flex-direction: column; gap: 4px;">
                    @for (int i = 0; i < Model.InternAllocations.Count; i++)
                    {
                        <div class="allocation-row">
                            <div class="allocation-info">
                                <span class="allocation-name">@Model.InternAllocations[i].LeaveType Leave</span>
                                <span class="allocation-desc">@GetLeaveDescription(Model.InternAllocations[i].LeaveType)</span>
                            </div>
                            <div class="allocation-input-group">
                                <input type="hidden" asp-for="InternAllocations[i].LeaveType" />
                                <input type="number" asp-for="InternAllocations[i].DefaultDays" class="days-input" min="0" max="365" required />
                                <span class="days-label">Days</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Save Button -->
        <button type="submit" class="btn-save">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                <polyline points="17 21 17 13 7 13 7 21"></polyline>
                <polyline points="7 3 7 8 15 8"></polyline>
            </svg>
            Save & Synchronize All Allocations
        </button>
    </form>
</div>

@functions {
    string GetLeaveDescription(string leaveType) => leaveType switch
    {
        "Annual"      => "Standard annual leave granted for rest and recreation.",
        "Casual"      => "Used for unexpected private matters or short illness.",
        "Medical"     => "Used for sickness, recovery, and healthcare appointments.",
        "Maternity"   => "Leave for female employees during childbirth and neonatal care.",
        "Overseas"    => "Granted for approved international travel and training.",
        "Exam"        => "Allocated for academic, higher studies, or professional examinations.",
        "Bereavement" => "Granted during the death of an immediate family member.",
        _             => "Other miscellaneous and special duty leaves."
    };
}

@section Scripts {
    <script>
        function selectTab(tabName) {
            document.getElementById('activeTabInput').value = tabName;

            document.querySelectorAll('.tab-item').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-panel').forEach(panel => panel.classList.remove('active'));

            const activeBtn = Array.from(document.querySelectorAll('.tab-item')).find(b => b.textContent.includes(tabName));
            if (activeBtn) activeBtn.classList.add('active');

            const activePanel = document.getElementById('panel-' + tabName);
            if (activePanel) activePanel.classList.add('active');
        }
    </script>
}
