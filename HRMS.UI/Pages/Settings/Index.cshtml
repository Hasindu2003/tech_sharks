@page
@model HRMS.UI.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "System Settings";
    ViewData["PageTitle"] = "Settings";
    ViewData["ActiveNav"] = "Settings";
}

@section Styles {
    <style>
        :root {
            --primary-green: #10823c;
            --bg-light: #f6f8f7;
            --border-color: #e2e5dc;
            --text-main: #151811;
            --text-muted: #7a8863;
        }

        .dashboard-container {
            position: relative;
        }

        .main-content {
            background-color: white;
            padding: 26px;
            min-height: calc(100vh - 62px);
        }

        .page-header {
            margin-bottom: 24px;
        }

        .page-header h2 {
            font-size: 20px;
            font-weight: 800;
            color: var(--text-main);
            margin-bottom: 4px;
        }

        .page-header p {
            font-size: 13px;
            color: var(--text-muted);
        }

        .settings-grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); 
            gap: 20px; 
            margin-top: 16px; 
        }

        .setting-card { 
            background: white; 
            border-radius: 10px; 
            padding: 20px; 
            border: 1px solid var(--border-color);
            text-decoration: none; 
            color: inherit; 
            display: block; 
            transition: all 0.2s ease;
        }

        .setting-card:hover { 
            border-color: var(--primary-green);
            background: #fcfdfc;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(16,130,60,0.08); 
        }

        .setting-icon { 
            width: 44px; 
            height: 44px; 
            border-radius: 8px; 
            background: rgba(16,130,60,0.08); 
            color: var(--primary-green); 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            margin-bottom: 16px; 
        }

        .setting-icon svg { 
            width: 22px; 
            height: 22px; 
            stroke: currentColor; 
            fill: none; 
        }

        .setting-title { 
            font-size: 15px; 
            font-weight: 700; 
            color: var(--text-main); 
            margin-bottom: 6px; 
        }

        .setting-desc { 
            font-size: 13px; 
            color: var(--text-muted); 
            line-height: 1.5; 
        }
    </style>
}

<div class="dashboard-container">
    <div class="main-content">
        <div class="page-header">
            <h2>System Settings</h2>
            <p>Manage your organization's core structures.</p>
        </div>

        <div class="settings-grid">
            @if (User.IsInRole("Admin"))
            {
                <a href="/Settings/Branches" class="setting-card">
                    <div class="setting-icon">
                        <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 10V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l2-1.14"/>
                            <path d="M16.5 9.4 7.55 4.24"/>
                            <polyline points="3.29 7 12 12 20.71 7"/>
                            <line x1="12" y1="22" x2="12" y2="12"/>
                            <circle cx="18" cy="18" r="3"/>
                        </svg>
                    </div>
                    <div class="setting-title">Branches</div>
                    <div class="setting-desc">Administer company locations across the country.</div>
                </a>
            }

            <a href="/Settings/Departments" class="setting-card">
                <div class="setting-icon">
                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
                        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                    </svg>
                </div>
                <div class="setting-title">Departments</div>
                <div class="setting-desc">Manage grouped business units and functions.</div>
            </a>

            @if (User.IsInRole("Admin"))
            {
                <a href="/Settings/Designations" class="setting-card">
                    <div class="setting-icon">
                        <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                            <circle cx="12" cy="12" r="1.5"/>
                        </svg>
                    </div>
                    <div class="setting-title">Designations</div>
                    <div class="setting-desc">Define standard global job titles and roles.</div>
                </a>

                <a href="/Admin/DutyAccounts" class="setting-card">
                    <div class="setting-icon">
                        <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
                            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                        </svg>
                    </div>
                    <div class="setting-title">Duty Accounts</div>
                    <div class="setting-desc">Create and manage position accounts for HR Managers, Area Managers, and Branch Managers.</div>
                </a>

                <a href="/Settings/LeaveAllocations" class="setting-card">
                    <div class="setting-icon">
                        <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                            <line x1="16" y1="2" x2="16" y2="6"/>
                            <line x1="8" y1="2" x2="8" y2="6"/>
                            <line x1="3" y1="10" x2="21" y2="10"/>
                        </svg>
                    </div>
                    <div class="setting-title">Leave Allocations</div>
                    <div class="setting-desc">Manually configure the annual allocations for leave categories (Annual, Casual, Medical, etc.).</div>
                </a>
            }
        </div>
    </div>
</div>
