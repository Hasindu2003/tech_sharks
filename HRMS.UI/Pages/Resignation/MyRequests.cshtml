@page
@model HRMS.UI.Pages.Resignation.MyRequestsModel
@{
    ViewData["Title"] = "My Resignation Requests";
}

<div class="page-header">
    <div>
        <h1 class="page-title">My Resignation Requests</h1>
        <p class="page-subtitle">Track the status of your resignation submissions.</p>
    </div>
    <a asp-page="/Resignation/Apply" class="btn-primary-action">
        <i class="bi bi-plus-lg me-2"></i>New Resignation
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

@if (!Model.Requests.Any())
{
    <div class="k-empty-state">
        <i class="bi bi-file-earmark-text"></i>
        <h3>No resignation requests found</h3>
        <p>You haven't submitted any resignation requests yet.</p>
        <a asp-page="/Resignation/Apply" class="btn-primary-action mt-3">Submit a Resignation</a>
    </div>
}
else
{
    <div class="k-card">
        <div class="table-responsive">
            <table class="k-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Submitted</th>
                        <th>Last Working Day</th>
                        <th>Notice (Days)</th>
                        <th>Status</th>
                        <th>Documents</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var req in Model.Requests)
                    {
                        <tr>
                            <td><span class="fw-semibold">#@req.Id</span></td>
                            <td>@req.ResignationDate.ToString("dd MMM yyyy")</td>
                            <td>@req.EffectiveDate.ToString("dd MMM yyyy")</td>
                            <td>@req.NoticePeriodDays</td>
                            <td><span class="k-badge @req.StatusBadgeClass">@req.StatusDisplay</span></td>
                            <td><span class="k-badge k-badge-info">@req.DocumentCount file(s)</span></td>
                            <td>
                                <a asp-page="/Resignation/Details" asp-route-id="@req.Id" class="btn-icon-sm" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (req.Status == ResignationStatusEnum.HRApproved && req.AcceptanceLetterGenerated)
                                {
                                    <a asp-page="/Resignation/AcceptanceLetter" asp-route-id="@req.Id" class="btn-icon-sm text-success" title="View Acceptance Letter">
                                        <i class="bi bi-file-earmark-check"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
