@page
@model HRMS.UI.Pages.Resignation.ApplyModel
@{
    ViewData["Title"] = "Submit Resignation";
}

<style>
    .page-h { font-size: 19px; font-weight: 800; color: #151811; margin: 0 0 3px 0; }
    .page-s { font-size: 12px; color: #7a8863; margin: 0 0 22px 0; }
    .form-section { background: white; border: 1px solid #e2e5dc; border-radius: 10px; padding: 20px 22px; margin-bottom: 16px; box-shadow: 0 1px 2px rgba(0,0,0,.05); }
    .fst { font-size: 12px; font-weight: 700; color: #7a8863; text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 16px 0; padding-bottom: 12px; border-bottom: 1px solid #e2e5dc; }
    .fg { margin-bottom: 14px; }
    .fg:last-child { margin-bottom: 0; }
    .fl { font-size: 13px; font-weight: 600; color: #151811; margin-bottom: 5px; display: block; }
    .fi { width: 100%; padding: 9px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 14px; color: #151811; font-family: 'Manrope', sans-serif; background: #fff; box-sizing: border-box; }
    .fi:focus { outline: none; border-color: #10823c; box-shadow: 0 0 0 2px rgba(16,130,60,.1); }
    .fi-hint { font-size: 11px; color: #7a8863; margin-top: 4px; display: block; }
    .ir { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid #f3f4f6; font-size: 14px; }
    .ir:last-child { border-bottom: none; padding-bottom: 0; }
    .ik { font-size: 12px; font-weight: 600; color: #7a8863; }
    .iv { font-weight: 600; color: #151811; }
    .divider-label { font-size: 12px; font-weight: 700; color: #7a8863; text-transform: uppercase; letter-spacing: 0.06em; margin: 16px 0 10px 0; padding-top: 14px; border-top: 1px solid #e2e5dc; }
    .req { color: #ef4444; }
    .btn-create { background: #10823c; color: white; padding: 10px 20px; border-radius: 6px; font-size: 13px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; border: none; cursor: pointer; }
    .btn-create:hover { background: #0d6e32; color: white; }
    .btn-outline { background: white; color: #151811; padding: 10px 20px; border-radius: 6px; font-size: 13px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; border: 1px solid #e2e5dc; }
    .btn-outline:hover { background: #f9fafb; color: #151811; }
    .error-banner { background: #fef2f2; color: #991b1b; padding: 14px 20px; border-radius: 10px; margin-bottom: 20px; font-size: 14px; font-weight: 600; border: 1px solid #fca5a5; }
    .notice-item { font-size: 13px; color: #7a8863; padding: 6px 0; display: flex; gap: 10px; align-items: flex-start; }
    .notice-num { width: 20px; height: 20px; border-radius: 50%; background: #e8f3ec; color: #10823c; font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px; }
    .warn-note { background: #fef3c7; border: 1px solid #fde68a; border-radius: 8px; padding: 12px 16px; margin-bottom: 12px; font-size: 13px; color: #92400e; font-weight: 600; }
</style>

<h2 class="page-h">Submit Resignation</h2>
<p class="page-s">Complete this form to initiate your resignation process.</p>

@if (TempData["ErrorMessage"] != null)
{
    <div class="error-banner">@TempData["ErrorMessage"]</div>
}

<div style="display:grid;grid-template-columns:300px 1fr;gap:16px;align-items:start">
    <!-- Left: Employee info + flow -->
    <div>
        <div class="form-section">
            <div class="fst">Your Details</div>
            <div class="ir"><span class="ik">Name</span><span class="iv">@Model.CurrentUser?.FullName</span></div>
            <div class="ir"><span class="ik">EPF No.</span><span class="iv">@Model.CurrentUser?.EpfNumber</span></div>
            <div class="ir"><span class="ik">Branch</span><span class="iv">@Model.CurrentUser?.Branch</span></div>
            <div class="ir"><span class="ik">Department</span><span class="iv">@Model.CurrentUser?.Department</span></div>
            <div class="ir"><span class="ik">Designation</span><span class="iv">@Model.CurrentUser?.Designation</span></div>
            <div class="ir"><span class="ik">Joined</span><span class="iv">@Model.CurrentUser?.DateOfJoining.ToString("MMM dd, yyyy")</span></div>
        </div>

        <div class="form-section">
            <div class="fst">Approval Flow</div>
            <div class="notice-item"><div class="notice-num">1</div><div>Branch Manager — Acknowledges</div></div>
            <div class="notice-item"><div class="notice-num">2</div><div>Area Manager — Reviews &amp; Approves</div></div>
            <div class="notice-item"><div class="notice-num">3</div><div>HR Manager — Final Approval</div></div>
        </div>
    </div>

    <!-- Right: Form -->
    <div>
        <div class="form-section">
            <div class="fst">Resignation Details</div>
            <form method="post" enctype="multipart/form-data" id="resignationForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="error-banner" style="display:none"></div>

                <div class="fg">
                    <label asp-for="Input.ReasonForResignation" class="fl">Reason for Resignation <span class="req">*</span></label>
                    <textarea asp-for="Input.ReasonForResignation" class="fi" rows="4"
                        placeholder="Please provide a detailed reason (minimum 20 characters)..."></textarea>
                    <span asp-validation-for="Input.ReasonForResignation" class="fi-hint" style="color:#ef4444"></span>
                </div>

                <div class="fg">
                    <label asp-for="Input.EffectiveDate" class="fl">Last Working Day <span class="req">*</span></label>
                    <input asp-for="Input.EffectiveDate" type="date" class="fi"
                           min="@DateTime.Today.AddDays(14).ToString("yyyy-MM-dd")" id="effectiveDateInput" />
                    <span asp-validation-for="Input.EffectiveDate" class="fi-hint" style="color:#ef4444"></span>
                    <span class="fi-hint">Minimum 14 days notice required. Notice period: <strong id="noticeDaysDisplay">—</strong></span>
                </div>

                <div class="fg">
                    <label asp-for="Input.AdditionalRemarks" class="fl">Additional Remarks</label>
                    <textarea asp-for="Input.AdditionalRemarks" class="fi" rows="2"
                        placeholder="Any additional information..."></textarea>
                </div>

                <div class="divider-label">Financial Obligations</div>
                <div class="fg">
                    <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer;margin-bottom:8px">
                        <input asp-for="Input.HasOutstandingLoans" class="form-check-input" type="checkbox" id="loansCheck" style="width:16px;height:16px;accent-color:#10823c" />
                        I have outstanding loan balances
                    </label>
                    <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer;margin-bottom:8px">
                        <input asp-for="Input.IsLoanGuarantor" class="form-check-input" type="checkbox" id="guarantorCheck" style="width:16px;height:16px;accent-color:#10823c" />
                        I am a guarantor for another employee's loan
                    </label>
                    <div id="overrideRow" style="display:none;">
                        <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer;color:#b45309">
                            <input asp-for="Input.HasOverridePermission" class="form-check-input" type="checkbox" style="width:16px;height:16px;accent-color:#f59e0b" />
                            Senior management override granted
                        </label>
                    </div>
                </div>
                <div class="fg" id="obligationDetailsRow" style="display:none;">
                    <label asp-for="Input.ObligationDetails" class="fl">Obligation Details</label>
                    <textarea asp-for="Input.ObligationDetails" class="fi" rows="2"
                        placeholder="Describe the obligations..."></textarea>
                </div>

                <div class="divider-label">Supporting Documents</div>
                <div class="fg" style="margin-bottom:20px">
                    <label class="fl">Attach Documents <span class="req">*</span></label>
                    <input asp-for="Input.Documents" type="file" class="fi" multiple
                           accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" style="padding:6px 12px" />
                    <span class="fi-hint">Accepted: PDF, DOC, DOCX, JPG, PNG. Max 5MB per file. At least one document required for submission.</span>
                </div>

                <div style="display:flex;gap:10px;flex-wrap:wrap">
                    <button type="submit" asp-page-handler="Submit" class="btn-create" id="submitBtn">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                        Submit Resignation
                    </button>
                    <button type="submit" asp-page-handler="SaveDraft" class="btn-outline">Save as Draft</button>
                    <a asp-page="/Resignation/MyRequests" class="btn-outline">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
    const effectiveDateInput = document.getElementById('effectiveDateInput');
    const noticeDaysDisplay = document.getElementById('noticeDaysDisplay');
    effectiveDateInput?.addEventListener('change', function () {
        const today = new Date(); today.setHours(0,0,0,0);
        const effective = new Date(this.value);
        if (!isNaN(effective)) {
            const days = Math.round((effective - today) / 86400000);
            noticeDaysDisplay.textContent = days + ' day' + (days !== 1 ? 's' : '');
        }
    });

    const loansCheck = document.getElementById('loansCheck');
    const guarantorCheck = document.getElementById('guarantorCheck');
    const overrideRow = document.getElementById('overrideRow');
    const obligationDetailsRow = document.getElementById('obligationDetailsRow');

    function updateObligationVisibility() {
        const hasObligation = loansCheck.checked || guarantorCheck.checked;
        overrideRow.style.display = hasObligation ? 'block' : 'none';
        obligationDetailsRow.style.display = hasObligation ? 'block' : 'none';
    }
    loansCheck?.addEventListener('change', updateObligationVisibility);
    guarantorCheck?.addEventListener('change', updateObligationVisibility);
    updateObligationVisibility();
</script>
}
