@page
@model HRMS.UI.Pages.Resignation.DetailsModel
@{
    ViewData["Title"] = $"Resignation Request #{Model.Request?.Id}";
    var r = Model.Request!;
}

<style>
    .back-link { color: #7a8863; font-size: 13px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; margin-bottom: 8px; }
    .back-link:hover { color: #10823c; }
    .page-h { font-size: 19px; font-weight: 800; color: #151811; margin: 0 0 6px 0; }
    .detail-card { background: white; border: 1px solid #e2e5dc; border-radius: 10px; padding: 20px 22px; margin-bottom: 16px; box-shadow: 0 1px 2px rgba(0,0,0,.05); }
    .dlt { font-size: 12px; font-weight: 700; color: #7a8863; text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 14px 0; padding-bottom: 10px; border-bottom: 1px solid #e2e5dc; }
    .ir { display: flex; justify-content: space-between; align-items: center; padding: 9px 0; border-bottom: 1px solid #f3f4f6; font-size: 14px; }
    .ir:last-child { border-bottom: none; }
    .ik { font-size: 12px; font-weight: 600; color: #7a8863; }
    .iv { font-weight: 500; color: #151811; }
    .k-badge, .status-badge { display: inline-flex; align-items: center; gap: 4px; padding: 2px 9px; border-radius: 9999px; font-size: 11.5px; font-weight: 700; border: 1px solid transparent; }
    .k-badge-pending  { background: #fef3c7; border-color: #fde68a; color: #b45309; }
    .k-badge-approved { background: #dcfce7; border-color: #bbf7d0; color: #10823c; }
    .k-badge-rejected { background: #fee2e2; border-color: #fecaca; color: #b91c1c; }
    /* Timeline */
    .timeline-wrap { display: flex; align-items: flex-start; gap: 0; overflow-x: auto; padding-bottom: 4px; }
    .tstep { flex: 1; display: flex; flex-direction: column; align-items: center; position: relative; min-width: 90px; }
    .tstep::before { content: ''; position: absolute; top: 13px; right: 50%; width: 100%; height: 2px; background: #e2e5dc; z-index: 0; }
    .tstep:first-child::before { display: none; }
    .tstep.done::before { background: #10823c; }
    .tstep-ic { width: 28px; height: 28px; border-radius: 50%; background: #f3f4f6; color: #7a8863; display: flex; align-items: center; justify-content: center; font-size: 12px; position: relative; z-index: 1; flex-shrink: 0; }
    .tstep.done .tstep-ic { background: #10823c; color: white; }
    .tstep-lbl { font-size: 11px; font-weight: 600; color: #151811; margin-top: 7px; text-align: center; }
    .tstep-date { font-size: 10px; color: #7a8863; text-align: center; }
    /* Review blocks */
    .review-block { padding: 14px 16px; border-radius: 8px; border: 1px solid #e2e5dc; margin-bottom: 10px; }
    .review-block:last-child { margin-bottom: 0; }
    .review-block.review-approved { background: #f0fdf4; border-color: #bbf7d0; }
    .review-block.review-rejected { background: #fef2f2; border-color: #fecaca; }
    .review-header { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; font-size: 13px; }
    /* Documents */
    .doc-row { display: flex; align-items: center; justify-content: space-between; padding: 9px 14px; background: #f9fafb; border: 1px solid #e2e5dc; border-radius: 8px; margin-bottom: 6px; font-size: 13px; }
    .doc-row:last-child { margin-bottom: 0; }
    .btn-action { color: #10823c; font-size: 13px; font-weight: 700; text-decoration: none; padding: 5px 10px; border-radius: 5px; transition: background .2s; }
    .btn-action:hover { background: #e8f3ec; }
    .btn-create { background: #10823c; color: white; padding: 9px 17px; border-radius: 6px; font-size: 13px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn-create:hover { background: #0d6e32; color: white; }
    .btn-outline { background: white; color: #151811; padding: 9px 17px; border-radius: 6px; font-size: 13px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; border: 1px solid #e2e5dc; }
    .btn-outline:hover { background: #f9fafb; color: #151811; }
    .letter-banner { background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 10px; padding: 16px 20px; display: flex; align-items: center; justify-content: space-between; }
</style>

<div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:4px;flex-wrap:wrap;gap:10px;">
    <div>
        @{
            var isDutyResign = User.IsInRole("Department Head") || User.IsInRole("Branch Manager") || User.IsInRole("Area Manager") || User.IsInRole("HR Manager") || User.IsInRole("HR Officer") || User.IsInRole("Admin");
            var backUrlResign = isDutyResign ? "/Separation/Dashboard?ActiveTab=Resignations" : "/Transfer/Separation?ActiveTab=Resignation";
        }
        <a href="@backUrlResign" class="back-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            Back
        </a>
        <h2 class="page-h">Resignation Request <span style="color:#10823c">#@r.Id</span></h2>
        <span class="k-badge @r.StatusBadgeClass">@r.StatusDisplay</span>
    </div>

    @if (r.Status == ResignationStatusEnum.Draft)
    {
        <div style="display:flex; gap:8px; align-items:center;">
            <a asp-page="/Resignation/EditDraft" asp-route-id="@r.Id" class="btn-create" style="padding:7px 14px; font-size:12.5px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                Edit Draft
            </a>
            <form method="post" asp-page-handler="DeleteDraft" asp-route-id="@r.Id" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this draft resignation? This action cannot be undone.');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-outline" style="padding:7px 14px; font-size:12.5px; background:#fee2e2; color:#b91c1c; border-color:#fecaca;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    Delete Draft
                </button>
            </form>
        </div>
    }
</div>

<!-- Approval Timeline -->
<div class="detail-card" style="margin-top:16px">
    <div class="dlt">Approval Timeline</div>
    @{
        (string label, string date, bool done)[] steps;

        if (r.IsManagerialNotification)
        {
            steps = new[] {
                ("1. Submitted (Manager Notice)", r.ResignationDate.ToString("dd MMM yyyy"), true),
                ("2. Seen by HR Manager", r.HRReviewDate?.ToString("dd MMM yyyy") ?? "Pending", r.Status >= ResignationStatusEnum.ManagerReviewed)
            };
        }
        else
        {
            var dhStatusDate = r.Status >= ResignationStatusEnum.DeptHeadsApproved 
                ? "Approved" 
                : (r.Status == ResignationStatusEnum.DeptHeadRejected 
                    ? "Rejected" 
                    : (r.TotalDeptHeadsCount > 0 ? $"{r.DeptHeadsApprovedCount}/{r.TotalDeptHeadsCount} Approved" : "Pending"));

            steps = new[] {
                ("1. Submitted", r.ResignationDate.ToString("dd MMM yyyy"), r.Status >= ResignationStatusEnum.SubmittedForApproval),
                ("2. Dept Heads", dhStatusDate, r.Status >= ResignationStatusEnum.DeptHeadsApproved),
                ("3. Branch Manager", r.BMReviewDate?.ToString("dd MMM yyyy") ?? (r.Status >= ResignationStatusEnum.DeptHeadsApproved ? "Pending" : "Waiting"), r.Status >= ResignationStatusEnum.BMApproved),
                ("4. Area Manager", r.AMReviewDate?.ToString("dd MMM yyyy") ?? (r.Status >= ResignationStatusEnum.BMApproved ? "Pending" : "Waiting"), r.Status >= ResignationStatusEnum.AMApproved),
                ("5. HR Officer", r.HRReviewDate?.ToString("dd MMM yyyy") ?? (r.Status >= ResignationStatusEnum.AMApproved ? "Pending" : "Waiting"), r.Status >= ResignationStatusEnum.HRApproved),
                ("6. Completed", r.AccountDeactivatedDate?.ToString("dd MMM yyyy") ?? (r.Status >= ResignationStatusEnum.HRApproved ? "Effective Date" : "Waiting"), r.Status == ResignationStatusEnum.Completed)
            };
        }
    }
    <div class="timeline-wrap">
        @foreach (var (label, date, done) in steps)
        {
            <div class="tstep @(done ? "done" : "")">
                <div class="tstep-ic">@(done ? "✓" : "·")</div>
                <div class="tstep-lbl">@label</div>
                <div class="tstep-date">@date</div>
            </div>
        }
    </div>
</div>

@if (r.IsManagerialNotification)
{
    <div style="background:#eff6ff;border:1px solid #bfdbfe;color:#1e40af;border-radius:8px;padding:12px 16px;margin-top:16px;font-size:13.5px;display:flex;align-items:flex-start;gap:10px">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-top:1px;flex-shrink:0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
        <div>
            <strong>Administrative Notice:</strong> This resignation request is an informational notice submitted by a managerial employee. Marking as reviewed confirms it has been seen by the HR Manager. Any subsequent resignation proceedings, exit clearances, and official documentation will take place outside of this system.
        </div>
    </div>
}

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px">
    <!-- Employee Details -->
    <div class="detail-card">
        <div class="dlt">Employee Details</div>
        <div class="ir"><span class="ik">Name</span><span class="iv">@r.EmployeeName</span></div>
        <div class="ir"><span class="ik">EPF No.</span><span class="iv">@r.EpfNumber</span></div>
        <div class="ir"><span class="ik">Email</span><span class="iv" style="font-size:13px">@r.EmployeeEmail</span></div>
        <div class="ir"><span class="ik">Branch</span><span class="iv">@r.Branch</span></div>
        <div class="ir"><span class="ik">Department</span><span class="iv">@r.Department</span></div>
        <div class="ir"><span class="ik">Designation</span><span class="iv">@r.Designation</span></div>
    </div>

    <!-- Resignation Details -->
    <div class="detail-card">
        <div class="dlt">Resignation Details</div>
        <div class="ir"><span class="ik">Submitted On</span><span class="iv">@r.ResignationDate.ToString("dd MMM yyyy")</span></div>
        <div class="ir"><span class="ik">Last Working Day</span><span class="iv" style="color:#10823c;font-weight:700">@r.EffectiveDate.ToString("dd MMM yyyy")</span></div>
        <div class="ir"><span class="ik">Notice Period</span><span class="iv">@r.NoticePeriodDays days</span></div>
    </div>
</div>

<!-- Reason -->
<div class="detail-card">
    <div class="dlt">Reason for Resignation</div>
    <p style="font-size:14px;color:#374151;line-height:1.8;margin:0">@r.ReasonForResignation</p>
</div>

<!-- Review Comments -->
@if (r.DepartmentReviews.Any() || r.BMReview != null || r.AMReview != null || r.HRReview != null)
{
    <div class="detail-card">
        <div class="dlt">Approval & Review Feedback</div>

        <!-- Department Head Reviews -->
        @if (r.DepartmentReviews.Any())
        {
            <div style="margin-bottom:14px">
                <div style="font-size:12.5px;font-weight:700;color:#151811;margin-bottom:8px;display:flex;align-items:center;justify-content:space-between">
                    <span>Department Head Reviews (Branch)</span>
                    <span class="k-badge @(r.AreAllDeptHeadsApproved ? "k-badge-approved" : "k-badge-pending")">
                        @r.DeptHeadsApprovedCount/@r.TotalDeptHeadsCount Approved
                    </span>
                </div>
                @foreach (var dr in r.DepartmentReviews)
                {
                    var isApproved = dr.Status == "Approved";
                    var isRejected = dr.Status == "Rejected";
                    <div class="review-block @(isApproved ? "review-approved" : (isRejected ? "review-rejected" : ""))" style="margin-bottom:8px">
                        <div class="review-header" style="justify-content:space-between">
                            <div style="display:flex;align-items:center;gap:8px">
                                <strong>@dr.DepartmentName Dept Head</strong>
                                @if (isApproved)
                                {
                                    <span class="k-badge k-badge-approved"><i class="bi bi-check"></i> Approved</span>
                                }
                                else if (isRejected)
                                {
                                    <span class="k-badge k-badge-rejected"><i class="bi bi-x"></i> Rejected</span>
                                }
                                else
                                {
                                    <span class="k-badge k-badge-pending"><i class="bi bi-hourglass-split"></i> Pending</span>
                                }
                            </div>
                            @if (dr.ReviewDate.HasValue)
                            {
                                <span style="font-size:11.5px;color:#7a8863">@dr.ReviewDate.Value.ToString("dd MMM yyyy HH:mm")</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(dr.ReviewerName))
                        {
                            <div style="font-size:12px;color:#7a8863;margin-bottom:2px">Reviewer: @dr.ReviewerName</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(dr.Comments))
                        {
                            <p style="margin:4px 0 0;font-size:13px;color:#374151">"@dr.Comments"</p>
                        }
                    </div>
                }
            </div>
        }

        @if (r.BMReview != null)
        {
            <div class="review-block @(r.BMReview == "Approved" ? "review-approved" : "review-rejected")">
                <div class="review-header">
                    <strong>Branch Manager</strong>
                    <span class="k-badge @(r.BMReview == "Approved" ? "k-badge-approved" : "k-badge-rejected")">@r.BMReview</span>
                    <span style="font-size:12px;color:#7a8863">@r.BMReviewDate?.ToString("dd MMM yyyy HH:mm")</span>
                </div>
                <p style="margin:0;font-size:13px;color:#374151">@r.BMComments</p>
            </div>
        }
        @if (r.AMReview != null)
        {
            <div class="review-block @(r.AMReview == "Approved" ? "review-approved" : "review-rejected")">
                <div class="review-header">
                    <strong>Area Manager</strong>
                    <span class="k-badge @(r.AMReview == "Approved" ? "k-badge-approved" : "k-badge-rejected")">@r.AMReview</span>
                    <span style="font-size:12px;color:#7a8863">@r.AMReviewDate?.ToString("dd MMM yyyy HH:mm")</span>
                </div>
                <p style="margin:0;font-size:13px;color:#374151">@r.AMComments</p>
            </div>
        }
        @if (r.HRReview != null)
        {
            <div class="review-block @(r.HRReview == "Approved" || r.HRReview == "Reviewed" || r.Status == ResignationStatusEnum.ManagerReviewed ? "review-approved" : "review-rejected")">
                <div class="review-header">
                    <strong>HR Officer / HR Manager</strong>
                    <span class="k-badge @(r.HRReview == "Approved" || r.HRReview == "Reviewed" || r.Status == ResignationStatusEnum.ManagerReviewed ? "k-badge-approved" : "k-badge-rejected")">
                        @(r.HRReview == "Reviewed" || r.Status == ResignationStatusEnum.ManagerReviewed ? "Reviewed (Notice)" : r.HRReview)
                    </span>
                    <span style="font-size:12px;color:#7a8863">@r.HRReviewDate?.ToString("dd MMM yyyy HH:mm")</span>
                </div>
                <p style="margin:0;font-size:13px;color:#374151">@r.HRComments</p>
            </div>
        }
    </div>
}

<!-- Documents -->
@if (r.Documents.Any())
{
    <div class="detail-card">
        <div class="dlt">Supporting Documents</div>
        @foreach (var doc in r.Documents)
        {
            <div class="doc-row">
                <span style="font-weight:600">@doc.FileName</span>
                <a asp-page="/Resignation/DownloadDocument" asp-route-id="@doc.Id" class="btn-action">Download</a>
            </div>
        }
    </div>
}
