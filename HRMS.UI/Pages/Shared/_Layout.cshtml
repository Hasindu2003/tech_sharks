@inject HRMS.UI.Services.INotificationService NotificationService
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kanrich HRMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Sidebar -->
        <aside class="sidebar">
            <a class="sidebar-brand" asp-page="/Index">
                <div class="brand-icon">K</div>
                <div class="brand-text">
                    <span class="brand-title">Kanrich HRMS</span>
                    <span class="brand-subtitle">Admin Portal</span>
                </div>
            </a>

            <nav class="sidebar-nav">
                <div class="nav-section-label">Main</div>

                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")"
                   asp-page="/Index">
                    <i class="bi bi-grid-1x2"></i> Dashboard
                </a>

                @if (User.IsInRole("Employee") || User.IsInRole("Branch Manager") || User.IsInRole("HR Manager"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Employee/Profile" ? "active" : "")"
                       asp-page="/Employee/Profile">
                        <i class="bi bi-people"></i> Employees
                    </a>
                }

                <a class="nav-link" href="#">
                    <i class="bi bi-mortarboard"></i> Training
                </a>

                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("Notifications") == true ? "active" : "")"
                   asp-page="/Transfer/Notifications">
                    <i class="bi bi-bell"></i> Notifications
                    @{
                        var notifEmail = User.Identity?.Name ?? "";
                        var sidebarUnread = await NotificationService.GetUnreadCountAsync(notifEmail);
                    }
                    @if (sidebarUnread > 0)
                    {
                        <span class="sidebar-notif-badge">@(sidebarUnread > 99 ? "99+" : sidebarUnread.ToString())</span>
                    }
                </a>

                <a class="nav-link" href="#">
                    <i class="bi bi-calendar3"></i> Calendar
                </a>

                @if (User.IsInRole("Employee"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("Transfer/") == true ? "active" : "")"
                       asp-page="/Transfer/Separation">
                        <i class="bi bi-clipboard-check"></i> Separation
                    </a>
                }

                @if (User.IsInRole("Branch Manager"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("BranchManager") == true || ViewContext.RouteData.Values["page"]?.ToString()?.Contains("Transfer/") == true ? "active" : "")"
                       asp-page="/BranchManager/ReviewTransfers">
                        <i class="bi bi-clipboard-check"></i> Separation
                    </a>
                }

                @if (User.IsInRole("HR Manager"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("HRManager") == true ? "active" : "")"
                       asp-page="/HRManager/ReviewTransfers">
                        <i class="bi bi-clipboard2-check"></i> Separation
                    </a>
                }

                @if (User.IsInRole("Area Manager"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("AreaManager") == true ? "active" : "")"
                       asp-page="/AreaManager/ReviewTransfers">
                        <i class="bi bi-clipboard2-check"></i> Separation
                    </a>
                }
            </nav>

            <div class="sidebar-footer">
                <form method="post" asp-page="/Account/Logout">
                    <button type="submit" class="btn-logout">
                        <i class="bi bi-box-arrow-left"></i> Log Out
                    </button>
                </form>
            </div>
        </aside>

        <!-- Top Bar -->
        <header class="topbar">
            <div class="topbar-title">@ViewData["Title"]</div>
            <div class="topbar-actions">
                @{
                    var bellEmail = User.Identity?.Name ?? "";
                    var unreadCount = await NotificationService.GetUnreadCountAsync(bellEmail);
                }
                <a asp-page="/Transfer/Notifications" class="icon-btn notification-bell" title="Notifications">
                    <i class="bi bi-bell"></i>
                    @if (unreadCount > 0)
                    {
                        <span class="notification-badge">@(unreadCount > 9 ? "9+" : unreadCount.ToString())</span>
                    }
                </a>
                <span class="icon-btn"><i class="bi bi-gear"></i></span>
                <div class="topbar-avatar" title="@User.Identity?.Name">
                    @{
                        var initials = User.Identity?.Name?.Split("@")[0]?.Substring(0, Math.Min(2, User.Identity?.Name?.Split("@")[0]?.Length ?? 0)).ToUpper() ?? "U";
                    }
                    @initials
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main class="main-content">
            @RenderBody()
        </main>
    }
    else
    {
        <!-- Unauthenticated: render body directly (login page handles its own layout) -->
        @RenderBody()
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>