@{
    // Pages set ViewData["ActiveNav"] to highlight the current nav item.
    // e.g. ViewData["ActiveNav"] = "Calendar";
    var activeNav = ViewData["ActiveNav"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Kanrich HRMS</title>
    <link rel="icon" type="image/png" href="/images/logo-title.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        html, body {
            height: 100%;
            font-family: 'Manrope', sans-serif;
            background: #f6f8f7;
            color: #151811;
        }

        /* ── LAYOUT ── */
        .app-shell { display: flex; height: 100vh; overflow: hidden; }

        /* ── SIDEBAR ── */
        .sidebar {
            width: 220px; min-width: 220px;
            background: #ffffff;
            border-right: 1px solid #e2e5dc;
            display: flex; flex-direction: column;
            justify-content: space-between;
            overflow: hidden;
        }
        .sidebar-top { padding: 16px 14px 18px; }
        .sidebar-brand { margin-bottom: 24px; }
        .sidebar-brand-title { font-size: 14px; font-weight: 700; color: #151811; line-height: 20px; }
        .sidebar-brand-sub  { font-size: 11px; font-weight: 400; color: #7a8863; line-height: 16px; }

        .nav-list { list-style: none; display: flex; flex-direction: column; gap: 3px; }
        .nav-item a {
            display: flex; align-items: center; gap: 9px;
            padding: 8px 11px; border-radius: 7px;
            text-decoration: none; font-size: 13px; font-weight: 500; color: #151811;
            transition: background 0.15s;
        }
        .nav-item a:hover { background: #f6f8f7; }
        .nav-item.active a { background: rgba(16,130,60,.1); color: #10823c; font-weight: 700; }
        .nav-icon { flex-shrink: 0; width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; color: inherit; }
        .nav-icon svg { width: 18px; height: 18px; stroke: currentColor; fill: none; }

        .sidebar-bottom { padding: 16px 14px; }
        .btn-logout {
            display: flex; align-items: center; justify-content: center;
            width: 100%; height: 36px;
            background: #10823c; color: #ffffff; border: none; border-radius: 7px;
            font-family: 'Manrope', sans-serif; font-size: 12px; font-weight: 700;
            cursor: pointer; text-decoration: none; transition: background 0.2s;
        }
        .btn-logout:hover { background: #0d6e32; color: #fff; }

        /* ── MAIN COLUMN ── */
        .main-col { flex: 1; display: flex; flex-direction: column; overflow: hidden; min-width: 0; }

        /* ── TOPBAR ── */
        .topbar {
            background: #ffffff; border-bottom: 1px solid #e2e5dc;
            padding: 10px 26px; display: flex; align-items: center; gap: 16px;
            flex-shrink: 0; z-index: 10;
        }
        .topbar-logo   { height: 34px; width: auto; flex-shrink: 0; }
        .topbar-title  { flex: 1; text-align: center; font-size: 16px; font-weight: 700; color: #151811; letter-spacing: -0.2px; }
        .topbar-right  { display: flex; align-items: center; gap: 7px; }

        .icon-btn {
            position: relative; width: 36px; height: 36px;
            background: #f6f8f7; border: none; border-radius: 7px;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; transition: background 0.15s;
        }
        .icon-btn:hover { background: #e2e5dc; }
        .icon-btn svg  { width: 18px; height: 18px; stroke: #151811; fill: none; }
        .notif-dot {
            position: absolute; top: 6px; right: 6px;
            width: 7px; height: 7px;
            background: #ef4444; border: 1px solid #fff; border-radius: 50%;
        }
        .avatar {
            width: 36px; height: 36px; border-radius: 50%;
            background: linear-gradient(135deg, #10823c, #0d6e32);
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 12px; font-weight: 700;
            box-shadow: 0 0 0 2px rgba(16,130,60,.2); cursor: pointer;
        }

        /* ── PAGE CONTENT ── */
        .page-content { flex: 1; overflow: auto; background: #ffffff; padding: 26px; }

        /* Remove double-padding from legacy containers from Main */
        .page-content .main-content,
        .page-content .dash-wrap,
        .page-content .edit-shell,
        .page-content > div[style*="padding: 26px"] {
            padding: 0 !important;
            background: transparent !important;
            min-height: auto !important;
        }

        /* ── NOTIFICATIONS DROPDOWN ── */
        .notif-wrapper { position: relative; }
        .notif-dropdown {
            position: absolute; top: calc(100% + 10px); right: -10px; width: 340px;
            background: #fff; border: 1px solid #e2e8f0; border-radius: 12px;
            box-shadow: 0 10px 40px -10px rgba(0,0,0,0.15);
            display: none; flex-direction: column; z-index: 100;
            overflow: hidden; opacity: 0; transform: translateY(-5px);
            transition: opacity 0.2s, transform 0.2s;
        }
        .notif-dropdown.open { display: flex; opacity: 1; transform: translateY(0); }
        .notif-head {
            padding: 14px 18px; border-bottom: 1px solid #f1f5f9;
            display: flex; justify-content: space-between; align-items: center;
        }
        .notif-head h4 { font-size: 14px; font-weight: 700; color: #0f172a; }
        .notif-markall { font-size: 12px; font-weight: 600; color: #10823c; background: none; border: none; cursor: pointer; }
        .notif-markall:hover { color: #0d6e32; text-decoration: underline; }
        
        .notif-body { max-height: 380px; overflow-y: auto; background: #f8fafc; }
        .notif-empty { padding: 40px 20px; text-align: center; color: #94a3b8; font-size: 13px; font-weight: 600; }
        .notif-item {
            padding: 14px 18px; border-bottom: 1px solid #e2e8f0;
            display: block; text-decoration: none; background: #fff; transition: background 0.15s;
        }
        .notif-item:hover { background: #f1f5f9; }
        .notif-item-title { font-size: 13px; font-weight: 700; color: #0f172a; margin-bottom: 4px; }
        .notif-item-msg { font-size: 12px; color: #64748b; line-height: 1.4; margin-bottom: 8px; }
        .notif-item-time { font-size: 11px; font-weight: 700; color: #10823c; }

        .notif-dot {
            position: absolute; top: 4px; right: 4px;
            min-width: 16px; height: 16px; padding: 0 4px;
            background: #ef4444; color: #fff;
            border: 2px solid #fff; border-radius: 999px;
            font-size: 9px; font-weight: 800; font-family: sans-serif;
            display: flex; align-items: center; justify-content: center;
        }
        .notif-dot.hidden { display: none; }

        /* ── Shared Table Pagination ── */
        .tbl-pg-bar {
            display: flex; justify-content: space-between; align-items: center;
            padding: 12px 18px; border-top: 1px solid #e2e5dc;
            background: #f9fafb; font-family: 'Manrope', sans-serif;
        }
        .tbl-pg-info { font-size: 13px; color: #7a8863; }
        .tbl-pg-btns { display: flex; gap: 6px; align-items: center; }
        .pg-btn {
            padding: 4px 10px; border-radius: 5px; border: 1px solid #e2e5dc;
            background: white; font-size: 13px; color: #151811; cursor: pointer;
            font-family: 'Manrope', sans-serif; text-decoration: none;
            display: inline-block; line-height: normal; transition: background 0.15s, border-color 0.15s;
        }
        .pg-btn:hover:not(:disabled) { background: #f0faf4; border-color: #10823c; color: #10823c; }
        .pg-btn.active { background: #10823c; color: white; border-color: #10823c; }
        .pg-btn:disabled { opacity: 0.45; cursor: not-allowed; }

        /* Collapsible Menu styling */
        .nav-item-collapsible {
            display: flex;
            flex-direction: column;
        }
        .nav-item-collapsible-trigger {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 11px;
            border-radius: 7px;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            color: #151811;
            cursor: pointer;
            transition: background 0.15s;
            user-select: none;
        }
        .nav-item-collapsible-trigger:hover {
            background: #f6f8f7;
        }
        .nav-item-collapsible.active-parent > .nav-item-collapsible-trigger {
            font-weight: 700;
            color: #10823c;
            background: rgba(16,130,60,.03);
        }
        .nav-item-collapsible-chevron {
            transition: transform 0.2s;
            font-size: 10px;
            color: #7a8863;
        }
        .nav-item-collapsible.open .nav-item-collapsible-chevron {
            transform: rotate(180deg);
        }
        .nav-item-collapsible-content {
            display: none;
            flex-direction: column;
            gap: 2px;
            padding-left: 12px;
            margin-top: 2px;
            border-left: 1.5px solid #e2e5dc;
            margin-left: 20px;
        }
        .nav-item-collapsible.open .nav-item-collapsible-content {
            display: flex;
        }
        .nav-item-sub a {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 10px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 12.5px;
            font-weight: 500;
            color: #4b5563;
            transition: background 0.15s, color 0.15s;
        }
        .nav-item-sub a:hover {
            background: #f6f8f7;
            color: #151811;
        }
        .nav-item-sub.active a {
            background: rgba(16,130,60,.08);
            color: #10823c;
            font-weight: 600;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<div class="app-shell">

    <!-- ── SIDEBAR ── -->
    <aside class="sidebar">
        <div class="sidebar-top">
            <div class="sidebar-brand">
                <div class="sidebar-brand-title">Kanrich HRMS</div>
                <div class="sidebar-brand-sub">
                    @if (User.IsInRole("Admin")) { <text>Admin Portal</text> }
                    else if (User.IsInRole("HR Manager")) { <text>HR Manager Portal</text> }
                    else if (User.IsInRole("Area Manager")) { <text>Area Manager Portal</text> }
                    else if (User.IsInRole("Branch Manager")) { <text>Branch Manager Portal</text> }
                    else if (User.IsInRole("Department Head")) { <text>Department Head Portal</text> }
                    else { <text>Employee Portal</text> }
                </div>
            </div>
            <nav>
                <ul class="nav-list">
                    <li class="nav-item @(activeNav == "Dashboard" ? "active" : "")">
                        <a href="/Index">
                            <span class="nav-icon">
                                <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                                    <rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
                                </svg>
                            </span>
                            Dashboard
                        </a>
                    </li>
                    @if (!User.IsInRole("Admin"))
                    {
                        <li class="nav-item @(activeNav == "Calendar" ? "active" : "")">
                            <a href="#">
                                <span class="nav-icon">
                                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                        <line x1="16" y1="2" x2="16" y2="6"/>
                                        <line x1="8" y1="2" x2="8" y2="6"/>
                                        <line x1="3" y1="10" x2="21" y2="10"/>
                                    </svg>
                                </span>
                                Calendar
                            </a>
                        </li>
                    }
                    @if (!User.IsInRole("Admin"))
                    {
                        <li class="nav-item @(activeNav == "Separation" ? "active" : "")">
                            @if (User.IsInRole("Branch Manager") || User.IsInRole("Area Manager") || User.IsInRole("HR Manager"))
                            {
                                <a href="/Separation/Dashboard">
                                    <span class="nav-icon">
                                        <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                            <circle cx="9" cy="7" r="4"/>
                                            <polyline points="17 11 19 13 23 9"/>
                                        </svg>
                                    </span>
                                    Separation
                                </a>
                            }
                            else if (User.IsInRole("Department Head"))
                            {
                                <a href="/DepartmentHead/ReviewTransfers">
                                    <span class="nav-icon">
                                        <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                            <circle cx="9" cy="7" r="4"/>
                                            <polyline points="17 11 19 13 23 9"/>
                                        </svg>
                                    </span>
                                    Separation
                                </a>
                            }
                            else
                            {
                                <a href="/Transfer/Separation">
                                    <span class="nav-icon">
                                        <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                            <circle cx="9" cy="7" r="4"/>
                                            <polyline points="17 11 19 13 23 9"/>
                                        </svg>
                                    </span>
                                    Separation
                                </a>
                            }
                        </li>

                        <li class="nav-item @(activeNav == "AttendanceDashboard" ? "active" : "")">
                            <a href="/Attendance/Dashboard">
                                <span class="nav-icon">
                                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10"/>
                                        <polyline points="12 6 12 12 16 14"/>
                                    </svg>
                                </span>
                                Attendance & Leave
                            </a>
                        </li>
                    }
                    
                    @if (User.IsInRole("HR Manager") || User.IsInRole("Area Manager") || User.IsInRole("Branch Manager"))

                    {
                        <li class="nav-item @(activeNav == "Employees" ? "active" : "")">
                            <a href="/Employees">
                                <span class="nav-icon">
                                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                        <circle cx="9" cy="7" r="4"/>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
                                    </svg>
                                </span>
                                Employees
                            </a>
                        </li>

                        <li class="nav-item @(activeNav == "Training" ? "active" : "")">
                            <a href="#">
                                <span class="nav-icon">
                                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                                        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                                    </svg>
                                </span>
                                Training
                            </a>
                        </li>
                        <li class="nav-item @(activeNav == "CVBank" ? "active" : "")">
                            <a href="#">
                                <span class="nav-icon">
                                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                        <polyline points="14 2 14 8 20 8"/>
                                        <line x1="16" y1="13" x2="8" y2="13"/>
                                        <line x1="16" y1="17" x2="8" y2="17"/>
                                        <polyline points="10 9 9 9 8 9"/>
                                    </svg>
                                </span>
                                CV Bank
                            </a>
                        </li>
                        <li class="nav-item @(activeNav == "Welfare" ? "active" : "")">
                            <a href="#">
                                <span class="nav-icon">
                                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                                    </svg>
                                </span>
                                Welfare
                            </a>
                        </li>
                    }


                </ul>

            </nav>
        </div>
        <div class="sidebar-bottom">
            <form method="post" action="/Account/Logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-logout">Log Out</button>
            </form>
        </div>
    </aside>

    <!-- ── MAIN COLUMN ── -->
    <div class="main-col">

        <!-- TOPBAR -->
        <header class="topbar">
            <img src="/images/logo.webp" alt="Kanrich Limited" class="topbar-logo" />
            <div class="topbar-title">@(ViewData["PageTitle"] ?? ViewData["Title"])</div>
            <div class="topbar-right">
                <div class="notif-wrapper" id="notifWrapper">
                    <button class="icon-btn" title="Notifications" id="btnNotifications" onclick="toggleNotifDropdown(event)">
                        <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                        </svg>
                        <span class="notif-dot hidden" id="notifBadge">0</span>
                    </button>
                    <!-- Dropdown -->
                    <div class="notif-dropdown" id="notifDropdown" onclick="event.stopPropagation()">
                        <div class="notif-head">
                            <h4>Notifications</h4>
                            <button class="notif-markall" id="notifMarkAll" onclick="markAllAsRead()">Mark all as read</button>
                        </div>
                        <div class="notif-body" id="notifList">
                            <div class="notif-empty">Loading...</div>
                        </div>
                        <div style="padding: 10px; border-top: 1px solid #f1f5f9; text-align: center; background: #fff;">
                            <a href="/Notifications" style="font-size: 13px; font-weight: 700; color: #10823c; text-decoration: none;">View all notifications</a>
                        </div>
                    </div>
                </div>
                @if (User.IsInRole("Admin"))
                {
                    <a href="/Settings" class="icon-btn" title="Settings" style="color: inherit;">
                        <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"/>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                        </svg>
                    </a>
                }
                
                @{
                    var roleText = User.IsInRole("Admin") ? "Admin" : 
                                  User.IsInRole("HR Manager") ? "HR Manager" : "Employee";
                    var userInitial = User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U";
                }
                <a href="/Profile" class="avatar" style="text-decoration: none;" title="View My Profile (@roleText)">@userInitial</a>
            </div>
        </header>

        <!-- PAGE CONTENT -->
        <div class="page-content">
            @RenderBody()
        </div>

    </div><!-- /main-col -->
</div><!-- /app-shell -->

<!-- Security Token for Javascript POSTs -->
@Html.AntiForgeryToken()

<script>
    // --- Notification System ---
    let notifDropdown = document.getElementById('notifDropdown');
    let notifWrapper = document.getElementById('notifWrapper');
    let dropIsOpen = false;

    // Toggle panel
    function toggleNotifDropdown(e) {
        e.stopPropagation();
        dropIsOpen = !dropIsOpen;
        if (dropIsOpen) {
            notifDropdown.classList.add('open');
            fetchNotifications(); // Refresh on open
        } else {
            notifDropdown.classList.remove('open');
        }
    }

    // Close on outside click
    document.addEventListener('click', function(e) {
        if (dropIsOpen && !notifWrapper.contains(e.target)) {
            dropIsOpen = false;
            notifDropdown.classList.remove('open');
        }
    });

    // Fetch and render
    async function fetchNotifications() {
        try {
            const resp = await fetch('/Api/Notifications');
            if (!resp.ok) return;

            const data = await resp.json();
            
            // Update Badge
            const badge = document.getElementById('notifBadge');
            if (data.unreadCount > 0) {
                badge.textContent = data.unreadCount > 99 ? '99+' : data.unreadCount;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }

            // Update List
            const list = document.getElementById('notifList');
            if (data.items.length === 0) {
                list.innerHTML = `<div class="notif-empty">You have no new notifications.</div>`;
            } else {
                let html = '';
                data.items.forEach(n => {
                    html += `
                        <a href="javascript:void(0)" onclick="clickNotification(${n.id}, '${n.targetUrl}')" class="notif-item">
                            <div class="notif-item-title">${n.title}</div>
                            <div class="notif-item-msg">${n.message}</div>
                            <div class="notif-item-time">${n.createdAt}</div>
                        </a>
                    `;
                });
                list.innerHTML = html;
            }
        } catch (e) { console.error('Error fetching notifications:', e); }
    }

    // Click Notification
    async function clickNotification(id, targetUrl) {
        // Mark as read in background, then navigate
        try {
            await fetch(`/Api/Notifications?handler=MarkAsRead&id=${id}`, { method: 'POST' });
        } catch(e) {}
        window.location.href = targetUrl;
    }

    // Mark all as read
    async function markAllAsRead() {
        try {
            const btn = document.getElementById('notifMarkAll');
            btn.textContent = "Marking...";
            await fetch('/Api/Notifications?handler=MarkAllAsRead', { method: 'POST' });
            btn.textContent = "Mark all as read";
            fetchNotifications();
            dropIsOpen = false;
            notifDropdown.classList.remove('open');
        } catch(e) {}
    }

    // Initialize polling every 45 secs
    document.addEventListener('DOMContentLoaded', () => {
        fetchNotifications();
        setInterval(fetchNotifications, 45000);
    });

    function toggleNavCollapsible(id) {
        const parent = document.getElementById(id);
        if (parent) {
            parent.classList.toggle('open');
        }
    }
</script>

<script>
function initTablePagination(tableId, initialPageSize) {
    var table = document.getElementById(tableId);
    if (!table) return;
    var tbody = table.querySelector('tbody');
    if (!tbody) return;
    
    var pageSize = initialPageSize || 10;
    var currentPage = 1;
    
    var bar = document.createElement('div');
    bar.className = 'tbl-pg-bar';
    table.insertAdjacentElement('afterend', bar);
    
    function render() {
        var dataRows = Array.from(tbody.querySelectorAll('tr')).filter(function(r) {
            return !r.classList.contains('empty-row');
        });
        
        var totalPages = Math.ceil(dataRows.length / pageSize);
        if (totalPages < 1) totalPages = 1;
        if (currentPage > totalPages) currentPage = totalPages;
        
        dataRows.forEach(function(row, i) {
            row.style.display = (i >= (currentPage-1)*pageSize && i < currentPage*pageSize) ? '' : 'none';
        });
        
        var start = (currentPage-1)*pageSize + 1;
        var end = Math.min(currentPage*pageSize, dataRows.length);
        
        bar.innerHTML = '';
        
        // 1. Info span
        var info = document.createElement('span');
        info.className = 'tbl-pg-info';
        info.textContent = 'Showing ' + start + '–' + end + ' of ' + dataRows.length;
        bar.appendChild(info);
        
        // 2. Page size selector dropdown
        var select = document.createElement('select');
        select.className = 'tbl-pg-select';
        select.style.cssText = 'margin-left: 12px; padding: 4px 8px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 12.5px; cursor: pointer; color: #374151; background: #fff; outline: none; font-family: inherit;';
        
        var sizes = [10, 20, 50, 100];
        sizes.forEach(function(sz) {
            var opt = document.createElement('option');
            opt.value = sz;
            opt.textContent = sz + ' / page';
            if (sz === pageSize) opt.selected = true;
            select.appendChild(opt);
        });
        
        select.onchange = function() {
            pageSize = parseInt(this.value, 10);
            currentPage = 1;
            render();
        };
        bar.appendChild(select);
        
        // 3. Button group container
        var btns = document.createElement('div');
        btns.className = 'tbl-pg-btns';
        
        // Prev button
        var prev = document.createElement('button');
        prev.className = 'pg-btn';
        prev.textContent = '← Prev';
        prev.disabled = currentPage <= 1;
        prev.onclick = function(e) {
            e.preventDefault();
            if (currentPage > 1) {
                currentPage--;
                render();
            }
        };
        btns.appendChild(prev);
        
        // Page numbers with smart ellipsis truncation
        var pageNumbers = [];
        if (totalPages <= 7) {
            for (var i = 1; i <= totalPages; i++) pageNumbers.push(i);
        } else {
            pageNumbers.push(1);
            
            var startP = Math.max(2, currentPage - 1);
            var endP = Math.min(totalPages - 1, currentPage + 1);
            
            if (currentPage <= 4) {
                endP = 5;
            } else if (currentPage >= totalPages - 3) {
                startP = totalPages - 4;
            }
            
            if (startP > 2) {
                pageNumbers.push('...');
            }
            
            for (var i = startP; i <= endP; i++) {
                pageNumbers.push(i);
            }
            
            if (endP < totalPages - 1) {
                pageNumbers.push('...');
            }
            
            pageNumbers.push(totalPages);
        }
        
        pageNumbers.forEach(function(p) {
            if (p === '...') {
                var el = document.createElement('span');
                el.className = 'tbl-pg-ellipsis';
                el.textContent = '...';
                el.style.cssText = 'padding: 6px 12px; font-size: 13px; color: #9ca3af; display: inline-block; font-weight: 500; user-select: none;';
                btns.appendChild(el);
            } else {
                var btn = document.createElement('button');
                btn.className = 'pg-btn' + (p === currentPage ? ' active' : '');
                btn.textContent = p;
                btn.onclick = function(e) {
                    e.preventDefault();
                    currentPage = p;
                    render();
                };
                btns.appendChild(btn);
            }
        });
        
        // Next button
        var next = document.createElement('button');
        next.className = 'pg-btn';
        next.textContent = 'Next →';
        next.disabled = currentPage >= totalPages;
        next.onclick = function(e) {
            e.preventDefault();
            if (currentPage < totalPages) {
                currentPage++;
                render();
            }
        };
        btns.appendChild(next);
        
        bar.appendChild(btns);
    }
    
    render();
}
</script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>