<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HRMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HRMS.UI.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: { primary: "#10823c" },
                    fontFamily: { display: "Manrope" }
                }
            },
            corePlugins: { preflight: false }  // keeps Bootstrap styles intact
        };
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24;
            font-family: 'Material Symbols Outlined';
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-page="/Index">
                    <i class="bi bi-building me-1"></i> HRMS
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @* ── Employee Navigation ── *@
                            @if (User.IsInRole("Employee"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-page="/Welfare/RequestForm">
                                        <i class="bi bi-file-earmark-plus me-1"></i>New Request
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-page="/Welfare/RequestList">
                                        <i class="bi bi-list-ul me-1"></i>My Requests
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-page="/Welfare/StatusTracking">
                                        <i class="bi bi-clock-history me-1"></i>Status Tracking
                                    </a>
                                </li>
                            }

                            @* ── BranchDGM Navigation ── *@
                            @if (User.IsInRole("BranchDGM"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-page="/Welfare/Approvals/BranchDGMApproval">
                                        <i class="bi bi-check2-square me-1"></i>Pending Approvals
                                    </a>
                                </li>
                            }

                            @* ── HODGM Navigation ── *@
                            @if (User.IsInRole("HODGM"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-page="/Welfare/Approvals/HODGMApproval">
                                        <i class="bi bi-check2-square me-1"></i>Pending Approvals
                                    </a>
                                </li>
                            }

                            @* ── Senior Management Navigation ── *@
                            @if (User.IsInRole("SeniorManagement"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-page="/Welfare/Approvals/SeniorManagementApproval">
                                        <i class="bi bi-check2-square me-1"></i>Pending Approvals
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-page="/Performance/Index">
                                        <i class="bi bi-bar-chart-line me-1"></i>Performance
                                    </a>
                                </li>
                            }

                            @* ── Finance Navigation ── *@
                            @if (User.IsInRole("Finance"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-page="/Welfare/Approvals/FinanceApproval">
                                        <i class="bi bi-check2-square me-1"></i>Pending Approvals
                                    </a>
                                </li>
                            }

                            @* ── Admin Navigation ── *@
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link text-dark dropdown-toggle" href="#"
                                       role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-people me-1"></i>Employees
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" asp-page="/Employees/Index">
                                                <i class="bi bi-list me-1"></i>Employee List
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link text-dark dropdown-toggle" href="#"
                                       role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-shield-check me-1"></i>Welfare
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" asp-page="/Welfare/RequestList">
                                                <i class="bi bi-list-ul me-1"></i>All Requests
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-page="/Welfare/Approval">
                                                <i class="bi bi-check2-all me-1"></i>Approvals
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-page="/Performance/Index">
                                        <i class="bi bi-bar-chart-line me-1"></i>Performance
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    @* ── Right side: Profile Pill or Login ── *@
                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                @await Component.InvokeAsync("ProfilePill")
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Account/Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Login
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - HRMS - <a asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
