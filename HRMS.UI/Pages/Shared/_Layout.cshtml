<script>
    // --- Notification & Windows Desktop Alert System ---
    let notifDropdown = document.getElementById('notifDropdown');
    let notifWrapper = document.getElementById('notifWrapper');
    let dropIsOpen = false;
    let isInitialFetch = true;

    // Track notified IDs persistently so the same notifications are never re-toasted across logins
    function getNotifiedSet() {
        try {
            const raw = localStorage.getItem('hrms_notified_ids');
            return raw ? new Set(JSON.parse(raw)) : new Set();
        } catch(e) { return new Set(); }
    }

    function saveNotifiedSet(set) {
        try {
            // Keep up to latest 200 IDs to bound storage
            const arr = Array.from(set).slice(-200);
            localStorage.setItem('hrms_notified_ids', JSON.stringify(arr));
        } catch(e) {}
    }

    // Update Desktop Notification Status UI
    function updateDesktopNotifUI() {
        const btn = document.getElementById('btnDesktopNotif');
        const statusSpan = document.getElementById('desktopNotifStatus');
        const bar = document.getElementById('desktopNotifBar');
        if (!btn || !statusSpan || !bar) return;

        if (!("Notification" in window)) {
            bar.style.display = 'none';
            return;
        }

        if (Notification.permission === 'granted') {
            bar.style.background = '#f0fdf4';
            bar.style.borderBottomColor = '#dcfce7';
            statusSpan.style.color = '#166534';
            statusSpan.innerHTML = `<i class="bi bi-check-circle-fill" style="color:#10823c;"></i> Windows Alerts Active`;
            btn.style.display = 'none';
        } else if (Notification.permission === 'denied') {
            bar.style.background = '#fef2f2';
            bar.style.borderBottomColor = '#fecaca';
            statusSpan.style.color = '#991b1b';
            statusSpan.innerHTML = `<i class="bi bi-exclamation-circle-fill" style="color:#ef4444;"></i> Blocked in browser`;
            btn.style.display = 'none';
        } else {
            bar.style.background = '#f0fdf4';
            bar.style.borderBottomColor = '#dcfce7';
            statusSpan.style.color = '#166534';
            statusSpan.innerHTML = `<i class="bi bi-display"></i> Windows Desktop Alerts`;
            btn.style.display = 'inline-block';
            btn.textContent = 'Enable';
        }
    }

    // Request Windows notification permission
    function enableWindowsNotifications(promptUser) {
        if (!("Notification" in window)) {
            alert("This browser does not support desktop notifications.");
            return;
        }

        if (Notification.permission === 'default' || promptUser) {
            Notification.requestPermission().then(permission => {
                updateDesktopNotifUI();
                if (permission === 'granted') {
                    try {
                        const testNotif = new Notification("Kanrich HRMS Desktop Alerts", {
                            body: "Windows notifications are enabled! You will receive alerts for approvals, reminders, and updates.",
                            icon: "/images/logo-title.png",
                            badge: "/images/logo-title.png"
                        });
                        testNotif.onclick = () => { window.focus(); testNotif.close(); };
                    } catch(e) {}
                }
            });
        }
    }

    // Display Windows Desktop Notification Toast
    function showWindowsToast(id, title, message, targetUrl) {
        if (!("Notification" in window) || Notification.permission !== 'granted') return;

        try {
            const notif = new Notification(title || "Kanrich HRMS Alert", {
                body: message || "You have a new update in Kanrich HRMS.",
                icon: "/images/logo-title.png",
                badge: "/images/logo-title.png",
                tag: "hrms-notif-" + id,
                renotify: true
            });

            notif.onclick = function() {
                window.focus();
                clickNotification(id, targetUrl);
                notif.close();
            };
        } catch (err) {
            console.warn("Could not dispatch Windows desktop notification:", err);
        }
    }

    // Display Consolidated Windows Desktop Notification Toast for batches
    function showWindowsSummaryToast(count, message) {
        if (!("Notification" in window) || Notification.permission !== 'granted') return;

        try {
            const notif = new Notification("Kanrich HRMS", {
                body: message || `You have ${count} new notifications waiting in HRMS. Click to view.`,
                icon: "/images/logo-title.png",
                badge: "/images/logo-title.png",
                tag: "hrms-summary-notif",
                renotify: true
            });

            notif.onclick = function() {
                window.focus();
                if (notifDropdown && !notifDropdown.classList.contains('open')) {
                    notifDropdown.classList.add('open');
                    dropIsOpen = true;
                }
                notif.close();
            };
        } catch (err) {
            console.warn("Could not dispatch Windows summary notification:", err);
        }
    }

    // Toggle panel
    function toggleNotifDropdown(e) {
        e.stopPropagation();
        dropIsOpen = !dropIsOpen;
        if (dropIsOpen) {
            notifDropdown.classList.add('open');
            fetchNotifications(); // Refresh on open
            updateDesktopNotifUI();
        } else {
            notifDropdown.classList.remove('open');
        }
    }

    // Close on outside click
    document.addEventListener('click', function(e) {
        if (dropIsOpen && !notifWrapper.contains(e.target)) {
            dropIsOpen = false;
            notifDropdown.classList.remove('open');
        }
    });

    // Fetch and render
    async function fetchNotifications() {
        try {
            const resp = await fetch('/Api/Notifications');
            if (!resp.ok) return;

            const data = await resp.json();
            const unread = (data && data.unreadCount !== undefined) ? data.unreadCount : ((data && data.UnreadCount !== undefined) ? data.UnreadCount : 0);
            const items = (data && data.items) ? data.items : ((data && data.Items) ? data.Items : []);
            
            // Update Badge
            const badge = document.getElementById('notifBadge');
            if (badge) {
                if (unread > 0) {
                    badge.textContent = unread > 99 ? '99+' : unread;
                    badge.classList.remove('hidden');
                } else {
                    badge.classList.add('hidden');
                }
            }

            // Update List
            const list = document.getElementById('notifList');
            if (list) {
                if (items.length === 0) {
                    list.innerHTML = `<div class="notif-empty">You have no new notifications.</div>`;
                } else {
                    let html = '';
                    items.forEach(n => {
                        const id = n.id !== undefined ? n.id : n.Id;
                        const title = n.title || n.Title || '';
                        const msg = n.message || n.Message || '';
                        const targetUrl = n.targetUrl || n.TargetUrl || '#';
                        const createdAt = n.createdAt || n.CreatedAt || '';
                        html += `
                            <a href="javascript:void(0)" onclick="clickNotification(${id}, '${targetUrl}')" class="notif-item">
                                <div class="notif-item-title">${title}</div>
                                <div class="notif-item-msg">${msg}</div>
                                <div class="notif-item-time">${createdAt}</div>
                            </a>
                        `;
                    });
                    list.innerHTML = html;
                }
            }

            // Check and trigger Windows Desktop Notifications for new live items
            const notifiedSet = getNotifiedSet();
            if (isInitialFetch) {
                // On initial load/login, register existing inbox items as known without spamming toasts
                items.forEach(item => {
                    const id = item.id !== undefined ? item.id : item.Id;
                    notifiedSet.add(id);
                });
                saveNotifiedSet(notifiedSet);
                isInitialFetch = false;
            } else {
                // Filter down to strictly new items that have not yet been notified
                const newItems = items.filter(item => {
                    const id = item.id !== undefined ? item.id : item.Id;
                    return !notifiedSet.has(id);
                });

                if (newItems.length > 0) {
                    if (newItems.length <= 2) {
                        // 1 or 2 new items: Dispatch individually with gentle spacing delay
                        newItems.forEach((item, index) => {
                            const id = item.id !== undefined ? item.id : item.Id;
                            setTimeout(() => {
                                showWindowsToast(id, item.title || item.Title, item.message || item.Message, item.targetUrl || item.TargetUrl);
                            }, index * 800);
                            notifiedSet.add(id);
                        });
                    } else {
                        // 3 or more items arriving at once: Dispatch a single consolidated summary toast
                        const firstTitle = newItems[0].title || newItems[0].Title || "Update";
                        const summaryMsg = `You have ${newItems.length} new notifications (${firstTitle} and ${newItems.length - 1} more). Click to view.`;
                        showWindowsSummaryToast(newItems.length, summaryMsg);

                        newItems.forEach(item => {
                            const id = item.id !== undefined ? item.id : item.Id;
                            notifiedSet.add(id);
                        });
                    }
                    saveNotifiedSet(notifiedSet);
                }
            }

        } catch (e) { console.error('Error fetching notifications:', e); }
    }

    // Click Notification
    async function clickNotification(id, targetUrl) {
        try {
            await fetch(`/Api/Notifications?handler=MarkAsRead&id=${id}`, { method: 'POST' });
        } catch(e) {}
        if (targetUrl && targetUrl !== '#' && targetUrl !== 'javascript:void(0)') {
            window.location.href = targetUrl;
        } else {
            fetchNotifications();
        }
    }

    // Mark all as read
    async function markAllAsRead() {
        try {
            const btn = document.getElementById('notifMarkAll');
            if (btn) btn.textContent = "Marking...";
            await fetch('/Api/Notifications?handler=MarkAllAsRead', { method: 'POST' });
            if (btn) btn.textContent = "Mark all as read";
            fetchNotifications();
            dropIsOpen = false;
            if (notifDropdown) notifDropdown.classList.remove('open');
        } catch(e) {}
    }

    // Initialize polling every 25 seconds & update desktop UI
    document.addEventListener('DOMContentLoaded', () => {
        updateDesktopNotifUI();
        fetchNotifications();
        setInterval(fetchNotifications, 25000);
    });

    function toggleNavCollapsible(id) {
        const parent = document.getElementById(id);
        if (parent) {
            parent.classList.toggle('open');
        }
    }
</script>

<script>
function initTablePagination(tableId, initialPageSize) {
    var table = document.getElementById(tableId);
    if (!table) return;
    var tbody = table.querySelector('tbody');
    if (!tbody) return;
    
    var pageSize = initialPageSize || 10;
    var currentPage = 1;
    
    var existingBar = table.parentElement ? table.parentElement.querySelector('.tbl-pg-bar[data-for-table="' + tableId + '"]') : null;
    var bar = existingBar || document.createElement('div');
    bar.className = 'tbl-pg-bar';
    bar.setAttribute('data-for-table', tableId);
    if (!existingBar) {
        table.insertAdjacentElement('afterend', bar);
    }
    
    function render() {
        var allRows = Array.from(tbody.querySelectorAll('tr')).filter(function(r) {
            return !r.classList.contains('empty-row') && !r.querySelector('td[colspan]');
        });
        
        allRows.forEach(function(r) {
            if (r.getAttribute('data-filter-hidden') === 'true') {
                r.style.display = 'none';
            }
        });

        var dataRows = allRows.filter(function(r) {
            return r.getAttribute('data-filter-hidden') !== 'true';
        });
        
        if (dataRows.length === 0) {
            bar.style.display = 'none';
            return;
        } else {
            bar.style.display = 'flex';
        }

        var totalPages = Math.ceil(dataRows.length / pageSize);
        if (totalPages < 1) totalPages = 1;
        if (currentPage > totalPages) currentPage = totalPages;
        
        dataRows.forEach(function(row, i) {
            row.style.display = (i >= (currentPage-1)*pageSize && i < currentPage*pageSize) ? '' : 'none';
        });
        
        var start = (currentPage-1)*pageSize + 1;
        var end = Math.min(currentPage*pageSize, dataRows.length);
        
        bar.innerHTML = '';
        
        // 1. Info span
        var info = document.createElement('span');
        info.className = 'tbl-pg-info';
        info.textContent = 'Showing ' + start + '–' + end + ' of ' + dataRows.length;
        bar.appendChild(info);
        
        // 2. Page size selector dropdown
        var select = document.createElement('select');
        select.className = 'tbl-pg-select';
        select.style.cssText = 'margin-left: 12px; padding: 4px 8px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 12.5px; cursor: pointer; color: #374151; background: #fff; outline: none; font-family: inherit;';
        
        var sizes = [10, 20, 50, 100];
        if (sizes.indexOf(pageSize) === -1) {
            sizes.push(pageSize);
            sizes.sort(function(a, b) { return a - b; });
        }
        sizes.forEach(function(sz) {
            var opt = document.createElement('option');
            opt.value = sz;
            opt.textContent = sz + ' / page';
            if (sz === pageSize) opt.selected = true;
            select.appendChild(opt);
        });
        
        select.onchange = function() {
            pageSize = parseInt(this.value, 10);
            currentPage = 1;
            render();
        };
        bar.appendChild(select);
        
        // 3. Button group container
        var btns = document.createElement('div');
        btns.className = 'tbl-pg-btns';
        
        // Prev button
        var prev = document.createElement('button');
        prev.className = 'pg-btn';
        prev.textContent = '← Prev';
        prev.disabled = currentPage <= 1;
        prev.onclick = function(e) {
            e.preventDefault();
            if (currentPage > 1) {
                currentPage--;
                render();
            }
        };
        btns.appendChild(prev);
        
        // Page numbers with smart ellipsis truncation
        var pageNumbers = [];
        if (totalPages <= 7) {
            for (var i = 1; i <= totalPages; i++) pageNumbers.push(i);
        } else {
            pageNumbers.push(1);
            
            var startP = Math.max(2, currentPage - 1);
            var endP = Math.min(totalPages - 1, currentPage + 1);
            
            if (currentPage <= 4) {
                endP = 5;
            } else if (currentPage >= totalPages - 3) {
                startP = totalPages - 4;
            }
            
            if (startP > 2) {
                pageNumbers.push('...');
            }
            
            for (var i = startP; i <= endP; i++) {
                pageNumbers.push(i);
            }
            
            if (endP < totalPages - 1) {
                pageNumbers.push('...');
            }
            
            pageNumbers.push(totalPages);
        }
        
        pageNumbers.forEach(function(p) {
            if (p === '...') {
                var el = document.createElement('span');
                el.className = 'tbl-pg-ellipsis';
                el.textContent = '...';
                el.style.cssText = 'padding: 6px 12px; font-size: 13px; color: #9ca3af; display: inline-block; font-weight: 500; user-select: none;';
                btns.appendChild(el);
            } else {
                var btn = document.createElement('button');
                btn.className = 'pg-btn' + (p === currentPage ? ' active' : '');
                btn.textContent = p;
                btn.onclick = function(e) {
                    e.preventDefault();
                    currentPage = p;
                    render();
                };
                btns.appendChild(btn);
            }
        });
        
        // Next button
        var next = document.createElement('button');
        next.className = 'pg-btn';
        next.textContent = 'Next →';
        next.disabled = currentPage >= totalPages;
        next.onclick = function(e) {
            e.preventDefault();
            if (currentPage < totalPages) {
                currentPage++;
                render();
            }
        };
        btns.appendChild(next);
        
        bar.appendChild(btns);
    }
    
    table._tablePaginationRender = render;
    table._tablePaginationResetPage = function() { currentPage = 1; };
    render();
}

// ── Global Document Preview Modal Controller ──
window.openDocumentPreview = function(url, title, subtitle) {
    if (!url) return;
    var modal = document.getElementById('globalDocPreviewModal');
    if (!modal) return;

    var titleEl = document.getElementById('docModalTitle');
    var subEl = document.getElementById('docModalSubtitle');
    var dlBtn = document.getElementById('docModalDownloadBtn');
    var extBtn = document.getElementById('docModalNewTabBtn');
    var loader = document.getElementById('docModalLoader');
    var iframe = document.getElementById('docModalIframe');
    var imgWrap = document.getElementById('docModalImageWrap');
    var img = document.getElementById('docModalImg');
    var fallback = document.getElementById('docModalFallback');
    var fbDl = document.getElementById('docModalFallbackDownload');
    var iconEl = document.getElementById('docModalIcon');

    titleEl.textContent = title || 'Document Preview';
    subEl.textContent = subtitle || url.split('/').pop() || 'Submitted Attachment';
    dlBtn.href = url;
    extBtn.href = '/Documents/Viewer?url=' + encodeURIComponent(url) + '&title=' + encodeURIComponent(titleEl.textContent) + '&name=' + encodeURIComponent(subEl.textContent);
    fbDl.href = url;

    // Reset states
    loader.style.display = 'flex';
    iframe.style.display = 'none';
    iframe.src = 'about:blank';
    imgWrap.style.display = 'none';
    img.src = '';
    fallback.style.display = 'none';

    modal.style.display = 'flex';
    requestAnimationFrame(function() {
        modal.classList.add('active');
        modal.setAttribute('aria-hidden', 'false');
    });

    // Detect file extension
    var cleanUrl = url.split('?')[0].toLowerCase();
    var isImage = cleanUrl.endsWith('.png') || cleanUrl.endsWith('.jpg') || cleanUrl.endsWith('.jpeg') || cleanUrl.endsWith('.webp') || cleanUrl.endsWith('.gif') || cleanUrl.endsWith('.bmp');
    var isPdf = cleanUrl.endsWith('.pdf');

    if (isImage) {
        iconEl.innerHTML = '<i class="bi bi-file-earmark-image"></i>';
        img.onload = function() {
            loader.style.display = 'none';
            imgWrap.style.display = 'flex';
        };
        img.onerror = function() {
            loader.style.display = 'none';
            fallback.style.display = 'block';
        };
        img.src = url;
    } else if (isPdf || cleanUrl.endsWith('.txt')) {
        iconEl.innerHTML = '<i class="bi bi-file-earmark-pdf"></i>';
        iframe.onload = function() {
            loader.style.display = 'none';
            iframe.style.display = 'block';
        };
        iframe.onerror = function() {
            loader.style.display = 'none';
            fallback.style.display = 'block';
        };
        iframe.src = url;
    } else {
        iconEl.innerHTML = '<i class="bi bi-file-earmark-text"></i>';
        iframe.onload = function() {
            loader.style.display = 'none';
            iframe.style.display = 'block';
        };
        iframe.onerror = function() {
            loader.style.display = 'none';
            fallback.style.display = 'block';
        };
        iframe.src = url;
    }
};

window.closeDocumentPreview = function() {
    var modal = document.getElementById('globalDocPreviewModal');
    if (!modal) return;
    modal.classList.remove('active');
    modal.setAttribute('aria-hidden', 'true');
    setTimeout(function() {
        modal.style.display = 'none';
        var iframe = document.getElementById('docModalIframe');
        if (iframe) iframe.src = 'about:blank';
        var img = document.getElementById('docModalImg');
        if (img) img.src = '';
    }, 240);
};

// Global click event listener for document links with class or data attribute
document.addEventListener('click', function(e) {
    var target = e.target.closest('[data-doc-preview], .js-doc-preview');
    if (target) {
        e.preventDefault();
        var url = target.getAttribute('data-doc-url') || target.getAttribute('href');
        var title = target.getAttribute('data-doc-title') || target.textContent.trim() || 'Document Preview';
        var subtitle = target.getAttribute('data-doc-sub') || '';
        window.openDocumentPreview(url, title, subtitle);
    }
});

// Close button & overlay click
document.addEventListener('DOMContentLoaded', function() {
    var closeBtn = document.getElementById('docModalCloseBtn');
    if (closeBtn) {
        closeBtn.addEventListener('click', function(e) {
            e.preventDefault();
            window.closeDocumentPreview();
        });
    }
    var modal = document.getElementById('globalDocPreviewModal');
    if (modal) {
        modal.addEventListener('click', function(e) {
            if (e.target === modal) {
                window.closeDocumentPreview();
            }
        });
    }
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            window.closeDocumentPreview();
        }
    });
});
</script>

<!-- Global Document Preview Modal -->
<div id="globalDocPreviewModal" class="doc-modal-overlay" style="display:none;" aria-hidden="true">
    <div class="doc-modal-container" role="dialog" aria-modal="true">
        <div class="doc-modal-header">
            <div class="doc-modal-title-wrap">
                <div class="doc-modal-icon" id="docModalIcon">
                    <i class="bi bi-file-earmark-text"></i>
                </div>
                <div>
                    <h3 class="doc-modal-title" id="docModalTitle">Document Preview</h3>
                    <span class="doc-modal-subtitle" id="docModalSubtitle">Submitted Attachment</span>
                </div>
            </div>
            <div class="doc-modal-actions">
                <a id="docModalDownloadBtn" href="#" download class="doc-modal-btn doc-modal-btn-download" title="Download Document">
                    <i class="bi bi-download"></i>
                    <span>Download</span>
                </a>
                <a id="docModalNewTabBtn" href="#" target="_blank" class="doc-modal-btn doc-modal-btn-ext" title="Open in New Tab">
                    <i class="bi bi-box-arrow-up-right"></i>
                </a>
                <button type="button" class="doc-modal-btn doc-modal-btn-close" id="docModalCloseBtn" title="Close Preview">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>
        <div class="doc-modal-body">
            <div id="docModalLoader" class="doc-modal-loader">
                <div class="doc-spinner"></div>
                <span>Loading preview...</span>
            </div>
            <iframe id="docModalIframe" class="doc-modal-frame" style="display:none;" frameborder="0"></iframe>
            <div id="docModalImageWrap" class="doc-modal-img-wrap" style="display:none;">
                <img id="docModalImg" src="" alt="Document Preview" />
            </div>
            <div id="docModalFallback" class="doc-modal-fallback" style="display:none;">
                <i class="bi bi-file-earmark-arrow-down" style="font-size: 44px; color: #10823c;"></i>
                <h4>File preview not supported directly</h4>
                <p>You can download or open the file using the button below.</p>
                <a id="docModalFallbackDownload" href="#" download class="doc-modal-btn doc-modal-btn-download">Download File</a>
            </div>
        </div>
    </div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>