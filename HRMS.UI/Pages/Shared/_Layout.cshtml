@{
    // Pages set ViewData["ActiveNav"] to highlight the current nav item.
    // e.g. ViewData["ActiveNav"] = "Calendar";
    var activeNav = ViewData["ActiveNav"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Kanrich HRMS</title>
    <link rel="icon" type="image/png" href="/images/logo-title.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        html, body {
            height: 100%;
            font-family: 'Manrope', sans-serif;
            background: #f6f8f7;
            color: #151811;
        }

        /* ── LAYOUT ── */
        .app-shell { display: flex; height: 100vh; overflow: hidden; }

        /* ── SIDEBAR ── */
        .sidebar {
            width: 220px; min-width: 220px;
            background: #ffffff;
            border-right: 1px solid #e2e5dc;
            display: flex; flex-direction: column;
            justify-content: space-between;
            overflow: hidden;
        }
        .sidebar-top { padding: 16px 14px 18px; }
        .sidebar-brand { margin-bottom: 24px; }
        .sidebar-brand-title { font-size: 14px; font-weight: 700; color: #151811; line-height: 20px; }
        .sidebar-brand-sub  { font-size: 11px; font-weight: 400; color: #7a8863; line-height: 16px; }

        .nav-list { list-style: none; display: flex; flex-direction: column; gap: 3px; }
        .nav-item a {
            display: flex; align-items: center; gap: 9px;
            padding: 8px 11px; border-radius: 7px;
            text-decoration: none; font-size: 13px; font-weight: 500; color: #151811;
            transition: background 0.15s;
        }
        .nav-item a:hover { background: #f6f8f7; }
        .nav-item.active a { background: rgba(16,130,60,.1); color: #10823c; font-weight: 700; }
        .nav-icon { flex-shrink: 0; width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; color: inherit; }
        .nav-icon svg { width: 18px; height: 18px; stroke: currentColor; fill: none; }

        .sidebar-bottom { padding: 16px 14px; }
        .btn-logout {
            display: flex; align-items: center; justify-content: center;
            width: 100%; height: 36px;
            background: #10823c; color: #ffffff; border: none; border-radius: 7px;
            font-family: 'Manrope', sans-serif; font-size: 12px; font-weight: 700;
            cursor: pointer; text-decoration: none; transition: background 0.2s;
        }
        .btn-logout:hover { background: #0d6e32; color: #fff; }

        /* ── MAIN COLUMN ── */
        .main-col { flex: 1; display: flex; flex-direction: column; overflow: hidden; min-width: 0; }

        /* ── TOPBAR ── */
        .topbar {
            background: #ffffff; border-bottom: 1px solid #e2e5dc;
            padding: 10px 26px; display: flex; align-items: center; gap: 16px;
            flex-shrink: 0; z-index: 10;
        }
        .topbar-logo   { height: 34px; width: auto; flex-shrink: 0; }
        .topbar-title  { flex: 1; text-align: center; font-size: 16px; font-weight: 700; color: #151811; letter-spacing: -0.2px; }
        .topbar-right  { display: flex; align-items: center; gap: 7px; }

        .icon-btn {
            position: relative; width: 36px; height: 36px;
            background: #f6f8f7; border: none; border-radius: 7px;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; transition: background 0.15s;
        }
        .icon-btn:hover { background: #e2e5dc; }
        .icon-btn svg  { width: 18px; height: 18px; stroke: #151811; fill: none; }
        .notif-dot {
            position: absolute; top: 6px; right: 6px;
            width: 7px; height: 7px;
            background: #ef4444; border: 1px solid #fff; border-radius: 50%;
        }
        .avatar {
            width: 36px; height: 36px; border-radius: 50%;
            background: linear-gradient(135deg, #10823c, #0d6e32);
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 12px; font-weight: 700;
            box-shadow: 0 0 0 2px rgba(16,130,60,.2); cursor: pointer;
        }

        /* ── PAGE CONTENT ── */
        .page-content { flex: 1; overflow: auto; background: #ffffff; padding: 26px; }

        /* Remove double-padding from legacy containers from Main */
        .page-content .main-content,
        .page-content .dash-wrap,
        .page-content .edit-shell,
        .page-content .form-shell,
        .page-content .list-shell,
        .page-content .payroll-shell,
        .page-content .perf-shell,
        .page-content .tracking-shell,
        .page-content .approval-shell,
        .page-content .welfare-page-wrap,
        .page-content > div[style*="padding: 26px"] {
            padding: 0 !important;
            background: transparent !important;
            min-height: auto !important;
        }

        /* ── NOTIFICATIONS DROPDOWN ── */
        .notif-wrapper { position: relative; }
        .notif-dropdown {
            position: absolute; top: calc(100% + 10px); right: -10px; width: 340px;
            background: #fff; border: 1px solid #e2e8f0; border-radius: 12px;
            box-shadow: 0 10px 40px -10px rgba(0,0,0,0.15);
            display: none; flex-direction: column; z-index: 100;
            overflow: hidden; opacity: 0; transform: translateY(-5px);
            transition: opacity 0.2s, transform 0.2s;
        }
        .notif-dropdown.open { display: flex; opacity: 1; transform: translateY(0); }
        .notif-head {
            padding: 14px 18px; border-bottom: 1px solid #f1f5f9;
            display: flex; justify-content: space-between; align-items: center;
        }
        .notif-head h4 { font-size: 14px; font-weight: 700; color: #0f172a; }
        .notif-markall { font-size: 12px; font-weight: 600; color: #10823c; background: none; border: none; cursor: pointer; }
        .notif-markall:hover { color: #0d6e32; text-decoration: underline; }
        
        .notif-body { max-height: 380px; overflow-y: auto; background: #f8fafc; }
        .notif-empty { padding: 40px 20px; text-align: center; color: #94a3b8; font-size: 13px; font-weight: 600; }
        .notif-item {
            padding: 14px 18px; border-bottom: 1px solid #e2e8f0;
            display: block; text-decoration: none; background: #fff; transition: background 0.15s;
        }
        .notif-item:hover { background: #f1f5f9; }
        .notif-item-title { font-size: 13px; font-weight: 700; color: #0f172a; margin-bottom: 4px; }
        .notif-item-msg { font-size: 12px; color: #64748b; line-height: 1.4; margin-bottom: 8px; }
        .notif-item-time { font-size: 11px; font-weight: 700; color: #10823c; }

        .notif-dot {
            position: absolute; top: 4px; right: 4px;
            min-width: 16px; height: 16px; padding: 0 4px;
            background: #ef4444; color: #fff;
            border: 2px solid #fff; border-radius: 999px;
            font-size: 9px; font-weight: 800; font-family: sans-serif;
            display: flex; align-items: center; justify-content: center;
        }
        .notif-dot.hidden { display: none; }

        /* ── Shared Table Pagination ── */
        .tbl-pg-bar {
            display: flex; justify-content: space-between; align-items: center;
            padding: 12px 18px; border-top: 1px solid #e2e5dc;
            background: #f9fafb; font-family: 'Manrope', sans-serif;
        }
        .tbl-pg-info { font-size: 13px; color: #7a8863; }
        .tbl-pg-btns { display: flex; gap: 6px; align-items: center; }
        .pg-btn {
            padding: 4px 10px; border-radius: 5px; border: 1px solid #e2e5dc;
            background: white; font-size: 13px; color: #151811; cursor: pointer;
            font-family: 'Manrope', sans-serif; text-decoration: none;
            display: inline-block; line-height: normal; transition: background 0.15s, border-color 0.15s;
        }
        .pg-btn:hover:not(:disabled) { background: #f0faf4; border-color: #10823c; color: #10823c; }
        .pg-btn.active { background: #10823c; color: white; border-color: #10823c; }
        .pg-btn:disabled { opacity: 0.45; cursor: not-allowed; }

        /* Collapsible Menu styling */
        .nav-item-collapsible {
            display: flex;
            flex-direction: column;
        }
        .nav-item-collapsible-trigger {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 11px;
            border-radius: 7px;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            color: #151811;
            cursor: pointer;
            transition: background 0.15s;
            user-select: none;
        }
        .nav-item-collapsible-trigger:hover {
            background: #f6f8f7;
        }
        .nav-item-collapsible.active-parent > .nav-item-collapsible-trigger {
            font-weight: 700;
            color: #10823c;
            background: rgba(16,130,60,.03);
        }
        .nav-item-collapsible-chevron {
            transition: transform 0.2s;
            font-size: 10px;
            color: #7a8863;
        }
        .nav-item-collapsible.open .nav-item-collapsible-chevron {
            transform: rotate(180deg);
        }
        .nav-item-collapsible-content {
            display: none;
            flex-direction: column;
            gap: 2px;
            padding-left: 12px;
            margin-top: 2px;
            border-left: 1.5px solid #e2e5dc;
            margin-left: 20px;
        }
        .nav-item-collapsible.open .nav-item-collapsible-content {
            display: flex;
        }
        .nav-item-sub a {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 10px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 12.5px;
            font-weight: 500;
            color: #4b5563;
            transition: background 0.15s, color 0.15s;
        }
        .nav-item-sub a:hover {
            background: #f6f8f7;
            color: #151811;
        }
        .nav-item-sub.active a {
            background: rgba(16,130,60,.08);
            color: #10823c;
            font-weight: 600;
        }

        /* ── Global Document Preview Modal ── */
        .doc-modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(15, 23, 42, 0.72);
            backdrop-filter: blur(5px);
            -webkit-backdrop-filter: blur(5px);
            z-index: 99999;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.22s ease, visibility 0.22s ease;
        }
        .doc-modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }
        .doc-modal-container {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(0,0,0,0.06);
            width: 92vw;
            max-width: 1050px;
            height: 88vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            transform: scale(0.96) translateY(10px);
            transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .doc-modal-overlay.active .doc-modal-container {
            transform: scale(1) translateY(0);
        }
        .doc-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 22px;
            border-bottom: 1px solid #e2e8f0;
            background: #ffffff;
            flex-shrink: 0;
        }
        .doc-modal-title-wrap {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
        }
        .doc-modal-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: rgba(16, 130, 60, 0.1);
            color: #10823c;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
        }
        .doc-modal-title {
            font-size: 15px;
            font-weight: 700;
            color: #0f172a;
            line-height: 1.2;
            margin: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .doc-modal-subtitle {
            font-size: 11.5px;
            color: #64748b;
            font-weight: 500;
            display: block;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .doc-modal-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }
        .doc-modal-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 12px;
            border-radius: 7px;
            font-size: 12.5px;
            font-weight: 600;
            text-decoration: none;
            border: none;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .doc-modal-btn-download {
            background: #10823c;
            color: #ffffff;
        }
        .doc-modal-btn-download:hover {
            background: #0d6e32;
            color: #ffffff;
        }
        .doc-modal-btn-ext {
            background: #f1f5f9;
            color: #475569;
        }
        .doc-modal-btn-ext:hover {
            background: #e2e8f0;
            color: #1e293b;
        }
        .doc-modal-btn-close {
            background: #f1f5f9;
            color: #64748b;
            padding: 7px 10px;
            font-size: 13px;
        }
        .doc-modal-btn-close:hover {
            background: #fee2e2;
            color: #ef4444;
        }
        .doc-modal-body {
            flex: 1;
            position: relative;
            background: #f8fafc;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .doc-modal-loader {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            color: #64748b;
            font-size: 13px;
            font-weight: 600;
        }
        .doc-spinner {
            width: 32px;
            height: 32px;
            border: 3px solid #e2e8f0;
            border-top-color: #10823c;
            border-radius: 50%;
            animation: docSpin 0.7s linear infinite;
        }
        @@keyframes docSpin {
            to { transform: rotate(360deg); }
        }
        .doc-modal-frame {
            width: 100%;
            height: 100%;
            border: none;
        }
        .doc-modal-img-wrap {
            width: 100%;
            height: 100%;
            overflow: auto;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .doc-modal-img-wrap img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            border-radius: 8px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        }
        .doc-modal-fallback {
            text-align: center;
            padding: 30px 20px;
            max-width: 380px;
        }
        .doc-modal-fallback h4 {
            font-size: 15px;
            font-weight: 700;
            color: #0f172a;
            margin: 14px 0 6px;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<div class="app-shell">

    <!-- ── SIDEBAR ── -->
    <aside class="sidebar">
        <div class="sidebar-top">
            <div class="sidebar-brand">
                <div class="sidebar-brand-title">Kanrich HRMS</div>
                <div class="sidebar-brand-sub">
                    @if (User.IsInRole("Admin")) { <text>Admin Portal</text> }
                    else if (User.IsInRole("HR Manager")) { <text>HR Manager Portal</text> }
                    else if (User.IsInRole("HR Officer")) { <text>HR Officer Portal</text> }
                    else if (User.IsInRole("Area Manager")) { <text>Area Manager Portal</text> }
                    else if (User.IsInRole("Branch Manager")) { <text>Branch Manager Portal</text> }
                    else if (User.IsInRole("Welfare Manager")) { <text>Welfare Manager Portal</text> }
                    else if (User.IsInRole("Department Head")) { <text>Department Head Portal</text> }
                    else { <text>Employee Portal</text> }
                </div>
            </div>
            <nav>
                <ul class="nav-list">
                    @if (!User.IsInRole("Welfare Manager") && !User.IsInRole("Admin"))
                    {
                        <li class="nav-item @(activeNav == "Dashboard" ? "active" : "")">
                            <a href="/Index">
                                <span class="nav-icon">
                                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                                        <rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
                                    </svg>
                                </span>
                                Dashboard
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item @(activeNav == "Settings" ? "active" : "")">
                            <a href="/Settings">
                                <span class="nav-icon">
                                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="3"/>
                                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                                    </svg>
                                </span>
                                System Settings
                            </a>
                        </li>
                        <li class="nav-item @(activeNav == "Users" || activeNav == "AdminUsers" ? "active" : "")">
                            <a href="/Admin/Users">
                                <span class="nav-icon">
                                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                        <circle cx="9" cy="7" r="4"/>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                    </svg>
                                </span>
                                User Accounts
                            </a>
                        </li>
                    }
                    @if (!User.IsInRole("Admin") && !User.IsInRole("Welfare Manager"))
                    {
                        <li class="nav-item @(activeNav == "Calendar" ? "active" : "")">
                            <a href="/Calendar/Index">
                                <span class="nav-icon">
                                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                        <line x1="16" y1="2" x2="16" y2="6"/>
                                        <line x1="8" y1="2" x2="8" y2="6"/>
                                        <line x1="3" y1="10" x2="21" y2="10"/>
                                    </svg>
                                </span>
                                Calendar
                            </a>
                        </li>
                    }
                    @if (!User.IsInRole("Admin") && !User.IsInRole("Welfare Manager"))
                    {
                        <li class="nav-item @(activeNav == "Separation" ? "active" : "")">
                            @if (User.IsInRole("Branch Manager") || User.IsInRole("Area Manager") || User.IsInRole("HR Manager") || User.IsInRole("HR Officer") || User.IsInRole("Department Head"))
                            {
                                <a href="/Separation/Dashboard">
                                    <span class="nav-icon">
                                        <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                            <circle cx="9" cy="7" r="4"/>
                                            <polyline points="17 11 19 13 23 9"/>
                                        </svg>
                                    </span>
                                    Separation
                                </a>
                            }
                            else
                            {
                                <a href="/Transfer/Separation">
                                    <span class="nav-icon">
                                        <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                            <circle cx="9" cy="7" r="4"/>
                                            <polyline points="17 11 19 13 23 9"/>
                                        </svg>
                                    </span>
                                    Separation
                                </a>
                            }
                        </li>

                        <li class="nav-item @(activeNav == "AttendanceDashboard" ? "active" : "")">
                            <a href="/Attendance/Dashboard">
                                <span class="nav-icon">
                                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10"/>
                                        <polyline points="12 6 12 12 16 14"/>
                                    </svg>
                                </span>
                                Attendance & Leave
                            </a>
                        </li>
                    }
                    
                    @if (User.IsInRole("HR Manager") || User.IsInRole("HR Officer") || User.IsInRole("Area Manager") || User.IsInRole("Branch Manager"))
                    {
                        <li class="nav-item @(activeNav == "Employees" ? "active" : "")">
                            <a href="/Employees">
                                <span class="nav-icon">
                                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                        <circle cx="9" cy="7" r="4"/>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
                                    </svg>
                                </span>
                                Employees
                            </a>
                        </li>

                        @if (User.IsInRole("HR Manager"))
                        {
                            <li class="nav-item @(activeNav == "HROfficers" || activeNav == "BranchAssignments" ? "active" : "")">
                                <a href="/HRManager/AssignBranches">
