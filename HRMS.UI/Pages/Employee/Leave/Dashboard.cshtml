@page
@model HRMS.UI.Pages.Employee.Leave.DashboardModel
@{
    ViewData["Title"] = "Leave Dashboard";
    ViewData["ActiveNav"] = "LeaveDashboard";
}

<style>
    .page-h { font-size: 19px; font-weight: 800; color: #151811; margin: 0 0 3px 0; }
    .page-s { font-size: 12px; color: #7a8863; margin: 0; }
    .section-title { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #7a8863; margin: 24px 0 12px 0; }

    /* Stats Cards */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }
    .stat-card {
        background: white;
        border: 1px solid #e2e5dc;
        border-radius: 10px;
        padding: 20px;
        text-align: center;
        box-shadow: 0 1px 2px rgba(0,0,0,.05);
    }
    .stat-card .number { font-size: 28px; font-weight: 800; color: #10823c; }
    .stat-card .label { font-size: 12px; font-weight: 700; text-transform: uppercase; color: #7a8863; margin-top: 4px; letter-spacing: 0.05em; }

    /* Balance Cards */
    .balance-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 14px;
        margin-bottom: 24px;
    }
    .balance-card {
        background: white;
        border: 1px solid #e2e5dc;
        border-radius: 10px;
        padding: 16px;
        box-shadow: 0 1px 2px rgba(0,0,0,.05);
    }
    .balance-card h4 { margin: 0 0 6px 0; font-size: 13px; font-weight: 700; color: #151811; }
    .balance-card .total { font-size: 22px; font-weight: 800; color: #10823c; margin-bottom: 8px; }
    .balance-card .details { font-size: 12px; color: #7a8863; line-height: 1.5; }
    
    /* Table styling */
    .tbl-card { background: white; border: 1px solid #e2e5dc; border-radius: 10px; overflow: hidden; margin-bottom: 8px; box-shadow: 0 1px 2px rgba(0,0,0,.05); }
    .sep-table { width: 100%; border-collapse: collapse; }
    .sep-table th { background: #f9fafb; padding: 12px 18px; text-align: left; font-size: 12px; font-weight: 700; color: #7a8863; text-transform: uppercase; letter-spacing: 0.04em; border-bottom: 1px solid #e2e5dc; }
    .sep-table td { padding: 13px 18px; border-bottom: 1px solid #e2e5dc; font-size: 13.5px; color: #151811; vertical-align: middle; }
    .sep-table tbody tr:last-child td { border-bottom: none; }
    .sep-table tbody tr:hover { background: #fafafa; }

    /* Badges */
    .status-badge {
        padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; display: inline-flex; align-items: center; gap: 4px;
    }
    .status-badge.Pending { background: #fef3c7; color: #92400e; }
    .status-badge.Approved { background: #dcfce7; color: #166534; }
    .status-badge.Rejected { background: #fee2e2; color: #991b1b; }
</style>

@if (TempData["ErrorMessage"] != null)
{
    <div class="k-alert k-alert-danger" style="margin-bottom: 20px;">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="k-alert k-alert-success" style="margin-bottom: 20px;">
        <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
    </div>
}

<div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:22px;">
    <div>
        <h1 class="page-h">Leave Management</h1>
        <p class="page-s">Track your personal leave balances and request approvals</p>
    </div>
    <div style="display: flex; gap: 10px;">
        <a href="/Employee/Leave/Status" class="btn-kanrich btn-kanrich-outline" style="padding:9px 18px">
            <i class="bi bi-list-task"></i> My Requests
        </a>
        <a href="/Employee/Leave/Apply" class="btn-kanrich btn-kanrich-primary" style="padding:9px 18px">
            <i class="bi bi-plus-circle"></i> Apply for Leave
        </a>
    </div>
</div>

<div class="stats-row">
    <div class="stat-card">
        <div class="number">@Model.PendingCount</div>
        <div class="label">Pending Requests</div>
    </div>
    <div class="stat-card">
        <div class="number">@Model.UsedCount</div>
        <div class="label">Approved Leaves</div>
    </div>
    <div class="stat-card">
        <div class="number">@Model.LeaveBalances.Sum(b => b.RemainingDays)</div>
        <div class="label">Remaining Balance</div>
    </div>
</div>

<h3 class="section-title">Leave Entitlement Balances</h3>
<div class="balance-grid">
    @foreach (var balance in Model.LeaveBalances)
    {
        <div class="balance-card">
            <h4>@balance.LeaveType</h4>
            <div class="total">@balance.RemainingDays <span style="font-size: 13px; font-weight: 500; color: #7a8863;">/ @balance.TotalDays Days</span></div>
            <div class="details">
                <div>Used: <strong style="color: #ef4444;">@balance.UsedDays</strong></div>
                <div>Remaining: <strong style="color: #10823c;">@balance.RemainingDays</strong></div>
            </div>
        </div>
    }
</div>

<h3 class="section-title">Upcoming Approved Leaves</h3>
<div class="tbl-card">
    <table class="sep-table">
        <thead>
            <tr>
                <th>Type</th>
                <th>From Date</th>
                <th>To Date</th>
                <th>Total Days</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.UpcomingApprovedLeaves.Any())
            {
                @foreach (var leave in Model.UpcomingApprovedLeaves)
                {
                    <tr>
                        <td style="font-weight: 600;">@leave.LeaveType</td>
                        <td>@leave.StartDate.ToString("MMM dd, yyyy")</td>
                        <td>@leave.EndDate.ToString("MMM dd, yyyy")</td>
                        <td>@leave.TotalDays days</td>
                        <td>
                            <span class="status-badge @leave.Status">
                                <i class="bi bi-check-circle-fill"></i> @leave.Status
                            </span>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" style="text-align: center; color: #9ca3af; padding: 36px 24px; font-size: 13.5px;">
                        <i class="bi bi-calendar-check" style="font-size: 2rem; display: block; margin-bottom: 8px;"></i>
                        No upcoming approved leaves found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
