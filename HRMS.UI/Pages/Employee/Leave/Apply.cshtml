@page
@model HRMS.UI.Pages.Employee.Leave.ApplyModel
@{
    ViewData["Title"] = "Apply Leave";
    ViewData["ActiveNav"] = "LeaveDashboard";
}

<style>
    .page-h { font-size: 19px; font-weight: 800; color: #151811; margin: 0 0 3px 0; }
    .page-s { font-size: 12px; color: #7a8863; margin: 0 0 22px 0; }

    /* Form card */
    .form-card {
        max-width: 600px;
        margin: 0 auto;
        background: #fff;
        border: 1px solid #e2e5dc;
        border-radius: 10px;
        box-shadow: 0 1px 2px rgba(0,0,0,.05);
        overflow: hidden;
    }
    .form-card-header {
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #7a8863;
        padding: 14px 20px;
        border-bottom: 1px solid #e2e5dc;
        background: #f9fafb;
    }
    .form-card-body { padding: 20px; }
    
    .fg { margin-bottom: 14px; }
    .fg:last-child { margin-bottom: 0; }
    .fl { font-size: 13px; font-weight: 600; color: #151811; margin-bottom: 5px; display: block; }
    .fi {
        width: 100%; padding: 9px 12px;
        border: 1px solid #d1d5db; border-radius: 6px;
        font-size: 14px; color: #151811;
        font-family: 'Manrope', sans-serif;
        background: #fff; box-sizing: border-box;
        transition: border-color 0.15s, box-shadow 0.15s;
    }
    .fi:focus { outline: none; border-color: #10823c; box-shadow: 0 0 0 2px rgba(16,130,60,.1); }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .req { color: #ef4444; }
    
    .calc-days-panel {
        background: #f6f8f7;
        border: 1px solid #e2e5dc;
        border-radius: 8px;
        padding: 12px;
        text-align: center;
        margin: 16px 0;
    }
    .calc-days-val { font-size: 20px; font-weight: 800; color: #10823c; }

    /* Info Banner */
    .info-banner {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        color: #1e40af;
        padding: 12px 16px;
        border-radius: 8px;
        font-size: 12.5px;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .sub-section-header {
        font-size: 12px;
        font-weight: 800;
        color: #7a8863;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin: 20px 0 10px 0;
        padding-bottom: 6px;
        border-bottom: 1px solid #e2e5dc;
    }

    /* Tabs Horizontal Navbar */
    .k-tabs {
        display: flex;
        border-bottom: 1px solid #e2e5dc;
        padding-left: 0;
        list-style: none;
        gap: 8px;
        margin: 0 0 20px 0;
    }
    .tab-btn {
        background: none;
        border: none;
        padding: 10px 16px;
        font-size: 13.5px;
        font-weight: 600;
        color: #7a8863;
        border-bottom: 2px solid transparent;
        cursor: pointer;
        transition: color 0.15s, border-color 0.15s;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .tab-btn.active {
        color: #10823c;
        border-bottom-color: #10823c;
        font-weight: 700;
    }
    .tab-btn:hover {
        color: #10823c;
    }
</style>

<div class="form-card" style="margin-top: 20px;">
    <div class="form-card-header">Leave Application Hub</div>
    <div class="form-card-body">
        
        <!-- Horizontal Navbar for Tab Navigation -->
        <ul class="k-tabs" id="applyTabs" role="tablist">
            <li class="nav-item">
                <button class="tab-btn active" id="standard-tab" data-tab="standard" type="button">
                    <i class="bi bi-calendar-plus"></i> Standard Leave
                </button>
            </li>
            <li class="nav-item">
                <button class="tab-btn" id="overseas-tab" data-tab="overseas" type="button">
                    <i class="bi bi-globe"></i> Overseas Leave
                </button>
            </li>
            @if (!Model.EmployeeGender.Equals("Male", StringComparison.OrdinalIgnoreCase))
            {
                <li class="nav-item">
                    <button class="tab-btn" id="maternity-tab" data-tab="maternity" type="button">
                        <i class="bi bi-heart-pulse"></i> Maternity Leave
                    </button>
                </li>
            }
        </ul>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="k-alert k-alert-danger" style="margin-bottom: 16px;">
                <i class="bi bi-exclamation-triangle-fill"></i> @Model.ErrorMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="k-alert k-alert-success" style="margin-bottom: 16px;">
                <i class="bi bi-check-circle-fill"></i> @Model.SuccessMessage
            </div>
        }

        <!-- Hidden input to preserve active tab across posts -->
        <form id="tabPreserveForm">
            <input type="hidden" asp-for="ActiveTab" id="activeTabInput" />
        </form>

        <!-- 1. STANDARD LEAVE PANE -->
        <div class="tab-pane" id="standard-pane">
            <h2 class="page-h">Apply for Standard Leave</h2>
            <p class="page-s">Submit an annual, casual, or medical leave request</p>

            <form method="post" asp-page-handler="Apply">
                <input type="hidden" name="ActiveTab" value="standard" />
                <div class="fg">
                    <label class="fl">Leave Type <span class="req">*</span></label>
                    <select asp-for="LeaveType" class="fi" required>
                        <option value="Annual">Annual Leave</option>
                        <option value="Casual">Casual Leave</option>
                        <option value="Medical">Medical Leave</option>
                        <option value="Bereavement">Bereavement Leave</option>
                        <option value="Exam">Exam Leave</option>
                        <option value="Other">Other Leave</option>
                    </select>
                </div>

                <div class="grid-2">
                    <div class="fg">
                        <label class="fl">Start Date <span class="req">*</span></label>
                        <input type="date" asp-for="StartDate" class="fi" required id="startDateInput" />
                    </div>
                    <div class="fg">
                        <label class="fl">End Date <span class="req">*</span></label>
                        <input type="date" asp-for="EndDate" class="fi" required id="endDateInput" />
                    </div>
                </div>

                <div class="calc-days-panel">
                    <span class="calc-days-val" id="daysCount">@Model.CalculatedDays</span>
                    <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #7a8863; margin-top: 2px;">Estimated Leave Day(s)</div>
                </div>

                <div class="fg">
                    <label class="fl">Reason for Leave <span class="req">*</span></label>
                    <textarea asp-for="Reason" class="fi" rows="3" required placeholder="Provide a brief explanation..."></textarea>
                </div>

                <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 20px;">
                    <a href="/Employee/Leave/Dashboard" class="btn-kanrich btn-kanrich-outline">Cancel</a>
                    <button type="submit" class="btn-kanrich btn-kanrich-primary">Submit Application</button>
                </div>
            </form>
        </div>

        <!-- 2. OVERSEAS LEAVE PANE -->
        <div class="tab-pane" id="overseas-pane" style="display: none;">
            <h2 class="page-h">Apply for Overseas Leave</h2>
            <p class="page-s">Submit passport details and contact info for overseas leave approval</p>

            <form method="post" asp-page-handler="Overseas">
                <input type="hidden" name="ActiveTab" value="overseas" />
                <div class="sub-section-header">Leave Period & Reason</div>
                
                <div class="grid-2">
                    <div class="fg">
                        <label class="fl">Start Date <span class="req">*</span></label>
                        <input type="date" asp-for="OverseasStartDate" class="fi" required id="overseasStartInput" />
                    </div>
                    <div class="fg">
                        <label class="fl">End Date <span class="req">*</span></label>
                        <input type="date" asp-for="OverseasEndDate" class="fi" required id="overseasEndInput" />
                    </div>
                </div>

                <div class="fg">
                    <label class="fl">Reason for Overseas Travel <span class="req">*</span></label>
                    <textarea asp-for="OverseasReason" class="fi" rows="2" required placeholder="State purpose of travel..."></textarea>
                </div>

                <div class="sub-section-header">Travel Documents & Contact</div>

                <div class="grid-2">
                    <div class="fg">
                        <label class="fl">Passport Number <span class="req">*</span></label>
                        <input asp-for="PassportNumber" class="fi" placeholder="e.g., N1234567" required />
                    </div>
                    <div class="fg">
                        <label class="fl">Passport Expiry Date <span class="req">*</span></label>
                        <input type="date" asp-for="PassportExpiry" class="fi" required />
                    </div>
                </div>

                <div class="grid-2">
                    <div class="fg">
                        <label class="fl">Destination Country <span class="req">*</span></label>
                        <input asp-for="Country" class="fi" placeholder="e.g., Australia" required />
                    </div>
                    <div class="fg">
                        <label class="fl">Emergency Contact Details</label>
                        <input asp-for="ContactDetails" class="fi" placeholder="Phone/Email while abroad" />
                    </div>
                </div>

                <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 24px;">
                    <a href="/Employee/Leave/Dashboard" class="btn-kanrich btn-kanrich-outline">Cancel</a>
                    <button type="submit" class="btn-kanrich btn-kanrich-primary">Submit Request</button>
                </div>
            </form>
        </div>

        <!-- 3. MATERNITY LEAVE PANE -->
        @if (!Model.EmployeeGender.Equals("Male", StringComparison.OrdinalIgnoreCase))
        {
            <div class="tab-pane" id="maternity-pane" style="display: none;">
                <h2 class="page-h">Apply for Maternity Leave</h2>
                <p class="page-s">Submit maternity details for verification and approval</p>

                <div class="info-banner">
                    <i class="bi bi-info-circle-fill"></i>
                    <span>Maternity leave is subject to HR verification. The standard duration is 84 days.</span>
                </div>

                <form method="post" asp-page-handler="Maternity">
                    <input type="hidden" name="ActiveTab" value="maternity" />
                    <div class="grid-2">
                        <div class="fg">
                            <label class="fl">Start Date <span class="req">*</span></label>
                            <input type="date" asp-for="MaternityStartDate" class="fi" required id="maternityStartInput" />
                        </div>
                        <div class="fg">
                            <label class="fl">End Date <span class="req">*</span></label>
                            <input type="date" asp-for="MaternityEndDate" class="fi" required id="maternityEndInput" />
                        </div>
                    </div>

                    <div class="grid-2">
                        <div class="fg">
                            <label class="fl">Child Number <span class="req">*</span></label>
                            <select asp-for="ChildNumber" class="fi" required>
                                <option value="1">First Child</option>
                                <option value="2">Second Child</option>
                                <option value="3">Third Child</option>
                                <option value="4">Fourth Child</option>
                                <option value="5">Fifth Child</option>
                            </select>
                        </div>
                        <div class="fg">
                            <label class="fl">Expected Delivery Date</label>
                            <input type="date" asp-for="ExpectedDeliveryDate" class="fi" />
                        </div>
                    </div>

                    <div class="fg">
                        <label class="fl">Additional Notes</label>
                        <textarea asp-for="MaternityReason" class="fi" rows="3" placeholder="Enter any comments or specific instructions..."></textarea>
                    </div>

                    <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 20px;">
                        <a href="/Employee/Leave/Dashboard" class="btn-kanrich btn-kanrich-outline">Cancel</a>
                        <button type="submit" class="btn-kanrich btn-kanrich-primary">Submit Request</button>
                    </div>
                </form>
            </div>
        }

    </div>
</div>

@section Scripts {
    <script>
        // Tab switching logic
        const tabBtns = document.querySelectorAll('.tab-btn');
        const tabPanes = document.querySelectorAll('.tab-pane');
        const activeTabInput = document.getElementById('activeTabInput');

        tabBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                tabBtns.forEach(b => b.classList.remove('active'));
                tabPanes.forEach(p => p.style.display = 'none');

                this.classList.add('active');
                const targetId = this.getAttribute('data-tab');
                document.getElementById(targetId + '-pane').style.display = 'block';
                if (activeTabInput) {
                    activeTabInput.value = targetId;
                }
            });
        });

        // Initialize active tab from model state
        const initialTab = '@Model.ActiveTab';
        const initialBtn = document.getElementById(initialTab + '-tab');
        if (initialBtn) {
            initialBtn.click();
        }

        // Standard Leave Day calculations
        const startInput = document.getElementById('startDateInput');
        const endInput = document.getElementById('endDateInput');
        const daysDisplay = document.getElementById('daysCount');

        function updateDays() {
            if (startInput.value && endInput.value) {
                const s = new Date(startInput.value);
                const e = new Date(endInput.value);
                if (s <= e) {
                    let count = 0;
                    let cur = new Date(s);
                    while (cur <= e) {
                        const day = cur.getDay();
                        if (day !== 0 && day !== 6) { // Skip weekends
                            count++;
                        }
                        cur.setDate(cur.getDate() + 1);
                    }
                    daysDisplay.textContent = count;
                } else {
                    daysDisplay.textContent = '0';
                }
            } else {
                daysDisplay.textContent = '—';
            }
        }

        if (startInput && endInput) {
            startInput.addEventListener('change', updateDays);
            endInput.addEventListener('change', updateDays);
        }

        // Maternity Auto End Date pre-calculation (84 days)
        const matStartInput = document.getElementById('maternityStartInput');
        const matEndInput = document.getElementById('maternityEndInput');

        if (matStartInput && matEndInput) {
            matStartInput.addEventListener('change', function() {
                if (matStartInput.value) {
                    const start = new Date(matStartInput.value);
                    start.setDate(start.getDate() + 83);
                    const year = start.getFullYear();
                    const month = String(start.getMonth() + 1).padStart(2, '0');
                    const day = String(start.getDate()).padStart(2, '0');
                    matEndInput.value = `${year}-${month}-${day}`;
                }
            });
        }
    </script>
}
