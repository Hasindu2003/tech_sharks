@page
@model HRMS.UI.Pages.Employee.Overseas.RequestModel
@{
    ViewData["Title"] = "Apply for Overseas Leave";
    ViewData["ActiveNav"] = "LeaveDashboard";
}

<style>
    .page-h { font-size: 19px; font-weight: 800; color: #151811; margin: 0 0 3px 0; }
    .page-s { font-size: 12px; color: #7a8863; margin: 0 0 22px 0; }

    /* Form card */
    .form-card {
        max-width: 600px;
        margin: 0 auto;
        background: #fff;
        border: 1px solid #e2e5dc;
        border-radius: 10px;
        box-shadow: 0 1px 2px rgba(0,0,0,.05);
        overflow: hidden;
    }
    .form-card-header {
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #7a8863;
        padding: 14px 20px;
        border-bottom: 1px solid #e2e5dc;
        background: #f9fafb;
    }
    .form-card-body { padding: 20px; }
    
    .fg { margin-bottom: 14px; }
    .fg:last-child { margin-bottom: 0; }
    .fl { font-size: 13px; font-weight: 600; color: #151811; margin-bottom: 5px; display: block; }
    .fi {
        width: 100%; padding: 9px 12px;
        border: 1px solid #d1d5db; border-radius: 6px;
        font-size: 14px; color: #151811;
        font-family: 'Manrope', sans-serif;
        background: #fff; box-sizing: border-box;
        transition: border-color 0.15s, box-shadow 0.15s;
    }
    .fi:focus { outline: none; border-color: #10823c; box-shadow: 0 0 0 2px rgba(16,130,60,.1); }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .req { color: #ef4444; }

    .sub-section-header {
        font-size: 12px;
        font-weight: 800;
        color: #7a8863;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin: 20px 0 10px 0;
        padding-bottom: 6px;
        border-bottom: 1px solid #e2e5dc;
    }
</style>

<div class="form-card" style="margin-top: 20px;">
    <div class="form-card-header">Overseas Leave Application</div>
    <div class="form-card-body">
        <h2 class="page-h">Overseas Leave Request</h2>
        <p class="page-s">Submit passport details and contact info for overseas leave approval</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="k-alert k-alert-danger" style="margin-bottom: 16px;">
                <i class="bi bi-exclamation-triangle-fill"></i> @Model.ErrorMessage
            </div>
        }

        <form method="post">
            <div class="sub-section-header">Leave Period & Reason</div>
            
            <div class="grid-2">
                <div class="fg">
                    <label class="fl">Start Date <span class="req">*</span></label>
                    <input type="date" asp-for="StartDate" class="fi" required />
                </div>
                <div class="fg">
                    <label class="fl">End Date <span class="req">*</span></label>
                    <input type="date" asp-for="EndDate" class="fi" required />
                </div>
            </div>

            <div class="fg">
                <label class="fl">Reason for Overseas Travel <span class="req">*</span></label>
                <textarea asp-for="Reason" class="fi" rows="2" required placeholder="State purpose of travel..."></textarea>
            </div>

            <div class="sub-section-header">Travel Documents & Contact</div>

            <div class="grid-2">
                <div class="fg">
                    <label class="fl">Passport Number <span class="req">*</span></label>
                    <input asp-for="PassportNumber" class="fi" placeholder="e.g., N1234567" required />
                </div>
                <div class="fg">
                    <label class="fl">Passport Expiry Date <span class="req">*</span></label>
                    <input type="date" asp-for="PassportExpiry" class="fi" required />
                </div>
            </div>

            <div class="grid-2">
                <div class="fg">
                    <label class="fl">Destination Country <span class="req">*</span></label>
                    <input asp-for="Country" class="fi" placeholder="e.g., Australia" required />
                </div>
                <div class="fg">
                    <label class="fl">Emergency Contact Details</label>
                    <input asp-for="ContactDetails" class="fi" placeholder="Phone/Email while abroad" />
                </div>
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 24px;">
                <a href="/Employee/Leave/Dashboard" class="btn-kanrich btn-kanrich-outline">Cancel</a>
                <button type="submit" class="btn-kanrich btn-kanrich-primary">Submit Request</button>
            </div>
        </form>
    </div>
</div>
