@page "{id:int}"
@model HRMS.UI.Pages.HRManager.ReviewResignationModel
@{
    ViewData["Title"] = "Review Resignation";
}

@if (TempData["SuccessMessage"] is string sMsg) { <div class="k-alert k-alert-success"><i class="bi bi-check-circle"></i> @sMsg</div> }
@if (TempData["ErrorMessage"] is string eMsg) { <div class="k-alert k-alert-danger"><i class="bi bi-exclamation-triangle"></i> @eMsg</div> }

@if (Model.ResignationRequest == null)
{
    <div class="k-alert k-alert-danger"><i class="bi bi-exclamation-triangle"></i> Resignation request not found.</div>
}
else
{
    var req = Model.ResignationRequest;
    var nameParts = (req.EmployeeName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = nameParts.Length > 0 ? string.Join("", nameParts.Take(2).Select(w => w[0])).ToUpper() : "EM";
    bool canReview = req.Status == ResignationStatusEnum.AMApproved;

    <div style="margin-bottom:20px">
        <a asp-page="/Separation/Dashboard" asp-route-ActiveTab="Resignations" style="color:#6b7280;text-decoration:none;font-size:0.88rem;display:inline-flex;align-items:center;gap:6px">
            <i class="bi bi-arrow-left"></i> Back
        </a>
        <span style="color:#9ca3af;font-size:0.85rem;margin-left:8px">Request #@req.Id</span>
        <span class="k-badge @req.StatusBadgeClass" style="margin-left:8px">@req.StatusDisplay</span>
    </div>

    <div class="profile-header">
        <div class="profile-info">
            <div class="profile-avatar">@initials</div>
            <div>
                <div class="profile-name">@req.EmployeeName</div>
                <div class="profile-meta">
                    <span><i class="bi bi-hash"></i> @req.EpfNumber</span>
                    <span><i class="bi bi-building"></i> @req.Branch</span>
                    <span><i class="bi bi-diagram-3"></i> @req.Department</span>
                    <span><i class="bi bi-person-badge"></i> @req.Designation</span>
                </div>
            </div>
        </div>
    </div>

    <div class="transfer-detail-grid">
        <div>
            <!-- Resignation Details -->
            <div class="k-card" style="margin-bottom:20px">
                <div class="k-card-header">Resignation Details</div>
                <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;margin-bottom:20px">
                    <div><div class="detail-label">Submitted On</div><div class="detail-value">@req.ResignationDate.ToString("MMM dd, yyyy")</div></div>
                    <div><div class="detail-label">Last Working Day</div><div class="detail-value" style="color:#1a7a3a;font-weight:700">@req.EffectiveDate.ToString("MMM dd, yyyy")</div></div>
                    <div><div class="detail-label">Notice Period</div><div class="detail-value">@req.NoticePeriodDays days</div></div>
                </div>
                <div>
                    <div class="detail-label">Reason for Resignation</div>
                    <div style="background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:14px;margin-top:6px;font-size:0.9rem;color:#374151;line-height:1.6">@req.ReasonForResignation</div>
                </div>
            </div>

            <!-- Prior Reviews: Department Heads -->
            @if (req.DepartmentReviews.Any())
            {
                <div class="k-card" style="margin-bottom:20px">
                    <div class="k-card-header" style="display:flex;justify-content:space-between;align-items:center">
                        <span>Department Head Reviews</span>
                        <span class="k-badge @(req.AreAllDeptHeadsApproved ? "k-badge-approved" : "k-badge-pending")">
                            @req.DeptHeadsApprovedCount/@req.TotalDeptHeadsCount Approved
                        </span>
                    </div>
                    @foreach (var dr in req.DepartmentReviews)
                    {
                        <div style="padding:10px 12px;border:1px solid #e5e7eb;border-radius:6px;margin-bottom:8px;background:#fcfcfc">
                            <div style="display:flex;justify-content:space-between;align-items:center">
                                <span style="font-weight:600;font-size:0.9rem;color:#151811">@dr.DepartmentName Department</span>
                                @if (dr.Status == "Approved")
                                {
                                    <span class="k-badge k-badge-approved"><i class="bi bi-check"></i> Approved</span>
                                }
                                else if (dr.Status == "Rejected")
                                {
                                    <span class="k-badge k-badge-rejected"><i class="bi bi-x"></i> Rejected</span>
                                }
                                else
                                {
                                    <span class="k-badge k-badge-pending">Pending</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(dr.ReviewerName))
                            {
                                <div style="font-size:0.8rem;color:#7a8863;margin-top:2px">Reviewer: @dr.ReviewerName (@(dr.ReviewDate?.ToString("MMM dd, yyyy") ?? ""))</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(dr.Comments))
                            {
                                <div style="font-size:0.85rem;color:#374151;margin-top:4px">"<i>@dr.Comments</i>"</div>
                            }
                        </div>
                    }
                </div>
            }

            <!-- Prior Reviews: Branch Manager -->
            @if (!string.IsNullOrWhiteSpace(req.BMComments))
            {
                <div class="review-card approved" style="margin-bottom:20px">
                    <h6 style="font-weight:700;margin-bottom:8px"><i class="bi bi-clipboard-check"></i> Branch Manager Review</h6>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;font-size:0.88rem">
                        <div><strong>Decision:</strong> @req.BMReview</div>
                        <div><strong>Date:</strong> @req.BMReviewDate?.ToString("MMM dd, yyyy")</div>
                    </div>
                    <div style="margin-top:8px;font-size:0.88rem"><strong>Comments:</strong> @req.BMComments</div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(req.AMComments))
            {
                <div class="review-card approved" style="margin-bottom:20px">
                    <h6 style="font-weight:700;margin-bottom:8px"><i class="bi bi-clipboard-check"></i> Area Manager Review</h6>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;font-size:0.88rem">
                        <div><strong>Decision:</strong> @req.AMReview</div>
                        <div><strong>Date:</strong> @req.AMReviewDate?.ToString("MMM dd, yyyy")</div>
                    </div>
                    <div style="margin-top:8px;font-size:0.88rem"><strong>Comments:</strong> @req.AMComments</div>
                </div>
            }

            <!-- Documents -->
            @if (req.Documents.Any())
            {
                <div class="k-card">
                    <div class="k-card-header">Document Attachments</div>
                    @foreach (var doc in req.Documents)
                    {
                        var ext = doc.FileName.Split('.').LastOrDefault()?.ToLower();
                        var icon = ext switch { "pdf" => "bi-file-earmark-pdf", "jpg" or "jpeg" or "png" => "bi-file-earmark-image", _ => "bi-file-earmark-word" };
                        var iconClass = ext switch { "pdf" => "pdf", "jpg" or "jpeg" or "png" => "img", _ => "doc" };
                        <div class="doc-item">
                            <div class="doc-info">
                                <div class="doc-icon @iconClass"><i class="bi @icon"></i></div>
                                <div><div class="doc-name">@doc.FileName</div><div style="font-size:0.78rem;color:#9ca3af">@doc.UploadedDate.ToString("MMM dd, yyyy")</div></div>
                            </div>
                            <a asp-page="/Resignation/DownloadDocument" asp-route-id="@doc.Id" style="color:#1a7a3a;font-size:1.1rem"><i class="bi bi-download"></i></a>
                        </div>
                    }
                </div>
            }
        </div>

        <div>
            @if (canReview)
            {
                <div class="eligibility-panel">
                    <h5><i class="bi bi-shield-check"></i> HR Manager — Final Approval</h5>
                    <p class="ep-subtitle">Provide final approval per HR policy. Approving generates an acceptance letter.</p>
                    <div class="ep-check-item">
                        <div class="ep-check-circle"></div>
                        <div>
                            <div class="ep-check-label">Notice Period</div>
                            <div class="ep-check-desc">@req.NoticePeriodDays days — Last day: @req.EffectiveDate.ToString("MMM dd, yyyy")</div>
                        </div>
                    </div>
                    <form method="post" class="ep-actions">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@req.Id" />
                        <div style="margin-bottom:10px">
                            <textarea name="comments" placeholder="Final HR remarks, policy compliance notes, or rejection reason (required)..." required minlength="5"
                                      style="width:100%;padding:10px;border-radius:6px;border:1px solid rgba(255,255,255,0.3);background:rgba(255,255,255,0.1);color:#fff;font-family:inherit;resize:vertical;min-height:80px"></textarea>
                        </div>
                        <button type="submit" name="action" value="approve" class="btn-ep-approve">
                            <i class="bi bi-check-circle"></i> Final Approve &amp; Generate Letter
                        </button>
                        <button type="submit" name="action" value="reject" class="btn-ep-reject" onclick="return confirm('Reject this resignation?')">
                            <i class="bi bi-x-circle"></i> Reject
                        </button>
                    </form>
                </div>
            }
            else
            {
                <div class="k-card" style="margin-bottom:16px">
                    <div class="k-alert k-alert-info" style="margin-bottom:0">
                        <i class="bi bi-info-circle"></i>
                        @if (req.Status == ResignationStatusEnum.HRApproved)
                        { <span>This resignation has been approved.</span> }
                        else if (req.Status == ResignationStatusEnum.Completed)
                        { <span>This resignation is fully completed.</span> }
                        else
                        { <span>This request is not yet at the HR approval stage.</span> }
                    </div>
                </div>

                <!-- Acceptance letter link -->
                @if (req.AcceptanceLetterGenerated)
                {
                    <div class="k-card" style="margin-bottom:16px">
                        <div class="k-card-header">Acceptance Letter</div>
                        <div style="padding:12px">
                            <a asp-page="/Resignation/AcceptanceLetter" asp-route-id="@req.Id"
                               class="btn-kanrich btn-kanrich-primary btn-kanrich-sm">
                                <i class="bi bi-file-earmark-check"></i> View Letter
                            </a>
                        </div>
                    </div>
                }

                <!-- Deactivation / reactivation controls -->
                @if (req.Status == ResignationStatusEnum.HRApproved || req.Status == ResignationStatusEnum.Completed)
                {
                    <div class="eligibility-panel">
                        <h5><i class="bi bi-person-gear"></i> Account Management</h5>
                        <p class="ep-subtitle">Effective date: @req.EffectiveDate.ToString("MMMM dd, yyyy")</p>

                        @if (req.CanProcessDeactivation)
                        {
                            <p class="ep-subtitle" style="color:#fbbf24">⚠ Effective date reached — account can now be deactivated.</p>
                            <form method="post" class="ep-actions">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@req.Id" />
                                <button type="submit" asp-page-handler="ProcessEffectiveDate" class="btn-ep-approve"
                                        onclick="return confirm('Deactivate this employee account?')">
                                    <i class="bi bi-person-slash"></i> Process Deactivation
                                </button>
                            </form>
                        }
                        else if (req.AccountDeactivated)
                        {
                            <p class="ep-subtitle">Account deactivated on @req.AccountDeactivatedDate?.ToString("MMM dd, yyyy").</p>
                            <form method="post" class="ep-actions">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@req.Id" />
                                <button type="submit" asp-page-handler="Reactivate" class="btn-ep-approve"
                                        onclick="return confirm('Reactivate this employee account?')">
                                    <i class="bi bi-person-check"></i> Reactivate Account
                                </button>
                            </form>
                        }
                        else
                        {
                            <p class="ep-subtitle">Effective date not yet reached. Account remains active until @req.EffectiveDate.ToString("MMM dd, yyyy").</p>
                        }
                    </div>
                }
            }
        </div>
    </div>
}
