@page
@model HRMS.UI.Pages.HRManager.ReviewResignationsModel
@{
    ViewData["Title"] = "Separation";
}

<div style="margin-bottom:24px">
    <a asp-page="/Separation/Dashboard" style="color:#6b7280;text-decoration:none;display:inline-flex;align-items:center;gap:4px;margin-bottom:12px">
        <i class="bi bi-arrow-left"></i> Back to Separation
    </a>
    <div style="display:flex;justify-content:space-between;align-items:flex-start;">
        <div>
            <h2 style="font-weight:700;font-size:1.6rem;margin-bottom:4px">Review Resignations</h2>
            <p style="color:#6b7280;font-size:0.9rem;margin:0">Manage employee Resignation processes</p>
        </div>
    </div>
</div>

<!-- Pending Final Approval -->
@if (Model.PendingRequests.Any())
{
    <h5 class="section-title">Pending Final Approval</h5>
    <div class="k-card" style="padding:0;overflow:hidden;margin-bottom:24px">
        <table class="k-table" id="tbl-hr-res-pending">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Submission Date</th>
                    <th>Last Working Day</th>
                    <th>Obligations</th>
                    <th>Review</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var req in Model.PendingRequests)
                {
                    var initials = string.Join("", req.EmployeeName.Split(' ').Take(2).Select(w => w[0])).ToUpper();
                    <tr>
                        <td>
                            <div class="employee-cell">
                                <div class="emp-avatar">@initials</div>
                                <div class="emp-details">
                                    <div class="emp-name">@req.EmployeeName</div>
                                    <div class="emp-dept">@req.Designation · @req.Branch</div>
                                </div>
                            </div>
                        </td>
                        <td>@req.ResignationDate.ToString("MMM dd, yyyy")</td>
                        <td style="font-weight:600;color:#1a7a3a">@req.EffectiveDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            @if (req.HasOutstandingLoans || req.IsLoanGuarantor)
                            {
                                <span class="k-badge k-badge-rejected"><i class="bi bi-exclamation-triangle"></i> Yes</span>
                            }
                            else { <span class="k-badge k-badge-approved">None</span> }
                        </td>
                        <td>
                            <a asp-page="/HRManager/ReviewResignation" asp-route-id="@req.Id"
                               class="btn-kanrich btn-kanrich-primary btn-kanrich-sm">Review</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="k-card" style="text-align:center;padding:32px;color:#9ca3af;margin-bottom:24px">
        <i class="bi bi-inbox" style="font-size:2rem;display:block;margin-bottom:8px"></i>
        <div style="font-size:0.9rem">No resignations pending final approval</div>
    </div>
}

<!-- Approved / Completed -->
@if (Model.ApprovedRequests.Any())
{
    <h5 class="section-title">Approved &amp; Completed Resignations</h5>
    <div class="k-card" style="padding:0;overflow:hidden">
        <table class="k-table" id="tbl-hr-res-done">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Last Working Day</th>
                    <th>Status</th>
                    <th>Account</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var req in Model.ApprovedRequests)
                {
                    var initials = string.Join("", req.EmployeeName.Split(' ').Take(2).Select(w => w[0])).ToUpper();
                    <tr>
                        <td>
                            <div class="employee-cell">
                                <div class="emp-avatar">@initials</div>
                                <div class="emp-details">
                                    <div class="emp-name">@req.EmployeeName</div>
                                    <div class="emp-dept">@req.EpfNumber · @req.Branch</div>
                                </div>
                            </div>
                        </td>
                        <td style="font-weight:600;color:#1a7a3a">@req.EffectiveDate.ToString("MMM dd, yyyy")</td>
                        <td><span class="k-badge @req.StatusBadgeClass">@req.StatusDisplay</span></td>
                        <td>
                            @if (req.AccountDeactivated)
                            {
                                <span class="k-badge k-badge-rejected">Deactivated</span>
                            }
                            else
                            {
                                <span class="k-badge k-badge-approved">Active</span>
                            }
                        </td>
                        <td>
                            <a asp-page="/HRManager/ReviewResignation" asp-route-id="@req.Id"
                               class="btn-kanrich btn-kanrich-outline btn-kanrich-sm">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    initTablePagination('tbl-hr-res-pending', 8);
    initTablePagination('tbl-hr-res-done', 8);
});
</script>
}
