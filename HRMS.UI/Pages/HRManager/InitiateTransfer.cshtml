@page
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "HR Manager,HR Officer")]
@model HRMS.UI.Pages.HRManager.InitiateTransferModel
@{
    ViewData["Title"] = "Initiate Transfer";
}

<div class="page-header" style="margin-bottom: 24px;">
    <a asp-page="/Separation/Dashboard" asp-route-ActiveTab="Transfers" class="btn-kanrich btn-kanrich-outline btn-kanrich-sm" style="border: none; padding-left: 0; color: var(--text-secondary); margin-bottom: 12px; font-weight: 600;">
        <i class="bi bi-arrow-left"></i> Back to Separation Hub
    </a>
    <h2>Initiate Transfer</h2>
    <p class="page-subtitle">Initiate a transfer request for an employee in your assigned branches</p>
</div>

<div asp-validation-summary="ModelOnly" class="k-alert k-alert-danger" style="display:@(ViewData.ModelState.ErrorCount > 0 ? "flex" : "none")"></div>

<form method="post" enctype="multipart/form-data" id="transferForm">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start">
        <!-- Left Column: Employee & Branch Selection -->
        <div>
            <!-- Branch & Employee Selection Card -->
            <div class="k-card" style="margin-bottom:20px">
                <div class="k-card-header">
                    <i class="bi bi-person-badge" style="color:#1a7a3a;margin-right:6px"></i> 
                    Employee Selection
                </div>
                
                <!-- 1. Current Branch Selection -->
                <div class="k-form-group">
                    <label asp-for="Input.SelectedBranchId">
                        <i class="bi bi-building" style="color:#1a7a3a;margin-right:4px"></i> Current Branch <span style="color:#ef4444">*</span>
                    </label>
                    <select asp-for="Input.SelectedBranchId" id="currentBranchSelect" class="k-form-control" asp-items="Model.AssignedBranchList">
                        <option value="">-- Select Assigned Branch --</option>
                    </select>
                    <span asp-validation-for="Input.SelectedBranchId" class="text-danger small"></span>
                </div>

                <!-- 2. Employee Selection -->
                <div class="k-form-group">
                    <label asp-for="Input.SelectedEmployeeId">
                        <i class="bi bi-person" style="color:#1a7a3a;margin-right:4px"></i> Employee <span style="color:#ef4444">*</span>
                    </label>
                    <select asp-for="Input.SelectedEmployeeId" id="employeeSelect" style="display:none" asp-items="Model.Employees">
                        <option value="">-- Select Employee --</option>
                    </select>
                    <div class="custom-dropdown" id="employeeDropdown">
                        <div class="custom-dropdown-trigger" id="employeeTrigger">
                            <span id="employeeTriggerText">-- Select Branch First --</span>
                            <i class="bi bi-chevron-down custom-dropdown-chevron"></i>
                        </div>
                        <div class="custom-dropdown-list" id="employeeList">
                            <div class="custom-dropdown-search-box">
                                <i class="bi bi-search custom-dropdown-search-icon"></i>
                                <input type="text" id="employeeSearch" class="custom-dropdown-search-input"
                                       placeholder="Search by EPF number or Name..." autocomplete="off" />
                            </div>
                            <div class="custom-dropdown-options-container" id="employeeOptionsContainer">
                                <div class="custom-dropdown-option" data-value="">-- Select Employee --</div>
                                @foreach (var emp in Model.Employees)
                                {
                                    <div class="custom-dropdown-option" data-value="@emp.Value">@emp.Text</div>
                                }
                            </div>
                            <div class="custom-dropdown-no-results" id="employeeNoResults" style="display:none">No active employees found in this branch.</div>
                        </div>
                    </div>
                    <span asp-validation-for="Input.SelectedEmployeeId" class="text-danger small"></span>
                </div>

                <!-- Selected Employee Summary Card -->
                <div id="empSummaryCard" style="display:none;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:14px;margin-top:12px">
                    <div style="display:flex;align-items:center;gap:12px;margin-bottom:10px">
                        <div id="empAvatar" style="width:38px;height:38px;border-radius:50%;background:#e8f3ec;color:#10823c;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px">EM</div>
                        <div>
                            <div id="empName" style="font-size:14px;font-weight:700;color:#151811">Employee Name</div>
                            <div id="empSub" style="font-size:12px;color:#64748b">EPF · Designation</div>
                        </div>
                    </div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:12px;border-top:1px solid #e2e8f0;padding-top:8px">
                        <div><span style="color:#64748b">Department:</span> <strong id="empDept" style="color:#1e293b">-</strong></div>
                        <div><span style="color:#64748b">Current Branch:</span> <strong id="empBranch" style="color:#1e293b">-</strong></div>
                        <div><span style="color:#64748b">Service Period:</span> <strong id="empService" style="color:#1e293b">-</strong></div>
                        <div><span style="color:#64748b">Email:</span> <strong id="empEmail" style="color:#1e293b">-</strong></div>
                    </div>
                </div>
            </div>

            <!-- Document Upload -->
            <div class="k-card">
                <div class="k-card-header"><i class="bi bi-paperclip" style="color:#1a7a3a;margin-right:6px"></i> Supporting Document (Optional)</div>
                <div class="k-form-group" style="margin-bottom:0">
                    <input asp-for="Input.Document" class="k-form-control" type="file"
                           accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
                    <div style="font-size:0.78rem;color:#9ca3af;margin-top:6px">Allowed: PDF, DOC, DOCX, JPG, PNG. Max size: 5 MB.</div>
                    <span asp-validation-for="Input.Document" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <!-- Right Column: Transfer Details -->
        <div>
            <div class="k-card" style="margin-bottom:20px">
                <div class="k-card-header"><i class="bi bi-arrow-left-right" style="color:#1a7a3a;margin-right:6px"></i> Transfer Details</div>

                <div class="k-form-group">
                    <label asp-for="Input.RequestedBranch">
                        <i class="bi bi-geo-alt" style="color:#1a7a3a;margin-right:4px"></i> Target Branch <span style="color:#ef4444">*</span>
                    </label>
                    <select asp-for="Input.RequestedBranch" id="branchSelect" class="k-form-control">
                        <option value="">-- Select Target Branch --</option>
                        @foreach (var branch in Model.AllBranches)
                        {
                            <option value="@branch">@branch</option>
                        }
                    </select>
                    <span asp-validation-for="Input.RequestedBranch" class="text-danger small"></span>
                </div>

                <div class="k-form-group">
                    <label asp-for="Input.PreferredDate">
                        <i class="bi bi-calendar-event" style="color:#1a7a3a;margin-right:4px"></i> Preferred Transfer Date <span style="color:#ef4444">*</span>
                    </label>
                    <input asp-for="Input.PreferredDate" class="k-form-control" type="date"
                           min="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")"
                           max="@DateTime.Today.AddYears(1).ToString("yyyy-MM-dd")" />
                    <div style="font-size:0.78rem;color:#9ca3af;margin-top:4px">Must be at least 7 days from today and within 1 year.</div>
                    <span asp-validation-for="Input.PreferredDate" class="text-danger small"></span>
                </div>

                <div class="k-form-group" style="margin-bottom:0">
                    <label asp-for="Input.Reason">
                        <i class="bi bi-chat-left-text" style="color:#1a7a3a;margin-right:4px"></i> Reason for Transfer <span style="color:#ef4444">*</span>
                    </label>
                    <textarea asp-for="Input.Reason" class="k-form-control" rows="5" maxlength="500"
                              placeholder="Please explain the reason for initiating this transfer (minimum 20 characters)"></textarea>
                    <div style="display:flex;justify-content:space-between;margin-top:4px;font-size:0.78rem;color:#9ca3af">
                        <span><span id="charCount">0</span>/500 characters</span>
                        <span>Min 20 characters</span>
                    </div>
                    <span asp-validation-for="Input.Reason" class="text-danger small"></span>
                </div>
            </div>

            <div style="display:flex;flex-direction:column;gap:10px">
                <button type="submit" class="btn-kanrich btn-kanrich-primary btn-kanrich-lg" style="justify-content:center;width:100%">
                    <i class="bi bi-send"></i> Initiate Transfer Request
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .custom-dropdown {
            position: relative;
        }
        .custom-dropdown-trigger {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.5rem 0.75rem;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            background: #fff;
            cursor: pointer;
            font-size: 0.95rem;
            color: #374151;
            user-select: none;
            transition: border-color 0.15s;
        }
        .custom-dropdown-trigger:hover {
            border-color: #1a7a3a;
        }
        .custom-dropdown-trigger.open {
            border-color: #1a7a3a;
            box-shadow: 0 0 0 2px rgba(26,122,58,0.15);
        }
        .custom-dropdown-chevron {
            transition: transform 0.2s;
            color: #6b7280;
            font-size: 0.8rem;
        }
        .custom-dropdown-trigger.open .custom-dropdown-chevron {
            transform: rotate(180deg);
        }
        .custom-dropdown-list {
            display: none;
            position: absolute;
            top: calc(100% + 4px);
            left: 0;
            right: 0;
            background: #fff;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.12);
            max-height: calc(6 * 2.5rem + 3rem);
            overflow-y: auto;
            z-index: 999;
        }
        .custom-dropdown-list.open {
            display: block;
        }
        .custom-dropdown-option {
            padding: 0.6rem 0.75rem;
            cursor: pointer;
            font-size: 0.95rem;
            color: #374151;
            transition: background 0.1s;
        }
        .custom-dropdown-option:hover {
            background: #f0faf4;
            color: #1a7a3a;
        }
        .custom-dropdown-option.selected {
            background: #e6f4ec;
            color: #1a7a3a;
            font-weight: 600;
        }
        .custom-dropdown-option[data-value=""] {
            color: #9ca3af;
        }
        .custom-dropdown-search-box {
            position: sticky;
            top: 0;
            background: #fff;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 0.75rem;
            border-bottom: 1px solid #e5e7eb;
            z-index: 1;
        }
        .custom-dropdown-search-icon {
            color: #9ca3af;
            font-size: 0.85rem;
            flex-shrink: 0;
        }
        .custom-dropdown-search-input {
            border: none;
            outline: none;
            flex: 1;
            font-size: 0.9rem;
            color: #374151;
            background: transparent;
        }
        .custom-dropdown-search-input::placeholder {
            color: #9ca3af;
        }
        .custom-dropdown-no-results {
            padding: 0.6rem 0.75rem;
            color: #9ca3af;
            font-size: 0.9rem;
            text-align: center;
        }
    </style>
    <script>
        let currentBranchEmployees = [];

        const reasonField = document.getElementById('Input_Reason');
        const charCount = document.getElementById('charCount');
        if (reasonField && charCount) {
            charCount.textContent = reasonField.value.length;
            reasonField.addEventListener('input', function () {
                charCount.textContent = this.value.length;
            });
        }

        const dateField = document.getElementById('Input_PreferredDate');
        if (dateField) {
            dateField.addEventListener('change', function () {
                const selected = new Date(this.value);
                const minDate = new Date();
                minDate.setDate(minDate.getDate() + 7);
                minDate.setHours(0, 0, 0, 0);
                if (selected < minDate) {
                    alert('Preferred date must be at least 7 days from today.');
                    this.value = '';
                }
            });
        }

        const fileInput = document.getElementById('Input_Document');
        if (fileInput) {
            fileInput.addEventListener('change', function () {
                if (this.files.length > 0 && this.files[0].size > 5 * 1024 * 1024) {
                    alert('File size must not exceed 5 MB.');
                    this.value = '';
                }
            });
        }

        // Custom Employee Dropdown Logic
        const employeeSelect = document.getElementById('employeeSelect');
        const employeeTrigger = document.getElementById('employeeTrigger');
        const employeeTriggerText = document.getElementById('employeeTriggerText');
        const employeeList = document.getElementById('employeeList');
        const employeeDropdown = document.getElementById('employeeDropdown');
        const employeeSearch = document.getElementById('employeeSearch');
        const employeeOptionsContainer = document.getElementById('employeeOptionsContainer');
        const employeeNoResults = document.getElementById('employeeNoResults');
        const currentBranchSelect = document.getElementById('currentBranchSelect');
        const targetBranchSelect = document.getElementById('branchSelect');

        function closeEmployeeDropdown() {
            employeeList.classList.remove('open');
            employeeTrigger.classList.remove('open');
            if (employeeSearch) {
                employeeSearch.value = '';
                filterEmployeeOptions('');
            }
        }

        employeeTrigger.addEventListener('click', function () {
            if (!currentBranchSelect.value) {
                alert('Please select a Current Branch first.');
                currentBranchSelect.focus();
                return;
            }
            const isOpen = employeeList.classList.contains('open');
            employeeList.classList.toggle('open', !isOpen);
            employeeTrigger.classList.toggle('open', !isOpen);
            if (!isOpen && employeeSearch) {
                setTimeout(() => employeeSearch.focus(), 50);
            }
        });

        document.addEventListener('click', function (e) {
            if (!employeeDropdown.contains(e.target)) {
                closeEmployeeDropdown();
            }
        });

        function filterEmployeeOptions(query) {
            const cleanQuery = (query || '').trim().toLowerCase();
            const options = employeeOptionsContainer.querySelectorAll('.custom-dropdown-option');
            let anyVisible = false;

            options.forEach(function (opt) {
                const val = opt.dataset.value;
                if (!val) {
                    opt.style.display = cleanQuery ? 'none' : '';
                    return;
                }
                const text = opt.textContent.toLowerCase();
                const epfMatch = (opt.textContent.match(/\(([^)]+)\)/) || [])[1] || '';
                const match = !cleanQuery || text.includes(cleanQuery) || epfMatch.toLowerCase().includes(cleanQuery);
                opt.style.display = match ? '' : 'none';
                if (match) anyVisible = true;
            });

            if (employeeNoResults) {
                employeeNoResults.style.display = (options.length > 1 && !anyVisible) ? '' : 'none';
            }
        }

        if (employeeSearch) {
            employeeSearch.addEventListener('click', e => e.stopPropagation());
            employeeSearch.addEventListener('input', function () {
                filterEmployeeOptions(this.value);
            });
        }

        function updateEmployeeSummary(emp) {
            const summaryCard = document.getElementById('empSummaryCard');
            if (!emp) {
                summaryCard.style.display = 'none';
                return;
            }
            summaryCard.style.display = 'block';
            
            const fullName = (emp.fullName || emp.FullName || 'Unknown Employee').trim();
            const epf = emp.epfNumber || emp.EPFNumber || emp.epfnumber || 'N/A';
            const designation = (emp.designationTitle || emp.DesignationTitle || '').trim();
            const department = (emp.departmentName || emp.DepartmentName || '').trim();
            const branch = emp.branchName || emp.BranchName || 'N/A';
            const dateJoined = emp.dateJoined || emp.DateJoined || '-';
            const years = (emp.yearsOfService !== undefined) ? emp.yearsOfService : (emp.YearsOfService !== undefined ? emp.YearsOfService : 0);
            const email = emp.email || emp.Email || '-';

            const nameParts = fullName.split(' ').filter(p => p.length > 0);
            const initials = nameParts.length > 0 ? nameParts.slice(0, 2).map(w => w[0]).join('').toUpperCase() : 'EM';

            const desigDisplay = (designation && designation !== 'N/A') ? designation : (department && department !== 'N/A' && department !== 'General' ? department : 'General Staff');

            document.getElementById('empAvatar').textContent = initials;
            document.getElementById('empName').textContent = fullName;
            document.getElementById('empSub').textContent = `${epf} · ${desigDisplay}`;
            document.getElementById('empDept').textContent = department && department !== 'N/A' ? department : 'General';
            document.getElementById('empBranch').textContent = branch;
            document.getElementById('empService').textContent = `${years} Years (Joined ${dateJoined})`;
            document.getElementById('empEmail').textContent = email;

            // Filter target branch dropdown so it does not contain the employee's current branch
            if (targetBranchSelect && branch && branch !== 'N/A') {
                for (let i = 0; i < targetBranchSelect.options.length; i++) {
                    const opt = targetBranchSelect.options[i];
                    if (opt.value && opt.value.toLowerCase() === branch.toLowerCase()) {
                        opt.disabled = true;
                        opt.style.display = 'none';
                        if (targetBranchSelect.value === opt.value) {
                            targetBranchSelect.value = '';
                        }
                    } else {
                        opt.disabled = false;
                        opt.style.display = '';
                    }
                }
            }
        }

        function bindEmployeeOptions(employees) {
            currentBranchEmployees = employees || [];
            employeeOptionsContainer.innerHTML = '<div class="custom-dropdown-option" data-value="">-- Select Employee --</div>';
            employeeSelect.innerHTML = '<option value="">-- Select Employee --</option>';

            if (!employees || employees.length === 0) {
                employeeTriggerText.textContent = '-- No Employees Found --';
                employeeNoResults.style.display = '';
                updateEmployeeSummary(null);
                return;
            }

            employeeNoResults.style.display = 'none';
            employeeTriggerText.textContent = '-- Select Employee --';

            employees.forEach(emp => {
                const fullName = emp.fullName || emp.FullName || 'Unknown';
                const epf = emp.epfNumber || emp.EPFNumber || emp.epfnumber || 'N/A';
                const designation = (emp.designationTitle || emp.DesignationTitle || '').trim();
                const department = (emp.departmentName || emp.DepartmentName || '').trim();
                const empId = emp.id !== undefined ? emp.id : (emp.Id !== undefined ? emp.Id : '');

                const desigSuffix = (designation && designation !== 'N/A') ? ` - ${designation}` : (department && department !== 'N/A' && department !== 'General' ? ` - ${department}` : '');
                const optText = `${fullName} (${epf})${desigSuffix}`;
                
                // Select element
                const selectOpt = document.createElement('option');
                selectOpt.value = empId;
                selectOpt.textContent = optText;
                employeeSelect.appendChild(selectOpt);

                // Custom dropdown item
                const dropOpt = document.createElement('div');
                dropOpt.className = 'custom-dropdown-option';
                dropOpt.dataset.value = empId;
                dropOpt.textContent = optText;
                dropOpt.addEventListener('click', function () {
                    const val = this.dataset.value;
                    employeeSelect.value = val;
                    employeeTriggerText.textContent = val ? this.textContent.trim() : '-- Select Employee --';
                    
                    employeeOptionsContainer.querySelectorAll('.custom-dropdown-option').forEach(o => o.classList.remove('selected'));
                    if (val) this.classList.add('selected');

                    closeEmployeeDropdown();
                    const selectedEmp = currentBranchEmployees.find(e => (e.id !== undefined ? e.id : e.Id) == val);
                    updateEmployeeSummary(selectedEmp);
                });
                employeeOptionsContainer.appendChild(dropOpt);
            });
        }

        // When Current Branch changes
        if (currentBranchSelect) {
            currentBranchSelect.addEventListener('change', async function () {
                const branchId = this.value;
                employeeSelect.value = '';
                employeeTriggerText.textContent = branchId ? 'Loading employees...' : '-- Select Branch First --';
                updateEmployeeSummary(null);

                // Also update target branch dropdown to disable the selected originating branch
                const selectedBranchName = currentBranchSelect.options[currentBranchSelect.selectedIndex]?.text;
                if (targetBranchSelect && selectedBranchName) {
                    for (let i = 0; i < targetBranchSelect.options.length; i++) {
                        const opt = targetBranchSelect.options[i];
                        if (opt.value && opt.value.toLowerCase() === selectedBranchName.toLowerCase()) {
                            opt.disabled = true;
                            opt.style.display = 'none';
                            if (targetBranchSelect.value === opt.value) {
                                targetBranchSelect.value = '';
                            }
                        } else {
                            opt.disabled = false;
                            opt.style.display = '';
                        }
                    }
                }

                if (!branchId) {
                    bindEmployeeOptions([]);
                    return;
                }

                try {
                    const response = await fetch(`?handler=EmployeesByBranch&branchId=${branchId}`);
                    if (response.ok) {
                        const employees = await response.json();
                        bindEmployeeOptions(employees);
                    } else {
                        bindEmployeeOptions([]);
                    }
                } catch (err) {
                    console.error('Failed to load branch employees', err);
                    bindEmployeeOptions([]);
                }
            });

            // If a branch is pre-selected (e.g. only 1 assigned branch or validation reload)
            if (currentBranchSelect.value) {
                currentBranchSelect.dispatchEvent(new Event('change'));
            }
        }
    </script>
}
