@page
@model HRMS.UI.Pages.Employees.CreateModel
@{
    ViewData["Title"] = "Add Employee";
    ViewData["PageTitle"] = "Employees";
    ViewData["ActiveNav"] = "Employees";
}

<style>
    /* Natively Scaled Create Employee Form (~80%) */
    .page-content { background: #ffffff !important; }

    .field-error {
        display: none; font-size: 11px; color: #dc3545; margin-top: 3px;
        font-weight: 500;
    }
    
    .create-page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 26px;
    }

    .create-page-title {
        font-family: 'Manrope', sans-serif;
        font-size: 19px;
        font-weight: 700;
        color: #151811;
        margin: 0 0 4px 0;
    }

    .create-page-subtitle {
        font-family: 'Manrope', sans-serif;
        font-size: 13px;
        font-weight: 400;
        color: #7a8863;
        margin: 0;
    }

    .form-actions {
        display: flex;
        gap: 10px;
    }

    .btn-cancel {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 9px 17px;
        border: 1px solid #e2e5dc;
        border-radius: 6px;
        background: transparent;
        font-family: 'Manrope', sans-serif;
        font-size: 13px;
        font-weight: 700;
        color: #151811;
        text-decoration: none;
        cursor: pointer;
    }

    .btn-draft {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 9px 17px;
        border: 1px solid #10823c;
        border-radius: 6px;
        background: transparent;
        font-family: 'Manrope', sans-serif;
        font-size: 13px;
        font-weight: 700;
        color: #10823c;
        cursor: pointer;
    }

    .btn-save {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 9px 17px;
        border: none;
        border-radius: 6px;
        background: #10823c;
        font-family: 'Manrope', sans-serif;
        font-size: 13px;
        font-weight: 700;
        color: #ffffff;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
        cursor: pointer;
    }

    /* Form Section Card */
    .form-section {
        background: #ffffff;
        border: 1px solid #e2e5dc;
        border-radius: 10px;
        margin-bottom: 20px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .form-section-header {
        background: #f9fafb;
        border-bottom: 1px solid #e2e5dc;
        padding: 13px 19px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .form-section-title {
        font-family: 'Manrope', sans-serif;
        font-size: 14px;
        font-weight: 700;
        color: #151811;
        margin: 0;
    }

    .form-section-body {
        padding: 19px;
    }

    /* 4-Column Grid */
    .form-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px 24px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .form-group.col-span-2, .col-span-2 {
        grid-column: span 2;
    }

    .form-group.col-span-3, .col-span-3 {
        grid-column: span 3;
    }

    .form-group.col-span-4, .col-span-4 {
        grid-column: span 4;
    }

    .form-label {
        font-family: 'Manrope', sans-serif;
        font-size: 11px;
        font-weight: 500;
        color: #7a8863;
        margin: 0;
    }

    .required-mark {
        color: #ef4444;
    }

    .form-control, .form-select {
        width: 100%;
        height: 38px;
        padding: 8px 14px;
        background: #ffffff;
        border: 1px solid #e2e5dc;
        border-radius: 6px;
        font-family: 'Manrope', sans-serif;
        font-size: 13px;
        font-weight: 400;
        color: #151811;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
        appearance: none;
    }

    .form-control::placeholder {
        color: #6b7280;
    }

    .form-control:focus, .form-select:focus {
        border-color: #10823c;
        box-shadow: 0 0 0 1px rgba(16, 130, 60, 0.2);
    }
    
    .select-wrapper {
        position: relative;
        width: 100%;
    }
    
    .select-wrapper::after {
        content: "";
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        width: 14px;
        height: 14px;
        background-image: url('data:image/svg+xml;utf8,<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 9L12 15L18 9" stroke="%23151811" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>');
        background-size: contain;
        background-repeat: no-repeat;
        pointer-events: none;
    }

    textarea.form-control {
        height: 114px;
        resize: none;
    }

    /* Spouse Sub-section */
    .spouse-box {
        background: #f9fafb;
        border: 1px dashed #e2e5dc;
        border-radius: 6px;
        padding: 14px;
        display: flex;
        flex-direction: column;
        gap: 13px;
    }

    .spouse-box-header {
        display: flex;
        align-items: center;
        gap: 6px;
        border-bottom: 1px solid #e5e7eb;
        padding-bottom: 7px;
    }

    .spouse-box-title {
        font-family: 'Manrope', sans-serif;
        font-size: 11px;
        font-weight: 700;
        color: #151811;
        margin: 0;
    }
</style>

<div style="padding: 26px;">
    
    <form method="post" enctype="multipart/form-data" novalidate id="employeeCreateForm">
        <input type="hidden" asp-for="DraftId" />
        <input type="hidden" asp-for="EmployeeId" />
        
        <!-- Header -->
        <div class="create-page-header">
            <div>
                <h2 class="create-page-title">@(Model.EmployeeId.HasValue ? "Edit Employee Profile" : "New Employee Profile")</h2>
                <p class="create-page-subtitle">@(Model.EmployeeId.HasValue ? "Modify the details of an existing employee record." : "Fill in the required details to create a new employee record.")</p>
            </div>
            <div class="form-actions">
                <a href="/Employees" class="btn-cancel">Cancel</a>
                
                @if (!Model.EmployeeId.HasValue)
                {
                    <button type="submit" asp-page-handler="Draft" formnovalidate class="btn-draft">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                        Save as Draft
                    </button>
                }
                
                <button type="submit" class="btn-save">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
                    @(Model.EmployeeId.HasValue ? "Update Employee" : "Save Employee")
                </button>
            </div>
        </div>

        @if (!ModelState.IsValid)
        {
            <div style="color:red; margin-bottom: 16px; font-size:13px;" asp-validation-summary="All"></div>
        }

        <!-- PERSONAL INFORMATION -->
        <div class="form-section">
            <div class="form-section-header">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#151811" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                <h3 class="form-section-title">Personal Information</h3>
            </div>
            <div class="form-section-body form-grid">
                
                <!-- Row 1 -->
                <div class="form-group col-span-2">
                    <label class="form-label">Full Name <span class="required-mark">*</span></label>
                    <input asp-for="NewEmployee.FullName" class="form-control" placeholder="e.g. Johnathan David Cooper" id="fullNameInput" required />
                    <span asp-validation-for="NewEmployee.FullName" id="fullNameError" class="field-error"></span>
                </div>
                <div class="form-group col-span-2">
                    <label class="form-label">Name with Initials <span class="required-mark">*</span></label>
                    <input asp-for="NewEmployee.Initials" class="form-control" placeholder="e.g. J.D. Cooper" id="initialsInput" required />
                    <span asp-validation-for="NewEmployee.Initials" id="initialsError" class="field-error"></span>
                </div>

                <!-- Row 2 -->
                <div class="form-group">
                    <label class="form-label">NIC Number <span class="required-mark">*</span></label>
                    <input asp-for="NewEmployee.NIC" class="form-control" placeholder="e.g. 199012345678" id="nicInput" />
                    <span asp-validation-for="NewEmployee.NIC" id="nicError" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label class="form-label">Date of Birth <span class="required-mark">*</span></label>
                    <input type="date" name="NewEmployee.DateOfBirth" value="@(Model.NewEmployee.DateOfBirth == default ? "" : Model.NewEmployee.DateOfBirth.ToString("yyyy-MM-dd"))" class="form-control" id="dobInput" />
                    <span asp-validation-for="NewEmployee.DateOfBirth" id="dobError" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label class="form-label">Sex <span class="required-mark">*</span></label>
                    <div class="select-wrapper">
                        <select asp-for="NewEmployee.Sex" asp-items="Model.SexList" class="form-select" id="sexSelect" required>
                            <option value="">Select Gender</option>
                        </select>
                    </div>
                    <span asp-validation-for="NewEmployee.Sex" id="sexError" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label class="form-label">Phone Number <span class="required-mark">*</span></label>
                    <input asp-for="NewEmployee.PhoneNumber" class="form-control" placeholder="e.g. 0771234567" id="phoneInput" maxlength="10" />
                    <span asp-validation-for="NewEmployee.PhoneNumber" id="phoneError" class="field-error"></span>
                </div>


                <!-- Row 3 -->
                <div class="form-group col-span-2">
                    <label class="form-label">Email Address <span class="required-mark">*</span></label>
                    <input asp-for="NewEmployee.Email" type="email" class="form-control" placeholder="e.g. employee@kanrich.lk" id="emailInput" required />
                    <span asp-validation-for="NewEmployee.Email" id="emailError" class="field-error"></span>
                </div>
                <div class="form-group col-span-2">
                    <label class="form-label">Residential Address <span class="required-mark">*</span></label>
                    <input asp-for="NewEmployee.ResidentialAddress" class="form-control" placeholder="e.g. 33, Walawwatta, Thalawitiya" id="residentialAddressInput" required />
                    <span asp-validation-for="NewEmployee.ResidentialAddress" id="addressError" class="field-error"></span>
                </div>

                <!-- Row 4 -->
                <div class="form-group col-span-4 spouse-box">
                    <div class="spouse-box-header">
                        <input type="checkbox" id="spouseCheckbox" style="width:14px; height:14px; accent-color: #10823c; cursor:pointer;" />
                        <label for="spouseCheckbox" class="spouse-box-title" style="cursor:pointer; margin:0;">Spouse Details (If Married)</label>
                    </div>
                    <div id="spouseFieldsContainer" style="display:grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                        <div class="form-group">
                            <label class="form-label">Spouse Name</label>
                            <input asp-for="NewEmployee.SpouseName" class="form-control" placeholder="Full name of spouse" id="spouseNameInput" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Spouse Contact No</label>
                            <input asp-for="NewEmployee.SpouseContactNo" class="form-control" placeholder="e.g. 0771234567" id="spousePhoneInput" maxlength="10" />
                            <span asp-validation-for="NewEmployee.SpouseContactNo" id="spousePhoneError" class="field-error"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- EMPLOYMENT DETAILS -->
        <div class="form-section">
            <div class="form-section-header">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#151811" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                <h3 class="form-section-title">Employment Details</h3>
            </div>
            <div class="form-section-body form-grid">
                
                <!-- Row 1 -->
                <input type="hidden" asp-for="SelectedRole" value="Employee" />
                <div class="form-group">
                    <label class="form-label">Employee Type <span class="required-mark">*</span></label>
                    <div class="select-wrapper">
                        <select asp-for="NewEmployee.EmployeeType" asp-items="Model.EmployeeTypeList" class="form-select" id="employeeTypeSelect" required>
                            <option value="">Select Type</option>
                        </select>
                    </div>
                    <span asp-validation-for="NewEmployee.EmployeeType" id="employeeTypeError" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label class="form-label">Branch <span class="required-mark">*</span></label>
                    <div class="select-wrapper">
                        <select asp-for="NewEmployee.BranchId" asp-items="Model.BranchList" class="form-select" id="branchSelect" required>
                            <option value="">Select Branch</option>
                        </select>
                    </div>
                    <span asp-validation-for="NewEmployee.BranchId" id="branchError" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label class="form-label">Department <span class="required-mark">*</span></label>
                    <div class="select-wrapper">
                        <select asp-for="NewEmployee.DepartmentId" asp-items="Model.DepartmentList" class="form-select" id="departmentSelect" required>
                            <option value="">@(Model.NewEmployee.BranchId > 0 ? "Select Department" : "Select Branch First")</option>
                        </select>
                    </div>
                    <span asp-validation-for="NewEmployee.DepartmentId" id="departmentError" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label class="form-label">Current Designation <span class="required-mark">*</span></label>
                    <div class="select-wrapper">
                        <select asp-for="NewEmployee.DesignationId" asp-items="Model.DesignationList" class="form-select" id="designationSelect" required>
                            <option value="">@(Model.NewEmployee.DepartmentId.HasValue && Model.NewEmployee.DepartmentId.Value > 0 ? "Select Designation" : "Select Department First")</option>
                        </select>
                    </div>
                    <span asp-validation-for="NewEmployee.DesignationId" id="designationError" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label class="form-label">Date Joined <span class="required-mark">*</span></label>
                    <input type="date" asp-for="NewEmployee.DateJoined" class="form-control" id="dateJoinedInput" />
                    <span asp-validation-for="NewEmployee.DateJoined" id="dateJoinedError" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label class="form-label">Date Confirmed</label>
                    <input type="date" asp-for="NewEmployee.DateConfirmed" class="form-control" id="dateConfirmedInput" />
                    <span asp-validation-for="NewEmployee.DateConfirmed" id="dateConfirmedError" class="field-error"></span>
                </div>

                <!-- Row 3: Conditional Period -->
                <div class="form-group" id="probationPeriodGroup" style="display:none;">
                    <label class="form-label">Probation Period (Months)</label>
                    <input type="number" min="0" max="36" asp-for="NewEmployee.ProbationPeriodMonths" class="form-control" placeholder="e.g. 6" />
                </div>
                <div class="form-group" id="internPeriodGroup" style="display:none;">
                    <label class="form-label">Intern Period (Months)</label>
                    <input type="number" min="0" max="36" asp-for="NewEmployee.InternPeriodMonths" class="form-control" placeholder="e.g. 3" id="internPeriodInput" />
                </div>
                
                <div class="form-group">
                    <label class="form-label">Previous Experience (Years)</label>
                    <input type="number" step="0.5" min="0" max="60" name="NewEmployee.PreviousExperienceYears" id="NewEmployee_PreviousExperienceYears" value="@(Model.NewEmployee.PreviousExperienceYears <= 0 ? "" : Model.NewEmployee.PreviousExperienceYears.ToString("0.##"))" class="form-control" placeholder="e.g. 2.5" />
                    <span id="expError" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label class="form-label">EPF Number <span class="required-mark">*</span></label>
                    <input asp-for="NewEmployee.EPFNumber" class="form-control" placeholder="e.g. 10452" id="epfInput" required />
                    <span asp-validation-for="NewEmployee.EPFNumber" id="epfError" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label class="form-label">ETF Number <span class="required-mark">*</span></label>
                    <input asp-for="NewEmployee.ETFNumber" class="form-control" placeholder="e.g. 10452" id="etfInput" required />
                    <span asp-validation-for="NewEmployee.ETFNumber" id="etfError" class="field-error"></span>
                </div>
            </div>
        </div>

        <!-- SALARY & BANKING DETAILS -->
        <div class="form-section">
            <div class="form-section-header">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#151811" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    <line x1="12" y1="8" x2="12" y2="16"></line>
                    <line x1="8" y1="12" x2="16" y2="12"></line>
                </svg>
                <h3 class="form-section-title">Salary &amp; Banking Details</h3>
            </div>
            <div class="form-section-body form-grid">
                <!-- Basic Salary -->
                <div class="form-group col-span-2">
                    <label class="form-label">Basic Salary (LKR)</label>
                    <input type="number" step="0.01" min="0" asp-for="BasicSalary" class="form-control" id="basicSalaryInput" placeholder="e.g. 75000.00" />
                    <span asp-validation-for="BasicSalary" class="field-error"></span>
                </div>

                <!-- Bank Name -->
                <div class="form-group col-span-2">
                    <label class="form-label">Bank Name</label>
                    <input asp-for="NewEmployee.BankName" list="bankList" class="form-control" placeholder="e.g. Commercial Bank of Ceylon" id="bankNameInput" />
                    <datalist id="bankList">
                        <option value="Bank of Ceylon" />
                        <option value="Commercial Bank of Ceylon" />
                        <option value="People's Bank" />
                        <option value="Sampath Bank" />
                        <option value="Hatton National Bank" />
                        <option value="Seylan Bank" />
                        <option value="Nations Trust Bank" />
                        <option value="DFCC Bank" />
                        <option value="National Savings Bank" />
                        <option value="Pan Asia Bank" />
                        <option value="Union Bank" />
                        <option value="Standard Chartered Bank" />
                        <option value="HSBC Sri Lanka" />
                    </datalist>
                    <span asp-validation-for="NewEmployee.BankName" class="field-error"></span>
                </div>

                <!-- Bank Account Name -->
                <div class="form-group col-span-2">
                    <label class="form-label">Bank Account Holder Name</label>
                    <input asp-for="NewEmployee.BankAccountName" class="form-control" placeholder="e.g. K.R. Perera" id="bankAccountNameInput" />
                    <span asp-validation-for="NewEmployee.BankAccountName" class="field-error"></span>
                </div>

                <!-- Bank Account Number -->
                <div class="form-group col-span-2">
                    <label class="form-label">Bank Account Number</label>
                    <input asp-for="NewEmployee.BankAccountNumber" class="form-control" placeholder="e.g. 100234567890" id="bankAccountNumberInput" />
                    <span asp-validation-for="NewEmployee.BankAccountNumber" class="field-error"></span>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="form-section-header">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#151811" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M9 15h6"></path><path d="M12 12v6"></path></svg>
                <h3 class="form-section-title">Supporting Documents</h3>
            </div>
            <div class="form-section-body form-grid">
                <div class="form-group col-span-2">
                    <label class="form-label">Scanned ID Card</label>
                    <input asp-for="IdCardScan" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" />
                    <span asp-validation-for="IdCardScan" class="field-error" style="display:block;"></span>
                </div>
                <div class="form-group col-span-2">
                    <label class="form-label">Police Clearance Document</label>
                    <input asp-for="PoliceClearanceScan" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" />
                    <span asp-validation-for="PoliceClearanceScan" class="field-error" style="display:block;"></span>
                </div>
                <div class="form-group col-span-2">
                    <p class="form-label" style="margin-top:6px;">Accepted formats: PDF, JPG, PNG. Maximum file size: 10 MB each.</p>
                </div>
            </div>
        </div>

    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const fullNameInput = document.getElementById('fullNameInput');
            const initialsInput = document.getElementById('initialsInput');
            const nicInput = document.getElementById('nicInput');
            const phoneInput = document.getElementById('phoneInput');
            const emailInput = document.getElementById('emailInput');
            const dobInput = document.getElementById('dobInput');
            const sexSelect = document.getElementById('sexSelect');
            const roleSelect = document.getElementById('roleSelect');
            const empTypeSelect = document.getElementById('employeeTypeSelect');
            const branchSelect = document.getElementById('branchSelect');
            const deptSelect = document.getElementById('departmentSelect');
            const desigSelect = document.getElementById('designationSelect');
            const dateJoinedInput = document.getElementById('dateJoinedInput');
            const dateConfirmedInput = document.getElementById('dateConfirmedInput');
            const resAddrInput = document.getElementById('residentialAddressInput');
            const epfInput = document.getElementById('epfInput');
            const etfInput = document.getElementById('etfInput');
            const spouseCheckbox = document.getElementById('spouseCheckbox');
            const spouseNameInput = document.getElementById('spouseNameInput');
            const spousePhoneInput = document.getElementById('spousePhoneInput');

            // --- Error helpers ---
            function showError(id, msg) {
                const el = document.getElementById(id);
                if (el) { el.textContent = msg; el.style.display = 'block'; }
            }
            function clearError(id) {
                const el = document.getElementById(id);
                if (el) { el.textContent = ''; el.style.display = 'none'; }
            }

            // --- Full Name → Initials auto-fill ---
            if (fullNameInput) {
                fullNameInput.addEventListener('input', function () {
                    const fullName = this.value.trim();
                    if (!fullName) { initialsInput.value = ''; return; }
                    const parts = fullName.split(/\s+/).filter(p => p.length > 0);
                    if (parts.length === 1) {
                        initialsInput.value = parts[0];
                    } else {
                        const surname = parts[parts.length - 1];
                        const initials = parts.slice(0, parts.length - 1).map(p => p.charAt(0).toUpperCase() + '.').join(' ');
                        initialsInput.value = initials + ' ' + surname;
                    }
                });
            }

            // --- Sri Lankan NIC Parser & Validator ---
            // Old format: 9 digits + V/X (e.g. 901234567V) -> born before 2000 (1900 + YY)
            // New format: 12 digits (e.g. 200301500132)    -> first 4 digits = YYYY
            // Next 3 digits: Days from Jan 1 (001-366 for Male, 501-866 for Female)
            function parseSriLankanNIC(nicStr) {
                if (!nicStr) return null;
                const val = nicStr.trim();
                const oldRegex = /^(\d{2})(\d{3})(\d{4})([VvXx])$/;
                const newRegex = /^(\d{4})(\d{3})(\d{5})$/;

                let year, dayNum;
                if (oldRegex.test(val)) {
                    const match = val.match(oldRegex);
                    year = 1900 + parseInt(match[1], 10);
                    dayNum = parseInt(match[2], 10);
                } else if (newRegex.test(val)) {
                    const match = val.match(newRegex);
                    year = parseInt(match[1], 10);
                    dayNum = parseInt(match[2], 10);
                } else {
                    return { valid: false, error: 'Invalid NIC format. Use 9 digits with V/X (e.g. 901234567V) or 12 digits (e.g. 200301500132).' };
                }

                let gender = 'Male';
                let days = dayNum;
                if (dayNum > 500) {
                    gender = 'Female';
                    days = dayNum - 500;
                }

                if (days < 1 || days > 366) {
                    return { valid: false, error: `Invalid NIC day digits (${String(dayNum).padStart(3, '0')}). Days must be 001-366 (Male) or 501-866 (Female).` };
                }

                // Month days in standard SL NIC mapping (Feb treated as 29 days)
                const monthDays = [31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
                let month = 1;
                let day = days;
                for (let i = 0; i < monthDays.length; i++) {
                    if (day <= monthDays[i]) {
                        month = i + 1;
                        break;
                    }
                    day -= monthDays[i];
                }

                const mm = String(month).padStart(2, '0');
                const dd = String(day).padStart(2, '0');
                const dobString = `${year}-${mm}-${dd}`;

                return {
                    valid: true,
                    year: year,
                    month: month,
                    day: day,
                    gender: gender,
                    dobString: dobString
                };
            }

            function validateNIC(autoFill = true) {
                if (!nicInput) return true;
                const val = nicInput.value.trim();
                if (!val) {
                    showError('nicError', 'NIC number is required.');
                    return false;
                }
                const parsed = parseSriLankanNIC(val);
                if (!parsed || !parsed.valid) {
                    showError('nicError', parsed ? parsed.error : 'Invalid NIC number.');
                    return false;
                }

                // Auto-fill DOB and Sex if empty
                if (autoFill) {
                    if (dobInput && !dobInput.value) {
                        dobInput.value = parsed.dobString;
                        clearError('dobError');
                    }
                    if (sexSelect && !sexSelect.value) {
                        sexSelect.value = parsed.gender;
                        clearError('sexError');
                    }
                }

                // Cross-check if already filled
                if (dobInput && dobInput.value && dobInput.value !== parsed.dobString) {
                    showError('nicError', `NIC indicates Date of Birth ${parsed.dobString}, which does not match entered Date of Birth (${dobInput.value}).`);
                    return false;
                }

                if (sexSelect && sexSelect.value && sexSelect.value.toLowerCase() !== parsed.gender.toLowerCase()) {
                    showError('nicError', `NIC indicates gender is ${parsed.gender}, but ${sexSelect.value} is selected.`);
                    return false;
                }

                clearError('nicError');
                return true;
            }

            if (nicInput) {
                nicInput.addEventListener('input', function () {
                    const val = this.value.trim();
                    if (val.length === 10 || val.length === 12) {
                        validateNIC(true);
                    } else if (!val) {
                        clearError('nicError');
                    }
                });
                nicInput.addEventListener('blur', function () {
                    validateNIC(true);
                });
            }

            // --- Phone Validation ---
            function validatePhone() {
                if (!phoneInput) return true;
                const val = phoneInput.value.trim();
                if (!val) {
                    showError('phoneError', 'Phone number is required.');
                    return false;
                }
                const phoneRegex = /^0\d{9}$/;
                if (!phoneRegex.test(val)) {
                    showError('phoneError', 'Phone must start with 0 and have exactly 10 digits.');
                    return false;
                }
                clearError('phoneError');
                return true;
            }
            if (phoneInput) {
                phoneInput.addEventListener('blur', validatePhone);
                phoneInput.addEventListener('input', function() {
                    this.value = this.value.replace(/\D/g, '').slice(0, 10);
                    if (this.value.trim()) clearError('phoneError');
                });
            }

            // --- Email Validation ---
            function validateEmail() {
                if (!emailInput) return true;
                const val = emailInput.value.trim();
                if (!val) {
                    showError('emailError', 'Email address is required.');
                    return false;
                }
                const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                if (!emailRegex.test(val)) {
                    showError('emailError', 'Please enter a valid email address.');
                    return false;
                }
                clearError('emailError');
                return true;
            }
            if (emailInput) {
                emailInput.addEventListener('blur', validateEmail);
                emailInput.addEventListener('input', function() { if (emailInput.value.trim()) clearError('emailError'); });
            }

            // --- Spouse Phone Validation ---
            function validateSpousePhone() {
                if (!spousePhoneInput || !spousePhoneInput.value) { clearError('spousePhoneError'); return true; }
                const val = spousePhoneInput.value.trim();
                if (!val) { clearError('spousePhoneError'); return true; }
                const phoneRegex = /^0\d{9}$/;
                if (!phoneRegex.test(val)) {
                    showError('spousePhoneError', 'Spouse Phone must start with 0 and have exactly 10 digits.');
                    return false;
                }
                clearError('spousePhoneError');
                return true;
            }
            if (spousePhoneInput) {
                spousePhoneInput.addEventListener('blur', validateSpousePhone);
                spousePhoneInput.addEventListener('input', function() {
                    this.value = this.value.replace(/\D/g, '').slice(0, 10);
                    if (this.value.trim()) clearError('spousePhoneError');
                });
            }

            // --- Spouse Details Checkbox Toggle ---
            function updateSpouseFieldsState() {
                if (!spouseCheckbox) return;
                const isChecked = spouseCheckbox.checked;
                if (spouseNameInput) spouseNameInput.disabled = !isChecked;
                if (spousePhoneInput) spousePhoneInput.disabled = !isChecked;
                if (!isChecked) {
                    if (spouseNameInput) spouseNameInput.value = '';
                    if (spousePhoneInput) spousePhoneInput.value = '';
                    clearError('spousePhoneError');
                }
            }
            if (spouseCheckbox) {
                if ((spouseNameInput && spouseNameInput.value.trim() !== '') || (spousePhoneInput && spousePhoneInput.value.trim() !== '')) {
                    spouseCheckbox.checked = true;
                }
                updateSpouseFieldsState();
                spouseCheckbox.addEventListener('change', updateSpouseFieldsState);
            }

            // --- DOB Validation ---
            function validateDOB() {
                if (!dobInput || !dobInput.value) {
                    showError('dobError', 'Date of Birth is required.');
                    return false;
                }
                const dob = new Date(dobInput.value);
                const today = new Date(); today.setHours(0,0,0,0);
                if (dob >= today) {
                    showError('dobError', 'Date of Birth must be in the past.');
                    return false;
                }
                const minAge = new Date(today);
                minAge.setFullYear(minAge.getFullYear() - 18);
                if (dob > minAge) {
                    showError('dobError', 'Employee must be at least 18 years old.');
                    return false;
                }
                clearError('dobError');
                if (nicInput && nicInput.value) validateNIC(false);
                return true;
            }
            if (dobInput) {
                dobInput.addEventListener('change', validateDOB);
                dobInput.addEventListener('blur', validateDOB);
            }

            // --- Date Joined Validation ---
            function validateDateJoined() {
                if (!dateJoinedInput || !dateJoinedInput.value) {
                    showError('dateJoinedError', 'Date Joined is required.');
                    return false;
                }
                const dj = new Date(dateJoinedInput.value);
                const today = new Date(); today.setHours(0,0,0,0);
                if (dj > today) {
                    showError('dateJoinedError', 'Date Joined cannot be in the future.');
                    return false;
                }
                if (dobInput && dobInput.value) {
                    const dob = new Date(dobInput.value);
                    if (dj <= dob) {
                        showError('dateJoinedError', 'Date Joined must be after Date of Birth.');
                        return false;
                    }
                }
                clearError('dateJoinedError');
                validateDateConfirmed();
                return true;
            }
            if (dateJoinedInput) {
                dateJoinedInput.addEventListener('change', validateDateJoined);
                dateJoinedInput.addEventListener('blur', validateDateJoined);
            }

            // --- Date Confirmed Validation ---
            function validateDateConfirmed() {
                if (!dateConfirmedInput || !dateConfirmedInput.value) { clearError('dateConfirmedError'); return true; }
                const dc = new Date(dateConfirmedInput.value);
                if (dateJoinedInput && dateJoinedInput.value) {
                    const dj = new Date(dateJoinedInput.value);
                    if (dc < dj) {
                        showError('dateConfirmedError', 'Date Confirmed must be on or after Date Joined.');
                        return false;
                    }
                }
                clearError('dateConfirmedError');
                return true;
            }
            if (dateConfirmedInput) dateConfirmedInput.addEventListener('change', validateDateConfirmed);

            // --- Employee Type Toggle (Intern vs Probationary vs Permanent) ---
            const probationGroup = document.getElementById('probationPeriodGroup');
            const internGroup = document.getElementById('internPeriodGroup');
            function togglePeriodFields() {
                const val = empTypeSelect ? empTypeSelect.value : '';
                if (val === 'Intern') {
                    if (probationGroup) probationGroup.style.display = 'none';
                    if (internGroup) internGroup.style.display = '';
                } else if (val === 'Probationary') {
                    if (probationGroup) probationGroup.style.display = '';
                    if (internGroup) internGroup.style.display = 'none';
                } else {
                    if (probationGroup) probationGroup.style.display = 'none';
                    if (internGroup) internGroup.style.display = 'none';
                }
            }

            function updateManagerialFieldsLock() {
                if (!roleSelect) return;
                const r = roleSelect.value;
                const isManagerial = (r === 'Branch Manager' || r === 'Area Manager' || r === 'Department Head');
                
                // Employee Type Lock
                if (empTypeSelect) {
                    if (isManagerial) {
                        empTypeSelect.value = 'Permanent';
                        empTypeSelect.style.pointerEvents = 'none';
                        empTypeSelect.style.backgroundColor = '#f1f5f9';
                        empTypeSelect.style.color = '#475569';
                        empTypeSelect.setAttribute('tabindex', '-1');
                        clearError('employeeTypeError');
                    } else {
                        empTypeSelect.style.pointerEvents = '';
                        empTypeSelect.style.backgroundColor = '';
                        empTypeSelect.style.color = '';
                        empTypeSelect.removeAttribute('tabindex');
                    }
                }

                // Area Manager: Branch Lock to Head Office
                if (branchSelect) {
                    if (r === 'Area Manager') {
                        selectOptionByText(branchSelect, 'Head Office', true);
                        branchSelect.style.pointerEvents = 'none';
                        branchSelect.style.backgroundColor = '#f1f5f9';
                        branchSelect.style.color = '#475569';
                        branchSelect.setAttribute('tabindex', '-1');
                        clearError('branchError');
                    } else {
                        branchSelect.style.pointerEvents = '';
                        branchSelect.style.backgroundColor = '';
                        branchSelect.style.color = '';
                        branchSelect.removeAttribute('tabindex');
                    }
                }

                // Branch Manager & Area Manager: Department Lock to Managerial
                if (deptSelect) {
                    if (r === 'Branch Manager' || r === 'Area Manager') {
                        deptSelect.style.pointerEvents = 'none';
                        deptSelect.style.backgroundColor = '#f1f5f9';
                        deptSelect.style.color = '#475569';
                        deptSelect.setAttribute('tabindex', '-1');
                        clearError('departmentError');
                    } else {
                        deptSelect.style.pointerEvents = '';
                        deptSelect.style.backgroundColor = '';
                        deptSelect.style.color = '';
                        deptSelect.removeAttribute('tabindex');
                    }
                }

                // Designation Lock for Managerial Roles
                if (desigSelect) {
                    if (isManagerial) {
                        desigSelect.style.pointerEvents = 'none';
                        desigSelect.style.backgroundColor = '#f1f5f9';
                        desigSelect.style.color = '#475569';
                        desigSelect.setAttribute('tabindex', '-1');
                        clearError('designationError');
                    } else {
                        desigSelect.style.pointerEvents = '';
                        desigSelect.style.backgroundColor = '';
                        desigSelect.style.color = '';
                        desigSelect.removeAttribute('tabindex');
                    }
                }

                togglePeriodFields();
            }

            if (empTypeSelect) {
                empTypeSelect.addEventListener('change', togglePeriodFields);
                togglePeriodFields();
                updateManagerialFieldsLock();
            }

            // --- Required Field Validators ---
            function validateRequiredInput(inputEl, errorId, errorMsg) {
                if (!inputEl) return true;
                const val = inputEl.value ? inputEl.value.trim() : '';
                if (!val) {
                    showError(errorId, errorMsg);
                    return false;
                }
                clearError(errorId);
                return true;
            }

            function validateRequiredSelect(selectEl, errorId, errorMsg) {
                if (!selectEl) return true;
                const val = selectEl.value ? selectEl.value.trim() : '';
                if (!val || val === '0' || val === '') {
                    showError(errorId, errorMsg);
                    return false;
                }
                clearError(errorId);
                return true;
            }

            function validateFullName() {
                return validateRequiredInput(fullNameInput, 'fullNameError', 'Full Name is required.');
            }
            function validateInitials() {
                return validateRequiredInput(initialsInput, 'initialsError', 'Name with Initials is required.');
            }
            function validateSex() {
                const ok = validateRequiredSelect(sexSelect, 'sexError', 'Please select a gender.');
                if (ok && nicInput && nicInput.value) validateNIC(false);
                return ok;
            }
            function validateEmployeeType() {
                return validateRequiredSelect(empTypeSelect, 'employeeTypeError', 'Please select an employee type.');
            }
            function validateBranch() {
                return validateRequiredSelect(branchSelect, 'branchError', 'Please select a branch.');
            }
            function validateDepartment() {
                return validateRequiredSelect(deptSelect, 'departmentError', 'Please select a department.');
            }
            function validateDesignation() {
                return validateRequiredSelect(desigSelect, 'designationError', 'Please select a designation.');
            }
            function validateAddress() {
                return validateRequiredInput(resAddrInput, 'addressError', 'Residential Address is required.');
            }
            function validateEPF() {
                return validateRequiredInput(epfInput, 'epfError', 'EPF Number is required.');
            }
            function validateETF() {
                return validateRequiredInput(etfInput, 'etfError', 'ETF Number is required.');
            }

            const expInput = document.getElementById('NewEmployee_PreviousExperienceYears');
            function validateExperience() {
                if (!expInput) return true;
                const valStr = expInput.value ? expInput.value.trim() : '';
                if (!valStr) {
                    clearError('expError');
                    return true;
                }
                const val = parseFloat(valStr);
                if (isNaN(val) || val < 0) {
                    showError('expError', 'Previous experience cannot be negative.');
                    return false;
                }
                if (val > 60) {
                    showError('expError', 'Previous experience cannot exceed 60 years.');
                    return false;
                }
                clearError('expError');
                return true;
            }

            if (expInput) {
                expInput.addEventListener('input', function() {
                    if (this.value && parseFloat(this.value) < 0) {
                        this.value = '0';
                    }
                    validateExperience();
                });
                expInput.addEventListener('blur', validateExperience);
            }

            if (fullNameInput) fullNameInput.addEventListener('blur', validateFullName);
            if (initialsInput) initialsInput.addEventListener('blur', validateInitials);
            if (sexSelect) sexSelect.addEventListener('change', validateSex);
            if (resAddrInput) resAddrInput.addEventListener('blur', validateAddress);
            if (empTypeSelect) empTypeSelect.addEventListener('change', validateEmployeeType);
            if (branchSelect) branchSelect.addEventListener('change', validateBranch);
            if (deptSelect) deptSelect.addEventListener('change', validateDepartment);
            if (desigSelect) desigSelect.addEventListener('change', validateDesignation);
            if (epfInput) epfInput.addEventListener('blur', validateEPF);
            if (etfInput) etfInput.addEventListener('blur', validateETF);

            // --- Block form submit if any validation fails ---
            const form = document.getElementById('employeeCreateForm');
            if (form) {
                form.addEventListener('submit', function (e) {
                    if (e.submitter && (e.submitter.classList.contains('btn-draft') || e.submitter.hasAttribute('formnovalidate') || (e.submitter.getAttribute('formaction') && e.submitter.getAttribute('formaction').includes('Draft')))) {
                        return;
                    }

                    const nameOk = validateFullName();
                    const initialsOk = validateInitials();
                    const nicOk = validateNIC(false);
                    const dobOk = validateDOB();
                    const sexOk = validateSex();
                    const phoneOk = validatePhone();
                    const emailOk = validateEmail();
                    const addrOk = validateAddress();
                    const empTypeOk = validateEmployeeType();
                    const branchOk = validateBranch();
                    const deptOk = validateDepartment();
                    const desigOk = validateDesignation();
                    const djOk = validateDateJoined();
                    const dcOk = validateDateConfirmed();
                    const epfOk = validateEPF();
                    const etfOk = validateETF();
                    const spOk = validateSpousePhone();
                    const expOk = validateExperience();

                    if (!nameOk || !initialsOk || !nicOk || !dobOk || !sexOk || !phoneOk || !emailOk || !addrOk ||
                        !empTypeOk || !branchOk || !deptOk || !desigOk || !djOk || !dcOk || !epfOk || !etfOk || !spOk || !expOk) {
                        e.preventDefault();
                        const firstErr = document.querySelector('.field-error[style*="block"]');
                        if (firstErr) firstErr.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                });
            }

            // --- Branch → Department → Designation cascade ---
            const initialBranchId = @(Model.NewEmployee.BranchId);
            const initialDeptId   = @(Model.NewEmployee.DepartmentId ?? 0);
            const initialDesigId  = @(Model.NewEmployee.DesignationId ?? 0);

            async function loadDepartments(branchId, preselectDeptId) {
                if (!deptSelect) return;
                deptSelect.innerHTML = '<option value="">Select Department</option>';
                if (desigSelect) desigSelect.innerHTML = '<option value="">Select Department First</option>';
                if (!branchId) { deptSelect.innerHTML = '<option value="">Select Branch First</option>'; return; }
                try {
                    const resp = await fetch(`?handler=DepartmentsByBranch&branchId=${branchId}`);
                    if (!resp.ok) return;
                    const data = await resp.json();
                    data.forEach(function(d) {
                        const opt = document.createElement('option');
                        opt.value = d.id;
                        opt.textContent = d.name;
                        if (preselectDeptId && d.id === preselectDeptId) opt.selected = true;
                        deptSelect.appendChild(opt);
                    });
                    if (preselectDeptId) loadDesignations(preselectDeptId, initialDesigId);
                } catch (e) { /* no-op */ }
            }

            async function loadDesignations(deptId, preselectDesigId) {
                if (!desigSelect) return;
                desigSelect.innerHTML = '<option value="">Select Designation</option>';
                if (!deptId) { desigSelect.innerHTML = '<option value="">Select Department First</option>'; return; }
                const branchId = branchSelect ? (branchSelect.value || 0) : 0;
                try {
                    const resp = await fetch(`?handler=DesignationsByDepartment&departmentId=${deptId}&branchId=${branchId}`);
                    if (!resp.ok) return;
                    const data = await resp.json();
                    data.forEach(function(d) {
                        const opt = document.createElement('option');
                        opt.value = d.id;
                        opt.textContent = d.title;
                        if (preselectDesigId && d.id === preselectDesigId) opt.selected = true;
                        desigSelect.appendChild(opt);
                    });
                } catch (e) { /* no-op */ }
            }

            const currentEmployeeId = @(Model.EmployeeId ?? 0);

            function selectOptionByText(selectEl, textToMatch, partial = false) {
                if (!selectEl) return false;
                for (let i = 0; i < selectEl.options.length; i++) {
                    const optText = selectEl.options[i].text.trim().toLowerCase();
                    const target = textToMatch.trim().toLowerCase();
                    if ((partial && optText.includes(target)) || (!partial && optText === target)) {
                        selectEl.selectedIndex = i;
                        return true;
                    }
                }
                return false;
            }

            async function syncFromRole() {
                if (!roleSelect) return;
                updateManagerialFieldsLock();
                const r = roleSelect.value;
                if (r === 'Branch Manager') {
                    if (branchSelect && branchSelect.value) {
                        await loadDepartments(branchSelect.value, null);
                        selectOptionByText(deptSelect, 'Managerial');
                        if (deptSelect && deptSelect.value) {
                            await loadDesignations(deptSelect.value, null);
                            selectOptionByText(desigSelect, 'Branch Manager');
                            validateDesignation();
                            checkDesignationAvailability();
                        }
                    } else {
                        selectOptionByText(deptSelect, 'Managerial');
                        selectOptionByText(desigSelect, 'Branch Manager');
                    }
                } else if (r === 'Area Manager') {
                    selectOptionByText(branchSelect, 'Head Office', true);
                    if (branchSelect && branchSelect.value) {
                        await loadDepartments(branchSelect.value, null);
                        selectOptionByText(deptSelect, 'Managerial');
                        if (deptSelect && deptSelect.value) {
                            await loadDesignations(deptSelect.value, null);
                            selectOptionByText(desigSelect, 'Area Manager');
                            validateDesignation();
                            checkDesignationAvailability();
                        }
                    }
                } else if (r === 'Department Head') {
                    if (desigSelect) {
                        selectOptionByText(desigSelect, 'Department Head');
                        validateDesignation();
                        checkDesignationAvailability();
                    }
                }
                updateManagerialFieldsLock();
            }

            if (roleSelect) {
                roleSelect.addEventListener('change', function() {
                    syncFromRole();
                });
            }

            async function checkDesignationAvailability() {
                if (!desigSelect || !desigSelect.value || !branchSelect || !branchSelect.value) return true;
                const branchId = branchSelect.value;
                const deptId = deptSelect ? (deptSelect.value || 0) : 0;
                const desigId = desigSelect.value;

                try {
                    const resp = await fetch(`?handler=CheckDesignationAvailability&branchId=${branchId}&departmentId=${deptId}&designationId=${desigId}&employeeId=${currentEmployeeId}`);
                    if (!resp.ok) return true;
                    const res = await resp.json();
                    if (!res.isAvailable) {
                        showError('designationError', res.message);
                        return false;
                    } else {
                        clearError('designationError');
                        return true;
                    }
                } catch (e) { return true; }
            }

            if (branchSelect) {
                branchSelect.addEventListener('change', function() {
                    validateBranch();
                    if (!this.value) {
                        if (deptSelect) deptSelect.innerHTML = '<option value="">Select Branch First</option>';
                        if (desigSelect) desigSelect.innerHTML = '<option value="">Select Department First</option>';
                        return;
                    }
                    const currentDeptId = deptSelect ? deptSelect.value : null;
                    const currentDesigId = desigSelect ? desigSelect.value : null;
                    loadDepartments(this.value, currentDeptId).then(() => {
                        if (deptSelect && deptSelect.value) {
                            loadDesignations(deptSelect.value, currentDesigId);
                        } else {
                            if (desigSelect) desigSelect.innerHTML = '<option value="">Select Department First</option>';
                        }
                    });
                    checkDesignationAvailability();
                });
                if (branchSelect.value) {
                    loadDepartments(branchSelect.value, initialDeptId || null);
                } else if (initialBranchId) {
                    loadDepartments(initialBranchId, initialDeptId || null);
                } else {
                    if (deptSelect) deptSelect.innerHTML = '<option value="">Select Branch First</option>';
                    if (desigSelect) desigSelect.innerHTML = '<option value="">Select Department First</option>';
                }
            }

            if (deptSelect) {
                deptSelect.addEventListener('change', function() {
                    validateDepartment();
                    if (!this.value) {
                        if (desigSelect) desigSelect.innerHTML = '<option value="">Select Department First</option>';
                    } else {
                        loadDesignations(this.value, null);
                    }
                    checkDesignationAvailability();
                });
            }

            if (desigSelect) {
                desigSelect.addEventListener('change', function() {
                    if (roleSelect) {
                        const selText = desigSelect.options[desigSelect.selectedIndex] ? desigSelect.options[desigSelect.selectedIndex].text.trim() : '';
                        if (selText === 'Branch Manager' || selText === 'Area Manager' || selText === 'Department Head') {
                            selectOptionByText(roleSelect, selText);
                            updateManagerialFieldsLock();
                        }
                    }
                    if (validateDesignation()) {
                        checkDesignationAvailability();
                    }
                });
            }
        });
    </script>
}

