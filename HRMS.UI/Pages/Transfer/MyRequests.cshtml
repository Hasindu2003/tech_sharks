@page
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Employee")]
@model HRMS.UI.Pages.Transfer.MyRequestsModel
@{
    ViewData["Title"] = "My Transfer Requests";
}

<style>
    .page-h { font-size: 19px; font-weight: 800; color: #151811; margin: 0 0 3px 0; }
    .page-s { font-size: 12px; color: #7a8863; margin: 0 0 22px 0; }
    .table-card { background: white; border: 1px solid #e2e5dc; border-radius: 10px; overflow: hidden; margin-bottom: 19px; box-shadow: 0 1px 2px rgba(0,0,0,.05); }
    .emp-table { width: 100%; border-collapse: collapse; }
    .emp-table th { background: #f9fafb; padding: 13px 19px; text-align: left; font-size: 13px; font-weight: 700; color: #7a8863; border-bottom: 1px solid #e2e5dc; }
    .emp-table td { padding: 13px 19px; border-bottom: 1px solid #e2e5dc; font-size: 14px; color: #151811; }
    .emp-table tr:last-child td { border-bottom: none; }
    .emp-table tbody tr:hover { background: #fafafa; }
    .k-badge, .status-badge { display: inline-flex; align-items: center; gap: 4px; padding: 2px 9px; border-radius: 9999px; font-size: 11.5px; font-weight: 700; border: 1px solid transparent; }
    .k-badge-pending  { background: #fef3c7; border-color: #fde68a; color: #b45309; }
    .k-badge-approved { background: #dcfce7; border-color: #bbf7d0; color: #10823c; }
    .k-badge-rejected { background: #fee2e2; border-color: #fecaca; color: #b91c1c; }
    .k-badge-info     { background: #dbeafe; border-color: #bfdbfe; color: #1d4ed8; }
    .btn-action { color: #10823c; font-size: 13px; font-weight: 700; text-decoration: none; padding: 5px 10px; border-radius: 5px; transition: background .2s; }
    .btn-action:hover { background: #e8f3ec; }
    .btn-create { background: #10823c; color: white; padding: 9px 17px; border-radius: 6px; font-size: 13px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn-create:hover { background: #0d6e32; color: white; }
    .success-banner { background: #ecfdf5; color: #065f46; padding: 14px 20px; border-radius: 10px; margin-bottom: 20px; font-size: 14px; font-weight: 600; border: 1px solid #10b981; display: flex; align-items: center; gap: 8px; }
</style>

<div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:4px">
    <div>
        <h2 class="page-h">My Transfer Requests</h2>
        <p class="page-s">View the status of your transfer applications</p>
    </div>
    <a asp-page="/Transfer/Apply" class="btn-create">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        New Transfer Request
    </a>
</div>

@if (TempData["SuccessMessage"] is string successMsg)
{
    <div class="success-banner">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        @successMsg
    </div>
}

@if (Model.Requests.Any())
{
    <div class="table-card">
        <table class="emp-table">
            <thead>
                <tr>
                    <th style="width:70px">ID</th>
                    <th>Submitted</th>
                    <th>From Branch</th>
                    <th>To Branch</th>
                    <th>Preferred Date</th>
                    <th>Status</th>
                    <th style="text-align:right"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model.Requests)
                {
                    <tr>
                        <td style="font-weight:600;color:#7a8863">#@request.Id</td>
                        <td style="color:#7a8863">@request.RequestedDate.ToString("MMM dd, yyyy")</td>
                        <td style="color:#7a8863">@request.CurrentBranch</td>
                        <td style="font-weight:600">@request.RequestedBranch</td>
                        <td style="color:#7a8863">@request.PreferredDate?.ToString("MMM dd, yyyy")</td>
                        <td>
                            @switch (request.Status)
                            {
                                case TransferStatus.Pending:
                                    <span class="k-badge k-badge-pending">Awaiting Dept Head</span>
                                    break;
                                case TransferStatus.DeptHeadApproved:
                                    <span class="k-badge k-badge-info">Dept Head Approved</span>
                                    break;
                                case TransferStatus.DeptHeadRejected:
                                    <span class="k-badge k-badge-rejected">Dept Head Rejected</span>
                                    break;
                                case TransferStatus.HRFinalRejected:
                                    <span class="k-badge k-badge-rejected">HR Rejected</span>
                                    break;
                                case TransferStatus.CurrentBMApproved:
                                case TransferStatus.TargetBMApproved:
                                    <span class="k-badge k-badge-info">BM Review</span>
                                    break;
                                case TransferStatus.CurrentBMRejected:
                                case TransferStatus.TargetBMRejected:
                                    <span class="k-badge k-badge-rejected">BM Rejected</span>
                                    break;
                                case TransferStatus.BothBMsApproved:
                                    <span class="k-badge k-badge-info">Awaiting AM</span>
                                    break;
                                case TransferStatus.AreaManagerApproved:
                                    <span class="k-badge k-badge-info">Awaiting HR</span>
                                    break;
                                case TransferStatus.AreaManagerRejected:
                                    <span class="k-badge k-badge-rejected">Rejected</span>
                                    break;
                                case TransferStatus.FullyApproved:
                                    <span class="k-badge k-badge-approved">Approved</span>
                                    break;
                            }
                        </td>
                        <td style="text-align:right">
                            <a asp-page="/Transfer/Details" asp-route-id="@request.Id" class="btn-action">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="table-card" style="text-align:center;padding:48px">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#e2e5dc" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:block;margin:0 auto 12px"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
        <p style="font-size:14px;font-weight:600;color:#151811;margin-bottom:4px">No transfer requests yet</p>
        <span style="font-size:12px;color:#7a8863;display:block;margin-bottom:16px">Submit a transfer request to get started</span>
        <a asp-page="/Transfer/Apply" class="btn-create" style="margin:0 auto">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Submit a Transfer Request
        </a>
    </div>
}
