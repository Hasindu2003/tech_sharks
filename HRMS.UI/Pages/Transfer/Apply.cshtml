@page
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Employee,Branch Manager")]
@model HRMS.UI.Pages.Transfer.ApplyModel
@{
    ViewData["Title"] = "Apply for Transfer";
}

<div class="page-header">
    <h2>Apply for Transfer</h2>
    <p class="page-subtitle">Submit a new transfer request to another branch</p>
</div>

<div asp-validation-summary="ModelOnly" class="k-alert k-alert-danger" style="display:@(ViewData.ModelState.ErrorCount > 0 ? "flex" : "none")"></div>

<form method="post" enctype="multipart/form-data">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start">
        <!-- Left Column -->
        <div>
            <!-- Auto-Filled Employee Details -->
            <div class="k-card" style="margin-bottom:20px">
                <div class="k-card-header"><i class="bi bi-person" style="color:#1a7a3a;margin-right:6px"></i> Employee Details (Auto-filled)</div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
                    <div class="k-form-group">
                        <label><i class="bi bi-person" style="color:#1a7a3a;margin-right:4px"></i> Full Name</label>
                        <input asp-for="Input.EmployeeName" class="k-form-control" readonly style="background:#f9fafb" />
                    </div>
                    <div class="k-form-group">
                        <label><i class="bi bi-hash" style="color:#1a7a3a;margin-right:4px"></i> EPF Number</label>
                        <input asp-for="Input.EpfNumber" class="k-form-control" readonly style="background:#f9fafb" />
                    </div>
                    <div class="k-form-group">
                        <label><i class="bi bi-building" style="color:#1a7a3a;margin-right:4px"></i> Current Branch</label>
                        <input asp-for="Input.CurrentBranch" class="k-form-control" readonly style="background:#f9fafb" />
                    </div>
                    <div class="k-form-group">
                        <label><i class="bi bi-briefcase" style="color:#1a7a3a;margin-right:4px"></i> Designation</label>
                        <input asp-for="Input.CurrentDesignation" class="k-form-control" readonly style="background:#f9fafb" />
                    </div>
                </div>
            </div>

            <!-- Document Upload -->
            <div class="k-card">
                <div class="k-card-header"><i class="bi bi-paperclip" style="color:#1a7a3a;margin-right:6px"></i> Supporting Document (Optional)</div>
                <div class="k-form-group" style="margin-bottom:0">
                    <input asp-for="Input.Document" class="k-form-control" type="file"
                           accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
                    <div style="font-size:0.78rem;color:#9ca3af;margin-top:6px">Allowed: PDF, DOC, DOCX, JPG, PNG. Max size: 5 MB.</div>
                    <span asp-validation-for="Input.Document" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <!-- Right Column: Transfer Details -->
        <div>
            <div class="k-card" style="margin-bottom:20px">
                <div class="k-card-header"><i class="bi bi-arrow-left-right" style="color:#1a7a3a;margin-right:6px"></i> Transfer Details</div>

                <div class="k-form-group">
                    <label asp-for="Input.RequestedBranch">
                        <i class="bi bi-geo-alt" style="color:#1a7a3a;margin-right:4px"></i> Requested Branch <span style="color:#ef4444">*</span>
                    </label>
                    <select asp-for="Input.RequestedBranch" class="k-form-control">
                        <option value="">-- Select Branch --</option>
                        @foreach (var branch in Model.AvailableBranches)
                        {
                            <option value="@branch">@branch</option>
                        }
                    </select>
                    <span asp-validation-for="Input.RequestedBranch" class="text-danger small"></span>
                </div>

                <div class="k-form-group">
                    <label asp-for="Input.PreferredDate">
                        <i class="bi bi-calendar-event" style="color:#1a7a3a;margin-right:4px"></i> Preferred Transfer Date <span style="color:#ef4444">*</span>
                    </label>
                    <input asp-for="Input.PreferredDate" class="k-form-control" type="date"
                           min="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")"
                           max="@DateTime.Today.AddYears(1).ToString("yyyy-MM-dd")" />
                    <div style="font-size:0.78rem;color:#9ca3af;margin-top:4px">Must be at least 7 days from today and within 1 year.</div>
                    <span asp-validation-for="Input.PreferredDate" class="text-danger small"></span>
                </div>

                <div class="k-form-group" style="margin-bottom:0">
                    <label asp-for="Input.Reason">
                        <i class="bi bi-chat-left-text" style="color:#1a7a3a;margin-right:4px"></i> Reason for Transfer <span style="color:#ef4444">*</span>
                    </label>
                    <textarea asp-for="Input.Reason" class="k-form-control" rows="5" maxlength="500"
                              placeholder="Please explain your reason for requesting this transfer (minimum 20 characters)"></textarea>
                    <div style="display:flex;justify-content:space-between;margin-top:4px;font-size:0.78rem;color:#9ca3af">
                        <span><span id="charCount">0</span>/500 characters</span>
                        <span>Min 20 characters</span>
                    </div>
                    <span asp-validation-for="Input.Reason" class="text-danger small"></span>
                </div>
            </div>

            <div style="display:flex;flex-direction:column;gap:10px">
                <button type="submit" class="btn-kanrich btn-kanrich-primary btn-kanrich-lg" style="justify-content:center;width:100%">
                    <i class="bi bi-send"></i> Submit Transfer Request
                </button>
                <a asp-page="/Transfer/MyRequests" class="btn-kanrich btn-kanrich-outline btn-kanrich-lg" style="justify-content:center;width:100%">
                    <i class="bi bi-list"></i> View My Requests
                </a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const reasonField = document.getElementById('Input_Reason');
        const charCount = document.getElementById('charCount');
        if (reasonField && charCount) {
            charCount.textContent = reasonField.value.length;
            reasonField.addEventListener('input', function () {
                charCount.textContent = this.value.length;
            });
        }
        const dateField = document.getElementById('Input_PreferredDate');
        if (dateField) {
            dateField.addEventListener('change', function () {
                const selected = new Date(this.value);
                const minDate = new Date();
                minDate.setDate(minDate.getDate() + 7);
                minDate.setHours(0, 0, 0, 0);
                if (selected < minDate) {
                    alert('Preferred date must be at least 7 days from today.');
                    this.value = '';
                }
            });
        }
        const fileInput = document.getElementById('Input_Document');
        if (fileInput) {
            fileInput.addEventListener('change', function () {
                if (this.files.length > 0 && this.files[0].size > 5 * 1024 * 1024) {
                    alert('File size must not exceed 5 MB.');
                    this.value = '';
                }
            });
        }
    </script>
}