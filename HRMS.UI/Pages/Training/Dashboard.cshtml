@page
@model HRMS.UI.Pages.Training.DashboardModel
@{
    ViewData["Title"] = "Training & Development Hub";
    ViewData["PageTitle"] = "Training & Development Hub";
    ViewData["ActiveNav"] = "Training";
}

<style>
    .sep-wrap { background: #ffffff; min-height: calc(100vh - 62px); }

    .sep-page-title  { font-size: 19px; font-weight: 800; color: #151811; margin: 0 0 3px 0; }
    .sep-page-sub    { font-size: 12px; font-weight: 400; color: #7a8863; margin: 0 0 22px 0; }
    .sep-section-title { font-size: 14px; font-weight: 700; color: #151811; margin: 0 0 12px 0; }

    .sep-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 14px;
        margin-bottom: 28px;
    }

    .sep-card {
        background: #ffffff;
        border: 1px solid #e2e5dc;
        border-radius: 10px;
        padding: 16px;
        display: flex;
        align-items: flex-start;
        gap: 14px;
        text-decoration: none;
        color: inherit;
        box-shadow: 0 1px 2px rgba(0,0,0,.05);
        transition: box-shadow 0.2s;
    }
    .sep-card:hover { box-shadow: 0 2px 8px rgba(0,0,0,.08); color: inherit; text-decoration: none; }

    .sep-icon {
        width: 40px; height: 40px; border-radius: 10px; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
    }
    .sep-icon svg { width: 20px; height: 20px; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

    .sep-icon.green  { background: rgba(16,130,60,0.1); }
    .sep-icon.green svg  { stroke: #10823c; }
    .sep-icon.orange { background: rgba(249,115,22,0.1); }
    .sep-icon.orange svg { stroke: #f97316; }
    .sep-icon.blue   { background: rgba(59,130,246,0.1); }
    .sep-icon.blue svg   { stroke: #3b82f6; }
    .sep-icon.purple { background: rgba(168,85,247,0.1); }
    .sep-icon.purple svg { stroke: #a855f7; }
    .sep-icon.red    { background: rgba(239,68,68,0.1); }
    .sep-icon.red svg    { stroke: #ef4444; }

    .sep-card-title { font-size: 13px; font-weight: 700; color: #151811; margin: 0 0 3px 0; }
    .sep-card-desc  { font-size: 12px; font-weight: 400; color: #7a8863; margin: 0; line-height: 1.5; }
</style>

<div class="sep-wrap">
    <h2 class="sep-page-title">Training & Development Hub</h2>
    <p class="sep-page-sub">Centralized panel for submitting training requests, scheduling professional workshops, and tracking employee progression.</p>

    <h3 class="sep-section-title">Features & Services</h3>
    <div class="sep-grid">

        <!-- Training Sessions (All Roles) -->
        <a href="/Training/Sessions" class="sep-card">
            <div class="sep-icon blue">
                <svg viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            </div>
            <div>
                <p class="sep-card-title">Training Sessions</p>
                <p class="sep-card-desc">View upcoming scheduled sessions and program history.</p>
            </div>
        </a>

        <!-- Manage Training Requests (Area & Branch Managers) -->
        @if (User.IsInRole("Area Manager") || User.IsInRole("Branch Manager"))
        {
            <a href="/Training/Manage" class="sep-card">
                <div class="sep-icon orange">
                    <svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </div>
                <div>
                    <p class="sep-card-title">Manage Requests</p>
                    <p class="sep-card-desc">Review, approve, or reject training applications submitted by staff members in your branch jurisdiction.</p>
                </div>
            </a>
        }

        <!-- Probationary Staff Tracking (Managers/HR) -->
        @if (User.IsInRole("Branch Manager") || User.IsInRole("Area Manager") || User.IsInRole("HR Manager") || User.IsInRole("HR Officer"))
        {
            <a href="/Training/ProbationTracking" class="sep-card">
                <div class="sep-icon green">
                    <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <div>
                    <p class="sep-card-title">Probation Tracking</p>
                    <p class="sep-card-desc">Monitor monthly evaluations and confirmation milestones for probationary staff.</p>
                </div>
            </a>
        }

        <!-- Intern Tracking (Managers/HR) -->
        @if (User.IsInRole("Branch Manager") || User.IsInRole("Area Manager") || User.IsInRole("HR Manager") || User.IsInRole("HR Officer"))
        {
            <a href="/Training/InternTracking" class="sep-card">
                <div class="sep-icon purple">
                    <svg viewBox="0 0 24 24"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c0 2 2.5 3 6 3s6-1 6-3v-5"/></svg>
                </div>
                <div>
                    <p class="sep-card-title">Intern Tracking</p>
                    <p class="sep-card-desc">Review internship feedback logs and evaluate technical competency development.</p>
                </div>
            </a>
        }

    </div>
</div>
