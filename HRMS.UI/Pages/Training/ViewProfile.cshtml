@page
@model HRMS.UI.Pages.Training.ViewProfileModel
@{
    // Layout එක link කිරීම
    Layout = "_Layout";
    
    bool isIntern = string.Equals(Model.EmpType, "Intern", StringComparison.OrdinalIgnoreCase);
    var themeColor = isIntern ? "#ca8a04" : "#15803d"; 
    ViewData["Title"] = "Profile - " + Model.FullName;
}

@section Styles {
    <style>
        .profile-container { padding: 20px; }
        .content-card { 
            background: white; 
            border-radius: 12px; 
            border: 1px solid #e2e8f0; 
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); 
            overflow: hidden; 
        }
        .status-pill { 
            padding: 4px 12px; 
            border-radius: 20px; 
            font-size: 0.75rem; 
            font-weight: 600; 
            display: inline-flex; 
            align-items: center; 
            gap: 6px; 
        }
        .status-intern { background: #fef9c3; color: #a16207; }
        .status-probation { background: #dcfce7; color: #15803d; }
        .chart-wrapper { height: 320px; position: relative; padding: 20px; }
        
        /* Back button styling */
        .back-link {
            text-decoration: none;
            color: #64748b;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin-bottom: 15px;
            transition: 0.2s;
        }
        .back-link:hover { color: #1e293b; }
    </style>
}

<div class="profile-container">
    <a href="/Training/Dashboard" class="back-link">
        <i class="bi bi-arrow-left"></i> Back to Dashboard
    </a>

    <div class="content-card">
        <div class="p-4 border-bottom bg-light">
            <div class="d-flex align-items-center">
                <img src="https://ui-avatars.com/api/?name=@Model.FullName&background=random" 
                     class="rounded-circle border me-4" width="80" height="80">
                <div>
                    <h3 class="fw-bold text-dark mb-1">@Model.FullName</h3>
                    <div class="d-flex align-items-center gap-3">
                        @if (isIntern) {
                            <span class="status-pill status-intern">
                                <i class="bi bi-mortarboard-fill"></i> Internship
                            </span>
                        } else {
                            <span class="status-pill status-probation">
                                <i class="bi bi-patch-check-fill"></i> Probation Period
                            </span>
                        }
                        <span class="text-muted small"><strong>ID:</strong> #@Model.EmpId</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="p-4">
            <h6 class="fw-bold text-dark mb-4">Performance Trend (Monthly Average)</h6>
            <div class="chart-wrapper">
                <canvas id="performanceChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const ctx = document.getElementById('performanceChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Month 1', 'Month 2', 'Month 3', 'Month 4', 'Month 5', 'Month 6'],
                    datasets: [{
                        label: 'Score %',
                        data: @Html.Raw(Json.Serialize(Model.MonthlyScores)),
                        borderColor: '@themeColor',
                        backgroundColor: '@(isIntern ? "rgba(202, 138, 4, 0.1)" : "rgba(21, 128, 61, 0.1)")',
                        borderWidth: 3,
                        tension: 0.3,
                        fill: true,
                        pointRadius: 5,
                        pointBackgroundColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true, max: 100 },
                        x: { grid: { display: false } }
                    },
                    plugins: { legend: { display: false } }
                }
            });
        });
    </script>
}