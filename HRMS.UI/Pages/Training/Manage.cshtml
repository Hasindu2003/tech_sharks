@page
@model HRMS.UI.Pages.Training.ManageModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Manage Training Requests";
}

<style>
    .sep-page-title { font-size: 19px; font-weight: 800; color: #151811; margin: 0 0 3px 0; }
    .sep-page-sub   { font-size: 12px; color: #7a8863; margin: 0 0 22px 0; }

    .tbl-card { background: white; border: 1px solid #e2e5dc; border-radius: 10px; overflow: hidden; margin-bottom: 28px; box-shadow: 0 1px 3px rgba(0,0,0,.04); }
    .sep-table { width: 100%; border-collapse: collapse; }
    .sep-table th { background: #f9fafb; padding: 12px 18px; text-align: left; font-size: 12px; font-weight: 700; color: #7a8863; text-transform: uppercase; letter-spacing: 0.04em; border-bottom: 1px solid #e2e5dc; }
    .sep-table td { padding: 13px 18px; border-bottom: 1px solid #e2e5dc; font-size: 13.5px; color: #151811; vertical-align: middle; }
    .sep-table tbody tr:last-child td { border-bottom: none; }
    .sep-table tbody tr:hover { background: #fafafa; }

    .status-pill { padding: 4px 10px; border-radius: 20px; font-size: 0.7rem; font-weight: 600; display: inline-flex; align-items: center; gap: 4px; }
    .status-pending { background: #fef9c3; color: #a16207; }
    .status-approved { background: rgba(16, 130, 60, 0.1); color: #10823c; }
    .status-rejected { background: #fee2e2; color: #b91c1c; }

    .back-link {
        text-decoration: none;
        color: #7a8863;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 15px;
        transition: 0.2s;
        font-weight: 500;
        font-size: 13px;
    }
    .back-link:hover { color: #151811; text-decoration: none; }

    .btn-action-review {
        background-color: #f0fdf4;
        color: #15803d;
        border: 1px solid #bbf7d0;
        border-radius: 6px;
        padding: 5px 14px;
        font-weight: 700;
        font-size: 0.75rem;
        text-decoration: none;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }
    .btn-action-review:hover { background-color: #10823c; color: white; border-color: #10823c; text-decoration: none; }

    .btn-action-view {
        background-color: #f8fafc;
        color: #475569;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        padding: 5px 14px;
        font-weight: 600;
        font-size: 0.75rem;
        text-decoration: none;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }
    .btn-action-view:hover { background-color: #334155; color: white; border-color: #334155; text-decoration: none; }

    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
    }
    .section-title {
        font-size: 14.5px;
        font-weight: 800;
        color: #151811;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }
</style>

<div>
    <a href="/Training/Dashboard" class="back-link">
        <i class="bi bi-arrow-left"></i> Back to Dashboard
    </a>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 px-3 mb-3" role="alert" style="font-size: 13px;">
            <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 px-3 mb-3" role="alert" style="font-size: 13px;">
            <i class="bi bi-exclamation-circle me-1"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:20px;">
        <div>
            <h1 class="sep-page-title">Manage Training Requests</h1>
            <p class="sep-page-sub">Review, approve, or reject employee training applications submitted from your assigned branches.</p>
        </div>
    </div>

    <!-- 1. Pending Requests Table -->
    <div class="section-header">
        <h2 class="section-title">
            <i class="bi bi-hourglass-split text-warning"></i> Pending Requests
        </h2>
        <span class="badge bg-warning text-dark" style="font-size: 12px; border-radius: 12px; padding: 4px 10px;">
            @Model.PendingRequests.Count Pending
        </span>
    </div>
    <div class="tbl-card">
        <table class="sep-table" id="tblPendingRequests">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Branch</th>
                    <th>Program Name</th>
                    <th>Requested Date</th>
                    <th>Status</th>
                    <th style="text-align: right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.PendingRequests.Any())
                {
                    <tr class="empty-row">
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="bi bi-check2-circle fs-4 d-block mb-1 text-success"></i>
                            No pending training requests awaiting review.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.PendingRequests)
                    {
                        <tr>
                            <td>
                                <strong>@item.EmployeeName</strong>
                            </td>
                            <td>
                                <span style="background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; font-size: 11.5px; font-weight: 600; padding: 2px 8px; border-radius: 12px; display: inline-block;">
                                    @item.BranchName
                                </span>
                            </td>
                            <td>
                                @item.ProgramName
                            </td>
                            <td class="text-muted">
                                @item.Date
                            </td>
                            <td>
                                <span class="status-pill status-pending">
                                    <i class="bi bi-clock-history me-1"></i> Pending Review
                                </span>
                            </td>
                            <td style="text-align: right;">
                                <a href="/Training/Details?id=@item.Id" class="btn-action-review">
                                    <i class="bi bi-check2-square"></i> Review Request
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- 2. Reviewed Requests Table -->
    <div class="section-header">
        <h2 class="section-title">
            <i class="bi bi-clock-history text-secondary"></i> Reviewed Requests
        </h2>
        <span class="badge bg-light text-muted border" style="font-size: 12px; border-radius: 12px; padding: 4px 10px;">
            @Model.ReviewedRequests.Count Reviewed
        </span>
    </div>
    <div class="tbl-card">
        <table class="sep-table" id="tblReviewedRequests">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Branch</th>
                    <th>Program Name</th>
                    <th>Requested Date</th>
                    <th>Status</th>
                    <th style="text-align: right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.ReviewedRequests.Any())
                {
                    <tr class="empty-row">
                        <td colspan="6" class="text-center py-4 text-muted">
                            No previously reviewed training requests found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.ReviewedRequests)
                    {
                        var statusClass = item.Status == "Approved" ? "status-approved" : "status-rejected";
                        <tr>
                            <td>
                                <span class="text-muted">@item.EmployeeName</span>
                            </td>
                            <td>
                                <span style="background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; font-size: 11.5px; font-weight: 600; padding: 2px 8px; border-radius: 12px; display: inline-block;">
                                    @item.BranchName
                                </span>
                            </td>
                            <td>
                                @item.ProgramName
                            </td>
                            <td class="text-muted">
                                @item.Date
                            </td>
                            <td>
                                <span class="status-pill @statusClass">
                                    <i class="bi @(item.Status == "Approved" ? "bi-check-circle" : "bi-x-circle") me-1"></i> @item.Status
                                </span>
                            </td>
                            <td style="text-align: right;">
                                <a href="/Training/Details?id=@item.Id" class="btn-action-view">
                                    <i class="bi bi-eye"></i> View Details
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        if (typeof initTablePagination === 'function') {
            initTablePagination('tblPendingRequests', 10);
            initTablePagination('tblReviewedRequests', 10);
        }
    });
</script>
