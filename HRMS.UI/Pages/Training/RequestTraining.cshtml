@page
@model HRMS.UI.Pages.Training.RequestTrainingModel
@{
    // Layout එක link කිරීම
    Layout = "_Layout";
    ViewData["Title"] = "Request Training - Kanrich HRMS";
}

@section Styles {
    <style>
        /* අනෙක් පිටුවලට සමාන padding සහ colors */
        .page-content { padding: 35px; }
        .content-card { 
            background: white; 
            border-radius: 12px; 
            border: 1px solid #e2e8f0; 
            padding: 30px; 
            max-width: 850px; /* Window size එකට ගැලපෙන සේ */
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
        }
        
        .btn-submit { 
            background: #15803d; 
            color: white; 
            border: none; 
            font-weight: 600; 
            padding: 12px 25px; 
            border-radius: 8px; 
            transition: 0.2s;
        }
        .btn-submit:hover { background: #166534; color: white; }

        /* Custom Dropdown Styling */
        .form-select-custom { 
            display: flex; align-items: center; justify-content: space-between; 
            width: 100%; padding: 12px 15px; font-size: 1rem; color: #475569; 
            background-color: #fff; border: 1px solid #cbd5e1; border-radius: 8px;
            transition: all 0.2s; text-decoration: none;
        }
        .form-select-custom:focus { border-color: #15803d; outline: none; box-shadow: 0 0 0 3px rgba(21, 128, 61, 0.1); }
        
        .dropdown-menu { 
            width: 100%; max-height: 300px; overflow-y: auto; 
            border-radius: 8px; border: 1px solid #e2e8f0; 
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); 
        }
        .dropdown-item { padding: 10px 15px; border-bottom: 1px solid #f8fafc; }
        .dropdown-item:hover { background-color: #f0fdf4; color: #15803d; }
        
        .back-link {
            text-decoration: none;
            color: #64748b;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 20px;
            font-weight: 500;
        }
        .back-link:hover { color: #1e293b; }
    </style>
}

<div class="page-content">
    <!-- Back Button -->
    <a href="/Training/Dashboard" class="back-link">
        <i class="bi bi-arrow-left"></i> Back to Dashboard
    </a>

    <!-- Page Header -->
    <div class="mb-4">
        <h2 class="fw-bold text-dark h4 mb-1">Training Request Form</h2>
        <p class="text-muted small">Submit your request for upcoming professional development programs.</p>
    </div>

    <!-- Eligibility Alert -->
    <div class="alert @(Model.IsEligible ? "alert-info" : "alert-warning") shadow-sm d-flex align-items-center border-0 mb-4">
        <i class="bi @(Model.IsEligible ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") fs-4 me-3"></i>
        <div>
            <div class="fw-bold">Status: @Model.EmployeeTypeDisplayName</div>
            <div class="small">
                @if (Model.IsEligible) {
                    <span>You are eligible to apply for training programs.</span>
                } else {
                    <span>Training requests are restricted to permanent staff only.</span>
                }
            </div>
        </div>
    </div>

    <!-- Form Card -->
    <div class="content-card">
        @if (Model.IsEligible)
        {
            <form method="post">
                <div class="row g-4">
                    <!-- Training Selection -->
                    <div class="col-md-12">
                        <label class="form-label fw-bold text-secondary small text-uppercase mb-2">Select Training Program</label>
                        <div class="dropdown">
                            <button class="form-select-custom dropdown-toggle" type="button" id="dropBtn" data-bs-toggle="dropdown" aria-expanded="false">
                                <span id="selectedLabel">-- Choose a Program --</span>
                            </button>
                            <ul class="dropdown-menu shadow" aria-labelledby="dropBtn">
                                @{
                                    var programs = new List<string> {
                                        "Gold Loan Appraising",
                                        "Credit Evaluation & Lending",
                                        "Leasing & Hire Purchase Operations",
                                        "Debt Recovery & Negotiation Skills",
                                        "AML & KYC Compliance",
                                        "Financial Fraud Detection",
                                        "Customer Service Excellence",
                                        "Financial Product Sales & Marketing",
                                        "Core Banking System (CBS) Training",
                                        "Cybersecurity & Data Privacy",
                                        "Advanced Microsoft Excel",
                                        "Microfinance Field Best Practices",
                                        "Workplace Ethics & Conduct",
                                        "Strategic Leadership & Team Management",
                                        "IT Infrastructure & Troubleshooting"
                                    };
                                    foreach(var p in programs) {
                                        <li><a class="dropdown-item" href="javascript:void(0)" onclick="selectProgram('@p')">@p</a></li>
                                    }
                                }
                            </ul>
                            <input type="hidden" asp-for="TrainingRequest.Title" id="selectedTitle" required />
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="col-md-12">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Reason for Training</label>
                        <textarea asp-for="TrainingRequest.Description" class="form-control shadow-sm" rows="5" 
                                  placeholder="Briefly explain why you need this training and how it helps your role..." 
                                  style="border-radius: 8px; border-color: #cbd5e1;"></textarea>
                    </div>

                    <!-- Action Buttons -->
                    <div class="col-md-12 pt-2">
                        <button type="submit" class="btn btn-submit shadow-sm">
                            <i class="bi bi-send me-1"></i> Submit Request
                        </button>
                        <a href="/Training/Dashboard" class="btn btn-outline-secondary ms-2 px-4 py-2" style="border-radius: 8px;">Cancel</a>
                    </div>
                </div>
            </form>
        }
        else
        {
            <!-- Restricted Access View -->
            <div class="text-center py-5">
                <i class="bi bi-lock-fill text-muted" style="font-size: 3.5rem; opacity: 0.5;"></i>
                <h4 class="mt-3 fw-bold text-secondary">Access Restricted</h4>
                <p class="text-muted">Currently, only permanent employees are authorized to submit training requests via the portal.</p>
                <a href="/Training/Dashboard" class="btn btn-light border mt-2">Return to Dashboard</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function selectProgram(val) {
            document.getElementById('selectedLabel').innerText = val;
            document.getElementById('selectedTitle').value = val;
        }
    </script>
}