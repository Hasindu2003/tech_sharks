@page
@model HRMS.UI.Pages.Manager.Leave.ApprovalModel
@{
    ViewData["Title"] = "Leave Approval Inbox";
    ViewData["ActiveNav"] = "LeaveApproval";

    string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "EM";
        var parts = name.Split(new[] { ' ', '.' }, StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 0 ? string.Join("", parts.Take(2).Select(w => w[0])).ToUpper() : "EM";
    }
}

<style>
    .page-h { font-size: 19px; font-weight: 800; color: #151811; margin: 0 0 3px 0; }
    .page-s { font-size: 12px; color: #7a8863; margin: 0 0 20px 0; }
    .sec-heading { font-size: 14px; font-weight: 700; color: #151811; margin: 0 0 12px 0; display: flex; align-items: center; gap: 8px; }

    /* Navigation Bar matching Kanrich pill buttons */
    .leave-nav-bar {
        display: flex;
        gap: 8px;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 24px;
    }

    .leave-nav-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 18px;
        font-family: 'Manrope', sans-serif;
        font-size: 0.85rem;
        font-weight: 600;
        border-radius: 6px;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.15s ease;
        line-height: 1.4;
    }

    .leave-nav-btn.btn-kanrich-primary {
        background: #10823c;
        color: #ffffff;
        border: 1px solid #10823c;
    }
    .leave-nav-btn.btn-kanrich-primary:hover {
        background: #0d6e32;
        border-color: #0d6e32;
        color: #ffffff;
    }

    .leave-nav-btn.btn-kanrich-outline {
        background: #ffffff;
        color: #10823c;
        border: 1px solid #d1d5db;
    }
    .leave-nav-btn.btn-kanrich-outline:hover {
        border-color: #10823c;
        background: #f0fdf4;
        color: #10823c;
    }

    .tab-badge {
        background: #ef4444;
        color: #ffffff;
        padding: 1px 6px;
        border-radius: 9999px;
        font-size: 10.5px;
        font-weight: 800;
        margin-left: 2px;
    }

    /* Tab Panes */
    .k-tab-pane {
        display: none;
        animation: fadeInTab 0.2s ease-in-out;
    }

    .k-tab-pane.active {
        display: block;
    }

    @@keyframes fadeInTab {
        from { opacity: 0; transform: translateY(3px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Tables & Cards matching Separation Management */
    .table-card { 
        background: white; 
        border: 1px solid #e2e5dc; 
        border-radius: 10px; 
        overflow: hidden; 
        margin-bottom: 28px; 
        box-shadow: 0 1px 2px rgba(0,0,0,.05); 
    }
    .emp-table { 
        width: 100%; 
        border-collapse: collapse; 
    }
    .emp-table th { 
        background: #f9fafb; 
        padding: 13px 19px; 
        text-align: left; 
        font-size: 13px; 
        font-weight: 700; 
        color: #7a8863; 
        border-bottom: 1px solid #e2e5dc; 
    }
    .emp-table td { 
        padding: 13px 19px; 
        border-bottom: 1px solid #e2e5dc; 
        font-size: 14px; 
        color: #151811; 
        vertical-align: middle;
    }
    .emp-table tr:last-child td { border-bottom: none; }
    .emp-table tbody tr:hover { background: #fafafa; }

    .employee-cell { display: flex; align-items: center; gap: 10px; }
    .avatar-circle { 
        width: 36px; 
        height: 36px; 
        border-radius: 50%; 
        background: #e8f3ec; 
        color: #10823c; 
        display: flex; 
        align-items: center; 
        justify-content: center; 
        font-size: 13px; 
        font-weight: 700; 
        flex-shrink: 0; 
    }
    .emp-info .name { font-size: 14px; font-weight: 700; color: #151811; display: block; }
    .emp-info .sub  { font-size: 12px; color: #7a8863; }

    /* Badges matching Separation */
    .k-badge, .status-badge { 
        display: inline-flex; 
        align-items: center; 
        gap: 4px; 
        padding: 3px 10px; 
        border-radius: 9999px; 
        font-size: 11.5px; 
        font-weight: 700; 
        border: 1px solid transparent; 
        white-space: nowrap;
    }
    .k-badge-pending  { background: #fef3c7; border-color: #fde68a; color: #b45309; }
    .k-badge-approved { background: #dcfce7; border-color: #bbf7d0; color: #10823c; }
    .k-badge-rejected { background: #fee2e2; border-color: #fecaca; color: #b91c1c; }
    .k-badge-info     { background: #dbeafe; border-color: #bfdbfe; color: #1d4ed8; }
    .k-badge-maternity { background: #fce7f3; border-color: #fbcfe8; color: #be185d; }
    .k-badge-overseas  { background: #e0f2fe; border-color: #bae6fd; color: #0369a1; }

    /* Empty state matching Separation Management */
    .empty-caught-up-card {
        background: #ffffff;
        border: 1px solid #e2e5dc;
        border-radius: 10px;
        text-align: center;
        padding: 44px 20px;
        margin-bottom: 28px;
        box-shadow: 0 1px 2px rgba(0,0,0,.03);
    }
    .check-icon-circle {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #f0fdf4;
        border: 1.5px solid #86efac;
        color: #10823c;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
        font-size: 22px;
    }
</style>

<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px;">
    <div>
        <h1 class="page-h">Leave Approval Inbox</h1>
        <p class="page-s">Review and process leave applications from your subordinates</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="k-alert k-alert-success" style="background:#ecfdf5;color:#065f46;padding:12px 16px;border-radius:8px;margin-bottom:16px;border:1px solid #10b981;display:flex;align-items:center;gap:8px">
        <i class="bi bi-check-circle-fill"></i> @Model.SuccessMessage
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="k-alert k-alert-danger" style="background:#fef2f2;color:#991b1b;padding:12px 16px;border-radius:8px;margin-bottom:16px;border:1px solid #fca5a5;display:flex;align-items:center;gap:8px">
        <i class="bi bi-exclamation-triangle-fill"></i> @Model.ErrorMessage
    </div>
}

<!-- Horizontal Navigation Bar matching Separation style -->
<div class="leave-nav-bar" role="tablist">
    <button type="button" 
            class="btn-kanrich @(Model.Tab == "standard" || string.IsNullOrEmpty(Model.Tab) ? "btn-kanrich-primary" : "btn-kanrich-outline") leave-nav-btn" 
            id="tab-btn-standard" 
            onclick="switchTab('standard')">
        <i class="bi bi-calendar2-check"></i> Standard Leaves (@Model.StandardCount)
    </button>
    <button type="button" 
            class="btn-kanrich @(Model.Tab == "maternity" ? "btn-kanrich-primary" : "btn-kanrich-outline") leave-nav-btn" 
            id="tab-btn-maternity" 
            onclick="switchTab('maternity')">
        <i class="bi bi-heart-pulse"></i> Maternity Leaves (@Model.MaternityCount)
    </button>
    <button type="button" 
            class="btn-kanrich @(Model.Tab == "overseas" ? "btn-kanrich-primary" : "btn-kanrich-outline") leave-nav-btn" 
            id="tab-btn-overseas" 
            onclick="switchTab('overseas')">
        <i class="bi bi-globe-americas"></i> Overseas Leaves (@Model.OverseasCount)
    </button>
</div>

<!-- ==================== 1. STANDARD LEAVES TAB PANE ==================== -->
<div class="k-tab-pane @(Model.Tab == "standard" || string.IsNullOrEmpty(Model.Tab) ? "active" : "")" id="pane-standard">
    <!-- Pending Section -->
    <div class="sec-heading">
        <span>Awaiting Your Review</span>
        @if (Model.StandardCount > 0)
        {
            <span class="tab-badge">@Model.StandardCount</span>
        }
    </div>

    @if (Model.PendingStandardLeaves.Any())
    {
        <div class="table-card">
            <table class="emp-table" id="table-standard-pending">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Leave Type</th>
                        <th>Duration</th>
                        <th>Days</th>
                        <th>Reason</th>
                        <th>Overall Status</th>
                        <th style="text-align:right"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var leave in Model.PendingStandardLeaves)
                    {
                        var nameWithInitials = leave.Employee?.NameWithInitials ?? leave.Employee?.FullName ?? "Unknown";
                        var initials = GetInitials(nameWithInitials);
                        <tr>
                            <td>
                                <div class="employee-cell">
                                    <div class="avatar-circle">@initials</div>
                                    <div class="emp-info">
                                        <span class="name" title="@leave.Employee?.FullName">@nameWithInitials</span>
                                        <span class="sub">@(leave.Employee?.Department?.Name ?? "General") &bull; EPF: @(leave.Employee?.EPFNumber ?? "N/A")</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="k-badge k-badge-info">
                                    <i class="bi bi-tag-fill" style="font-size:9px;"></i> @leave.LeaveType
                                </span>
                            </td>
                            <td style="color:#334155; font-weight:600">
                                @if (leave.StartDate.Date == leave.EndDate.Date)
                                {
                                    @leave.StartDate.ToString("MMM dd, yyyy")
                                }
                                else
                                {
                                    @leave.StartDate.ToString("MMM dd") <text>–</text> @leave.EndDate.ToString("MMM dd, yyyy")
                                }
                            </td>
                            <td>
                                @if (leave.IsHalfDay)
                                {
                                    <span style="font-weight:700; color:#10823c;">0.5 day <small style="display:block; font-size:10.5px; color:#15803d; font-weight:600;">(@(leave.HalfDaySession ?? "Half Day"))</small></span>
                                }
                                else
                                {
                                    <span style="font-weight:700; color:#10823c;">@(leave.TotalDays % 1 == 0 ? $"{leave.TotalDays:0}" : $"{leave.TotalDays:0.0}") @(leave.TotalDays == 1 ? "day" : "days")</span>
                                }
                            </td>
                            <td style="color:#64748b; font-size:13px; max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@leave.Reason">
                                @(string.IsNullOrWhiteSpace(leave.Reason) ? "—" : leave.Reason)
                            </td>
                            <td>
                                <span class="k-badge k-badge-pending">@leave.Status</span>
                            </td>
                            <td style="text-align:right">
                                <a asp-page="./Review" asp-route-id="@leave.Id" class="btn-kanrich btn-kanrich-primary btn-kanrich-sm">
                                    Review &rarr;
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-caught-up-card">
            <div class="check-icon-circle">
                <i class="bi bi-check-lg"></i>
            </div>
            <div style="font-size:15px;font-weight:700;color:#151811;margin-bottom:4px">All Caught Up!</div>
            <div style="font-size:12.5px;color:#7a8863">No pending standard leave requests awaiting your review.</div>
        </div>
    }

    <!-- Reviewed History Section -->
    <div class="sec-heading" style="margin-top: 32px;">
        <span>Recently Reviewed Standard Leaves</span>
        <span style="background:#f3f4f6;color:#7a8863;padding:2px 8px;border-radius:20px;font-size:11px;font-weight:800">@Model.ReviewedStandardLeaves.Count</span>
    </div>

    @if (Model.ReviewedStandardLeaves.Any())
    {
        <div class="table-card">
            <table class="emp-table" id="table-standard-history">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Leave Type</th>
                        <th>Duration</th>
                        <th>Days</th>
                        <th>Your Decision</th>
                        <th>Date Processed</th>
                        <th>Overall Status</th>
                        <th style="text-align:right"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var hist in Model.ReviewedStandardLeaves)
                    {
                        var initials = GetInitials(hist.EmployeeName);
                        <tr>
                            <td>
                                <div class="employee-cell">
                                    <div class="avatar-circle">@initials</div>
                                    <div class="emp-info">
                                        <span class="name">@hist.EmployeeName</span>
                                        <span class="sub">Processed Leave Request</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="k-badge k-badge-info">@hist.LeaveType</span>
                            </td>
                            <td style="color:#334155; font-weight:600">
                                @hist.StartDate.ToString("MMM dd") – @hist.EndDate.ToString("MMM dd, yyyy")
                            </td>
                            <td style="font-weight:700; color:#10823c;">
                                @(hist.TotalDays % 1 == 0 ? $"{hist.TotalDays:0}" : $"{hist.TotalDays:0.0}") @(hist.TotalDays == 1 ? "day" : "days")
                                @if (hist.IsHalfDay)
                                {
                                    <small style="display:block; font-size:10.5px; color:#15803d; font-weight:600;">(@(hist.HalfDaySession ?? "Half Day"))</small>
                                }
                            </td>
                            <td>
                                <span class="k-badge @(hist.ActionTaken == "Approved" ? "k-badge-approved" : "k-badge-rejected")">
                                    @(hist.ActionTaken == "Approved" ? "✓ Approved" : "✕ Rejected")
                                </span>
                            </td>
                            <td style="color:#7a8863; font-size:13px">@hist.ActionDate.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>
                                <span class="k-badge @(hist.OverallStatus == "Approved" ? "k-badge-approved" : (hist.OverallStatus.Contains("Rejected") ? "k-badge-rejected" : "k-badge-pending"))">
                                    @hist.OverallStatus
                                </span>
                            </td>
                            <td style="text-align:right">
                                <a asp-page="./Review" asp-route-id="@hist.LeaveId" class="btn-kanrich btn-kanrich-outline btn-kanrich-sm">
                                    View Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div style="text-align: center; padding: 28px 20px; background: white; border: 1px dashed #e2e8f0; border-radius: 10px; color: #94a3b8; font-size: 13px; margin-bottom: 40px;">
            <i class="bi bi-clock-history" style="font-size: 1.4rem; display: block; margin-bottom: 4px;"></i>
            No previously processed standard leave requests found.
        </div>
    }
</div>

<!-- ==================== 2. MATERNITY LEAVES TAB PANE ==================== -->
<div class="k-tab-pane @(Model.Tab == "maternity" ? "active" : "")" id="pane-maternity">
    <!-- Pending Section -->
    <div class="sec-heading">
        <span>Awaiting Your Review</span>
        @if (Model.MaternityCount > 0)
        {
            <span class="tab-badge">@Model.MaternityCount</span>
        }
    </div>

    @if (Model.PendingMaternityLeaves.Any())
    {
        <div class="table-card">
            <table class="emp-table" id="table-maternity-pending">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Maternity Details</th>
                        <th>Duration</th>
                        <th>Days</th>
                        <th>Remarks</th>
                        <th>Overall Status</th>
                        <th style="text-align:right"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var leave in Model.PendingMaternityLeaves)
                    {
                        var nameWithInitials = leave.Employee?.NameWithInitials ?? leave.Employee?.FullName ?? "Unknown";
                        var initials = GetInitials(nameWithInitials);
                        <tr>
                            <td>
                                <div class="employee-cell">
                                    <div class="avatar-circle">@initials</div>
                                    <div class="emp-info">
                                        <span class="name" title="@leave.Employee?.FullName">@nameWithInitials</span>
                                        <span class="sub">@(leave.Employee?.Department?.Name ?? "General") &bull; EPF: @(leave.Employee?.EPFNumber ?? "N/A")</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="k-badge k-badge-maternity">
                                    <i class="bi bi-heart-pulse-fill"></i> Maternity
                                </span>
                                @if (leave.MaternityLeave != null)
                                {
                                    <span class="k-badge k-badge-info" style="margin-left: 4px;">
                                        Child #@leave.MaternityLeave.ChildNumber
                                    </span>
                                    @if (leave.MaternityLeave.ExpectedDeliveryDate.HasValue)
                                    {
                                        <span style="font-size:12px; color:#64748b; margin-left: 6px;">
                                            EDD: @leave.MaternityLeave.ExpectedDeliveryDate.Value.ToString("MMM dd, yyyy")
                                        </span>
                                    }
                                }
                            </td>
                            <td style="color:#334155; font-weight:600">
                                @leave.StartDate.ToString("MMM dd") – @leave.EndDate.ToString("MMM dd, yyyy")
                            </td>
                            <td>
                                <span style="font-weight:700; color:#10823c;">@leave.TotalDays days</span>
                            </td>
                            <td style="color:#64748b; font-size:13px; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@leave.Reason">
                                @(string.IsNullOrWhiteSpace(leave.Reason) ? "Maternity Leave" : leave.Reason)
                            </td>
                            <td>
                                <span class="k-badge k-badge-pending">@leave.Status</span>
                            </td>
                            <td style="text-align:right">
                                <a asp-page="./Review" asp-route-id="@leave.Id" class="btn-kanrich btn-kanrich-primary btn-kanrich-sm">
                                    Review &rarr;
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-caught-up-card">
            <div class="check-icon-circle">
                <i class="bi bi-check-lg"></i>
            </div>
            <div style="font-size:15px;font-weight:700;color:#151811;margin-bottom:4px">All Caught Up!</div>
            <div style="font-size:12.5px;color:#7a8863">No pending maternity leave requests awaiting your review.</div>
        </div>
    }

    <!-- Reviewed History Section -->
    <div class="sec-heading" style="margin-top: 32px;">
        <span>Recently Reviewed Maternity Leaves</span>
        <span style="background:#f3f4f6;color:#7a8863;padding:2px 8px;border-radius:20px;font-size:11px;font-weight:800">@Model.ReviewedMaternityLeaves.Count</span>
    </div>

    @if (Model.ReviewedMaternityLeaves.Any())
    {
        <div class="table-card">
            <table class="emp-table" id="table-maternity-history">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Details</th>
                        <th>Duration</th>
                        <th>Days</th>
                        <th>Your Decision</th>
                        <th>Date Processed</th>
                        <th>Overall Status</th>
                        <th style="text-align:right"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var hist in Model.ReviewedMaternityLeaves)
                    {
                        var initials = GetInitials(hist.EmployeeName);
                        <tr>
                            <td>
                                <div class="employee-cell">
                                    <div class="avatar-circle">@initials</div>
                                    <div class="emp-info">
                                        <span class="name">@hist.EmployeeName</span>
                                        <span class="sub">Maternity Leave</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="k-badge k-badge-maternity">
                                    @(string.IsNullOrEmpty(hist.AdditionalInfo) ? "Maternity" : hist.AdditionalInfo)
                                </span>
                            </td>
                            <td style="color:#334155; font-weight:600">
                                @hist.StartDate.ToString("MMM dd") – @hist.EndDate.ToString("MMM dd, yyyy")
                            </td>
                            <td style="font-weight:700; color:#10823c;">@hist.TotalDays</td>
                            <td>
                                <span class="k-badge @(hist.ActionTaken == "Approved" ? "k-badge-approved" : "k-badge-rejected")">
                                    @(hist.ActionTaken == "Approved" ? "✓ Approved" : "✕ Rejected")
                                </span>
                            </td>
                            <td style="color:#7a8863; font-size:13px">@hist.ActionDate.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>
                                <span class="k-badge @(hist.OverallStatus == "Approved" ? "k-badge-approved" : (hist.OverallStatus.Contains("Rejected") ? "k-badge-rejected" : "k-badge-pending"))">
                                    @hist.OverallStatus
                                </span>
                            </td>
                            <td style="text-align:right">
                                <a asp-page="./Review" asp-route-id="@hist.LeaveId" class="btn-kanrich btn-kanrich-outline btn-kanrich-sm">
                                    View Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div style="text-align: center; padding: 28px 20px; background: white; border: 1px dashed #e2e8f0; border-radius: 10px; color: #94a3b8; font-size: 13px; margin-bottom: 40px;">
            <i class="bi bi-clock-history" style="font-size: 1.4rem; display: block; margin-bottom: 4px;"></i>
            No previously processed maternity leave requests found.
        </div>
    }
</div>

<!-- ==================== 3. OVERSEAS LEAVES TAB PANE ==================== -->
<div class="k-tab-pane @(Model.Tab == "overseas" ? "active" : "")" id="pane-overseas">
    <!-- Pending Section -->
    <div class="sec-heading">
        <span>Awaiting Your Review</span>
        @if (Model.OverseasCount > 0)
        {
            <span class="tab-badge">@Model.OverseasCount</span>
        }
    </div>

    @if (Model.PendingOverseasLeaves.Any())
    {
        <div class="table-card">
            <table class="emp-table" id="table-overseas-pending">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Destination & Passport</th>
                        <th>Duration</th>
                        <th>Days</th>
                        <th>Reason</th>
                        <th>Overall Status</th>
                        <th style="text-align:right"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var leave in Model.PendingOverseasLeaves)
                    {
                        var nameWithInitials = leave.Employee?.NameWithInitials ?? leave.Employee?.FullName ?? "Unknown";
                        var initials = GetInitials(nameWithInitials);
                        <tr>
                            <td>
                                <div class="employee-cell">
                                    <div class="avatar-circle">@initials</div>
                                    <div class="emp-info">
                                        <span class="name" title="@leave.Employee?.FullName">@nameWithInitials</span>
                                        <span class="sub">@(leave.Employee?.Department?.Name ?? "General") &bull; EPF: @(leave.Employee?.EPFNumber ?? "N/A")</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="k-badge k-badge-overseas">
                                    <i class="bi bi-globe-americas"></i> @(leave.OverseasLeave?.Country ?? "Overseas")
                                </span>
                                @if (!string.IsNullOrEmpty(leave.OverseasLeave?.PassportNumber))
                                {
                                    <span style="font-size:12px; color:#64748b; margin-left: 6px;">
                                        Pass: @leave.OverseasLeave.PassportNumber
                                    </span>
                                }
                            </td>
                            <td style="color:#334155; font-weight:600">
                                @leave.StartDate.ToString("MMM dd") – @leave.EndDate.ToString("MMM dd, yyyy")
                            </td>
                            <td>
                                <span style="font-weight:700; color:#10823c;">@leave.TotalDays days</span>
                            </td>
                            <td style="color:#64748b; font-size:13px; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@leave.Reason">
                                @(string.IsNullOrWhiteSpace(leave.Reason) ? "Overseas Leave" : leave.Reason)
                            </td>
                            <td>
                                <span class="k-badge k-badge-pending">@leave.Status</span>
                            </td>
                            <td style="text-align:right">
                                <a asp-page="./Review" asp-route-id="@leave.Id" class="btn-kanrich btn-kanrich-primary btn-kanrich-sm">
                                    Review &rarr;
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-caught-up-card">
            <div class="check-icon-circle">
                <i class="bi bi-check-lg"></i>
            </div>
            <div style="font-size:15px;font-weight:700;color:#151811;margin-bottom:4px">All Caught Up!</div>
            <div style="font-size:12.5px;color:#7a8863">No pending overseas travel leave requests awaiting your review.</div>
        </div>
    }

    <!-- Reviewed History Section -->
    <div class="sec-heading" style="margin-top: 32px;">
        <span>Recently Reviewed Overseas Leaves</span>
        <span style="background:#f3f4f6;color:#7a8863;padding:2px 8px;border-radius:20px;font-size:11px;font-weight:800">@Model.ReviewedOverseasLeaves.Count</span>
    </div>

    @if (Model.ReviewedOverseasLeaves.Any())
    {
        <div class="table-card">
            <table class="emp-table" id="table-overseas-history">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Destination</th>
                        <th>Duration</th>
                        <th>Days</th>
                        <th>Your Decision</th>
                        <th>Date Processed</th>
                        <th>Overall Status</th>
                        <th style="text-align:right"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var hist in Model.ReviewedOverseasLeaves)
                    {
                        var initials = GetInitials(hist.EmployeeName);
                        <tr>
                            <td>
                                <div class="employee-cell">
                                    <div class="avatar-circle">@initials</div>
                                    <div class="emp-info">
                                        <span class="name">@hist.EmployeeName</span>
                                        <span class="sub">Overseas Travel</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="k-badge k-badge-overseas">
                                    @(string.IsNullOrEmpty(hist.AdditionalInfo) ? "Overseas" : hist.AdditionalInfo)
                                </span>
                            </td>
                            <td style="color:#334155; font-weight:600">
                                @hist.StartDate.ToString("MMM dd") – @hist.EndDate.ToString("MMM dd, yyyy")
                            </td>
                            <td style="font-weight:700; color:#10823c;">@hist.TotalDays</td>
                            <td>
                                <span class="k-badge @(hist.ActionTaken == "Approved" ? "k-badge-approved" : "k-badge-rejected")">
                                    @(hist.ActionTaken == "Approved" ? "✓ Approved" : "✕ Rejected")
                                </span>
                            </td>
                            <td style="color:#7a8863; font-size:13px">@hist.ActionDate.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>
                                <span class="k-badge @(hist.OverallStatus == "Approved" ? "k-badge-approved" : (hist.OverallStatus.Contains("Rejected") ? "k-badge-rejected" : "k-badge-pending"))">
                                    @hist.OverallStatus
                                </span>
                            </td>
                            <td style="text-align:right">
                                <a asp-page="./Review" asp-route-id="@hist.LeaveId" class="btn-kanrich btn-kanrich-outline btn-kanrich-sm">
                                    View Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div style="text-align: center; padding: 28px 20px; background: white; border: 1px dashed #e2e8f0; border-radius: 10px; color: #94a3b8; font-size: 13px; margin-bottom: 40px;">
            <i class="bi bi-clock-history" style="font-size: 1.4rem; display: block; margin-bottom: 4px;"></i>
            No previously processed overseas leave requests found.
        </div>
    }
</div>

@section Scripts {
<script>
    function switchTab(tabName) {
        if (!tabName) tabName = 'standard';
        
        // Hide all tab panes
        document.querySelectorAll('.k-tab-pane').forEach(function(pane) {
            pane.classList.remove('active');
        });

        // Reset all nav buttons to outline style
        document.querySelectorAll('.leave-nav-btn').forEach(function(btn) {
            btn.classList.remove('btn-kanrich-primary');
            btn.classList.add('btn-kanrich-outline');
        });

        // Activate selected button with primary style and display selected pane
        var selectedBtn = document.getElementById('tab-btn-' + tabName);
        var selectedPane = document.getElementById('pane-' + tabName);
        if (selectedBtn) {
            selectedBtn.classList.remove('btn-kanrich-outline');
            selectedBtn.classList.add('btn-kanrich-primary');
        }
        if (selectedPane) {
            selectedPane.classList.add('active');
        }

        // Update URL query parameter without full reload
        try {
            var url = new URL(window.location);
            url.searchParams.set('tab', tabName);
            window.history.replaceState({}, '', url);
        } catch (e) {
            console.error(e);
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        // Initialize active tab from URL query param
        var urlParams = new URLSearchParams(window.location.search);
        var tab = urlParams.get('tab');
        if (tab && (tab === 'standard' || tab === 'maternity' || tab === 'overseas')) {
            switchTab(tab);
        }

        // Initialize table pagination matching Separation Management
        if (typeof initTablePagination === 'function') {
            initTablePagination('table-standard-pending', 5);
            initTablePagination('table-standard-history', 10);
            initTablePagination('table-maternity-pending', 5);
            initTablePagination('table-maternity-history', 10);
            initTablePagination('table-overseas-pending', 5);
            initTablePagination('table-overseas-history', 10);
        }
    });
</script>
}
