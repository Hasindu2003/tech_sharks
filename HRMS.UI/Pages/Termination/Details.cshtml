@page "{id:int}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "HR Manager,HR Officer,Area Manager,Branch Manager,Department Head,Employee")]
@model HRMS.UI.Pages.Termination.DetailsModel
@{
    ViewData["Title"] = "Termination Details";
    var req = Model.Request!;
}

<style>
    .back-link { color: #7a8863; font-size: 13px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; margin-bottom: 8px; }
    .back-link:hover { color: #10823c; }
    .page-h { font-size: 20px; font-weight: 800; color: #151811; margin: 0 0 6px 0; }
    .detail-card { background: white; border: 1px solid #e2e5dc; border-radius: 10px; padding: 20px 22px; margin-bottom: 16px; box-shadow: 0 1px 2px rgba(0,0,0,.05); }
    .detail-card.green-bg { background: #f0fdf4; border-color: #bbf7d0; }
    .dlt { font-size: 12px; font-weight: 700; color: #7a8863; text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 14px 0; padding-bottom: 10px; border-bottom: 1px solid #e2e5dc; }
    .detail-card.green-bg .dlt { border-bottom-color: #bbf7d0; }
    .dl-grid { display: grid; gap: 14px; margin-bottom: 14px; }
    .dl dt { font-size: 11px; font-weight: 700; color: #7a8863; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 2px; }
    .dl dd { font-size: 14px; font-weight: 500; color: #151811; margin: 0; }
    .k-badge, .status-badge { display: inline-flex; align-items: center; gap: 4px; padding: 2px 9px; border-radius: 9999px; font-size: 11.5px; font-weight: 700; border: 1px solid transparent; }
    .k-badge-pending  { background: #fef3c7; border-color: #fde68a; color: #b45309; }
    .k-badge-approved { background: #dcfce7; border-color: #bbf7d0; color: #10823c; }
    .k-badge-rejected { background: #fee2e2; border-color: #fecaca; color: #b91c1c; }
    .k-badge-info     { background: #dbeafe; border-color: #bfdbfe; color: #1d4ed8; }
    .k-badge-warning  { background: #fef3c7; border-color: #fde68a; color: #b45309; }
    .doc-row { display: flex; align-items: center; justify-content: space-between; padding: 9px 14px; background: #f9fafb; border: 1px solid #e2e5dc; border-radius: 8px; margin-bottom: 6px; }
    .doc-row:last-child { margin-bottom: 0; }
    .doc-name { font-size: 13px; font-weight: 600; color: #151811; }
    .doc-meta { font-size: 11px; color: #7a8863; }
    .btn-action { color: #10823c; font-size: 13px; font-weight: 700; text-decoration: none; padding: 5px 10px; border-radius: 5px; transition: background .2s; }
    .btn-action:hover { background: #e8f3ec; }
    .tstep { display: flex; gap: 12px; padding: 10px 0; border-bottom: 1px solid #f3f4f6; }
    .tstep:last-child { border-bottom: none; }
    .tstep-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; margin-top: 4px; background: #e2e5dc; }
    .tstep-dot.done { background: #10823c; }
    .tstep-dot.rejected { background: #ef4444; }
    .tstep-lbl { font-size: 13px; font-weight: 600; color: #151811; }
    .tstep-desc { font-size: 12px; color: #7a8863; }
</style>

<div style="margin-bottom: 16px;">
    <a asp-page="/Separation/Dashboard" asp-route-ActiveTab="Terminations" class="back-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        Back to Separation Hub
    </a>
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px">
        <div>
            <h2 class="page-h">Termination Request #@req?.Id</h2>
            <div style="font-size:13px;color:#7a8863">@req?.EmployeeName (@req?.EpfNumber) &bull; @req?.Branch</div>
        </div>
        <div>
            <span class="k-badge @req?.StatusBadgeClass" style="font-size:13px;padding:5px 12px">@req?.StatusDisplay</span>
        </div>
    </div>
</div>

@if (req != null)
{
    <div style="display:grid;grid-template-columns:1fr 320px;gap:16px;align-items:start">
        <!-- Left Column -->
        <div>
            <div class="detail-card green-bg">
                <div class="dlt">Employee Information</div>
                <div class="dl-grid" style="grid-template-columns:1fr 1fr 1fr">
                    <div class="dl"><dt>Employee Name</dt><dd>@req.EmployeeName</dd></div>
                    <div class="dl"><dt>EPF Number</dt><dd>@req.EpfNumber</dd></div>
                    <div class="dl"><dt>Email</dt><dd style="font-size:13px">@req.EmployeeEmail</dd></div>
                    <div class="dl"><dt>Branch</dt><dd>@req.Branch</dd></div>
                    <div class="dl"><dt>Department</dt><dd>@req.Department</dd></div>
                    <div class="dl"><dt>Designation</dt><dd>@req.Designation</dd></div>
                </div>
            </div>

            <div class="detail-card">
                <div class="dlt">Termination Details</div>
                <div class="dl-grid" style="grid-template-columns:1fr 1fr 1fr;margin-bottom:16px">
                    <div class="dl"><dt>Termination Type</dt><dd>@req.TerminationTypeDisplay</dd></div>
                    <div class="dl"><dt>Initiation Date</dt><dd>@req.InitiationDate.ToString("MMM dd, yyyy")</dd></div>
                    <div class="dl"><dt>Effective Date</dt><dd style="font-weight:700;color:#ef4444">@req.EffectiveTerminationDate.ToString("MMM dd, yyyy")</dd></div>
                </div>
                <div style="margin-bottom:14px">
                    <div style="font-size:11px;font-weight:700;color:#7a8863;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:6px">Reason for Termination</div>
                    <div style="font-size:14px;color:#374151;line-height:1.5">@req.ReasonForTermination</div>
                </div>
            </div>

            <!-- Stage 2: Department Clearances Table -->
            <div class="detail-card">
                <div class="dlt" style="display:flex;justify-content:space-between;align-items:center">
                    <span>Stage 2: Branch Department Clearances</span>
                    <span class="k-badge @(req.AreAllDeptHeadsApproved ? "k-badge-approved" : "k-badge-pending")">
                        @req.DeptHeadsApprovedCount / @req.TotalDeptHeadsCount Approved
                    </span>
                </div>
                <div class="k-table-responsive">
                    <table class="k-table" style="font-size:13px">
                        <thead>
                            <tr>
                                <th>Department</th>
                                <th>Reviewer</th>
                                <th>Status</th>
                                <th>Review Date</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dept in req.DepartmentReviews)
                            {
                                <tr>
                                    <td style="font-weight:600">@dept.DepartmentName</td>
                                    <td>@(string.IsNullOrWhiteSpace(dept.ReviewerName) ? "-" : dept.ReviewerName)</td>
                                    <td><span class="k-badge @dept.StatusBadgeClass">@dept.Status</span></td>
                                    <td>@(dept.ReviewDate.HasValue ? dept.ReviewDate.Value.ToString("yyyy-MM-dd HH:mm") : "-")</td>
                                    <td style="max-width:200px">@(string.IsNullOrWhiteSpace(dept.Comments) ? "-" : dept.Comments)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Stage 3 & 4 Review Cards -->
            @if (!string.IsNullOrWhiteSpace(req.BMReview))
            {
                <div class="detail-card">
                    <div class="dlt">Stage 3: Branch Manager Review</div>
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
                        <span class="k-badge @(req.BMReview == "Approved" ? "k-badge-approved" : "k-badge-rejected")">@req.BMReview</span>
                        <span style="font-size:12px;color:#7a8863">@req.BMReviewDate?.ToString("yyyy-MM-dd HH:mm") &bull; @req.BMEmail</span>
                    </div>
                    <p style="font-size:13px;margin:0;color:#374151">@(string.IsNullOrWhiteSpace(req.BMComments) ? "No remarks." : req.BMComments)</p>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(req.AMReview))
            {
                <div class="detail-card">
                    <div class="dlt">Stage 4: Area Manager Review</div>
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
                        <span class="k-badge @(req.AMReview == "Approved" ? "k-badge-approved" : "k-badge-rejected")">@req.AMReview</span>
                        <span style="font-size:12px;color:#7a8863">@req.AMReviewDate?.ToString("yyyy-MM-dd HH:mm") &bull; @req.AMEmail</span>
                    </div>
                    <p style="font-size:13px;margin:0;color:#374151">@(string.IsNullOrWhiteSpace(req.AMComments) ? "No remarks." : req.AMComments)</p>
                </div>
            }

            <!-- Stage 5: HR Finalization / Finance Clearance -->
            @if (req.FinanceClearanceCompleted || !string.IsNullOrWhiteSpace(req.HRReview))
            {
                <div class="detail-card green-bg">
                    <div class="dlt">Stage 5: HR Finalization & Financial Clearance</div>
                    <div class="dl-grid" style="grid-template-columns:1fr 1fr;margin-bottom:8px">
                        <div class="dl"><dt>Status</dt><dd style="color:#10823c;font-weight:700">@(req.HRReview ?? "Completed")</dd></div>
                        <div class="dl"><dt>Completed Date</dt><dd>@req.FinanceClearanceDate?.ToString("MMM dd, yyyy HH:mm")</dd></div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(req.FinanceClearanceNotes))
                    {
                        <div class="dl"><dt>Notes</dt><dd style="margin-top:4px">@req.FinanceClearanceNotes</dd></div>
                    }
                </div>
            }

            <div class="detail-card">
                <div class="dlt">Supporting Documents (@req.Documents.Count)</div>
                @if (req.Documents.Any())
                {
                    @foreach (var doc in req.Documents)
                    {
                        <div class="doc-row">
                            <div>
                                <div class="doc-name">@doc.FileName</div>
                                <div class="doc-meta">@doc.DocumentType · @doc.UploadedDate.ToString("MMM dd, yyyy HH:mm")</div>
                            </div>
                            <a asp-page="/Termination/DownloadDocument" asp-route-id="@doc.Id" class="btn-action">Download</a>
                        </div>
                    }
                }
                else { <p style="font-size:13px;color:#7a8863;margin:0">No documents attached.</p> }
            </div>
        </div>

        <!-- Right Column: 5-Stage Stepper -->
        <div>
            <div class="detail-card">
                <div class="dlt">5-Stage Approval Progress</div>
                <div class="tstep">
                    <div class="tstep-dot done"></div>
                    <div><div class="tstep-lbl">1. Initiated by HR</div><div class="tstep-desc">@req.CreatedDate.ToString("MMM dd, yyyy")</div></div>
                </div>
                <div class="tstep">
                    <div class="tstep-dot @(req.Status == HRMS.Application.Models.TerminationStatusEnum.DeptHeadRejected ? "rejected" : (req.Status >= HRMS.Application.Models.TerminationStatusEnum.DeptHeadsApproved ? "done" : ""))"></div>
                    <div>
                        <div class="tstep-lbl">2. Branch Dept Clearances</div>
                        <div class="tstep-desc">@req.DeptHeadsApprovedCount/@req.TotalDeptHeadsCount Approved</div>
                    </div>
                </div>
                <div class="tstep">
                    <div class="tstep-dot @(req.Status == HRMS.Application.Models.TerminationStatusEnum.BMRejected ? "rejected" : (req.Status >= HRMS.Application.Models.TerminationStatusEnum.BMApproved ? "done" : ""))"></div>
                    <div>
                        <div class="tstep-lbl">3. Branch Manager Review</div>
                        <div class="tstep-desc">@(req.BMReview ?? (req.Status >= HRMS.Application.Models.TerminationStatusEnum.DeptHeadsApproved ? "Awaiting Review" : "Pending Prior Stage"))</div>
                    </div>
                </div>
                <div class="tstep">
                    <div class="tstep-dot @(req.Status == HRMS.Application.Models.TerminationStatusEnum.AMRejected ? "rejected" : (req.Status >= HRMS.Application.Models.TerminationStatusEnum.AMApproved ? "done" : ""))"></div>
                    <div>
                        <div class="tstep-lbl">4. Area Manager Review</div>
                        <div class="tstep-desc">@(req.AMReview ?? (req.Status >= HRMS.Application.Models.TerminationStatusEnum.BMApproved ? "Awaiting Review" : "Pending Prior Stage"))</div>
                    </div>
                </div>
                <div class="tstep">
                    <div class="tstep-dot @(req.Status == HRMS.Application.Models.TerminationStatusEnum.HRRejected ? "rejected" : (req.Status == HRMS.Application.Models.TerminationStatusEnum.Terminated ? "done" : ""))"></div>
                    <div>
                        <div class="tstep-lbl">5. HR Finalization</div>
                        <div class="tstep-desc">@(req.Status == HRMS.Application.Models.TerminationStatusEnum.Terminated ? "Finalized & Completed" : (req.Status >= HRMS.Application.Models.TerminationStatusEnum.AMApproved ? "Ready for Action" : "Pending Prior Stage"))</div>
                    </div>
                </div>
            </div>

            <div class="detail-card">
                <div class="dlt">Request Originator</div>
                <div style="font-weight:700;font-size:14px;color:#151811">@req.InitiatedBy</div>
                <div style="font-size:12px;color:#7a8863;margin-top:2px">@req.InitiatedByRole</div>
            </div>
        </div>
    </div>
}
