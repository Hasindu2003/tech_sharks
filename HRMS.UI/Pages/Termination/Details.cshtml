@page "{id:int}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "HR Manager,Area Manager,Branch Manager")]
@model HRMS.UI.Pages.Termination.DetailsModel
@{
    ViewData["Title"] = "Employee Termination";
    var req = Model.Request!;
}

<div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px">
    <div>
        <h2 style="font-weight:700;font-size:1.6rem;margin-bottom:4px">Termination Request #@req.Id</h2>
        <p style="color:#6b7280;font-size:0.9rem;margin:0">
            <span class="k-badge @req.StatusBadgeClass" style="font-size:0.8rem">@req.StatusDisplay</span>
            &nbsp;Â·&nbsp; Created @req.CreatedDate.ToString("MMM dd, yyyy")
        </p>
    </div>
    <a asp-page="/Termination/Requests" class="btn-kanrich btn-kanrich-outline">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="transfer-detail-grid">
    <div>
        <!-- Employee Information -->
        <div class="k-fieldset" style="background:#f0fdf4;border-color:#bbf7d0">
            <div class="k-fieldset-title"><i class="bi bi-person-badge" style="margin-right:8px;color:var(--primary)"></i>Employee Information</div>
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px">
                <div>
                    <div class="detail-label">Employee Name</div>
                    <div class="detail-value">@req.EmployeeName</div>
                </div>
                <div>
                    <div class="detail-label">EPF Number</div>
                    <div class="detail-value">@req.EpfNumber</div>
                </div>
                <div>
                    <div class="detail-label">Email</div>
                    <div class="detail-value" style="font-size:0.85rem">@req.EmployeeEmail</div>
                </div>
                <div>
                    <div class="detail-label">Branch</div>
                    <div class="detail-value">@req.Branch</div>
                </div>
                <div>
                    <div class="detail-label">Department</div>
                    <div class="detail-value">@req.Department</div>
                </div>
                <div>
                    <div class="detail-label">Designation</div>
                    <div class="detail-value">@req.Designation</div>
                </div>
            </div>
        </div>

        <!-- Termination Details -->
        <div class="k-fieldset">
            <div class="k-fieldset-title"><i class="bi bi-clipboard-x" style="margin-right:8px;color:var(--accent-red)"></i>Termination Details</div>
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin-bottom:16px">
                <div>
                    <div class="detail-label">Termination Type</div>
                    <div class="detail-value">@req.TerminationTypeDisplay</div>
                </div>
                <div>
                    <div class="detail-label">Initiation Date</div>
                    <div class="detail-value">@req.InitiationDate.ToString("MMM dd, yyyy")</div>
                </div>
                <div>
                    <div class="detail-label">Effective Date</div>
                    <div class="detail-value" style="font-weight:700;color:var(--accent-red)">@req.EffectiveTerminationDate.ToString("MMM dd, yyyy")</div>
                </div>
            </div>
            <div style="margin-bottom:16px">
                <div class="detail-label">Reason for Termination</div>
                <div class="detail-value" style="margin-top:4px;line-height:1.5">@req.ReasonForTermination</div>
            </div>
            @if (!string.IsNullOrWhiteSpace(req.SupervisorRemarks))
            {
                <div style="margin-bottom:16px">
                    <div class="detail-label">Supervisor Remarks</div>
                    <div class="detail-value" style="margin-top:4px;line-height:1.5">@req.SupervisorRemarks</div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(req.SpecialRemarks))
            {
                <div>
                    <div class="detail-label">Special Remarks / Notes</div>
                    <div class="detail-value" style="margin-top:4px;line-height:1.5">@req.SpecialRemarks</div>
                </div>
            }
        </div>

        <!-- Obligations -->
        <div class="k-fieldset">
            <div class="k-fieldset-title"><i class="bi bi-exclamation-triangle" style="margin-right:8px;color:var(--accent-orange)"></i>Employee Obligations</div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:12px">
                <div>
                    <div class="detail-label">Direct Obligations</div>
                    <div class="detail-value">@(string.IsNullOrWhiteSpace(req.DirectObligations) ? "None" : req.DirectObligations)</div>
                </div>
                <div>
                    <div class="detail-label">Indirect Obligations</div>
                    <div class="detail-value">@(string.IsNullOrWhiteSpace(req.IndirectObligations) ? "None" : req.IndirectObligations)</div>
                </div>
            </div>
            <div style="display:flex;gap:16px;flex-wrap:wrap">
                @if (req.HasOutstandingLoans)
                {
                    <span class="k-badge k-badge-rejected"><i class="bi bi-exclamation-triangle"></i> Outstanding Loans</span>
                }
                @if (req.IsLoanGuarantor)
                {
                    <span class="k-badge k-badge-rejected"><i class="bi bi-exclamation-triangle"></i> Loan Guarantor</span>
                }
                @if (req.HasOverridePermission)
                {
                    <span class="k-badge k-badge-pending"><i class="bi bi-shield-exclamation"></i> Override Granted</span>
                }
                @if (!req.HasOutstandingLoans && !req.IsLoanGuarantor)
                {
                    <span class="k-badge k-badge-approved"><i class="bi bi-check-circle"></i> No Outstanding Obligations</span>
                }
            </div>
        </div>

        <!-- Documents -->
        <div class="k-fieldset">
            <div class="k-fieldset-title"><i class="bi bi-file-earmark" style="margin-right:8px;color:var(--accent-blue)"></i>Supporting Documents (@req.Documents.Count)</div>
            @if (req.Documents.Any())
            {
                @foreach (var doc in req.Documents)
                {
                    <div class="doc-item">
                        <div class="doc-info">
                            <div class="doc-icon @(doc.ContentType.Contains("pdf") ? "pdf" : "doc")">
                                <i class="bi @(doc.ContentType.Contains("pdf") ? "bi-file-pdf" : doc.ContentType.Contains("image") ? "bi-file-image" : "bi-file-word")"></i>
                            </div>
                            <div>
                                <div class="doc-name">@doc.FileName</div>
                                <div class="doc-size">@doc.DocumentType Â· @doc.UploadedDate.ToString("MMM dd, yyyy HH:mm")</div>
                            </div>
                        </div>
                        <a asp-page="/Termination/DownloadDocument" asp-route-id="@doc.Id" class="btn-kanrich btn-kanrich-outline btn-kanrich-sm">
                            <i class="bi bi-download"></i> Download
                        </a>
                    </div>
                }
            }
            else
            {
                <p style="color:var(--text-muted);font-size:0.88rem">No documents attached.</p>
            }
        </div>

        <!-- Approval Details -->
        @if (req.ApproverReview != null)
        {
            <div class="k-fieldset">
                <div class="k-fieldset-title"><i class="bi bi-clipboard-check" style="margin-right:8px;color:var(--primary)"></i>Approval Decision</div>
                <div class="review-card @(req.ApproverReview == "Approved" ? "approved" : "rejected")">
                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
                        <i class="bi @(req.ApproverReview == "Approved" ? "bi-check-circle-fill" : "bi-x-circle-fill")"
                           style="font-size:1.2rem;color:@(req.ApproverReview == "Approved" ? "var(--primary)" : "var(--accent-red)")"></i>
                        <span style="font-weight:700;font-size:1rem">@req.ApproverReview</span>
                    </div>
                    <div style="font-size:0.85rem;color:var(--text-secondary);margin-bottom:8px">
                        by @req.ApprovedBy Â· @req.ApproverReviewDate?.ToString("MMM dd, yyyy HH:mm")
                    </div>
                    @if (!string.IsNullOrWhiteSpace(req.ApproverComments))
                    {
                        <div style="font-size:0.9rem;line-height:1.5">@req.ApproverComments</div>
                    }
                </div>
            </div>
        }

        <!-- Finance Clearance -->
        @if (req.FinanceClearanceCompleted)
        {
            <div class="k-fieldset" style="background:#f0fdf4;border-color:#bbf7d0">
                <div class="k-fieldset-title"><i class="bi bi-cash-coin" style="margin-right:8px;color:var(--primary)"></i>Finance Clearance</div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:12px">
                    <div>
                        <div class="detail-label">Clearance Status</div>
                        <div class="detail-value" style="color:var(--primary);font-weight:700">Completed âœ…</div>
                    </div>
                    <div>
                        <div class="detail-label">Clearance Date</div>
                        <div class="detail-value">@req.FinanceClearanceDate?.ToString("MMM dd, yyyy HH:mm")</div>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(req.FinanceClearanceNotes))
                {
                    <div>
                        <div class="detail-label">Notes</div>
                        <div class="detail-value" style="margin-top:4px;line-height:1.5">@req.FinanceClearanceNotes</div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Sidebar: Timeline -->
    <div>
        <div class="eligibility-panel">
            <h5><i class="bi bi-clock-history"></i> Termination Timeline</h5>
            <p class="ep-subtitle">Track the progress of this request</p>

            <div class="ep-check-item">
                <div class="ep-check-circle" style="@(req.Status >= 0 ? "background:#fff;border-color:#fff" : "")"></div>
                <div>
                    <div class="ep-check-label">Request Created</div>
                    <div class="ep-check-desc">@req.CreatedDate.ToString("MMM dd, yyyy HH:mm")</div>
                </div>
            </div>

            <div class="ep-check-item">
                <div class="ep-check-circle" style="@(req.Status >= HRMS.Application.Models.TerminationStatusEnum.SubmittedForApproval ? "background:#fff;border-color:#fff" : "")"></div>
                <div>
                    <div class="ep-check-label">Submitted for Approval</div>
                    <div class="ep-check-desc">
                        @(req.Status >= HRMS.Application.Models.TerminationStatusEnum.SubmittedForApproval ? "Completed" : "Pending")
                    </div>
                </div>
            </div>

            <div class="ep-check-item">
                <div class="ep-check-circle" style="@(req.Status >= HRMS.Application.Models.TerminationStatusEnum.Approved || req.Status == HRMS.Application.Models.TerminationStatusEnum.Rejected ? "background:#fff;border-color:#fff" : "")"></div>
                <div>
                    <div class="ep-check-label">Approval Decision</div>
                    <div class="ep-check-desc">
                        @if (req.ApproverReview == "Approved") { <text>Approved</text> }
                        else if (req.ApproverReview == "Rejected") { <text>Rejected</text> }
                        else { <text>Pending</text> }
                    </div>
                </div>
            </div>

            <div class="ep-check-item">
                <div class="ep-check-circle" style="@(req.FinanceClearanceCompleted ? "background:#fff;border-color:#fff" : "")"></div>
                <div>
                    <div class="ep-check-label">Finance Clearance</div>
                    <div class="ep-check-desc">
                        @(req.FinanceClearanceCompleted ? "Completed" : "Pending")
                    </div>
                </div>
            </div>

            <div class="ep-check-item">
                <div class="ep-check-circle" style="@(req.Status == HRMS.Application.Models.TerminationStatusEnum.Terminated ? "background:#fff;border-color:#fff" : "")"></div>
                <div>
                    <div class="ep-check-label">Terminated</div>
                    <div class="ep-check-desc">
                        @(req.Status == HRMS.Application.Models.TerminationStatusEnum.Terminated ? "Employee status updated" : "Awaiting completion")
                    </div>
                </div>
            </div>
        </div>

        <!-- Initiated by -->
        <div class="k-card" style="margin-top:16px;padding:16px">
            <div style="font-weight:600;font-size:0.85rem;color:var(--text-secondary);margin-bottom:8px">Initiated By</div>
            <div style="font-weight:600;font-size:0.95rem">@req.InitiatedBy</div>
            <div style="font-size:0.8rem;color:var(--text-muted)">@req.InitiatedByRole</div>
        </div>
    </div>
</div>
