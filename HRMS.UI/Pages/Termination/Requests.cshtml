@page
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "HR Manager,Area Manager")]
@model HRMS.UI.Pages.Termination.RequestsModel
@{
    ViewData["Title"] = "Employee Termination";
}

<style>
    .back-link { color: #7a8863; font-size: 13px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; margin-bottom: 8px; }
    .back-link:hover { color: #10823c; }
    .page-h { font-size: 19px; font-weight: 800; color: #151811; margin: 0 0 3px 0; }
    .page-s { font-size: 12px; color: #7a8863; margin: 0 0 18px 0; }
    .stat-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 16px; }
    .stat-mini { background: white; border: 1px solid #e2e5dc; border-radius: 10px; padding: 14px 18px; display: flex; align-items: center; gap: 12px; box-shadow: 0 1px 2px rgba(0,0,0,.05); }
    .sic { width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .sic svg { width: 18px; height: 18px; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .sic.blue   { background: rgba(59,130,246,0.1); } .sic.blue svg   { stroke: #3b82f6; }
    .sic.orange { background: rgba(249,115,22,0.1); } .sic.orange svg { stroke: #f97316; }
    .sic.green  { background: rgba(16,130,60,0.1); }  .sic.green svg  { stroke: #10823c; }
    .sic.red    { background: rgba(239,68,68,0.1); }  .sic.red svg    { stroke: #ef4444; }
    .stat-num { font-size: 20px; font-weight: 800; color: #151811; line-height: 1; }
    .stat-lbl { font-size: 11px; font-weight: 600; color: #7a8863; margin-top: 2px; }
    .filter-card { background: white; border: 1px solid #e2e5dc; border-radius: 10px; padding: 16px 20px; margin-bottom: 16px; }
    .filter-lbl { font-size: 12px; font-weight: 700; color: #7a8863; margin-bottom: 5px; display: block; }
    .fi { padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 13px; color: #151811; font-family: 'Manrope', sans-serif; background: #fff; }
    .fi:focus { outline: none; border-color: #10823c; }
    .table-card { background: white; border: 1px solid #e2e5dc; border-radius: 10px; overflow: hidden; margin-bottom: 19px; box-shadow: 0 1px 2px rgba(0,0,0,.05); }
    .emp-table { width: 100%; border-collapse: collapse; }
    .emp-table th { background: #f9fafb; padding: 13px 19px; text-align: left; font-size: 13px; font-weight: 700; color: #7a8863; border-bottom: 1px solid #e2e5dc; }
    .emp-table td { padding: 13px 19px; border-bottom: 1px solid #e2e5dc; font-size: 14px; color: #151811; }
    .emp-table tr:last-child td { border-bottom: none; }
    .emp-table tbody tr:hover { background: #fafafa; }
    .employee-cell { display: flex; align-items: center; gap: 10px; }
    .avatar-circle { width: 36px; height: 36px; border-radius: 50%; background: #e8f3ec; color: #10823c; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; flex-shrink: 0; }
    .emp-info .name { font-size: 14px; font-weight: 700; color: #151811; display: block; }
    .emp-info .sub  { font-size: 12px; color: #7a8863; }
    .k-badge, .status-badge { display: inline-flex; align-items: center; gap: 4px; padding: 2px 9px; border-radius: 9999px; font-size: 11.5px; font-weight: 700; border: 1px solid transparent; }
    .k-badge-pending  { background: #fef3c7; border-color: #fde68a; color: #b45309; }
    .k-badge-approved { background: #dcfce7; border-color: #bbf7d0; color: #10823c; }
    .k-badge-rejected { background: #fee2e2; border-color: #fecaca; color: #b91c1c; }
    .k-badge-info     { background: #dbeafe; border-color: #bfdbfe; color: #1d4ed8; }
    .btn-action { color: #10823c; font-size: 13px; font-weight: 700; text-decoration: none; padding: 5px 10px; border-radius: 5px; transition: background .2s; }
    .btn-action:hover { background: #e8f3ec; }
    .btn-action-primary { background: #10823c; color: white; font-size: 13px; font-weight: 700; text-decoration: none; padding: 5px 12px; border-radius: 5px; }
    .btn-action-primary:hover { background: #0d6e32; color: white; }
    .btn-create { background: #10823c; color: white; padding: 9px 17px; border-radius: 6px; font-size: 13px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn-create:hover { background: #0d6e32; color: white; }
    .btn-filter { background: #10823c; color: white; padding: 0 16px; border-radius: 6px; font-size: 13px; font-weight: 700; border: none; cursor: pointer; height: 37px; }
    .btn-clear  { background: white; color: #7a8863; padding: 0 16px; border-radius: 6px; font-size: 13px; font-weight: 700; text-decoration: none; border: 1px solid #e2e5dc; display: inline-flex; align-items: center; height: 37px; }
    .success-banner { background: #ecfdf5; color: #065f46; padding: 14px 20px; border-radius: 10px; margin-bottom: 20px; font-size: 14px; font-weight: 600; border: 1px solid #10b981; display: flex; align-items: center; gap: 8px; }
</style>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
    <div>
        <h2 class="page-h">Employee Termination</h2>
        <p style="font-size:12px;color:#7a8863;margin:0">Manage employee termination requests and track their status</p>
    </div>
    @if (User.IsInRole("HR Manager"))
    {
        <a asp-page="/Termination/CreateRequest" class="btn-create">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            New Termination Request
        </a>
    }
</div>

@if (TempData["SuccessMessage"] is string successMsg)
{
    <div class="success-banner">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        @successMsg
    </div>
}

@{
    var totalCount = Model.Requests.Count;
    var newCount = Model.Requests.Count(r => r.Status == HRMS.Application.Models.TerminationStatusEnum.New);
    var submittedCount = Model.Requests.Count(r => r.Status == HRMS.Application.Models.TerminationStatusEnum.SubmittedForApproval);
    var terminatedCount = Model.Requests.Count(r => r.Status == HRMS.Application.Models.TerminationStatusEnum.Terminated);
    var rejectedCount = Model.Requests.Count(r => r.Status == HRMS.Application.Models.TerminationStatusEnum.Rejected);
}
<div class="stat-row">
    <div class="stat-mini">
        <div class="sic blue"><svg viewBox="0 0 24 24"><rect x="9" y="2" width="6" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg></div>
        <div><div class="stat-num">@totalCount</div><div class="stat-lbl">Total Requests</div></div>
    </div>
    <div class="stat-mini">
        <div class="sic orange"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
        <div><div class="stat-num">@(newCount + submittedCount)</div><div class="stat-lbl">Pending</div></div>
    </div>
    <div class="stat-mini">
        <div class="sic green"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
        <div><div class="stat-num">@terminatedCount</div><div class="stat-lbl">Terminated</div></div>
    </div>
    <div class="stat-mini">
        <div class="sic red"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg></div>
        <div><div class="stat-num">@rejectedCount</div><div class="stat-lbl">Rejected</div></div>
    </div>
</div>

<div class="filter-card">
    <form method="get" style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap">
        <div style="flex:1;min-width:200px">
            <label class="filter-lbl">Search</label>
            <input type="text" name="Search" value="@Model.Search" class="fi" style="width:100%" placeholder="Employee name, EPF number, or email..." />
        </div>
        <div style="min-width:180px">
            <label class="filter-lbl">Status</label>
            <select name="StatusFilter" class="fi" style="width:100%">
                <option value="">All Statuses</option>
                <option value="New" selected="@(Model.StatusFilter == "New")">New (Draft)</option>
                <option value="SubmittedForApproval" selected="@(Model.StatusFilter == "SubmittedForApproval")">Submitted for Approval</option>
                <option value="Approved" selected="@(Model.StatusFilter == "Approved")">Approved</option>
                <option value="Rejected" selected="@(Model.StatusFilter == "Rejected")">Rejected</option>
                <option value="FinanceClearance" selected="@(Model.StatusFilter == "FinanceClearance")">Finance Clearance</option>
                <option value="Terminated" selected="@(Model.StatusFilter == "Terminated")">Terminated</option>
            </select>
        </div>
        <button type="submit" class="btn-filter">Filter</button>
        <a asp-page="/Termination/Requests" class="btn-clear">Clear</a>
    </form>
</div>

@if (Model.Requests.Any())
{
    <div class="table-card">
        <table class="emp-table">
            <thead>
                <tr>
                    <th style="width:70px">ID</th>
                    <th>Employee</th>
                    <th>Type</th>
                    <th>Effective Date</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th style="text-align:right"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var req in Model.Requests)
                {
                    var initials = string.Join("", req.EmployeeName.Split(' ').Take(2).Select(w => w[0])).ToUpper();
                    <tr>
                        <td style="font-weight:600;color:#7a8863">#@req.Id</td>
                        <td>
                            <div class="employee-cell">
                                <div class="avatar-circle">@initials</div>
                                <div class="emp-info">
                                    <span class="name">@req.EmployeeName</span>
                                    <span class="sub">@req.EpfNumber · @req.Department</span>
                                </div>
                            </div>
                        </td>
                        <td style="color:#7a8863">@req.TerminationTypeDisplay</td>
                        <td style="font-weight:600;color:#10823c">@req.EffectiveTerminationDate.ToString("MMM dd, yyyy")</td>
                        <td><span class="k-badge @req.StatusBadgeClass">@req.StatusDisplay</span></td>
                        <td style="color:#7a8863">@req.CreatedDate.ToString("MMM dd, yyyy")</td>
                        <td style="text-align:right">
                            @if (req.Status == HRMS.Application.Models.TerminationStatusEnum.New || req.Status == HRMS.Application.Models.TerminationStatusEnum.Rejected)
                            {
                                <a asp-page="/Termination/EditRequest" asp-route-id="@req.Id" class="btn-action-primary">Edit</a>
                            }
                            else
                            {
                                <a asp-page="/Termination/Details" asp-route-id="@req.Id" class="btn-action">View</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="table-card" style="text-align:center;padding:48px">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#e2e5dc" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:block;margin:0 auto 12px"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
        <p style="font-size:14px;font-weight:600;color:#151811;margin-bottom:4px">No termination requests found</p>
        <span style="font-size:12px;color:#7a8863">Create a new termination request to get started</span>
    </div>
}
