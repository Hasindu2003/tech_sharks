@page
@model HRMS.UI.Pages.AreaManager.ReviewResignationsModel
@{
    ViewData["Title"] = "Separation";
}

<div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px">
    <div>
        <h2 style="font-weight:700;font-size:1.6rem;margin-bottom:4px">Employee Separation</h2>
        <p style="color:#6b7280;font-size:0.9rem;margin:0">Manage employee Transfer, Termination, Resignation and Death</p>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMsg)
{
    <div class="k-alert k-alert-success"><i class="bi bi-check-circle"></i> @successMsg</div>
}
@if (TempData["ErrorMessage"] is string errorMsg)
{
    <div class="k-alert k-alert-danger"><i class="bi bi-exclamation-triangle"></i> @errorMsg</div>
}

<!-- Tabs -->
<div style="display:flex;gap:24px;margin-bottom:24px;border-bottom:2px solid #e5e7eb;padding-bottom:0">
    <a href="/AreaManager/ReviewTransfers" style="padding:10px 4px;color:#9ca3af;font-size:0.9rem;display:flex;align-items:center;gap:6px;text-decoration:none">
        Transfer <span style="background:#f3f4f6;color:#9ca3af;padding:2px 8px;border-radius:10px;font-size:0.75rem;font-weight:700">→</span>
    </a>
    <a href="/Termination/ApprovalQueue" style="padding:10px 4px;color:#9ca3af;font-size:0.9rem;display:flex;align-items:center;gap:6px;text-decoration:none">
        Termination <span style="background:#f3f4f6;color:#9ca3af;padding:2px 8px;border-radius:10px;font-size:0.75rem;font-weight:700">→</span>
    </a>
    <div style="padding:10px 4px;border-bottom:2px solid #1a7a3a;margin-bottom:-2px;font-weight:600;color:#1a7a3a;font-size:0.9rem;display:flex;align-items:center;gap:6px">
        Resignation <span style="background:#e8f5e9;color:#1a7a3a;padding:2px 8px;border-radius:10px;font-size:0.75rem;font-weight:700">@Model.PendingRequests.Count</span>
    </div>
    <div style="padding:10px 4px;color:#9ca3af;font-size:0.9rem;display:flex;align-items:center;gap:6px">
        Death <span style="background:#f3f4f6;color:#9ca3af;padding:2px 8px;border-radius:10px;font-size:0.75rem;font-weight:700">0</span>
    </div>
</div>

@if (Model.PendingRequests.Any())
{
    <h5 class="section-title">Pending Review</h5>
    <div class="k-card" style="padding:0;overflow:hidden;margin-bottom:8px">
        <table class="k-table">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Submission Date</th>
                    <th>Last Working Day</th>
                    <th>BM Review</th>
                    <th>Obligations</th>
                    <th>Review</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var req in Model.PendingRequests)
                {
                    var initials = string.Join("", req.EmployeeName.Split(' ').Take(2).Select(w => w[0])).ToUpper();
                    <tr>
                        <td>
                            <div class="employee-cell">
                                <div class="emp-avatar">@initials</div>
                                <div class="emp-details">
                                    <div class="emp-name">@req.EmployeeName</div>
                                    <div class="emp-dept">@req.Designation · @req.Branch</div>
                                </div>
                            </div>
                        </td>
                        <td>@req.ResignationDate.ToString("MMM dd, yyyy")</td>
                        <td style="font-weight:600;color:#1a7a3a">@req.EffectiveDate.ToString("MMM dd, yyyy")</td>
                        <td><span class="k-badge k-badge-approved"><i class="bi bi-check"></i> @req.BMReviewDate?.ToString("MMM dd")</span></td>
                        <td>
                            @if (req.HasOutstandingLoans || req.IsLoanGuarantor)
                            {
                                <span class="k-badge k-badge-rejected"><i class="bi bi-exclamation-triangle"></i> Yes</span>
                            }
                            else { <span class="k-badge k-badge-approved">None</span> }
                        </td>
                        <td>
                            <a asp-page="/AreaManager/ReviewResignation" asp-route-id="@req.Id"
                               class="btn-kanrich btn-kanrich-primary btn-kanrich-sm">Review</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="k-card" style="text-align:center;padding:48px;color:#9ca3af">
        <i class="bi bi-inbox" style="font-size:2.5rem;display:block;margin-bottom:12px"></i>
        <div style="font-weight:600;font-size:1rem;margin-bottom:4px">No pending resignation requests</div>
        <div style="font-size:0.88rem">All resignation requests have been reviewed</div>
    </div>
}
