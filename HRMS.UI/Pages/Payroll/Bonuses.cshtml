@section Scripts {
    <script>
        function filterTable() {
            const search = (document.getElementById('tableSearch').value || '').toLowerCase().trim();
            const type = (document.getElementById('typeFilter').value || '').toLowerCase().trim();
            const dept = (document.getElementById('deptFilter').value || '').toLowerCase().trim();
            const cycle = (document.getElementById('cycleFilter').value || '').trim();

            let visibleCount = 0;
            let sumAmount = 0;

            document.querySelectorAll('.allowance-row').forEach(row => {
                const name = (row.dataset.name || '').toLowerCase();
                const epf = (row.dataset.epf || '').toLowerCase();
                const rowDept = (row.dataset.dept || '').toLowerCase();
                const rowType = (row.dataset.type || '').toLowerCase();
                const rowCycle = (row.dataset.cycle || '').trim();
                const remarks = (row.dataset.remarks || '').toLowerCase();

                const matchSearch = !search || name.includes(search) || epf.includes(search) || remarks.includes(search);
                const matchType = !type || rowType === type;
                const matchDept = !dept || rowDept === dept;
                const matchCycle = !cycle || rowCycle === cycle;

                if (matchSearch && matchType && matchDept && matchCycle) {
                    row.style.display = '';
                    visibleCount++;
                    sumAmount += parseFloat(row.dataset.amount || 0);
                } else {
                    row.style.display = 'none';
                }
            });

            // Update record count badge
            const countBadge = document.getElementById('recordCountBadge');
            if (countBadge) {
                countBadge.textContent = `Showing ${visibleCount} record(s)`;
            }

            // Update footer total
            const footTotal = document.getElementById('footTotal');
            if (footTotal) {
                footTotal.textContent = 'Rs ' + formatMoney(sumAmount);
            }
        }

        function formatMoney(num) {
            return Number(num || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function openGrantModal() {
            document.getElementById('grantModal').classList.add('open');
        }

        function closeGrantModal(e) {
            if (!e || e.target === document.getElementById('grantModal') || e.target.closest('button')) {
                document.getElementById('grantModal').classList.remove('open');
            }
        }

        function openEditModal(id, empId, empName, type, amount, payrollMonth, reason) {
            document.getElementById('editBonusId').value = id;
            document.getElementById('editEmployeeId').value = empId;
            document.getElementById('editEmpSubtitle').textContent = empName;
            document.getElementById('editBonusType').value = type;
            document.getElementById('editAmount').value = amount;
            document.getElementById('editPayrollMonth').value = payrollMonth;
            document.getElementById('editReason').value = reason;

            document.getElementById('editModal').classList.add('open');
        }

        function closeEditModal(e) {
            if (!e || e.target === document.getElementById('editModal') || e.target.closest('button')) {
                document.getElementById('editModal').classList.remove('open');
            }
        }

        function exportCsv() {
            const rows = [
                ["Employee Name", "EPF Number", "Department", "Designation", "Allowance Category", "Amount (Rs)", "Payroll Cycle", "Remarks"]
            ];

            document.querySelectorAll('.allowance-row').forEach(row => {
                if (row.style.display !== 'none') {
                    const name = row.querySelector('td:nth-child(1) p:first-child')?.textContent.trim() || '';
                    const epf = (row.dataset.epf || '').toUpperCase();
                    const dept = row.dataset.dept || '';
                    const desig = row.querySelector('td:nth-child(2) p:last-child')?.textContent.trim() || '';
                    const type = row.dataset.type || '';
                    const amount = row.dataset.amount || '0';
                    const cycle = row.querySelector('td:nth-child(5) span')?.textContent.trim() || '';
                    const remarks = row.querySelector('td:nth-child(6) span')?.textContent.trim() || '';

                    rows.push([
                        `"${name}"`,
                        `"${epf}"`,
                        `"${dept}"`,
                        `"${desig}"`,
                        `"${type}"`,
                        amount,
                        `"${cycle}"`,
                        `"${remarks.replace(/"/g, '""')}"`
                    ]);
                }
            });

            const csvContent = "data:text/csv;charset=utf-8," + rows.map(e => e.join(",")).join("\n");
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `Allowances_Schedule_${'@(Model.CurrentBranch?.Name ?? "Branch")'.replace(/\s+/g, '_')}_${'@Model.SelectedMonthName'.replace(/\s+/g, '_')}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        document.addEventListener("DOMContentLoaded", function () {
            filterTable();
        });

        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape") {
                closeGrantModal();
                closeEditModal();
            }
        });
    </script>
}
