                    </select>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div>
                        <label style="font-size: 11.5px; font-weight: 700; color: #334155; margin-bottom: 4px; display: block;">Allowance Category *</label>
                        <select asp-for="BonusType" required class="filter-input" style="width: 100%;">
                            <option value="">Select Category…</option>
                            <option value="Performance">Performance Bonus</option>
                            <option value="Festival">Festival Allowance</option>
                            <option value="Transport">Transport / Fuel</option>
                            <option value="Housing">Housing Allowance</option>
                            <option value="Meal">Meal / Food</option>
                            <option value="Overtime">Overtime Pay</option>
                            <option value="Medical">Medical Allowance</option>
                            <option value="Special">Special Duty / Acting</option>
                            <option value="Other">Other Discretionary</option>
                        </select>
                    </div>

                    <div>
                        <label style="font-size: 11.5px; font-weight: 700; color: #334155; margin-bottom: 4px; display: block;">Payroll Month *</label>
                        <input type="month" asp-for="PayrollMonth" value="@(Model.Year)-@(Model.Month?.ToString("D2") ?? "01")" required class="filter-input" style="width: 100%;" />
                    </div>
                </div>

                <div>
                    <label style="font-size: 11.5px; font-weight: 700; color: #334155; margin-bottom: 4px; display: block;">Amount (LKR) *</label>
                    <div class="input-prefix-box">
                        <span class="input-prefix-tag">Rs</span>
                        <input type="number" asp-for="Amount" placeholder="0.00" min="1" step="0.01" required class="filter-input input-prefix-field" style="width: 100%;" />
                    </div>
                </div>

                <div>
                    <label style="font-size: 11.5px; font-weight: 700; color: #334155; margin-bottom: 4px; display: block;">Justification / Remarks</label>
                    <textarea asp-for="Reason" rows="2" placeholder="e.g. Q3 Performance recognition or fuel reimbursement..." class="filter-input" style="width: 100%; resize: none;"></textarea>
                </div>

            </div>

            <div style="padding: 12px 18px; background: #f8fafc; border-top: 1px solid #e2e8f0; display: flex; justify-content: flex-end; gap: 8px;">
                <button type="button" onclick="closeGrantModal()" class="btn-kanrich btn-kanrich-outline" style="padding: 5px 12px; font-size: 0.8rem;">Cancel</button>
                <button type="submit" class="btn-kanrich btn-kanrich-primary" style="padding: 5px 14px; font-size: 0.8rem; display: inline-flex; align-items: center; gap: 4px;">
                    <i class="bi bi-check-lg"></i> Grant Allowance
                </button>
            </div>
        </form>

    </div>
</div>

