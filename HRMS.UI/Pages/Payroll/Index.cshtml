@page
@model HRMS.UI.Pages.Payroll.IndexModel
@{
    ViewData["Title"] = "Payroll Management";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payroll Management — Kanrich HRMS</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script>
        tailwind.config = {
            theme: { extend: { colors: { primary: "#10823c" }, fontFamily: { display: "Manrope" } } }
        };
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24;
        }

        .icon-fill {
            font-variation-settings: 'FILL' 1,'wght' 400,'GRAD' 0,'opsz' 24;
        }

        body {
            font-family: 'Manrope',sans-serif;
        }

        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-thumb {
            background: #d1d5db;
            border-radius: 3px;
        }

        @@media print {
            body * {
                visibility: hidden;
            }

            #exportReport, #exportReport * {
                visibility: visible;
            }

            #exportReport {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                padding: 20px;
            }
        }
    </style>
</head>
<body class="bg-[#f6f8f7] text-[#151811] overflow-hidden">
    <div class="flex h-screen w-full">

        <!-- Sidebar -->
        <aside class="w-[260px] bg-white border-r border-[#e2e5dc] flex flex-col justify-between shrink-0 h-full overflow-y-auto z-20">
            <div class="flex flex-col gap-5 p-5">
                <div class="flex items-center gap-3">
                    <div class="bg-[#10823c] rounded-xl size-10 flex items-center justify-center text-white font-bold text-lg shadow-lg">K</div>
                    <div>
                        <h1 class="text-[#151811] text-base font-bold leading-tight">Kanrich HRMS</h1>
                        <p class="text-[#7a8863] text-xs">Admin Portal</p>
                    </div>
                </div>
                <nav class="flex flex-col gap-1">
                    <p class="px-3 text-[10px] font-bold text-[#7a8863] uppercase tracking-widest mb-1">Main Menu</p>
                    <a href="/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#f6f8f7] text-[#7a8863] transition-colors">
                        <span class="material-symbols-outlined text-[20px]">dashboard</span><span class="text-sm font-medium">Dashboard</span>
                    </a>
                    <a href="/Employees/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#f6f8f7] text-[#7a8863] transition-colors">
                        <span class="material-symbols-outlined text-[20px]">group</span><span class="text-sm font-medium">Employees</span>
                    </a>
                    <a href="/Performance/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#f6f8f7] text-[#7a8863] transition-colors">
                        <span class="material-symbols-outlined text-[20px]">bar_chart</span><span class="text-sm font-medium">Performance</span>
                    </a>
                    <a href="/Welfare/RequestList" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#f6f8f7] text-[#7a8863] transition-colors">
                        <span class="material-symbols-outlined text-[20px]">volunteer_activism</span><span class="text-sm font-medium">Welfare</span>
                    </a>
                    <a href="/Payroll/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg bg-[#10823c]/10 text-[#10823c]">
                        <span class="material-symbols-outlined icon-fill text-[20px]">payments</span><span class="text-sm font-bold">Payroll</span>
                    </a>
                    <div class="h-px bg-gray-100 my-2"></div>
                    <p class="px-3 text-[10px] font-bold text-[#7a8863] uppercase tracking-widest mb-1">Analytics</p>
                    <a href="#" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#f6f8f7] text-[#7a8863] transition-colors">
                        <span class="material-symbols-outlined text-[20px]">analytics</span><span class="text-sm font-medium">Reports</span>
                    </a>
                </nav>
            </div>
            <div class="p-5">
                <div class="bg-[#f6f8f7] p-3 rounded-xl mb-3 flex items-center gap-3">
                    <div class="bg-[#10823c]/20 rounded-full p-1.5 text-[#10823c]">
                        <span class="material-symbols-outlined text-lg">headset_mic</span>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-[#151811]">Need Help?</p>
                        <p class="text-[11px] text-[#7a8863]">Contact IT Support</p>
                    </div>
                </div>
                <a href="/Account/Logout" class="flex w-full items-center justify-center h-10 bg-[#10823c] text-white text-sm font-bold rounded-xl hover:bg-opacity-90 transition-all shadow-md">Log Out</a>
            </div>
        </aside>

        <!-- Main -->
        <div class="flex flex-col flex-1 h-full overflow-hidden">

            <!-- Header -->
            <header class="flex items-center justify-between border-b border-[#e2e5dc] bg-white px-8 py-4 shrink-0">
                <div class="flex items-center gap-3">
                    <h2 class="text-xl font-bold">Payroll Management</h2>
                    <span class="px-2.5 py-0.5 rounded-full bg-green-100 text-green-700 text-xs font-bold border border-green-200">
                        @Model.CurrentMonthName
                    </span>
                </div>
                <div class="flex items-center gap-4">
                    <div class="flex items-center gap-2 px-2 py-1 rounded-full">
                        <div class="size-9 rounded-full bg-[#10823c]/10 flex items-center justify-center text-[#10823c] font-bold text-sm ring-2 ring-white shadow-sm">
                            @(User.Identity?.Name?.Length > 0 ? User.Identity.Name.Substring(0, 1).ToUpper() : "A")
                        </div>
                        <div>
                            <p class="text-xs font-bold text-[#151811]">@User.Identity?.Name</p>
                            <p class="text-[10px] text-[#7a8863]">Administrator</p>
                        </div>
                    </div>
                    <button onclick="openNotifications()" class="relative flex size-10 items-center justify-center rounded-xl bg-[#f6f8f7] hover:bg-gray-200 transition-colors">
                        <span class="material-symbols-outlined text-[20px]">notifications</span>
                        <span class="notif-dot absolute top-2.5 right-2.5 size-2 bg-red-500 rounded-full border border-white" style="display:none"></span>
                    </button>
                </div>
            </header>

            <!-- Tabs -->
            <div class="flex items-center gap-1 px-8 bg-white border-b border-[#e2e5dc] shrink-0">
                <a href="/Payroll/Index" class="px-4 py-3.5 text-sm font-bold text-[#10823c] border-b-2 border-[#10823c]">Dashboard</a>
                <a href="/Payroll/AttendanceReview" class="px-4 py-3.5 text-sm font-medium text-[#7a8863] hover:text-[#151811] border-b-2 border-transparent hover:border-gray-300 transition-colors">Attendance Review</a>
                <a href="/Payroll/Bonuses" class="px-4 py-3.5 text-sm font-medium text-[#7a8863] hover:text-[#151811] border-b-2 border-transparent hover:border-gray-300 transition-colors">Bonuses</a>
                <a href="/Payroll/EpfEtf" class="px-4 py-3.5 text-sm font-medium text-[#7a8863] hover:text-[#151811] border-b-2 border-transparent hover:border-gray-300 transition-colors">EPF & ETF</a>
                <a href="/Payroll/Payslips" class="px-4 py-3.5 text-sm font-medium text-[#7a8863] hover:text-[#151811] border-b-2 border-transparent hover:border-gray-300 transition-colors">Payslips</a>
            </div>

            <!-- Content -->
            <main class="flex-1 overflow-y-auto bg-[#f6f8f7] p-8">
                <div class="max-w-[1400px] mx-auto flex flex-col gap-6">

                    <!-- Page Title + Actions -->
                    <div class="flex items-start justify-between">
                        <div>
                            <h3 class="text-2xl font-bold text-[#151811]">@Model.CurrentMonthName Payroll</h3>
                            <p class="text-sm text-[#7a8863] mt-1">Next Processing Date: 25th of this month</p>
                        </div>
                        <div class="flex gap-3">
                            <!-- ✅ Issue 1: Export Report — triggers print dialog -->
                            <button onclick="exportReport()"
                                    class="flex items-center gap-2 px-5 py-2.5 bg-white border border-[#e2e5dc] text-[#151811] text-sm font-bold rounded-xl hover:bg-gray-50 transition-colors shadow-sm">
                                <span class="material-symbols-outlined text-[16px]">download</span> Export Report
                            </button>
                            @if (!User.IsInRole("SeniorManagement"))
                            {
                                <form method="post" asp-page-handler="RunPayroll">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="flex items-center gap-2 px-5 py-2.5 bg-[#10823c] text-white text-sm font-bold rounded-xl hover:bg-opacity-90 transition-all shadow-md shadow-[#10823c]/20">
                                        <span class="material-symbols-outlined text-[16px]">play_circle</span> Run Payroll
                                    </button>
                                </form>
                            }
                        </div>
                    </div>

                    @if (TempData["Success"] != null)
                    {
                        <div class="flex items-center gap-3 px-5 py-3.5 bg-green-50 border border-green-200 rounded-2xl text-sm font-medium text-green-800">
                            <span class="material-symbols-outlined icon-fill text-green-600 text-[20px]">check_circle</span>
                            @TempData["Success"]
                        </div>
                    }

                    <!-- Stats Cards -->
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
                        <div class="bg-white rounded-2xl border border-[#e2e5dc] p-5 shadow-sm hover:shadow-md transition-shadow">
                            <div class="flex items-center justify-between mb-3">
                                <div class="p-2 bg-green-50 rounded-xl">
                                    <span class="material-symbols-outlined text-[#10823c] text-[20px]">account_balance</span>
                                </div>
                                <span class="text-xs font-bold text-green-600 bg-green-100 px-2 py-0.5 rounded-lg">This Month</span>
                            </div>
                            <p class="text-xs font-semibold text-[#7a8863] mb-1">Estimated Payroll Total</p>
                            <p class="text-2xl font-bold text-[#151811]">Rs @Model.TotalPayroll.ToString("N0")</p>
                            <!-- ✅ Issue 3: Always show last month comparison -->
                            <p class="text-xs text-[#7a8863] mt-1">
                                @Model.LastMonthName:
                                @if (Model.LastMonthPayroll > 0)
                                {
                                    <span>Rs @Model.LastMonthPayroll.ToString("N0")</span>
                                    @if (Model.TotalPayroll > Model.LastMonthPayroll)
                                    {
                                        <span class="text-green-600 font-bold"> ↑</span>
                                    }
                                    else if (Model.TotalPayroll < Model.LastMonthPayroll)
                                    {
                                        <span class="text-red-500 font-bold"> ↓</span>
                                    }
                                }
                                else
                                {
                                    <span class="italic">No data</span>
                                }
                            </p>
                        </div>
                        <div class="bg-white rounded-2xl border border-[#e2e5dc] p-5 shadow-sm hover:shadow-md transition-shadow">
                            <div class="flex items-center justify-between mb-3">
                                <div class="p-2 bg-blue-50 rounded-xl">
                                    <span class="material-symbols-outlined text-blue-600 text-[20px]">group</span>
                                </div>
                                <span class="text-xs font-bold text-blue-600 bg-blue-100 px-2 py-0.5 rounded-lg">Active</span>
                            </div>
                            <p class="text-xs font-semibold text-[#7a8863] mb-1">Total Employees</p>
                            <p class="text-2xl font-bold text-[#151811]">@Model.TotalEmployees</p>
                            <p class="text-xs text-[#7a8863] mt-1">With salary records</p>
                        </div>
                        <div class="bg-white rounded-2xl border border-[#e2e5dc] p-5 shadow-sm hover:shadow-md transition-shadow">
                            <div class="flex items-center justify-between mb-3">
                                <div class="p-2 bg-purple-50 rounded-xl">
                                    <span class="material-symbols-outlined text-purple-600 text-[20px]">workspace_premium</span>
                                </div>
                                <span class="text-xs font-bold text-purple-600 bg-purple-100 px-2 py-0.5 rounded-lg">Bonuses</span>
                            </div>
                            <p class="text-xs font-semibold text-[#7a8863] mb-1">Bonuses & Additions</p>
                            <p class="text-2xl font-bold text-[#151811]">Rs @Model.TotalBonuses.ToString("N0")</p>
                            <p class="text-xs text-[#7a8863] mt-1">
                                @if (Model.TotalBonuses == 0)
                                {
                                    <span class="italic">No bonuses this month</span>
                                }
                                else
                                {
                                    <span>Performance & Overtime</span>
                                }
                            </p>
                        </div>
                        <div class="bg-white rounded-2xl border border-[#e2e5dc] p-5 shadow-sm hover:shadow-md transition-shadow">
                            <div class="flex items-center justify-between mb-3">
                                <div class="p-2 bg-orange-50 rounded-xl">
                                    <span class="material-symbols-outlined text-orange-500 text-[20px]">remove_circle</span>
                                </div>
                                <span class="text-xs font-bold text-orange-600 bg-orange-100 px-2 py-0.5 rounded-lg">Deductions</span>
                            </div>
                            <p class="text-xs font-semibold text-[#7a8863] mb-1">Deductions (EPF/ETF/Tax)</p>
                            <p class="text-2xl font-bold text-[#151811]">Rs @Model.TotalDeductions.ToString("N0")</p>
                            <p class="text-xs text-[#7a8863] mt-1">EPF 8% + ETF 3% of basic</p>
                        </div>
                    </div>

                    <!-- Bottom Grid -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                        <!-- ✅ Issue 2: Dynamic Processing Checklist -->
                        <div class="lg:col-span-2">
                            <h3 class="text-base font-bold mb-4">Processing Checklist</h3>
                            <div class="bg-white rounded-2xl border border-[#e2e5dc] shadow-sm overflow-hidden">

                                <!-- Step 1: Salary Records -->
                                @{
                                    var step1Done = Model.HasSalaryRecords;
                                }
                                <div class="flex items-start gap-4 p-5 border-b border-[#e2e5dc] @(step1Done ? "" : "bg-yellow-50/50")">
                                    <div class="size-8 rounded-full @(step1Done ? "bg-green-100" : "bg-yellow-100") flex items-center justify-center shrink-0 mt-0.5">
                                        <span class="material-symbols-outlined @(step1Done ? "icon-fill text-[#10823c]" : "text-yellow-600") text-[18px]">
                                            @(step1Done ? "check_circle" : "pending")
                                        </span>
                                    </div>
                                    <div class="flex-1">
                                        <p class="text-sm font-bold text-[#151811]">1. Salary Additions Review</p>
                                        <p class="text-xs text-[#7a8863] mt-1">
                                            @(step1Done
                                                                                        ? $"Salary records found for {Model.TotalEmployees} employee(s)."
                                                                                        : "No salary records found. Add salary records to proceed.")
                                        </p>
                                        @if (!step1Done)
                                        {
                                            <a href="/Payroll/EpfEtf" class="inline-flex items-center gap-1 mt-2 px-3 py-1.5 bg-[#10823c] text-white text-xs font-bold rounded-lg hover:bg-opacity-90 transition-colors">
                                                Add Salary Records
                                            </a>
                                        }
                                    </div>
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold shrink-0 @(step1Done ? "bg-green-100 text-green-700" : "bg-yellow-100 text-yellow-700")">
                                        @(step1Done ? "Completed" : "Pending")
                                    </span>
                                </div>

                                <!-- Step 2: Attendance Review -->
                                @{
                                    var step2Active = step1Done;
                                }
                                <div id="step2Container" class="flex items-start gap-4 p-5 border-b border-[#e2e5dc] @(step2Active ? "bg-yellow-50/50" : "")">
                                    <div id="step2Icon" class="size-8 rounded-full @(step2Active ? "bg-yellow-100" : "bg-gray-100") flex items-center justify-center shrink-0 mt-0.5">
                                        <span class="material-symbols-outlined @(step2Active ? "text-yellow-600" : "text-gray-400") text-[18px]">
                                            @(step2Active ? "pending" : "radio_button_unchecked")
                                        </span>
                                    </div>
                                    <div class="flex-1">
                                        <p class="text-sm font-bold text-[#151811]">2. Attendance & Leave Reconciliation</p>
                                        <p class="text-xs text-[#7a8863] mt-1" id="step2Text">Reconcile no-pay leaves and half-days before processing.</p>
                                        @if (step2Active)
                                        {
                                            <a href="/Payroll/AttendanceReview" class="inline-flex items-center gap-1 mt-2 px-3 py-1.5 bg-[#10823c] text-white text-xs font-bold rounded-lg hover:bg-opacity-90 transition-colors">
                                                Review Attendance
                                            </a>
                                        }
                                    </div>
                                    <span id="step2Badge" class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold shrink-0 @(step2Active ? "bg-yellow-100 text-yellow-700" : "bg-gray-100 text-gray-600")">
                                        @(step2Active ? "In Progress" : "Waiting")
                                    </span>
                                </div>

                                <!-- Step 3: EPF/ETF -->
                                @{
                                    var step3Done = step1Done;
                                }
                                <div class="flex items-start gap-4 p-5 border-b border-[#e2e5dc]">
                                    <div class="size-8 rounded-full @(step3Done ? "bg-green-100" : "bg-gray-100") flex items-center justify-center shrink-0 mt-0.5">
                                        <span class="material-symbols-outlined @(step3Done ? "icon-fill text-[#10823c]" : "text-gray-400") text-[18px]">
                                            @(step3Done ? "check_circle" : "radio_button_unchecked")
                                        </span>
                                    </div>
                                    <div class="flex-1">
                                        <p class="text-sm font-bold text-[#151811]">3. Statutory Deductions (EPF/ETF/Tax)</p>
                                        <p class="text-xs text-[#7a8863] mt-1">
                                            @(step3Done
                                                                                        ? $"EPF & ETF calculated for {Model.TotalEmployees} employee(s). Total deductions: Rs {Model.TotalDeductions:N0}."
                                                                                        : "Awaiting salary records to calculate deductions.")
                                        </p>
                                        <a href="/Payroll/EpfEtf" class="inline-flex items-center gap-1 mt-2 px-3 py-1.5 bg-[#f6f8f7] border border-[#e2e5dc] text-[#151811] text-xs font-bold rounded-lg hover:bg-gray-100 transition-colors">
                                            Review EPF/ETF
                                        </a>
                                    </div>
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold shrink-0 @(step3Done ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-600")">
                                        @(step3Done ? "Completed" : "Pending")
                                    </span>
                                </div>

                                <!-- Step 4: Payslips Generated -->
                                <div class="flex items-start gap-4 p-5">
                                    <div class="size-8 rounded-full @(Model.HasPayslips ? "bg-green-100" : "bg-gray-100") flex items-center justify-center shrink-0 mt-0.5">
                                        <span class="material-symbols-outlined @(Model.HasPayslips ? "icon-fill text-[#10823c]" : "text-gray-400") text-[18px]">
                                            @(Model.HasPayslips ? "check_circle" : "radio_button_unchecked")
                                        </span>
                                    </div>
                                    <div class="flex-1">
                                        <p class="text-sm font-bold text-[#151811]">4. Final Verification & Generation</p>
                                        <p class="text-xs text-[#7a8863] mt-1">
                                            @(Model.HasPayslips
                                                                                        ? "Payslips generated successfully for this month."
                                                                                        : "Click Run Payroll to generate payslips.")
                                        </p>
                                        <a href="/Payroll/Payslips" class="inline-flex items-center gap-1 mt-2 px-3 py-1.5 bg-[#f6f8f7] border border-[#e2e5dc] text-[#151811] text-xs font-bold rounded-lg hover:bg-gray-100 transition-colors">
                                            View Payslips
                                        </a>
                                    </div>
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold shrink-0 @(Model.HasPayslips ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-600")">
                                        @(Model.HasPayslips ? "Completed" : "Pending")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Past Payroll Cycles -->
                        <div>
                            <h3 class="text-base font-bold mb-4">Past Payroll Cycles</h3>
                            <div class="bg-white rounded-2xl border border-[#e2e5dc] shadow-sm overflow-hidden">
                                @if (!Model.PastRuns.Any())
                                {
                                    <div class="flex flex-col items-center justify-center py-10 text-[#7a8863]">
                                        <span class="material-symbols-outlined text-4xl mb-2">history</span>
                                        <p class="text-sm font-semibold">No past cycles</p>
                                        <p class="text-xs mt-1">Run payroll to see history.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="divide-y divide-[#e2e5dc]">
                                        @foreach (var run in Model.PastRuns)
                                        {
                                            <div class="flex items-center justify-between p-4">
                                                <div>
                                                    <p class="text-sm font-bold text-[#151811]">@run.MonthName</p>
                                                    <p class="text-xs text-[#7a8863]">Processed @run.ProcessedAt?.ToString("dd MMM")</p>
                                                </div>
                                                <div class="text-right">
                                                    <p class="text-sm font-bold text-[#151811]">Rs @run.TotalAmount.ToString("N0")</p>
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold @(run.Status == "Completed" ? "bg-green-100 text-green-700" : "bg-yellow-100 text-yellow-700")">
                                                        @run.Status
                                                    </span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <div class="p-4 border-t border-[#e2e5dc] text-center">
                                        <a href="/Payroll/Payslips" class="text-sm font-bold text-[#10823c] hover:underline">View All History</a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- ✅ Issue 1: Hidden Export Report section (printed via browser) -->
    <div id="exportReport" style="display:none;">
        <div style="font-family:Arial,sans-serif; padding:20px; max-width:800px; margin:0 auto;">
            <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:3px solid #10823c; padding-bottom:16px; margin-bottom:24px;">
                <div>
                    <h1 style="color:#10823c; font-size:24px; margin:0;">Kanrich HRMS</h1>
                    <p style="color:#666; margin:4px 0 0;">Payroll Summary Report</p>
                </div>
                <div style="text-align:right;">
                    <p style="font-size:18px; font-weight:bold; margin:0;">@Model.CurrentMonthName</p>
                    <p style="color:#666; font-size:12px;">Generated: @DateTime.Now.ToString("dd MMM yyyy hh:mm tt")</p>
                </div>
            </div>

            <table style="width:100%; border-collapse:collapse; margin-bottom:24px;">
                <tr style="background:#f6f8f7;">
                    <td style="padding:12px; border:1px solid #e2e5dc; font-weight:bold;">Estimated Payroll Total</td>
                    <td style="padding:12px; border:1px solid #e2e5dc; font-weight:bold; color:#10823c;">Rs @Model.TotalPayroll.ToString("N2")</td>
                    <td style="padding:12px; border:1px solid #e2e5dc; font-weight:bold;">Total Employees</td>
                    <td style="padding:12px; border:1px solid #e2e5dc; font-weight:bold; color:#10823c;">@Model.TotalEmployees</td>
                </tr>
                <tr>
                    <td style="padding:12px; border:1px solid #e2e5dc;">Bonuses & Additions</td>
                    <td style="padding:12px; border:1px solid #e2e5dc;">Rs @Model.TotalBonuses.ToString("N2")</td>
                    <td style="padding:12px; border:1px solid #e2e5dc;">Total Deductions (EPF/ETF)</td>
                    <td style="padding:12px; border:1px solid #e2e5dc;">Rs @Model.TotalDeductions.ToString("N2")</td>
                </tr>
                <tr style="background:#f6f8f7;">
                    <td style="padding:12px; border:1px solid #e2e5dc;">Last Month Total (@Model.LastMonthName)</td>
                    <td style="padding:12px; border:1px solid #e2e5dc;">@(Model.LastMonthPayroll > 0 ? "Rs " + Model.LastMonthPayroll.ToString("N2") : "No data")</td>
                    <td style="padding:12px; border:1px solid #e2e5dc;">Payslips Generated</td>
                    <td style="padding:12px; border:1px solid #e2e5dc;">@(Model.HasPayslips ? "Yes" : "No")</td>
                </tr>
            </table>

            @if (Model.PastRuns.Any())
            {
                <h3 style="border-bottom:1px solid #e2e5dc; padding-bottom:8px; margin-bottom:16px;">Past Payroll Cycles</h3>
                <table style="width:100%; border-collapse:collapse;">
                    <thead>
                        <tr style="background:#10823c; color:white;">
                            <th style="padding:10px; text-align:left;">Month</th>
                            <th style="padding:10px; text-align:left;">Processed Date</th>
                            <th style="padding:10px; text-align:left;">Total Amount</th>
                            <th style="padding:10px; text-align:left;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var run in Model.PastRuns)
                        {
                            <tr style="border-bottom:1px solid #e2e5dc;">
                                <td style="padding:10px;">@run.MonthName</td>
                                <td style="padding:10px;">@run.ProcessedAt?.ToString("dd MMM yyyy")</td>
                                <td style="padding:10px; font-weight:bold;">Rs @run.TotalAmount.ToString("N2")</td>
                                <td style="padding:10px; color:#10823c;">@run.Status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <p style="margin-top:32px; font-size:11px; color:#999; text-align:center;">
                This is a computer-generated report from Kanrich HRMS. Generated on @DateTime.Now.ToString("dd MMM yyyy hh:mm tt").
            </p>
        </div>
    </div>

    <script>
        // ✅ Fix Export Report — open in new window for proper printing
        function exportReport() {
            const content = document.getElementById('exportReport').innerHTML;
            const win = window.open('', '_blank', 'width=900,height=700');
            win.document.write(`
                <!DOCTYPE html>
                <html>
                <head>
                    <title>Payroll Report - @Model.CurrentMonthName</title>
                    <style>
                        body { font-family: Arial, sans-serif; padding: 20px; color: #111; }
                        table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
                        th { background: #10823c; color: white; padding: 10px; text-align: left; }
                        td { padding: 10px; border: 1px solid #e2e5dc; }
                        tr:nth-child(even) { background: #f6f8f7; }
                        h1 { color: #10823c; }
                        @@media print { button { display: none; } }
                    </style>
                </head>
                <body>
                    <button onclick="window.print()" style="margin-bottom:16px;padding:8px 16px;background:#10823c;color:white;border:none;border-radius:8px;cursor:pointer;font-weight:bold;">
                        🖨️ Print / Save as PDF
                    </button>
                    ${content}
                </body>
                </html>
            `);
            win.document.close();
        }

        // ✅ Check sessionStorage for attendance finalized state
        document.addEventListener('DOMContentLoaded', function () {
            const isFinalized = sessionStorage.getItem('attendance_finalized') === 'true';
            if (isFinalized) {
                const container = document.getElementById('step2Container');
                const icon      = document.getElementById('step2Icon');
                const badge     = document.getElementById('step2Badge');
                const text      = document.getElementById('step2Text');
                if (container && icon && badge && text) {
                    container.classList.remove('bg-yellow-50/50');
                    container.classList.add('bg-green-50/30');
                    icon.className = 'size-8 rounded-full bg-green-100 flex items-center justify-center shrink-0 mt-0.5';
                    icon.innerHTML = '<span style="font-family:\'Material Symbols Outlined\';font-variation-settings:\'FILL\' 1,\'wght\' 400,\'GRAD\' 0,\'opsz\' 24;font-size:18px;color:#10823c;">check_circle</span>';
                    badge.className = 'inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold shrink-0 bg-green-100 text-green-700';
                    badge.textContent = 'Completed';
                    text.textContent = 'Attendance reconciliation finalized. All records verified.';
                }
            }
        });
    </script>

    <script src="/js/notifications.js"></script>
</body>
</html>
