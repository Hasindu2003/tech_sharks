@page
@model HRMS.UI.Pages.Payroll.EpfEtfModel
@{
    ViewData["Title"] = "EPF & ETF";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EPF & ETF — Kanrich HRMS</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script>tailwind.config = { theme: { extend: { colors: { primary: "#10823c" }, fontFamily: { display: "Manrope" } } } };</script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24;
        }

        .icon-fill {
            font-variation-settings: 'FILL' 1,'wght' 400,'GRAD' 0,'opsz' 24;
        }

        body {
            font-family: 'Manrope',sans-serif;
        }

        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-thumb {
            background: #d1d5db;
            border-radius: 3px;
        }
    </style>
</head>
<body class="bg-[#f6f8f7] text-[#151811] overflow-hidden">
    <div class="flex h-screen w-full">

        <!-- Sidebar -->
        <aside class="w-[260px] bg-white border-r border-[#e2e5dc] flex flex-col justify-between shrink-0 h-full overflow-y-auto z-20">
            <div class="flex flex-col gap-5 p-5">
                <div class="flex items-center gap-3">
                    <div class="bg-[#10823c] rounded-xl size-10 flex items-center justify-center text-white font-bold text-lg shadow-lg">K</div>
                    <div>
                        <h1 class="text-[#151811] text-base font-bold leading-tight">Kanrich HRMS</h1>
                        <p class="text-[#7a8863] text-xs">Admin Portal</p>
                    </div>
                </div>
                <nav class="flex flex-col gap-1">
                    <p class="px-3 text-[10px] font-bold text-[#7a8863] uppercase tracking-widest mb-1">Main Menu</p>
                    <a href="/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#f6f8f7] text-[#7a8863] transition-colors">
                        <span class="material-symbols-outlined text-[20px]">dashboard</span><span class="text-sm font-medium">Dashboard</span>
                    </a>
                    <a href="/Employees/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#f6f8f7] text-[#7a8863] transition-colors">
                        <span class="material-symbols-outlined text-[20px]">group</span><span class="text-sm font-medium">Employees</span>
                    </a>
                    <a href="/Performance/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#f6f8f7] text-[#7a8863] transition-colors">
                        <span class="material-symbols-outlined text-[20px]">bar_chart</span><span class="text-sm font-medium">Performance</span>
                    </a>
                    <a href="/Welfare/RequestList" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#f6f8f7] text-[#7a8863] transition-colors">
                        <span class="material-symbols-outlined text-[20px]">volunteer_activism</span><span class="text-sm font-medium">Welfare</span>
                    </a>
                    <a href="/Payroll/Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg bg-[#10823c]/10 text-[#10823c]">
                        <span class="material-symbols-outlined icon-fill text-[20px]">payments</span><span class="text-sm font-bold">Payroll</span>
                    </a>
                    <div class="h-px bg-gray-100 my-2"></div>
                    <a href="#" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[#f6f8f7] text-[#7a8863] transition-colors">
                        <span class="material-symbols-outlined text-[20px]">analytics</span><span class="text-sm font-medium">Reports</span>
                    </a>
                </nav>
            </div>
            <div class="p-5">
                <a href="/Account/Logout" class="flex w-full items-center justify-center h-10 bg-[#10823c] text-white text-sm font-bold rounded-xl hover:bg-opacity-90 transition-all shadow-md">Log Out</a>
            </div>
        </aside>

        <!-- Main -->
        <div class="flex flex-col flex-1 h-full overflow-hidden">

            <!-- Header -->
            <header class="flex items-center justify-between border-b border-[#e2e5dc] bg-white px-8 py-4 shrink-0">
                <div class="flex items-center gap-3">
                    <h2 class="text-xl font-bold">Payroll Management</h2>
                </div>
                <div class="flex items-center gap-4">
                    <button onclick="openNotifications()" class="relative flex size-10 items-center justify-center rounded-xl bg-[#f6f8f7] hover:bg-gray-200 transition-colors">
                        <span class="material-symbols-outlined text-[20px]">notifications</span>
                        <span class="notif-dot absolute top-2.5 right-2.5 size-2 bg-red-500 rounded-full border border-white" style="display:none"></span>
                    </button>
                    <div class="size-9 rounded-full bg-[#10823c]/10 flex items-center justify-center text-[#10823c] font-bold text-sm">
                        @(User.Identity?.Name?.Length > 0 ? User.Identity.Name.Substring(0, 1).ToUpper() : "A")
                    </div>
                </div>
            </header>

            <!-- Tabs -->
            <div class="flex items-center gap-1 px-8 bg-white border-b border-[#e2e5dc] shrink-0">
                <a href="/Payroll/Index" class="px-4 py-3.5 text-sm font-medium text-[#7a8863] hover:text-[#151811] border-b-2 border-transparent hover:border-gray-300 transition-colors">Dashboard</a>
                <a href="/Payroll/AttendanceReview" class="px-4 py-3.5 text-sm font-medium text-[#7a8863] hover:text-[#151811] border-b-2 border-transparent hover:border-gray-300 transition-colors">Attendance Review</a>
                <a href="/Payroll/Bonuses" class="px-4 py-3.5 text-sm font-medium text-[#7a8863] hover:text-[#151811] border-b-2 border-transparent hover:border-gray-300 transition-colors">Bonuses</a>
                <a href="/Payroll/EpfEtf" class="px-4 py-3.5 text-sm font-bold text-[#10823c] border-b-2 border-[#10823c]">EPF & ETF</a>
                <a href="/Payroll/Payslips" class="px-4 py-3.5 text-sm font-medium text-[#7a8863] hover:text-[#151811] border-b-2 border-transparent hover:border-gray-300 transition-colors">Payslips</a>
            </div>

            <!-- Content -->
            <main class="flex-1 overflow-y-auto bg-[#f6f8f7] p-8">
                <div class="max-w-[1300px] mx-auto flex flex-col gap-6">

                    <!-- Page Header -->
                    <div class="flex items-start justify-between">
                        <div>
                            <h3 class="text-2xl font-bold">Manage EPF & ETF</h3>
                            <p class="text-sm text-[#7a8863] mt-1">Statutory contribution rates and monthly deduction breakdown</p>
                        </div>
                        <button class="flex items-center gap-2 px-5 py-2.5 bg-white border border-[#e2e5dc] text-[#151811] text-sm font-bold rounded-xl hover:bg-gray-50 transition-colors shadow-sm">
                            <span class="material-symbols-outlined text-[16px]">download</span> Export Report
                        </button>
                    </div>

                    <!-- Top Grid: Rates + KPI Cards -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                        <!-- Current Rates Card -->
                        <div class="bg-white rounded-2xl border border-[#e2e5dc] shadow-sm overflow-hidden">
                            <div class="flex items-center justify-between px-6 py-4 border-b border-[#e2e5dc]">
                                <div>
                                    <h3 class="text-sm font-bold">Current Rates</h3>
                                    <p class="text-xs text-[#7a8863]">Standard statutory percentages</p>
                                </div>
                                <span class="material-symbols-outlined text-[#10823c] text-[20px]">percent</span>
                            </div>
                            <div class="p-6 flex flex-col gap-3">
                                <div class="flex items-center justify-between bg-[#f6f8f7] px-4 py-3 rounded-xl">
                                    <div>
                                        <p class="text-sm font-bold text-[#151811]">EPF (Employee)</p>
                                        <p class="text-xs text-[#7a8863]">Deducted from basic salary</p>
                                    </div>
                                    <span class="text-xl font-black text-[#10823c]">8%</span>
                                </div>
                                <div class="flex items-center justify-between bg-[#f6f8f7] px-4 py-3 rounded-xl">
                                    <div>
                                        <p class="text-sm font-bold text-[#151811]">EPF (Employer)</p>
                                        <p class="text-xs text-[#7a8863]">Company contribution</p>
                                    </div>
                                    <span class="text-xl font-black text-blue-600">12%</span>
                                </div>
                                <div class="flex items-center justify-between bg-[#f6f8f7] px-4 py-3 rounded-xl">
                                    <div>
                                        <p class="text-sm font-bold text-[#151811]">ETF (Employer)</p>
                                        <p class="text-xs text-[#7a8863]">Company contribution</p>
                                    </div>
                                    <span class="text-xl font-black text-orange-600">3%</span>
                                </div>
                                <div class="flex items-start gap-2 px-3 py-2.5 bg-indigo-50 border border-indigo-200 rounded-xl mt-1">
                                    <span class="material-symbols-outlined icon-fill text-indigo-500 text-[16px] mt-0.5 shrink-0">info</span>
                                    <p class="text-xs text-indigo-700">These rates meet the minimum requirements under Sri Lanka Labour Law.</p>
                                </div>
                            </div>
                        </div>

                        <!-- KPI Cards -->
                        <div class="lg:col-span-2 grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div class="bg-white rounded-2xl border border-[#e2e5dc] p-5 shadow-sm hover:shadow-md transition-shadow">
                                <div class="p-2 bg-blue-50 rounded-xl w-fit mb-3">
                                    <span class="material-symbols-outlined text-blue-600 text-[20px]">person</span>
                                </div>
                                <p class="text-xs font-semibold text-[#7a8863] mb-1">EPF Employee (8%)</p>
                                <p class="text-2xl font-bold text-blue-600">Rs @Model.TotalEpfEmployee.ToString("N0")</p>
                                <p class="text-xs text-[#7a8863] mt-1">@DateTime.Now.ToString("MMM yyyy") total</p>
                            </div>
                            <div class="bg-white rounded-2xl border border-[#e2e5dc] p-5 shadow-sm hover:shadow-md transition-shadow">
                                <div class="p-2 bg-green-50 rounded-xl w-fit mb-3">
                                    <span class="material-symbols-outlined text-[#10823c] text-[20px]">business</span>
                                </div>
                                <p class="text-xs font-semibold text-[#7a8863] mb-1">EPF Employer (12%)</p>
                                <p class="text-2xl font-bold text-[#10823c]">Rs @Model.TotalEpfEmployer.ToString("N0")</p>
                                <p class="text-xs text-[#7a8863] mt-1">@DateTime.Now.ToString("MMM yyyy") total</p>
                            </div>
                            <div class="bg-white rounded-2xl border border-[#e2e5dc] p-5 shadow-sm hover:shadow-md transition-shadow">
                                <div class="p-2 bg-orange-50 rounded-xl w-fit mb-3">
                                    <span class="material-symbols-outlined text-orange-600 text-[20px]">account_balance</span>
                                </div>
                                <p class="text-xs font-semibold text-[#7a8863] mb-1">ETF Employer (3%)</p>
                                <p class="text-2xl font-bold text-orange-600">Rs @Model.TotalEtf.ToString("N0")</p>
                                <p class="text-xs text-[#7a8863] mt-1">@DateTime.Now.ToString("MMM yyyy") total</p>
                            </div>
                        </div>
                    </div>

                    <!-- Breakdown Table -->
                    <div class="bg-white rounded-2xl border border-[#e2e5dc] shadow-sm overflow-hidden">
                        <div class="flex items-center justify-between px-6 py-4 border-b border-[#e2e5dc]">
                            <h3 class="text-sm font-bold">Individual Breakdowns — @DateTime.Now.ToString("MMMM yyyy")</h3>
                            <div class="flex items-center bg-[#f6f8f7] rounded-xl px-3 py-2 gap-2 border border-transparent focus-within:border-[#10823c]/40">
                                <span class="material-symbols-outlined text-[#7a8863] text-[16px]">search</span>
                                <input id="epfSearch" oninput="filterEpf()" class="bg-transparent text-xs placeholder:text-[#7a8863] focus:outline-none w-48" placeholder="Search by name..." />
                            </div>
                        </div>

                        @if (!Model.SalaryData.Any())
                        {
                            <div class="flex flex-col items-center justify-center py-16 text-[#7a8863]">
                                <span class="material-symbols-outlined text-5xl mb-3">account_balance</span>
                                <p class="text-sm font-semibold">No salary records found</p>
                                <p class="text-xs mt-1">Add salary records to see EPF/ETF calculations.</p>
                            </div>
                        }
                        else
                        {
                            <div class="overflow-x-auto">
                                <table class="w-full text-left text-sm">
                                    <thead class="bg-[#f8f9fa] text-[#7a8863] border-b border-[#e2e5dc]">
                                        <tr>
                                            <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider">Employee</th>
                                            <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider">Basic Salary</th>
                                            <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-blue-600">EPF 8% (Emp)</th>
                                            <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-[#10823c]">EPF 12% (Co)</th>
                                            <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-orange-600">ETF 3% (Co)</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-[#e2e5dc]" id="epfBody">
                                        @foreach (var item in Model.SalaryData)
                                        {
                                            <tr class="hover:bg-gray-50 transition-colors epf-row" data-name="@((item.Employee?.FirstName + " " + item.Employee?.LastName).ToLower())">
                                                <td class="px-6 py-4">
                                                    <div class="flex items-center gap-3">
                                                        <div class="size-8 rounded-full bg-[#10823c]/10 flex items-center justify-center text-[#10823c] font-bold text-xs shrink-0">
                                                            @item.Employee?.FirstName[0]
                                                        </div>
                                                        <div>
                                                            <p class="font-bold text-[#151811]">@item.Employee?.FirstName @item.Employee?.LastName</p>
                                                            <p class="text-xs text-[#7a8863]">@(item.Employee?.EPFNumber ?? "—")</p>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="px-6 py-4 font-semibold">Rs @item.BasicSalary.ToString("N2")</td>
                                                <td class="px-6 py-4 font-bold text-blue-600">Rs @(item.EpfEmployee.ToString("N2"))</td>
                                                <td class="px-6 py-4 font-bold text-[#10823c]">Rs @(item.EpfEmployer.ToString("N2"))</td>
                                                <td class="px-6 py-4 font-bold text-orange-600">Rs @(item.Etf.ToString("N2"))</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <!-- Totals Row -->
                                    <tfoot>
                                        <tr class="bg-[#f8f9fa] border-t-2 border-[#e2e5dc]">
                                            <td class="px-6 py-4 font-black text-[#151811]">TOTALS</td>
                                            <td class="px-6 py-4 font-black">Rs @Model.SalaryData.Sum(s => s.BasicSalary).ToString("N2")</td>
                                            <td class="px-6 py-4 font-black text-blue-600">Rs @Model.TotalEpfEmployee.ToString("N2")</td>
                                            <td class="px-6 py-4 font-black text-[#10823c]">Rs @Model.TotalEpfEmployer.ToString("N2")</td>
                                            <td class="px-6 py-4 font-black text-orange-600">Rs @Model.TotalEtf.ToString("N2")</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                    </div>

                </div>
            </main>
        </div>
    </div>

    <script>
        function filterEpf() {
            const search = document.getElementById('epfSearch').value.toLowerCase();
            document.querySelectorAll('.epf-row').forEach(row => {
                row.style.display = !search || row.dataset.name.includes(search) ? '' : 'none';
            });
        }
    </script>
    <script src="/js/notifications.js"></script>
</body>
</html>
