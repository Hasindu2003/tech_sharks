@page
@model HRMS.UI.Pages.Payroll.AttendanceReviewModel
@{
    ViewData["Title"] = "Attendance Review";
    ViewData["PageTitle"] = "Payroll / Attendance Review";
    ViewData["ActiveNav"] = "Payroll";
}

@section Styles {
    <style>
        .payroll-shell {
            padding: 26px;
            background: #ffffff;
            min-height: calc(100vh - 62px);
        }
        .filters-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-bottom: 20px;
        }
        .btn-action-small {
            font-size: 0.75rem;
            padding: 4px 10px;
        }
        #attendanceTable {
            width: 100%;
            table-layout: fixed;
        }
        #attendanceTable th {
            vertical-align: middle;
            font-size: 0.76rem;
            letter-spacing: 0.4px;
            text-transform: uppercase;
        }
        #attendanceTable td {
            vertical-align: middle;
            font-size: 0.85rem;
        }

        /* Modal Styles */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(15, 23, 42, 0.55);
            backdrop-filter: blur(3px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1060;
            padding: 20px;
        }
        .modal-overlay.open {
            display: flex;
        }
        .modal-dialog-large {
            background: #ffffff;
            border-radius: 12px;
            width: 100%;
            max-width: 940px;
            max-height: 88vh;
            display: flex;
            flex-direction: column;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            overflow: hidden;
            border: 1px solid var(--border-color);
        }
        .modal-header-custom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 24px;
            border-bottom: 1px solid #e2e8f0;
            background: #f8fafc;
            flex-shrink: 0;
        }
        .modal-body-scroll {
            padding: 18px 24px;
            overflow-y: auto;
            flex: 1;
            min-height: 0;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }
        .daily-table-scroll {
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            overflow-y: auto;
            max-height: 380px;
            position: relative;
            background: #ffffff;
        }
        .daily-table-scroll table thead th {
            position: sticky;
            top: 0;
            background: #f8fafc;
            z-index: 4;
            box-shadow: 0 1px 2px rgba(0,0,0,0.06);
        }
        .modal-body-scroll::-webkit-scrollbar,
        .daily-table-scroll::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        .modal-body-scroll::-webkit-scrollbar-track,
        .daily-table-scroll::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 4px;
        }
        .modal-body-scroll::-webkit-scrollbar-thumb,
        .daily-table-scroll::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        .modal-body-scroll::-webkit-scrollbar-thumb:hover,
        .daily-table-scroll::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        .kpi-badge-box {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 10px 14px;
            text-align: center;
        }
        .log-filter-pill {
            padding: 5px 12px;
            font-size: 12px;
            font-weight: 700;
            border-radius: 20px;
            border: 1px solid #cbd5e1;
            background: white;
            color: #475569;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .log-filter-pill:hover, .log-filter-pill.active {
            background: #10823c;
            color: white;
            border-color: #10823c;
        }
    </style>
}

<div class="payroll-shell">

    <!-- Sub-navigation Tabs with Branch Switcher -->
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); margin-bottom: 24px; padding-bottom: 12px; flex-wrap: wrap; gap: 12px;">
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
            <a href="/Payroll/Index?branchId=@Model.BranchId" class="btn-kanrich btn-kanrich-outline" style="padding: 6px 16px; font-size: 0.85rem;">Dashboard</a>
            <a href="/Payroll/AttendanceReview?branchId=@Model.BranchId" class="btn-kanrich btn-kanrich-primary" style="padding: 6px 16px; font-size: 0.85rem;">Attendance Review</a>
            <a href="/Payroll/Bonuses?branchId=@Model.BranchId" class="btn-kanrich btn-kanrich-outline" style="padding: 6px 16px; font-size: 0.85rem;">Allowances</a>
            <a href="/Payroll/EpfEtf?branchId=@Model.BranchId" class="btn-kanrich btn-kanrich-outline" style="padding: 6px 16px; font-size: 0.85rem;">EPF & ETF</a>
            <a href="/Payroll/Payslips?branchId=@Model.BranchId" class="btn-kanrich btn-kanrich-outline" style="padding: 6px 16px; font-size: 0.85rem;">Payslips</a>
        </div>

        <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
            <!-- Month Selector -->
            <div style="display: flex; align-items: center; gap: 8px; background: #f8fafc; padding: 4px 10px; border-radius: 8px; border: 1px solid #e2e8f0;">
                <label style="font-size: 12px; font-weight: 700; color: #475569; margin: 0; display: flex; align-items: center; gap: 4px;">
                    <i class="bi bi-calendar-month" style="color: #10823c;"></i> Cycle:
                </label>
                <select onchange="const [y, m] = this.value.split('-'); location.href='?branchId=@Model.BranchId&month=' + m + '&year=' + y;" style="font-size: 13px; font-weight: 700; padding: 4px 8px; border: 1px solid #cbd5e1; border-radius: 6px; background: white; color: #0f172a; cursor: pointer;">
                    @for (int i = 0; i < 6; i++)
                    {
                        var mDate = SriLankaTime.Now.AddMonths(-i);
                        var isSel = (mDate.Month == Model.Month && mDate.Year == Model.Year);
                        <option value="@mDate.Year-@mDate.Month" selected="@isSel">@mDate.ToString("MMMM yyyy")</option>
                    }
                </select>
            </div>

            @if (Model.ManagedBranchesList.Count > 1)
            {
                <div style="display: flex; align-items: center; gap: 8px; background: #f8fafc; padding: 4px 10px; border-radius: 8px; border: 1px solid #e2e8f0;">
                    <label style="font-size: 12px; font-weight: 700; color: #475569; margin: 0; display: flex; align-items: center; gap: 4px;">
                        <i class="bi bi-geo-alt-fill" style="color: #10823c;"></i> Branch:
                    </label>
                    <select onchange="location.href='?branchId=' + this.value + '&month=@Model.Month&year=@Model.Year'" style="font-size: 13px; font-weight: 700; padding: 4px 8px; border: 1px solid #cbd5e1; border-radius: 6px; background: white; color: #0f172a; cursor: pointer;">
                        @foreach (var b in Model.ManagedBranchesList)
                        {
                            <option value="@b.Id" selected="@(b.Id == Model.BranchId)">@b.Name</option>
                        }
                    </select>
                </div>
            }
            else if (Model.CurrentBranch != null)
            {
                <div style="font-size: 12px; font-weight: 700; color: #10823c; background: #ebf5ee; padding: 6px 12px; border-radius: 6px; display: inline-flex; align-items: center; gap: 6px;">
                    <i class="bi bi-geo-alt-fill"></i> Branch: @Model.CurrentBranch.Name
                </div>
            }
        </div>
    </div>

    <!-- Header block -->
    <div class="page-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
        <div>
            <h2 style="margin: 0; display: inline-flex; align-items: center; gap: 10px;">
                Attendance & Leave Reconciliation
                <span style="font-size: 1.1rem; color: #10823c; font-weight: 700;">(@Model.SelectedMonthName)</span>
                @if (Model.CurrentBranch != null)
                {
                    <span style="font-size: 1.1rem; color: #64748b; font-weight: 600;">— @Model.CurrentBranch.Name</span>
                }
            </h2>
            <p class="page-subtitle" style="margin-top: 4px;">Reconcile check-in records, working days, overtime, and leaves for <strong>@(Model.CurrentBranch?.Name ?? "Selected Branch")</strong> during <strong>@Model.SelectedMonthName</strong></p>
        </div>
        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
            <form method="post" asp-page-handler="SyncOtToPayroll" style="margin: 0;">
                <input type="hidden" name="branchId" value="@Model.BranchId" />
                <input type="hidden" name="month" value="@Model.Month" />
                <input type="hidden" name="year" value="@Model.Year" />
                <button type="submit" class="btn-kanrich btn-kanrich-primary" style="display: inline-flex; align-items: center; gap: 6px; font-weight: 700;">
                    <i class="bi bi-arrow-repeat"></i> Sync OT to Allowances
                </button>
            </form>
        </div>
    </div>

    <!-- Toast message container -->
    <div id="toastMsg" class="alert" style="display: none; margin-bottom: 20px;"></div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" style="margin-bottom: 20px;">✓ @TempData["Success"]</div>
    }

    <!-- Filters Row -->
    <div class="filters-row">
        <div class="k-form-group">
            <label>Department</label>
            <select id="deptFilter" onchange="filterTable()" class="k-form-control">
                <option value="">All Departments</option>
                @foreach (var dept in Model.BranchDepartments)
                {
                    <option value="@dept">@dept</option>
                }
            </select>
        </div>
        <div class="k-form-group">
            <label>Status / Anomalies</label>
            <select id="statusFilter" onchange="filterTable()" class="k-form-control">
                <option value="">All Employees</option>
                <option value="Anomaly">Employees with Anomalies</option>
                <option value="Verified">Verified Attendance</option>
                <option value="Pending">Pending Records</option>
            </select>
        </div>
        <div class="k-form-group">
            <label>Search Employee</label>
            <input id="tableSearch" oninput="filterTable()" class="k-form-control" placeholder="Search by name or ID..." />
        </div>
    </div>

    <!-- Attendance Table -->
    <div class="k-card" style="padding: 0; overflow: hidden; border: 1px solid #e2e8f0; border-radius: 8px;">
        <div style="overflow-x: auto;">
            <table class="k-table" id="attendanceTable" style="width: 100%; border-collapse: collapse;">
                <thead style="background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                    <tr>
                        <th style="text-align: left; padding: 12px 18px; width: 26%; min-width: 220px; font-weight: 700; color: #475569;">Employee</th>
                        <th style="text-align: center; padding: 12px 12px; width: 13%; min-width: 110px; font-weight: 700; color: #475569;">Working Days</th>
                        <th style="text-align: center; padding: 12px 12px; width: 10%; min-width: 90px; font-weight: 700; color: #475569;">Paid Leaves</th>
                        <th style="text-align: center; padding: 12px 12px; width: 12%; min-width: 110px; font-weight: 700; color: #d97706;">No-Pay Leaves</th>
                        <th style="text-align: center; padding: 12px 12px; width: 12%; min-width: 100px; font-weight: 700; color: #0284c7;">OT Hours</th>
                        <th style="text-align: center; padding: 12px 12px; width: 13%; min-width: 110px; font-weight: 700; color: #7e22ce;">Est. OT Pay</th>
                        <th style="text-align: center; padding: 12px 12px; width: 14%; min-width: 110px; font-weight: 700; color: #475569;">Action</th>
                    </tr>
                </thead>
                <tbody id="attendanceBody">
                    @for (int i = 0; i < Model.AttendanceData.Count; i++)
                    {
                        var emp = Model.AttendanceData[i];
                        <tr class="att-row" data-empid="@emp.EmpId" data-name="@emp.Name.ToLower()" data-dept="@emp.Department" data-status="@emp.Status">
                            <td style="text-align: left; padding: 12px 18px; vertical-align: middle;">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--primary-light); color: var(--primary); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.85rem; flex-shrink: 0;">@(emp.Name.FirstOrDefault())</div>
                                    <div>
                                        <p style="font-weight: 700; margin: 0; font-size: 0.88rem; color: #0f172a; line-height: 1.2;">@emp.Name</p>
                                        <p style="font-size: 0.72rem; color: var(--text-secondary); margin: 2px 0 0 0;">@emp.EmpId • @emp.Department</p>
                                    </div>
                                </div>
                            </td>
                            <td style="text-align: center; padding: 12px 16px; vertical-align: middle;">
                                <span style="font-weight: 700; color: #0f172a; font-size: 0.88rem;">@emp.WorkingDays</span>
                                <span style="color: var(--text-secondary); font-size: 0.76rem;"> / @emp.TotalDays days</span>
                            </td>
                            <td style="text-align: center; padding: 12px 16px; vertical-align: middle; font-weight: 600; color: #334155; font-size: 0.88rem;">
                                @emp.PaidLeaves
                            </td>
                            <td style="text-align: center; padding: 12px 16px; vertical-align: middle;">
                                @if (emp.NoPayLeaves > 0 && emp.Status == "Anomaly")
                                {
                                    <span style="display: inline-flex; align-items: center; gap: 4px; padding: 3px 8px; border-radius: 6px; background: #fee2e2; color: #b91c1c; font-weight: 700; font-size: 0.78rem; border: 1px solid #fecaca;">
                                        @emp.NoPayLeaves <span style="font-size: 0.68rem; font-weight: 600;">(Unexcused)</span>
                                    </span>
                                }
                                else if (emp.NoPayLeaves > 0)
                                {
                                    <span style="display: inline-flex; align-items: center; gap: 4px; padding: 3px 8px; border-radius: 6px; background: #fef3c7; color: #b45309; font-weight: 700; font-size: 0.78rem; border: 1px solid #fde68a;">
                                        @emp.NoPayLeaves <span style="font-size: 0.68rem; font-weight: 600;">(Approved)</span>
                                    </span>
                                }
                                else
                                {
                                    <span style="color: #94a3b8; font-size: 0.84rem;">0</span>
                                }
                            </td>
                            <td style="text-align: center; padding: 12px 12px; vertical-align: middle;">
                                @if (emp.OvertimeHours > 0)
                                {
                                    <span style="font-weight: 700; color: #0284c7; font-size: 0.88rem;">@emp.OvertimeHours hrs</span>
                                    @if (emp.WeekendOtHours > 0)
                                    {
                                        <span style="display: block; font-size: 0.68rem; color: #64748b;">(@emp.WeekdayOtHours wkd / @emp.WeekendOtHours wnd)</span>
                                    }
                                }
                                else
                                {
                                    <span style="color: #94a3b8; font-size: 0.84rem;">0 hrs</span>
                                }
                            </td>
                            <td style="text-align: center; padding: 12px 12px; vertical-align: middle;">
                                @if (emp.EstimatedOtPay > 0)
                                {
                                    <span style="display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 6px; background: #f5f3ff; color: #7e22ce; font-weight: 700; font-size: 0.82rem; border: 1px solid #e9d5ff;">
                                        Rs @emp.EstimatedOtPay.ToString("N0")
                                    </span>
                                }
                                else
                                {
                                    <span style="color: #94a3b8; font-size: 0.84rem;">—</span>
                                }
                            </td>
                            <td style="text-align: center; padding: 12px 12px; vertical-align: middle;">
                                <button type="button" onclick="openReviewModal(@i)" class="btn-kanrich btn-kanrich-outline" style="padding: 4px 12px; font-size: 0.78rem; font-weight: 700; display: inline-flex; align-items: center; gap: 5px;">
                                    <i class="bi bi-calendar2-check"></i> Review
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 14px 20px; border-top: 1px solid var(--border-color);">
            <span style="font-size: 0.75rem; color: var(--text-secondary);" id="recordCount">Showing @Model.AttendanceData.Count employees</span>
            <div style="display: flex; gap: 4px;">
                <button class="btn-kanrich btn-kanrich-outline btn-action-small" style="padding: 4px 8px;"><i class="bi bi-chevron-left"></i></button>
                <button class="btn-kanrich btn-kanrich-primary btn-action-small" style="padding: 4px 8px;">1</button>
                <button class="btn-kanrich btn-kanrich-outline btn-action-small" style="padding: 4px 8px;">2</button>
                <button class="btn-kanrich btn-kanrich-outline btn-action-small" style="padding: 4px 8px;"><i class="bi bi-chevron-right"></i></button>
            </div>
        </div>
    </div>

</div>

<!-- Employee Attendance Duration Review Modal -->
<div class="modal-overlay" id="attendanceDetailModal" onclick="closeReviewModal(event)">
    <div class="modal-dialog-large" onclick="event.stopPropagation()">
        <div class="modal-header-custom">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div id="modalEmpAvatar" style="width: 40px; height: 40px; border-radius: 50%; background: var(--primary-light); color: var(--primary); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1rem; flex-shrink: 0;">E</div>
                <div>
                    <h3 id="modalEmpName" style="margin: 0; font-size: 1.05rem; color: #0f172a; font-weight: 800;">Employee Name</h3>
                    <p id="modalEmpMeta" style="margin: 2px 0 0 0; font-size: 0.76rem; color: #64748b;">EMP-001 • Department • Branch • Cycle</p>
                </div>
            </div>
            <button type="button" onclick="closeReviewModal()" style="background: none; border: none; font-size: 1.4rem; cursor: pointer; color: #94a3b8; line-height: 1;">&times;</button>
        </div>

        <div class="modal-body-scroll">
            <!-- KPI Summary Bar -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; flex-shrink: 0;">
                <div class="kpi-badge-box">
                    <span style="font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase;">Working Days</span>
                    <div id="modalKpiWorkingDays" style="font-size: 17px; font-weight: 800; color: #0f172a; margin-top: 2px;">0 / 21</div>
                </div>
                <div class="kpi-badge-box">
                    <span style="font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase;">Paid Leaves</span>
                    <div id="modalKpiPaidLeaves" style="font-size: 17px; font-weight: 800; color: #334155; margin-top: 2px;">0</div>
                </div>
                <div class="kpi-badge-box">
                    <span style="font-size: 11px; font-weight: 700; color: #d97706; text-transform: uppercase;">No-Pay Leaves</span>
                    <div id="modalKpiNoPayLeaves" style="font-size: 17px; font-weight: 800; color: #b45309; margin-top: 2px;">0</div>
                </div>
                <div class="kpi-badge-box">
                    <span style="font-size: 11px; font-weight: 700; color: #0284c7; text-transform: uppercase;">Weekday OT (1.5×)</span>
                    <div id="modalKpiWeekdayOt" style="font-size: 17px; font-weight: 800; color: #0284c7; margin-top: 2px;">0 hrs</div>
                </div>
                <div class="kpi-badge-box">
                    <span style="font-size: 11px; font-weight: 700; color: #0284c7; text-transform: uppercase;">Weekend OT (2.0×)</span>
                    <div id="modalKpiWeekendOt" style="font-size: 17px; font-weight: 800; color: #0284c7; margin-top: 2px;">0 hrs</div>
                </div>
                <div class="kpi-badge-box" style="background: #f5f3ff; border-color: #e9d5ff;">
                    <span style="font-size: 11px; font-weight: 700; color: #7e22ce; text-transform: uppercase;">Estimated OT Pay</span>
                    <div id="modalKpiOtPay" style="font-size: 17px; font-weight: 800; color: #7e22ce; margin-top: 2px;">Rs 0</div>
                </div>
            </div>

            <!-- Daily Logs Filter Bar -->
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; flex-shrink: 0;">
                <div style="display: flex; gap: 6px; flex-wrap: wrap;" id="logFilterContainer">
                    <button type="button" class="log-filter-pill active" onclick="filterDailyLogs('all', event)">All Days (<span id="countAll">0</span>)</button>
                    <button type="button" class="log-filter-pill" onclick="filterDailyLogs('working', event)">Working Days (<span id="countWorking">0</span>)</button>
                    <button type="button" class="log-filter-pill" onclick="filterDailyLogs('ot', event)">Overtime (<span id="countOt">0</span>)</button>
                    <button type="button" class="log-filter-pill" onclick="filterDailyLogs('leaves', event)">Leaves (<span id="countLeaves">0</span>)</button>
                    <button type="button" class="log-filter-pill" onclick="filterDailyLogs('anomalies', event)">Anomalies (<span id="countAnomalies">0</span>)</button>
                </div>
                <span style="font-size: 12px; color: #64748b;" id="dailyLogCount">Showing all days</span>
            </div>

            <!-- Detailed Daily Attendance Table Container with dedicated vertical scrolling and sticky header -->
            <div class="daily-table-scroll">
                <table class="k-table" style="width: 100%; border-collapse: collapse; font-size: 0.84rem;">
                    <thead style="background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                        <tr>
                            <th style="text-align: left; padding: 10px 14px; font-weight: 700; color: #475569; width: 18%;">Date & Day</th>
                            <th style="text-align: center; padding: 10px 12px; font-weight: 700; color: #475569; width: 16%;">Check In</th>
                            <th style="text-align: center; padding: 10px 12px; font-weight: 700; color: #475569; width: 16%;">Check Out</th>
                            <th style="text-align: center; padding: 10px 12px; font-weight: 700; color: #475569; width: 14%;">Duration</th>
                            <th style="text-align: center; padding: 10px 12px; font-weight: 700; color: #475569; width: 18%;">Status</th>
                            <th style="text-align: right; padding: 10px 14px; font-weight: 700; color: #475569; width: 18%;">Overtime Pay</th>
                        </tr>
                    </thead>
                    <tbody id="dailyLogsTableBody">
                        <!-- Rendered dynamically by JavaScript -->
                    </tbody>
                </table>
            </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; padding: 14px 24px; border-top: 1px solid #e2e8f0; background: #f8fafc; flex-shrink: 0;">
            <span style="font-size: 12px; color: #64748b;">Formula applied: Basic ÷ (@Model.OtPolicy.StandardMonthlyWorkingDays × @Model.OtPolicy.StandardDailyWorkingHours) × Rate Multiplier</span>
            <button type="button" onclick="closeReviewModal()" class="btn-kanrich btn-kanrich-outline" style="padding: 6px 18px;">Close</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Preloaded Attendance Records Data
        const attendanceRecords = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AttendanceData, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
        const selectedCycle = '@Model.SelectedMonthName';
        const branchName = '@(Model.CurrentBranch?.Name ?? "Selected Branch")';

        let currentActiveRecord = null;
        let currentFilter = 'all';

        function filterTable() {
            const search = (document.getElementById('tableSearch').value || '').toLowerCase().trim();
            const dept   = (document.getElementById('deptFilter').value || '').toLowerCase().trim();
            const status = (document.getElementById('statusFilter').value || '').toLowerCase().trim();

            let visibleCount = 0;

            document.querySelectorAll('.att-row').forEach(row => {
                const matchName   = !search || (row.dataset.name || '').includes(search) || (row.dataset.empid || '').toLowerCase().includes(search);
                const matchDept   = !dept   || (row.dataset.dept || '').toLowerCase().includes(dept);
                const matchStatus = !status || (row.dataset.status || '').toLowerCase() === status;

                if (matchName && matchDept && matchStatus) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const recordCount = document.getElementById('recordCount');
            if (recordCount) {
                recordCount.textContent = `Showing ${visibleCount} employees`;
            }
        }

        function openReviewModal(index) {
            const emp = attendanceRecords[index];
            if (!emp) return;

            currentActiveRecord = emp;
            currentFilter = 'all';

            document.getElementById('modalEmpAvatar').textContent = emp.name.charAt(0).toUpperCase();
            document.getElementById('modalEmpName').textContent = emp.name;
            document.getElementById('modalEmpMeta').textContent = `${emp.empId} • ${emp.designation || 'Employee'} • ${emp.department} • ${branchName} • ${selectedCycle}`;

            document.getElementById('modalKpiWorkingDays').textContent = `${emp.workingDays} / ${emp.totalDays}`;
            document.getElementById('modalKpiPaidLeaves').textContent = emp.paidLeaves;
            document.getElementById('modalKpiNoPayLeaves').textContent = emp.noPayLeaves;
            document.getElementById('modalKpiWeekdayOt').textContent = `${emp.weekdayOtHours} hrs`;
            document.getElementById('modalKpiWeekendOt').textContent = `${emp.weekendOtHours} hrs`;
            document.getElementById('modalKpiOtPay').textContent = emp.estimatedOtPay > 0 ? `Rs ${emp.estimatedOtPay.toLocaleString()}` : 'Rs 0';

            // Counts for filter pills
            const logs = emp.dailyLogs || [];
            document.getElementById('countAll').textContent = logs.length;
            document.getElementById('countWorking').textContent = logs.filter(l => (l.totalHours > 0 || l.status === 'Present' || l.status === 'Late') && !l.hasLeave).length;
            document.getElementById('countOt').textContent = logs.filter(l => l.otHours > 0).length;
            document.getElementById('countLeaves').textContent = logs.filter(l => l.hasLeave || l.status.toLowerCase().includes('leave')).length;
            document.getElementById('countAnomalies').textContent = logs.filter(l => l.status.toLowerCase().includes('anomaly')).length;

            // Reset active filter pill to "All Days"
            document.querySelectorAll('#logFilterContainer .log-filter-pill').forEach(pill => pill.classList.remove('active'));
            const firstPill = document.querySelector('#logFilterContainer .log-filter-pill');
            if (firstPill) firstPill.classList.add('active');

            renderDailyLogs();
            document.getElementById('attendanceDetailModal').classList.add('open');
        }

        function filterDailyLogs(type, ev) {
            if (ev) {
                ev.stopPropagation();
            }
            currentFilter = type;
            document.querySelectorAll('#logFilterContainer .log-filter-pill').forEach(pill => pill.classList.remove('active'));
            if (ev && ev.currentTarget) {
                ev.currentTarget.classList.add('active');
            }
            renderDailyLogs();
        }

        function renderDailyLogs() {
            if (!currentActiveRecord) return;
            const tbody = document.getElementById('dailyLogsTableBody');
            tbody.innerHTML = '';

            const logs = currentActiveRecord.dailyLogs || [];
            let visibleCount = 0;

            logs.forEach(log => {
                let include = true;
                if (currentFilter === 'working') {
                    include = (log.totalHours > 0 || log.status === 'Present' || log.status === 'Late') && !log.hasLeave;
                } else if (currentFilter === 'ot') {
                    include = log.otHours > 0;
                } else if (currentFilter === 'leaves') {
                    include = log.hasLeave || log.status.toLowerCase().includes('leave');
                } else if (currentFilter === 'anomalies') {
                    include = log.status.toLowerCase().includes('anomaly');
                }

                if (!include) return;
                visibleCount++;

                const tr = document.createElement('tr');
                tr.style.borderBottom = '1px solid #f1f5f9';
                if (log.isWeekend) {
                    tr.style.backgroundColor = '#fafafa';
                }

                let badgeHtml = '';
                if (log.status.includes('Anomaly')) {
                    badgeHtml = `<span class="k-badge k-badge-rejected" style="font-size: 11px;">⚠️ ${log.status}</span>`;
                } else if (log.status === 'Present') {
                    badgeHtml = `<span class="k-badge k-badge-approved" style="font-size: 11px;">✓ Present</span>`;
                } else if (log.status === 'Late') {
                    badgeHtml = `<span class="k-badge k-badge-warning" style="font-size: 11px;">⏱ Late</span>`;
                } else if (log.status.includes('No-Pay')) {
                    badgeHtml = `<span class="k-badge k-badge-rejected" style="font-size: 11px;">No-Pay Leave</span>`;
                } else if (log.status.includes('Leave')) {
                    badgeHtml = `<span class="k-badge k-badge-warning" style="font-size: 11px;">${log.status}</span>`;
                } else if (log.status === 'Weekend Duty') {
                    badgeHtml = `<span class="k-badge k-badge-info" style="font-size: 11px;">Weekend Duty</span>`;
                } else if (log.status === 'Weekend') {
                    badgeHtml = `<span style="color: #94a3b8; font-size: 11px; font-weight: 600;">Weekend</span>`;
                } else {
                    badgeHtml = `<span style="color: #94a3b8; font-size: 11px;">${log.status}</span>`;
                }

                let otHtml = '—';
                if (log.otHours > 0) {
                    otHtml = `<div style="text-align: right;">
                                <span style="font-weight: 700; color: #0284c7; font-size: 12.5px;">+${log.otHours} hrs (${log.otRateLabel})</span>
                                ${log.otPay > 0 ? `<div style="font-size: 11px; color: #7e22ce; font-weight: 700;">Rs ${log.otPay.toLocaleString()}</div>` : ''}
                              </div>`;
                }

                tr.innerHTML = `
                    <td style="padding: 10px 14px; vertical-align: middle;">
                        <span style="font-weight: 700; color: #0f172a;">${log.dateStr}</span>
                        <span style="font-size: 11px; color: ${log.isWeekend ? '#d97706' : '#64748b'}; font-weight: 600; margin-left: 4px;">(${log.dayName})</span>
                    </td>
                    <td style="text-align: center; padding: 10px 12px; vertical-align: middle; font-weight: 600; color: #334155;">${log.timeIn}</td>
                    <td style="text-align: center; padding: 10px 12px; vertical-align: middle; font-weight: 600; color: #334155;">${log.timeOut}</td>
                    <td style="text-align: center; padding: 10px 12px; vertical-align: middle;">
                        ${log.totalHours > 0 ? `<strong style="color: #0f172a;">${log.totalHours} hrs</strong>` : '<span style="color: #94a3b8;">0 hrs</span>'}
                    </td>
                    <td style="text-align: center; padding: 10px 12px; vertical-align: middle;">${badgeHtml}</td>
                    <td style="text-align: right; padding: 10px 14px; vertical-align: middle;">${otHtml}</td>
                `;

                tbody.appendChild(tr);
            });

            if (visibleCount === 0) {
                const tr = document.createElement('tr');
                tr.innerHTML = `<td colspan="6" style="text-align: center; padding: 24px; color: #94a3b8; font-size: 13px;">No attendance records found for this filter.</td>`;
                tbody.appendChild(tr);
            }

            document.getElementById('dailyLogCount').textContent = `Showing ${visibleCount} of ${logs.length} days`;
        }

        function closeReviewModal(e) {
            if (!e || e.target === document.getElementById('attendanceDetailModal')) {
                document.getElementById('attendanceDetailModal').classList.remove('open');
            }
        }

        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape") {
                closeReviewModal();
            }
        });

        document.addEventListener('DOMContentLoaded', function () {
            filterTable();
        });
    </script>
}
